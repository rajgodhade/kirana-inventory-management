<Application
    x:Class="Kirana.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Kirana.App.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/DesignTokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/ChartTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:StringToBoolConverter x:Key="StringToBoolConverter" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <conv:StockStatusToBrushConverter x:Key="StockStatusToBrushConverter" />
            <conv:ExpiryStatusToBrushConverter x:Key="ExpiryStatusToBrushConverter" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:CurrencyConverter x:Key="CurrencyConverter" />
            <conv:QuantityConverter x:Key="QuantityConverter" />
            <conv:PaymentMethodConverter x:Key="PaymentMethodConverter" />
            <conv:PaymentMethodIconConverter x:Key="PaymentMethodIconConverter" />
            <conv:DetailIndentConverter x:Key="DetailIndentConverter" />
            <conv:BillTabFontWeightConverter x:Key="BillTabFontWeightConverter" />
            <conv:ImportRowBackgroundConverter x:Key="ErrorRowBackgroundConverter" />
            <conv:ImportStatusForegroundConverter x:Key="ErrorStatusForegroundConverter" />
            <conv:ImportRowBorderConverter x:Key="ErrorRowBorderConverter" />
            <conv:HardwareStatusForegroundConverter x:Key="HardwareStatusForegroundConverter" />
            <conv:HardwareStatusBackgroundConverter x:Key="HardwareStatusBackgroundConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
