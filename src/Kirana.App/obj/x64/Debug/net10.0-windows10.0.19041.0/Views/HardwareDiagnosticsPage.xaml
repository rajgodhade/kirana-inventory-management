<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.HardwareDiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Padding="{StaticResource PageHeaderPadding}" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Hardware Diagnostics" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Check devices and local system dependencies without interrupting billing." Style="{StaticResource PageSubtitleTextStyle}" /></StackPanel>
            <Button x:ConnectionId='11' Grid.Column="1" Content="Run diagnostics" Style="{StaticResource AccentButtonStyle}"                                                                                  />
            <Button x:ConnectionId='12' Grid.Column="2" Content="Export report"                                                                />
        </Grid>
        <StackPanel Grid.Row="1" Margin="24,0,24,12" Spacing="8">
            <TextBlock x:ConnectionId='9'                                                    Style="{StaticResource CaptionTextStyle}" />
            <InfoBar x:ConnectionId='10'                                                                                                         Severity="Error"                                                        />
        </StackPanel>
        <ListView x:ConnectionId='2' Grid.Row="2" Margin="24,0,24,24"                                          SelectionMode="None">
            <ListView.ItemTemplate><DataTemplate                                       >
                <Border x:ConnectionId='4' Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,8">
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock x:ConnectionId='5'                           FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border x:ConnectionId='6' Grid.Column="1"                                                                                            CornerRadius="12" Padding="10,5"><TextBlock x:ConnectionId='8'                            FontWeight="SemiBold"                                                                                            /></Border>
                        <TextBlock x:ConnectionId='7' Grid.Column="2"                        TextWrapping="Wrap" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </DataTemplate></ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

