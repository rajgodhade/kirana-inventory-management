<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.DatabaseMaintenancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:maint="using:Kirana.Application.Maintenance">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="{StaticResource PageHeaderPadding}" Spacing="2">
            <TextBlock Text="Database Maintenance" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Health checks and housekeeping. None of these tools add, change or delete your business records."
                       Style="{StaticResource PageSubtitleTextStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,0,24,24" Spacing="16" MaxWidth="880" HorizontalAlignment="Left">

                <ProgressBar x:ConnectionId='2' IsIndeterminate="True"
                                                                                                                                       />

                <InfoBar x:ConnectionId='3'                                                                                                        
                         Severity="Error"                                                        IsClosable="False" />
                <InfoBar x:ConnectionId='4'                                                                                                         
                         Severity="Success"                                                         IsClosable="False" />

                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Database" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock x:ConnectionId='19'                                                        
                                       Style="{StaticResource CodeTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock x:ConnectionId='20'                                                   
                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:ConnectionId='21'                                                          
                                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button x:ConnectionId='15' Content="Refresh statistics"                                                      
                                                                                 HorizontalAlignment="Left" />

                        <ItemsControl x:ConnectionId='16'                                                 >
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <muxc:ItemsWrapGrid Orientation="Horizontal" ItemWidth="200" ItemHeight="24" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate                      >
                                    <TextBlock x:ConnectionId='18'                 Style="{StaticResource SecondaryTextStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Health &amp; housekeeping" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                                       Text="Integrity check reads the file and reports problems. Vacuum rebuilds it to reclaim unused space. Analyze refreshes the statistics SQLite uses to plan queries." />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:ConnectionId='12' Content="Run integrity check" Style="{StaticResource AccentButtonStyle}"
                                                                                         
                                                                                     />
                            <Button x:ConnectionId='13' Content="Vacuum"                                                                        />
                            <Button x:ConnectionId='14' Content="Analyze"                                            
                                                                                     />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Dangling records" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                                       Text="Looks for rows whose parent record is missing. This is a read-only report — Kirana never deletes business records automatically." />
                        </StackPanel>

                        <Button x:ConnectionId='6' Content="Check for dangling records"                                                
                                                                                 HorizontalAlignment="Left" />

                        <ItemsControl x:ConnectionId='7'                                              >
                            <ItemsControl.ItemTemplate>
                                <DataTemplate                                     >
                                    <Grid x:ConnectionId='9' ColumnSpacing="16" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:ConnectionId='10' Grid.Column="0"                            
                                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock x:ConnectionId='11' Grid.Column="1"                      
                                                   Style="{StaticResource AmountTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Verify a backup file" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                                       Text="Runs the same checks a restore would: bundle structure, checksum, and an integrity check of the database inside it." />
                        </StackPanel>

                        <Button x:ConnectionId='5' Content="Choose a backup file…"                            
                                                                                 HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

