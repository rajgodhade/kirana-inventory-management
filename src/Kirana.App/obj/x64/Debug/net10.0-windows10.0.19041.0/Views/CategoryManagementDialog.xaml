<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.CategoryManagementDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:entities="using:Kirana.Domain.Entities"
    CloseButtonText="Done"
    DefaultButton="Close">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Manage Categories" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:ConnectionId='2' Grid.Column="1" Padding="6" Background="Transparent" BorderThickness="0"
                                             AutomationProperties.Name="Close">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <StackPanel Spacing="10" MinWidth="360" MaxHeight="480">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:ConnectionId='12' Grid.Column="0" PlaceholderText="New category name"                                                        />
            <Button x:ConnectionId='13' Grid.Column="1" Content="Add"                                         />
        </Grid>

        <InfoBar x:ConnectionId='3'                                                                                                        
                 Severity="Error"                                                        />

        <ListView x:ConnectionId='4'                                             MaxHeight="360">
            <ListView.ItemTemplate>
                <DataTemplate                               >
                    <Grid x:ConnectionId='6' ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:ConnectionId='7' Grid.Column="0"                      VerticalAlignment="Center" />

                        <Border x:ConnectionId='8' Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Center"
                                Background="{ThemeResource SuccessSubtleBrush}"
                                                                                                                    >
                            <TextBlock Text="Active" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource SuccessBrush}" />
                        </Border>
                        <Border x:ConnectionId='9' Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Center"
                                Background="{ThemeResource SurfaceAltBrush}"
                                                                                                                           >
                            <TextBlock Text="Inactive" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource TextTertiaryBrush}" />
                        </Border>

                        <Button x:ConnectionId='10' Grid.Column="2" Content="Deactivate"                                           
                                                                                                                     />
                        <Button x:ConnectionId='11' Grid.Column="2" Content="Reactivate"                                           
                                                                                                                            />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>

