<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.PaymentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    Title="Payment"
    PrimaryButtonText="Complete Sale"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="520" MaxHeight="560">

        <TextBlock FontSize="28" FontWeight="Bold" HorizontalAlignment="Center">
            <Run Text="Total: ₹" /><Run x:ConnectionId='13'                                                   />
        </TextBlock>

        <ListView x:ConnectionId='2'                                               MaxHeight="280" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate                                     >
                    <Grid x:ConnectionId='7' ColumnSpacing="6" Padding="0,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox x:ConnectionId='8' Grid.Column="0"                                        
                                                                              />
                        <TextBox x:ConnectionId='9' Grid.Column="1" PlaceholderText="Amount"                                         />
                        <TextBox x:ConnectionId='10' Grid.Column="2" PlaceholderText="Cash tendered"                                                 />
                        <TextBox x:ConnectionId='11' Grid.Column="3" PlaceholderText="Reference #"                                              />
                        <Button x:ConnectionId='12' Grid.Column="4" Content="✕"                                          />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button x:ConnectionId='3' Content="+ Add Payment (Split)"                                                    HorizontalAlignment="Left" />

        <TextBlock FontSize="16">
            <Run Text="Remaining: ₹" /><Run x:ConnectionId='5'                                                        />
        </TextBlock>

        <InfoBar x:ConnectionId='4'                                                                                                        
                 Severity="Error"                                                        />
    </StackPanel>
</ContentDialog>

