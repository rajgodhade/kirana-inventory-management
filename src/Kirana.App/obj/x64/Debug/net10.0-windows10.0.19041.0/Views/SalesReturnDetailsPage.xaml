<Page
    x:Class="Kirana.App.Views.SalesReturnDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:print="using:Kirana.Application.Printing">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock x:ConnectionId='18' x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:ConnectionId='19' x:Name="SubtitleText" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <Button x:ConnectionId='17' Grid.Column="1"                      VerticalAlignment="Center" AutomationProperties.Name="Print Receipt">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE749;" FontSize="14" />
                    <TextBlock Text="Print Receipt" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,0,24,24" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">

                <InfoBar x:ConnectionId='2' x:Name="ErrorBar" IsOpen="False" Severity="Error" />

                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="32" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Value of goods" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock x:ConnectionId='16' x:Name="TotalText" Style="{StaticResource MetricTextStyle}" FontSize="22" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="Refunded" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock x:ConnectionId='15' x:Name="RefundText" Style="{StaticResource MetricTextStyle}" FontSize="22" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Method" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock x:ConnectionId='14' x:Name="MethodText" Style="{StaticResource SectionTitleTextStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4">
                            <TextBlock x:ConnectionId='12' x:Name="CustomerText" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock x:ConnectionId='13' x:Name="ReasonText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Spacing="10">
                    <TextBlock Text="Returned items" Style="{StaticResource SectionTitleTextStyle}" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                        <ItemsControl x:ConnectionId='3' x:Name="LinesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate                                     >
                                    <Grid x:ConnectionId='5' Padding="14,12" ColumnSpacing="16"
                                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="200" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock x:ConnectionId='10'                             Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock x:ConnectionId='11'                             Style="{StaticResource CodeTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center">
                                            <Run x:ConnectionId='8'                                                                        /><Run Text=" " /><Run x:ConnectionId='9'                      />
                                        </TextBlock>
                                        <TextBlock x:ConnectionId='6' Grid.Column="2"                             Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock x:ConnectionId='7' Grid.Column="3"                                                                               
                                                   Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

