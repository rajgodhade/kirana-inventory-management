<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.SetupWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="48" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left" Spacing="12">

            <TextBlock Text="Set up your store" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="This information appears on invoices and is used across the app."
                       Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBlock Text="Store name *" />
            <TextBox x:ConnectionId='2'                                                  />

            <TextBlock Text="Owner name *" />
            <TextBox x:ConnectionId='3'                                                  />

            <TextBlock Text="GSTIN (optional)" />
            <TextBox x:ConnectionId='4'                                              />

            <TextBlock Text="Address" />
            <TextBox x:ConnectionId='5'                                                />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:ConnectionId='16' Grid.Column="0" Header="City"                                             />
                <TextBox x:ConnectionId='17' Grid.Column="1" Header="State"                                              />
                <TextBox x:ConnectionId='18' Grid.Column="2" Header="PIN code"                                                />
            </Grid>

            <TextBox x:ConnectionId='6' Header="Contact number"                                                      />
            <TextBox x:ConnectionId='7' Header="Email"                                              />

            <CheckBox x:ConnectionId='8' Content="Enable GST billing"                                                          Margin="0,8,0,0" />
            <TextBox x:ConnectionId='9' Header="Invoice prefix"                                                      />

            <TextBlock Text="Admin account" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,0" />
            <TextBlock Text="You'll use this to unlock the management area from the billing screen."
                       Opacity="0.7" TextWrapping="Wrap" />

            <TextBox x:ConnectionId='10' Header="Admin full name *"                                                      />
            <TextBox x:ConnectionId='11' Header="Admin username *"                                                      />
            <PasswordBox x:ConnectionId='12' Header="Admin password *"                                                          />
            <PasswordBox x:ConnectionId='13' Header="Quick-access PIN (optional)"                                                     />

            <InfoBar x:ConnectionId='14'
                                                                                                                       
                Severity="Error"
                                                                      
                Margin="0,12,0,0" />

            <Button x:ConnectionId='15'
                Content="Finish setup"
                                                                 
                                                                                                                         
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Left"
                Margin="0,20,0,40" />

        </StackPanel>
    </ScrollViewer>
</Page>

