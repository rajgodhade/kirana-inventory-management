<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.CustomerPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:entities="using:Kirana.Domain.Entities"
    Title="Select Customer"
    PrimaryButtonText="Select"
    SecondaryButtonText="Walk-in Customer"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="380" MaxHeight="520">

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:ConnectionId='11' Grid.Column="0" PlaceholderText="Search by name or phone"
                                                                                                    />
            <Button x:ConnectionId='12' Grid.Column="1" Content="Search"                       />
        </Grid>

        <ListView x:ConnectionId='2' x:Name="ResultsList"                                          MaxHeight="200"
                  SelectionMode="None" IsItemClickEnabled="True"                            >
            <ListView.ItemTemplate>
                <DataTemplate                               >
                    <StackPanel x:ConnectionId='8' Orientation="Horizontal" Spacing="10">
                        <TextBlock x:ConnectionId='9'                      FontWeight="SemiBold" />
                        <TextBlock x:ConnectionId='10'                       Opacity="0.7" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Text="Add new customer" FontWeight="SemiBold" Margin="0,8,0,0" />
        <TextBox x:ConnectionId='3' PlaceholderText="Name"                                                        />
        <TextBox x:ConnectionId='4' PlaceholderText="Phone"                                                         />
        <Button x:ConnectionId='5' Content="Create &amp; Select"                                                    HorizontalAlignment="Left" />

        <InfoBar x:ConnectionId='6'                                                                                                        
                 Severity="Error"                                                        />
    </StackPanel>
</ContentDialog>

