<ContentDialog
    x:Class="Kirana.App.Views.ResetPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Reset"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Reset Password" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:ConnectionId='2' Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                                             AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <StackPanel Spacing="10" MinWidth="320">
        <PasswordBox x:ConnectionId='3' x:Name="NewPasswordBox" Header="New password (min. 6 characters)" />
        <PasswordBox x:ConnectionId='4' x:Name="ConfirmPasswordBox" Header="Confirm new password" />
        <InfoBar x:ConnectionId='5' x:Name="ErrorBar" IsOpen="False" Severity="Error" />
    </StackPanel>
</ContentDialog>

