<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.HeldBillsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:entities="using:Kirana.Domain.Entities"
    Title="Resume Held Bill"
    CloseButtonText="Cancel"
    DefaultButton="Close">

    <StackPanel Spacing="10" MinWidth="420" MaxHeight="480">
        <InfoBar x:ConnectionId='2'                                                                                                        
                 Severity="Error"                                                        />

        <ListView x:ConnectionId='3'                                            MaxHeight="400" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate                               >
                    <Grid x:ConnectionId='5' ColumnSpacing="10" Padding="0,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="Held at " /><Run x:ConnectionId='9'                           />
                            </TextBlock>
                            <TextBlock Opacity="0.7">
                                <Run Text="Items: " /><Run x:ConnectionId='7'                             />
                                <Run Text="  Customer: " /><Run x:ConnectionId='8'                               />
                            </TextBlock>
                        </StackPanel>
                        <Button x:ConnectionId='6' Grid.Column="1" Content="Resume"                                      />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>

