<Page x:ConnectionId='1' x:Class="Kirana.App.Views.InvoicesPage" x:Name="RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:dom="using:Kirana.Domain.Entities"
      xmlns:vm="using:Kirana.App.ViewModels"
      xmlns:interaction="using:Kirana.App.Interaction">
    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}"><StackPanel Spacing="2"><TextBlock Text="Invoices" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Completed sales, receipts, returns and invoice history." Style="{StaticResource PageSubtitleTextStyle}" /></StackPanel></Grid>

        <Grid Grid.Row="1" Padding="24,0,24,16" ColumnSpacing="{StaticResource SpacingL}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:ConnectionId='42' Grid.Column="0"                      Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><Border Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelBlueBrush}" BorderBrush="{ThemeResource PastelBlueBrush}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity=".65"/><FontIcon Glyph="&#xE8C7;" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="{ThemeResource PastelBlueOnBrush}"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="TODAY'S SALES" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}"/><TextBlock x:ConnectionId='49'                                                                                                 Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}"/><TextBlock Text="completed today" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}"/></StackPanel></Grid></Border></Button>
            <Button x:ConnectionId='43' Grid.Column="1"                      Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><Border Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelGreenBrush}" BorderBrush="{ThemeResource PastelGreenBrush}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity=".65"/><FontIcon Glyph="&#xE7C3;" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="{ThemeResource PastelGreenOnBrush}"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="TODAY'S BILLS" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}"/><TextBlock x:ConnectionId='48'                                                       Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}"/><TextBlock Text="in the current view" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}"/></StackPanel></Grid></Border></Button>
            <Button x:ConnectionId='44' Grid.Column="2"                      Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><Border Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelVioletBrush}" BorderBrush="{ThemeResource PastelVioletBrush}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity=".65"/><FontIcon Glyph="&#xEAF4;" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="{ThemeResource PastelVioletOnBrush}"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="AVERAGE BILL VALUE" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}"/><TextBlock x:ConnectionId='47'                                                                                                       Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}"/><TextBlock Text="today" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}"/></StackPanel></Grid></Border></Button>
            <Button x:ConnectionId='45' Grid.Column="3"                           Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><Border Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity=".65"/><FontIcon Glyph="&#xE9D9;" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="{ThemeResource PastelAmberOnBrush}"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="TOTAL SALES" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}"/><TextBlock x:ConnectionId='46'                                                                                                          Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}"/><TextBlock Text="selected period" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}"/></StackPanel></Grid></Border></Button>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource FilterBarStyle}" Margin="24,0,24,16"><StackPanel Spacing="8"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBox x:ConnectionId='35' PlaceholderText="Search invoice / customer / mobile..."                                                                                                                                                    />
            <CalendarDatePicker x:ConnectionId='36' Grid.Column="1" PlaceholderText="From date"                                                                                   />
            <CalendarDatePicker x:ConnectionId='37' Grid.Column="2" PlaceholderText="To date"                                                                                 />
            <ComboBox x:ConnectionId='38' Grid.Column="3"                                                                                                                                                               />
            <ComboBox x:ConnectionId='39' Grid.Column="4"                                                                                                                                                                ><ComboBox.ItemTemplate><DataTemplate                          ><TextBlock x:ConnectionId='41'                     /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        </Grid><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:ConnectionId='28' Grid.Column="0"                                                       DisplayMemberPath="Name"                                                                                                        />
            <ComboBox x:ConnectionId='29' Grid.Column="1"                                                                                                                                                                  />
            <ComboBox x:ConnectionId='30' Grid.Column="2"                                                                                                                                                            />
            <ComboBox x:ConnectionId='31' Grid.Column="3"                                                                                                                                                  />
            <Button x:ConnectionId='32' Grid.Column="5" Content="Clear dates"                           />
            <Button x:ConnectionId='33' Grid.Column="6" Content="Clear filters"                             />
            <Button x:ConnectionId='34' Grid.Column="7" Content="Export"                                                                />
        </Grid></StackPanel></Border>

        <Grid Grid.Row="3" Margin="24,0,24,24"><Border Style="{StaticResource ElevatedCardStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="12,10" ColumnSpacing="12" Background="{ThemeResource SurfaceAltBrush}" CornerRadius="16,16,0,0" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*" MinWidth="160"/><ColumnDefinition Width="120"/><ColumnDefinition Width="145"/><ColumnDefinition Width="80"/><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><TextBlock Text="INVOICE" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="1" Text="CUSTOMER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="2" Text="CASHIER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="3" Text="DATE &amp; TIME" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="4" Text="ITEMS" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="5" Text="PAYMENT / PROMO" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="6" Text="TOTAL" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/><TextBlock Grid.Column="7" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="8" Text="ACTIONS" Style="{StaticResource ColumnHeaderTextStyle}"/></Grid>
            <StackPanel x:ConnectionId='3' Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"                                                                                                                     ><FontIcon Glyph="&#xE8C7;" FontSize="36" Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="No invoices found." Style="{StaticResource CardTitleTextStyle}" HorizontalAlignment="Center"/><TextBlock Text="Try changing the filters or date range." Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center"/></StackPanel>
            <ListView x:ConnectionId='4' Grid.Row="1"                                           SelectionMode="None"                                                                                                              ><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="0"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate                                    ><Border x:ConnectionId='6' Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"><Grid x:ConnectionId='7' Padding="12,11" ColumnSpacing="12"                                     interaction:ActionCursor.IsActionable="True"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*" MinWidth="160"/><ColumnDefinition Width="120"/><ColumnDefinition Width="145"/><ColumnDefinition Width="80"/><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><TextBlock x:ConnectionId='8'                               FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock x:ConnectionId='26'                              Style="{StaticResource BodyTextStyle}"/><TextBlock x:ConnectionId='27'                                   Style="{StaticResource CaptionTextStyle}"/></StackPanel><TextBlock x:ConnectionId='9' Grid.Column="2"                             Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/><TextBlock x:ConnectionId='10' Grid.Column="3"                              Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/><TextBlock x:ConnectionId='11' Grid.Column="4"                                Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/><StackPanel Grid.Column="5" Spacing="2" VerticalAlignment="Center"><TextBlock x:ConnectionId='23'                                   Style="{StaticResource CaptionTextStyle}"/><Border x:ConnectionId='24' Background="{ThemeResource PastelVioletBrush}" Style="{StaticResource BadgeBorderStyle}"                                                                                         ><TextBlock x:ConnectionId='25'                               Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}"/></Border></StackPanel><TextBlock x:ConnectionId='12' Grid.Column="6"                                                                          Style="{StaticResource AmountTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/><Border Grid.Column="7" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource SuccessSubtleBrush}" VerticalAlignment="Center"><TextBlock x:ConnectionId='22'                            Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource SuccessBrush}"/></Border><StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button x:ConnectionId='13' Content="View"                                   /><Button x:ConnectionId='14' Content="Print"                                    /><Button x:ConnectionId='15'                Width="34" Padding="8,5" AutomationProperties.Name="More invoice actions"><FontIcon Glyph="&#xE712;"/><Button.Flyout><MenuFlyout><MenuFlyoutItem x:ConnectionId='16' Text="Print GST invoice"                                        IsEnabled="{Binding ElementName=RootPage, Path=ViewModel.CanReprint}"/><MenuFlyoutItem x:ConnectionId='17' Text="Duplicate copy"                                         IsEnabled="{Binding ElementName=RootPage, Path=ViewModel.CanReprint}"/><MenuFlyoutItem x:ConnectionId='18' Text="Return items"                                      IsEnabled="{Binding ElementName=RootPage, Path=ViewModel.CanRefund}"/><MenuFlyoutItem Text="Refund" IsEnabled="False" ToolTipService.ToolTip="Use Return items to process supported refunds."/><MenuFlyoutSeparator/><MenuFlyoutItem x:ConnectionId='19' Text="Export PDF"                          IsEnabled="{Binding ElementName=RootPage, Path=ViewModel.CanExport}"/><MenuFlyoutItem x:ConnectionId='20' Text="Export Excel"                            IsEnabled="{Binding ElementName=RootPage, Path=ViewModel.CanExport}"/><MenuFlyoutItem Text="Share (coming soon)" IsEnabled="False"/><MenuFlyoutItem x:ConnectionId='21' Text="Audit history"                                   /></MenuFlyout></Button.Flyout></Button></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
        </Grid></Border><InfoBar x:ConnectionId='2'                                                                                                         Severity="Error"                                                        VerticalAlignment="Top" Margin="0,0,0,8"/></Grid>
    </Grid>
</Page>

