<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.ProductImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    CloseButtonText="Close"
    PrimaryButtonText="Import"
                                                                      
                                             
    DefaultButton="Primary">

    <!-- A ContentDialog's actual rendered width comes from the ContentDialogMaxWidth theme
         resource baked into its default template, not the MaxWidth property set on the element
         itself (that has no visible effect — confirmed live: it rendered at ~620px regardless).
         Overriding the theme resource here is the documented way to widen it. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1300</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">900</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Import Products" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:ConnectionId='2' Grid.Column="1" Padding="6" Background="Transparent" BorderThickness="0"
                                             AutomationProperties.Name="Close">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <!-- ContentDialog wraps whatever is set as Content in its own implicit ScrollViewer, and keeps
         Primary/Secondary/Close outside it in a fixed footer — that's why "Close" has always stayed
         visible no matter how tall the preview list gets, and why Import uses PrimaryButtonText
         instead of a custom in-content Button: a button placed inside Content is never actually
         pinned to the dialog's own viewport, only to the bottom of the content that scrolls with it
         (this silently hid an earlier version of this button behind a large preview list).

         The dialog's own width now comes from the ContentDialogMaxWidth/MinWidth resource override
         above; this just stretches to fill whatever that gives it. -->
    <ScrollViewer HorizontalAlignment="Stretch" MaxHeight="620" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">

        <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"
                   Text="Load a .csv or .xlsx file to add or update products in bulk. Nothing is saved until you press Import. Rows that match a product you already have can be updated, imported as a separate new product, or removed from this import." />

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:ConnectionId='32' Grid.Column="0"                           Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.Name="Choose file">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                    <TextBlock Text="Choose File…" />
                </StackPanel>
            </Button>

            <Button x:ConnectionId='33' Grid.Column="1"                                 AutomationProperties.Name="Download template">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                    <TextBlock Text="Download Template" />
                </StackPanel>
            </Button>

            <TextBlock x:ConnectionId='34' Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"
                       TextTrimming="CharacterEllipsis"
                                                                       />
        </Grid>

        <ProgressBar x:ConnectionId='3' IsIndeterminate="True"
                                                                                                                               />

        <InfoBar x:ConnectionId='4'                                                                                                        
                 Severity="Error"                                                        />

        <InfoBar x:ConnectionId='5'                                                                                                          
                 Severity="Success"                                                          />

        <TextBlock x:ConnectionId='6'                                                    Style="{StaticResource CardTitleTextStyle}"
                                                                                                                                 />

        <InfoBar x:ConnectionId='7'                                                              Severity="Informational"
                                                                                IsClosable="False" />

        <Border x:ConnectionId='8' Style="{StaticResource CardBorderStyle}" Padding="0" MaxHeight="420"
                                                                                                                             >
            <ListView x:ConnectionId='9'                                       SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate                                          >
                        <Grid x:ConnectionId='11' Padding="16,10" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"
                                                                        >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:ConnectionId='18' Grid.Column="0"                               Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock x:ConnectionId='29'                      Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:ConnectionId='30'                         Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                                                                                                                          />
                                    <TextBlock x:ConnectionId='31'                              Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource DangerBrush}"
                                                                                                                                   />
                                </StackPanel>

                                <!-- Actions: what's offered depends on why the row needs attention.
                                     Update rows matched an existing product by SKU/Barcode — that's
                                     the "duplicate item" case — so they get the choice to update it
                                     (the default, needs no click), import it as a separate new
                                     product instead, or drop it from this import entirely. Error
                                     rows get Fix first since they can't import until corrected. -->
                                <StackPanel x:ConnectionId='19' Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                                                                                                                >
                                    <Button x:ConnectionId='26' Content="Fix…"                                      Padding="10,4"
                                                                                                                               
                                                                                                         />
                                    <Button x:ConnectionId='27' Content="Import as new"                                           Padding="10,4"
                                            ToolTipService.ToolTip="Create a separate new product instead of updating the existing one (its SKU/Barcode will be cleared on this row)"
                                                                                                                                             
                                                                                                                 />
                                    <Button x:ConnectionId='28' Content="Remove"                                         Padding="10,4"
                                                                                                            />
                                </StackPanel>

                                <StackPanel x:ConnectionId='20' Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                                                                                                              >
                                    <Button x:ConnectionId='25' Content="Undo"                                          Padding="10,4"
                                                                                                                />
                                </StackPanel>

                                <Border x:ConnectionId='21' Grid.Column="3" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Top"
                                        HorizontalAlignment="Right"
                                        Background="{ThemeResource SuccessSubtleBrush}"
                                                                                                                                             >
                                    <TextBlock Text="NEW" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource SuccessBrush}" />
                                </Border>
                                <Border x:ConnectionId='22' Grid.Column="3" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Top"
                                        HorizontalAlignment="Right"
                                        Background="{ThemeResource WarningSubtleBrush}"
                                                                                                                                                >
                                    <TextBlock Text="DUPLICATE" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource WarningBrush}" />
                                </Border>
                                <Border x:ConnectionId='23' Grid.Column="3" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Top"
                                        HorizontalAlignment="Right"
                                        Background="{ThemeResource DangerSubtleBrush}"
                                                                                                                                               >
                                    <TextBlock Text="ERROR" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource DangerBrush}" />
                                </Border>
                                <Border x:ConnectionId='24' Grid.Column="3" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Top"
                                        HorizontalAlignment="Right"
                                        Background="{ThemeResource SurfaceAltBrush}"
                                                                                                                                          >
                                    <TextBlock Text="REMOVED" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>

                            <!-- Inline correction form: expands in place instead of opening a second
                                 ContentDialog (which would crash — see the class-level comment on
                                 ProductImportRowViewModel). -->
                            <Border x:ConnectionId='12' Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,10,0,0" Padding="16"
                                    Background="{ThemeResource SurfaceAltBrush}"
                                                                                                                                      >
                                <StackPanel Spacing="12">
                                    <ItemsControl x:ConnectionId='13'                                  >
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate                                            >
                                                <TextBox x:ConnectionId='17'                                                           
                                                                                    
                                                         Width="300" Margin="0,0,12,10" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button x:ConnectionId='14' Content="Cancel"                                         />
                                        <Button x:ConnectionId='15' Content="Save"                                      
                                                Style="{StaticResource AccentButtonStyle}"
                                                                                                                 />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>

