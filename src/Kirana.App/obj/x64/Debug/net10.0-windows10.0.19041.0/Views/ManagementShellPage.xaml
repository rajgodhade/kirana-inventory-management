<Page
    x:Class="Kirana.App.Views.ManagementShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- App bar: store identity on the left, session actions on the right. Persistent across
             every management screen, which is the point of the shell. -->
        <Grid Grid.Row="0" Padding="20,10" Background="{ThemeResource NavigationBackgroundBrush}"
              BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="{StaticResource RadiusMedium}"
                    Background="{ThemeResource BrandPrimaryBrush}" VerticalAlignment="Center">
                <TextBlock Text="K" FontSize="17" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                <TextBlock x:ConnectionId='37' x:Name="StoreNameText" FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="Management" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>

            <Button x:ConnectionId='29' Grid.Column="2"                              VerticalAlignment="Center" Padding="10,6"
                    CornerRadius="{StaticResource RadiusMedium}" AutomationProperties.Name="Back to Billing">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE7BF;" FontSize="14" />
                    <TextBlock Text="Back to Billing" />
                </StackPanel>
            </Button>

            <!-- Live store clock is persistent, so management users can stay oriented without
                 relying on the desktop taskbar. -->
            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock x:ConnectionId='35' x:Name="CurrentDayDateText" Style="{StaticResource SecondaryTextStyle}"
                           HorizontalAlignment="Right" />
                <TextBlock x:ConnectionId='36' x:Name="CurrentTimeText" Style="{StaticResource CaptionTextStyle}"
                           HorizontalAlignment="Right" />
            </StackPanel>

            <!-- Signed-in user, so it's never ambiguous whose actions are being audited. -->
            <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,4,0">
                <TextBlock x:ConnectionId='33' x:Name="UserNameText" Style="{StaticResource SecondaryTextStyle}"
                           HorizontalAlignment="Right" />
                <TextBlock x:ConnectionId='34' x:Name="UserRoleText" Style="{StaticResource CaptionTextStyle}"
                           HorizontalAlignment="Right" />
            </StackPanel>

            <Button x:ConnectionId='30' Grid.Column="6"                            VerticalAlignment="Center"
                    AutomationProperties.Name="Toggle light and dark theme"
                    ToolTipService.ToolTip="Switch between light and dark">
                <FontIcon x:ConnectionId='32' x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="15" />
            </Button>

            <Button x:ConnectionId='31' Grid.Column="7"                     VerticalAlignment="Center"
                    AutomationProperties.Name="Lock and return to billing">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72E;" FontSize="14" />
                    <TextBlock Text="Lock" />
                </StackPanel>
            </Button>
        </Grid>

        <muxc:NavigationView x:ConnectionId='2'
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="228"
            IsSettingsVisible="False"
            IsBackButtonVisible="Auto"
            IsPaneToggleButtonVisible="True"
            Background="Transparent"
                                                    
                                              >

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Home" Tag="Home">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="Catalogue" />

                <muxc:NavigationViewItem x:ConnectionId='3' x:Name="NavProducts" Content="Products" Tag="Products">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BF;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:ConnectionId='4' x:Name="NavPromotions" Content="Promotions &amp; Offers" Tag="Promotions">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EC;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:ConnectionId='5' x:Name="NavBarcodes" Content="Barcode Scan" Tag="Barcodes">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C1;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader x:ConnectionId='6' x:Name="NavTradeHeader" Content="Trade" />

                <muxc:NavigationViewItem x:ConnectionId='7' x:Name="NavInvoices" Content="Invoices" Tag="Invoices">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:ConnectionId='8' x:Name="NavCustomers" Content="Customers &amp; Udhaar" Tag="Customers">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:ConnectionId='9' x:Name="NavSuppliers" Content="Suppliers" Tag="Suppliers">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:ConnectionId='10' x:Name="NavPurchases" Content="Purchases" Tag="Purchases">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader x:ConnectionId='11' x:Name="NavReturnsHeader" Content="Returns &amp; Money" />

                <muxc:NavigationViewItem x:ConnectionId='12' x:Name="NavSalesReturns" Content="Sales Returns" Tag="SalesReturns">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7A7;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:ConnectionId='13' x:Name="NavPurchaseReturns" Content="Purchase Returns" Tag="PurchaseReturns">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B9;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:ConnectionId='14' x:Name="NavExpenses" Content="Expenses" Tag="Expenses">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C7;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader x:ConnectionId='15' x:Name="NavAdminHeader" Content="Administration" />

                <muxc:NavigationViewItem x:ConnectionId='16' x:Name="NavUsers" Content="Users" Tag="Users">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:ConnectionId='17' x:Name="NavAudit" Content="Audit Log" Tag="Audit">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:ConnectionId='18' x:Name="NavReports" Content="Reports" Tag="Reports">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:ConnectionId='19' x:Name="NavSettings" Content="Settings" Tag="Settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:ConnectionId='20' x:Name="NavDeviceStatus" Content="Device Status" Tag="DeviceStatus">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:ConnectionId='21' x:Name="NavHardwareSettings" Content="Hardware Settings" Tag="HardwareSettings">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:ConnectionId='22' x:Name="NavHardwareDiagnostics" Content="Hardware Diagnostics" Tag="HardwareDiagnostics">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader x:ConnectionId='23' x:Name="NavDataHeader" Content="Data" />

                <muxc:NavigationViewItem x:ConnectionId='24' x:Name="NavBackupManager" Content="Backup Manager" Tag="BackupManager">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:ConnectionId='25' x:Name="NavRestore" Content="Restore" Tag="Restore">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE777;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:ConnectionId='26' x:Name="NavExportCenter" Content="Export Center" Tag="ExportCenter">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDE1;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:ConnectionId='27' x:Name="NavDatabaseMaintenance" Content="Database Maintenance" Tag="DatabaseMaintenance">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F5;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Frame x:ConnectionId='28' x:Name="ContentFrame" />
        </muxc:NavigationView>
    </Grid>
</Page>

