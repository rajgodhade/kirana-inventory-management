<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.ProductsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:ConnectionId='34' Grid.Column="0" Content="◀ Management"                     Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="Products" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:ConnectionId='35' Grid.Column="2" Content="Lock &amp; Return to Billing"                     />
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Padding="20,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:ConnectionId='26' Grid.Column="0" PlaceholderText="Search name / SKU / barcode…"
                                                                                                    />

            <ComboBox x:ConnectionId='27' Grid.Column="1" PlaceholderText="Category"
                                                                  DisplayMemberPath="Name"
                                                                                     
                                                                  />

            <ComboBox x:ConnectionId='28' Grid.Column="2" PlaceholderText="Brand"
                                                              DisplayMemberPath="Name"
                                                                                  
                                                                  />

            <CheckBox x:ConnectionId='29' Grid.Column="3" Content="Show inactive" VerticalAlignment="Center"
                                                                                                                                                 />

            <Button x:ConnectionId='30' Grid.Column="5" Content="Categories"                                 />
            <Button x:ConnectionId='31' Grid.Column="6" Content="Brands"                             Margin="8,0,0,0" />
            <Button x:ConnectionId='32' Grid.Column="7" Content="Bulk Labels"                           Margin="8,0,0,0"
                                                                      />
            <Button x:ConnectionId='33' Grid.Column="8" Content="Add Product" Style="{StaticResource AccentButtonStyle}"
                                                                                             Margin="8,0,0,0" />
        </Grid>

        <!-- Results -->
        <Grid Grid.Row="2">
            <InfoBar x:ConnectionId='2'                                                                                                        
                     Severity="Error"                                                       
                     Margin="20,0,20,8" VerticalAlignment="Top" />

            <ListView x:ConnectionId='3'                                           Padding="20,0,20,20" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate                                    >
                        <Grid x:ConnectionId='5' Padding="12" ColumnSpacing="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="220" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:ConnectionId='22'                      FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Opacity="0.6" FontSize="12">
                                    <Run x:ConnectionId='23'                             />
                                    <Run Text=" · SKU: " /><Run x:ConnectionId='24'                     />
                                    <Run Text=" · Barcode: " /><Run x:ConnectionId='25'                         />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:ConnectionId='19'                              FontSize="12" />
                                <TextBlock x:ConnectionId='20'                           FontSize="12" Opacity="0.7" />
                                <TextBlock x:ConnectionId='21'                      FontSize="12" Opacity="0.7" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock FontSize="12"><Run Text="MRP ₹" /><Run x:ConnectionId='18'                     /></TextBlock>
                                <TextBlock FontWeight="SemiBold"><Run Text="Sell ₹" /><Run x:ConnectionId='17'                              /></TextBlock>
                                <TextBlock x:ConnectionId='15' FontSize="12" Opacity="0.7"
                                                                                                                                        >
                                    <Run Text="Cost ₹" /><Run x:ConnectionId='16'                               />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Spacing="4" HorizontalAlignment="Center">
                                <TextBlock x:ConnectionId='12'                       FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <Border x:ConnectionId='13'                                                                                          
                                                                                                                                 
                                        CornerRadius="3" Padding="6,2">
                                    <TextBlock x:ConnectionId='14'                             FontSize="10" Foreground="White" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button x:ConnectionId='6' Content="Edit"                                    />
                                <Button x:ConnectionId='7' Content="Stock"                                           />
                                <Button x:ConnectionId='8' Content="Labels"                                      />
                                <Button x:ConnectionId='9' Content="Batches"                                      
                                                                                                                                  />
                                <Button x:ConnectionId='10' Content="Deactivate"                                           
                                                                                                                             />
                                <Button x:ConnectionId='11' Content="Reactivate"                                           
                                                                                                                                    />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>

