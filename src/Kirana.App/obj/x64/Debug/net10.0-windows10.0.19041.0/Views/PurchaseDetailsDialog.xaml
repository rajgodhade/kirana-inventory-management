<ContentDialog
    x:Class="Kirana.App.Views.PurchaseDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:ConnectionId='2' x:Name="DialogTitleText" Grid.Column="0" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:ConnectionId='3' Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                                             AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <ScrollViewer MaxHeight="560">
        <StackPanel Spacing="10" MinWidth="480">
            <TextBlock x:ConnectionId='4' x:Name="HeaderText" FontSize="14" TextWrapping="Wrap" />

            <ListView x:ConnectionId='5' x:Name="ItemsList" MaxHeight="300" SelectionMode="None">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8" Padding="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Product" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Qty" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Price" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Total" FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
            </ListView>

            <TextBlock x:ConnectionId='6' x:Name="TotalsText" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

