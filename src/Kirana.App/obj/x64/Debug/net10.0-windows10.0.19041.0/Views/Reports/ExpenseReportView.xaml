<UserControl x:ConnectionId='1'
    x:Class="Kirana.App.Views.Reports.ExpenseReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels.Reports">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:ConnectionId='12' Grid.Column="0" Header="Report"                                             
                                                                                           
                          HorizontalAlignment="Stretch"                                    />

                <ComboBox x:ConnectionId='13' Grid.Column="1"                                                        
                                                                                                      
                          HorizontalAlignment="Stretch"                                    />

                <CalendarDatePicker x:ConnectionId='14' Grid.Column="2" Header="From"                                                             
                                                                                                                                                                  
                                                                />

                <CalendarDatePicker x:ConnectionId='15' Grid.Column="3" Header="To"                                                           
                                                                                                                                                                  
                                                                />

                <Button x:ConnectionId='16' Grid.Column="5"                        VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="6" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:ConnectionId='17' Text="CSV"                          />
                            <MenuFlyoutItem x:ConnectionId='18' Text="Excel"                            />
                            <MenuFlyoutItem x:ConnectionId='19' Text="PDF"                          />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <InfoBar x:ConnectionId='2'                                                                                                        
                     Severity="Error"                                                        />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Total" Style="{StaticResource MetricLabelTextStyle}" />
                    <TextBlock x:ConnectionId='11'                                                  Style="{StaticResource MetricTextStyle}" FontSize="20"
                               Foreground="{ThemeResource WarningBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <ItemsControl x:ConnectionId='3'                                      >
                    <ItemsControl.ItemTemplate>
                        <DataTemplate                                          >
                            <Grid x:ConnectionId='5' Margin="0,0,0,10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:ConnectionId='6' Grid.Column="0"                         Style="{StaticResource BodyTextStyle}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:ConnectionId='9'                              Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock x:ConnectionId='10'                              Style="{StaticResource BodyTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock x:ConnectionId='7'                              Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock x:ConnectionId='8'                              Style="{StaticResource BodyTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

