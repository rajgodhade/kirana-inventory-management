<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.HardwareSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kirana.App.Views.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Padding="{StaticResource PageHeaderPadding}" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Hardware Settings" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Configure printers and keyboard-wedge barcode scanners without coupling them to Billing."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <Button x:ConnectionId='23' Grid.Column="1" Content="Refresh devices"                                             />
            <Button x:ConnectionId='24' Grid.Column="2" Content="Save settings" Style="{StaticResource AccentButtonStyle}"
                                                                                                      />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,0,24,24" Spacing="16" MaxWidth="1080" HorizontalAlignment="Left">
                <InfoBar x:ConnectionId='2'                                                                                                        
                         Severity="Error"                                                        />
                <InfoBar x:ConnectionId='3'                                                                                                         
                         Severity="Success"                                                         />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <controls:DeviceStatusWidget x:ConnectionId='21' Title="Receipt printer" Glyph="&#xE749;"
                                                                                           
                                                                                            />
                    <controls:DeviceStatusWidget x:ConnectionId='22' Grid.Column="1" Title="Barcode scanner" Glyph="&#xE8BD;"
                                                                                           
                                                                                            />
                </Grid>

                <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel><TextBlock Text="Printer Management" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Installed Windows print queues are detected automatically. Test print is sent directly to the selected receipt printer."
                                       Style="{StaticResource PageSubtitleTextStyle}" TextWrapping="Wrap" /></StackPanel>
                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <ComboBox x:ConnectionId='16' Header="App default printer"                                                                                                                 HorizontalAlignment="Stretch" />
                            <ComboBox x:ConnectionId='17' Grid.Column="1" Header="Receipt printer" PlaceholderText="No physical receipt printer detected"                                                                                                                        HorizontalAlignment="Stretch" />
                            <ComboBox x:ConnectionId='18' Grid.Column="2" Header="Invoice printer"                                                                                                                 HorizontalAlignment="Stretch" />
                            <ComboBox x:ConnectionId='19' Grid.Row="1" Header="Receipt paper"                                                                                                              HorizontalAlignment="Stretch" />
                            <Button x:ConnectionId='20' Grid.Row="1" Grid.Column="1" Content="Print sample receipt" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                                                                                                           />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="28">
                            <ToggleSwitch x:ConnectionId='13' Header="Auto print receipt"                                                                                                  />
                            <ToggleSwitch x:ConnectionId='14' Header="Print duplicate copy"                                                                                                    />
                            <ToggleSwitch x:ConnectionId='15' Header="Open cash drawer after cash payment (future)"                                                                       IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel><TextBlock Text="Barcode Scanner" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="USB and Bluetooth keyboard-wedge scanners share the same transport-neutral input pipeline."
                                       Style="{StaticResource PageSubtitleTextStyle}" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="28">
                            <ToggleSwitch x:ConnectionId='10' Header="Enable barcode scanner"                                                                                                       />
                            <ToggleSwitch x:ConnectionId='11' Header="Sound on scan"                                                                                                   />
                            <ToggleSwitch x:ConnectionId='12' Header="Auto focus scan field"                                                                                                       />
                        </StackPanel>
                        <TextBox x:ConnectionId='4' Header="Scanner timeout / maximum inter-key delay (ms)" Width="300" HorizontalAlignment="Left"
                                                                                                                                    />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:ConnectionId='8' x:Name="ScannerTestBox" Header="Test scanner" PlaceholderText="Focus here, scan a barcode, then press Enter"
                                                                                                                                                                 />
                            <Button x:ConnectionId='9' Grid.Column="1" Content="Test lookup" VerticalAlignment="Bottom"                                                
                                                                             />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="RAW DATA" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='7'                                                    /></StackPanel></Border>
                            <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="DETECTED BARCODE" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='6'                                                        /></StackPanel></Border>
                            <Border Grid.Column="2" Background="{ThemeResource PastelBlueBrush}" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="PRODUCT LOOKUP" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='5'                                                     TextWrapping="Wrap" /></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="20" Opacity="0.72">
                    <StackPanel Spacing="8"><TextBlock Text="Future device adapters" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="Cash drawer · Customer display · Electronic scale · Payment terminal · Mobile/WebSocket scanner · QR payment device"
                                   TextWrapping="Wrap" Style="{StaticResource PageSubtitleTextStyle}" />
                        <TextBlock Text="Architecture prepared; no hardware-specific behavior is enabled until an adapter is installed." Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

