<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.ManagementHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    xmlns:rpt="using:Kirana.Application.Reports">

    <Page.Resources>
        <Style x:Key="DashboardTileButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="MinHeight" Value="126" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="142" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="DashboardPanelStyle" TargetType="Border" BasedOn="{StaticResource ElevatedCardStyle}">
            <Setter Property="Padding" Value="20" />
        </Style>
    </Page.Resources>

    <ScrollViewer Background="{ThemeResource PageBackgroundBrush}">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="22" MaxWidth="1600" HorizontalAlignment="Stretch">
            <InfoBar x:ConnectionId='2'                                                                                                        
                     Severity="Warning"                                                        />

            <!-- Greeting and operational context -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock x:ConnectionId='87'                                                 Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock x:ConnectionId='88'                                                      Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{ThemeResource PastelGreenBrush}" CornerRadius="14" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource PastelGreenOnBrush}" />
                            <TextBlock Text="Billing active" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource PastelGreenOnBrush}" />
                        </StackPanel>
                    </Border>
                    <Border x:ConnectionId='84' Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource CardElevatedBorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="10,6"
                                                                                                                                  >
                        <TextBlock x:ConnectionId='86'                                                       FontSize="12"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Border>
                    <Border Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource CardElevatedBorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="10,6">
                        <TextBlock x:ConnectionId='85'                                                 FontSize="12"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Commercial KPI cards -->
            <StackPanel Spacing="10">
                <Grid>
                    <TextBlock Text="Today at a glance" Style="{StaticResource SectionTitleTextStyle}" />
                    <ProgressRing x:ConnectionId='83'                                                   Width="18" Height="18"
                                  HorizontalAlignment="Right" AutomationProperties.Name="Loading dashboard" />
                </Grid>
                <Grid x:ConnectionId='59' x:Name="KpiGrid" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:ConnectionId='60' x:Name="KpiColumn1" Width="*" />
                        <ColumnDefinition x:ConnectionId='61' x:Name="KpiColumn2" Width="*" />
                        <ColumnDefinition x:ConnectionId='62' x:Name="KpiColumn3" Width="*" />
                        <ColumnDefinition x:ConnectionId='63' x:Name="KpiColumn4" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button x:ConnectionId='64' x:Name="SalesCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource DashboardTileButtonStyle}"
                            Background="{ThemeResource PastelGreenBrush}" BorderBrush="{ThemeResource PastelGreenBrush}"
                            Tag="Reports"                                     AutomationProperties.Name="Open today's sales report">
                        <Grid><StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7BF;" FontSize="15" Foreground="{ThemeResource PastelGreenOnBrush}" /><TextBlock Text="TODAY'S SALES" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}" /></StackPanel>
                            <TextBlock x:ConnectionId='79'                                                       Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}" />
                            <TextBlock x:ConnectionId='80'                                                            Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}" />
                        </StackPanel><FontIcon Glyph="&#xE76C;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource PastelGreenOnBrush}" /></Grid>
                    </Button>

                    <Button x:ConnectionId='65' x:Name="ProfitCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource DashboardTileButtonStyle}"
                            Background="{ThemeResource PastelTealBrush}" BorderBrush="{ThemeResource PastelTealBrush}"
                            Tag="Reports"                                     AutomationProperties.Name="Open profit report"
                                                                                                                              >
                        <Grid><StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="{ThemeResource PastelTealOnBrush}" /><TextBlock Text="EST. GROSS PROFIT" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelTealOnBrush}" /></StackPanel>
                            <TextBlock x:ConnectionId='78'                                                        Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelTealOnBrush}" />
                            <TextBlock Text="based on recorded costs" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelTealOnBrush}" />
                        </StackPanel><FontIcon Glyph="&#xE76C;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource PastelTealOnBrush}" /></Grid>
                    </Button>

                    <Button x:ConnectionId='66' x:Name="BillsCard" Grid.Row="0" Grid.Column="2" Style="{StaticResource DashboardTileButtonStyle}"
                            Background="{ThemeResource PastelBlueBrush}" BorderBrush="{ThemeResource PastelBlueBrush}"
                            Tag="Reports"                                     AutomationProperties.Name="Open bills report">
                        <Grid><StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C7;" FontSize="15" Foreground="{ThemeResource PastelBlueOnBrush}" /><TextBlock Text="BILLS" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}" /></StackPanel>
                            <TextBlock x:ConnectionId='77'                                                      Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}" />
                            <TextBlock Text="invoices completed today" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}" />
                        </StackPanel><FontIcon Glyph="&#xE76C;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource PastelBlueOnBrush}" /></Grid>
                    </Button>

                    <Button x:ConnectionId='67' x:Name="ItemsCard" Grid.Row="0" Grid.Column="3" Style="{StaticResource DashboardTileButtonStyle}"
                            Background="{ThemeResource PastelVioletBrush}" BorderBrush="{ThemeResource PastelVioletBrush}"
                            Tag="Reports"                                     AutomationProperties.Name="Open items sold report">
                        <Grid><StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE719;" FontSize="15" Foreground="{ThemeResource PastelVioletOnBrush}" /><TextBlock Text="ITEMS SOLD" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" /></StackPanel>
                            <TextBlock x:ConnectionId='76'                                                      Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" />
                            <TextBlock Text="units sold today" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" />
                        </StackPanel><FontIcon Glyph="&#xE76C;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource PastelVioletOnBrush}" /></Grid>
                    </Button>

                    <Button x:ConnectionId='68' x:Name="CreditCard" Grid.Row="1" Grid.Column="0" Style="{StaticResource DashboardTileButtonStyle}"
                            Background="{ThemeResource PastelRoseBrush}" BorderBrush="{ThemeResource PastelRoseBrush}"
                            Tag="Customers"                                     AutomationProperties.Name="Open customer credit"
                                                                                                                                          >
                        <Grid><StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="{ThemeResource PastelRoseOnBrush}" /><TextBlock Text="CUSTOMER CREDIT" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" /></StackPanel>
                            <TextBlock x:ConnectionId='75'                                                              Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" />
                            <TextBlock Text="outstanding udhaar" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" />
                        </StackPanel><FontIcon Glyph="&#xE76C;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource PastelRoseOnBrush}" /></Grid>
                    </Button>

                    <Button x:ConnectionId='69' x:Name="PayableCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardTileButtonStyle}"
                            Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}"
                            Tag="Purchases"                                     AutomationProperties.Name="Open supplier payables"
                                                                                                                                          >
                        <Grid><StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7B8;" FontSize="15" Foreground="{ThemeResource PastelAmberOnBrush}" /><TextBlock Text="SUPPLIER PAYABLE" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" /></StackPanel>
                            <TextBlock x:ConnectionId='74'                                                        Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" />
                            <TextBlock Text="outstanding balance" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" />
                        </StackPanel><FontIcon Glyph="&#xE76C;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource PastelAmberOnBrush}" /></Grid>
                    </Button>

                    <Button x:ConnectionId='70' x:Name="LowStockCard" Grid.Row="1" Grid.Column="2" Style="{StaticResource DashboardTileButtonStyle}"
                            Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}"
                            Tag="Products"                                     AutomationProperties.Name="Open low stock products"
                                                                                                                                 >
                        <Grid><StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="{ThemeResource PastelAmberOnBrush}" /><TextBlock Text="LOW STOCK" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" /></StackPanel>
                            <TextBlock x:ConnectionId='73'                                                          Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" />
                            <TextBlock Text="at or below minimum" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" />
                        </StackPanel><FontIcon Glyph="&#xE76C;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource PastelAmberOnBrush}" /></Grid>
                    </Button>

                    <Button x:ConnectionId='71' x:Name="OutStockCard" Grid.Row="1" Grid.Column="3" Style="{StaticResource DashboardTileButtonStyle}"
                            Background="{ThemeResource PastelRoseBrush}" BorderBrush="{ThemeResource PastelRoseBrush}"
                            Tag="Products"                                     AutomationProperties.Name="Open out of stock products"
                                                                                                                                 >
                        <Grid><StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEA39;" FontSize="15" Foreground="{ThemeResource PastelRoseOnBrush}" /><TextBlock Text="OUT OF STOCK" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" /></StackPanel>
                            <TextBlock x:ConnectionId='72'                                                            Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" />
                            <TextBlock Text="needs replenishment" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" />
                        </StackPanel><FontIcon Glyph="&#xE76C;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource PastelRoseOnBrush}" /></Grid>
                    </Button>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:ConnectionId='81' x:Name="CompactKpis">
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="KpiColumn3.Width" Value="0" /><Setter Target="KpiColumn4.Width" Value="0" />
                                    <Setter Target="BillsCard.(Grid.Row)" Value="1" /><Setter Target="BillsCard.(Grid.Column)" Value="0" />
                                    <Setter Target="ItemsCard.(Grid.Row)" Value="1" /><Setter Target="ItemsCard.(Grid.Column)" Value="1" />
                                    <Setter Target="CreditCard.(Grid.Row)" Value="2" /><Setter Target="CreditCard.(Grid.Column)" Value="0" />
                                    <Setter Target="PayableCard.(Grid.Row)" Value="2" /><Setter Target="PayableCard.(Grid.Column)" Value="1" />
                                    <Setter Target="LowStockCard.(Grid.Row)" Value="3" /><Setter Target="LowStockCard.(Grid.Column)" Value="0" />
                                    <Setter Target="OutStockCard.(Grid.Row)" Value="3" /><Setter Target="OutStockCard.(Grid.Column)" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:ConnectionId='82' x:Name="WideKpis">
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1250" /></VisualState.StateTriggers>
                                <VisualState.Setters><Setter Target="KpiColumn3.Width" Value="*" /><Setter Target="KpiColumn4.Width" Value="*" /></VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Grid>
            </StackPanel>

            <Border x:ConnectionId='3' Style="{StaticResource DashboardPanelStyle}"                                                                                                       >
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12" Background="{ThemeResource PastelVioletBrush}"><FontIcon Glyph="&#xE8EC;" FontSize="17" Foreground="{ThemeResource PastelVioletOnBrush}" /></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="RUNNING PROMOTIONS" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='58'                                                              FontSize="22" FontWeight="Bold" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="ENDS TODAY" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='57'                                                                  FontSize="22" FontWeight="Bold" /></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="TOP PROMOTION TODAY" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='56'                                                         FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <Button x:ConnectionId='55' Grid.Column="4" Content="Manage offers" Tag="Promotions"                                     />
                </Grid>
            </Border>

            <!-- Active alerts only -->
            <StackPanel x:ConnectionId='4' Spacing="10"                                                                                                             >
                <TextBlock Text="Business alerts" Style="{StaticResource SectionTitleTextStyle}" />
                <ItemsControl x:ConnectionId='48'                                                >
                    <ItemsControl.ItemTemplate>
                        <DataTemplate                                        >
                            <Border x:ConnectionId='50' Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource WarningBrush}"
                                    BorderThickness="3,0,0,0" CornerRadius="10" Padding="14,11" Margin="0,0,0,8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon x:ConnectionId='51' Grid.Column="0"                        FontSize="15" Foreground="{ThemeResource PastelAmberOnBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2"><TextBlock x:ConnectionId='53'                       FontWeight="SemiBold" /><TextBlock x:ConnectionId='54'                        Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" /></StackPanel>
                                    <Button x:ConnectionId='52' Grid.Column="2"                                                                                          VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Primary workflows -->
            <StackPanel Spacing="10">
                <TextBlock Text="Quick actions" Style="{StaticResource SectionTitleTextStyle}" />
                <ItemsControl>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="154" ItemHeight="52" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <Button x:ConnectionId='41' Style="{StaticResource QuickActionButtonStyle}"                              AutomationProperties.Name="Create a new bill"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE710;" FontSize="15" /><TextBlock Text="New Bill" /></StackPanel></Button>
                    <Button x:ConnectionId='42' Style="{StaticResource QuickActionButtonStyle}" Tag="PurchaseEntry"                                     AutomationProperties.Name="Create purchase"                                                                                                               ><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE7B8;" FontSize="15" /><TextBlock Text="New Purchase" /></StackPanel></Button>
                    <Button x:ConnectionId='43' Style="{StaticResource QuickActionButtonStyle}" Tag="Customers"                                     AutomationProperties.Name="Open customers"                                                                                                               ><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE716;" FontSize="15" /><TextBlock Text="Add Customer" /></StackPanel></Button>
                    <Button x:ConnectionId='44' Style="{StaticResource QuickActionButtonStyle}" Tag="Expenses"                                     AutomationProperties.Name="Add expense"                                                                                                        ><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE8C7;" FontSize="15" /><TextBlock Text="Add Expense" /></StackPanel></Button>
                    <Button x:ConnectionId='45' Style="{StaticResource QuickActionButtonStyle}"                               AutomationProperties.Name="Reprint invoice"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE749;" FontSize="15" /><TextBlock Text="Reprint Invoice" /></StackPanel></Button>
                    <Button x:ConnectionId='46' Style="{StaticResource QuickActionButtonStyle}" Tag="Reports"                                     AutomationProperties.Name="Open reports"                                                                                                    ><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE9D2;" FontSize="15" /><TextBlock Text="View Reports" /></StackPanel></Button>
                    <Button x:ConnectionId='47' Style="{StaticResource QuickActionButtonStyle}" Tag="Backup"                                     AutomationProperties.Name="Open backup manager"                                                                                                       ><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE753;" FontSize="15" /><TextBlock Text="Backup" /></StackPanel></Button>
                </ItemsControl>
            </StackPanel>

            <!-- Today summary and decision support -->
            <Grid x:ConnectionId='5' ColumnSpacing="14"                                                                                                    >
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource DashboardPanelStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Today summary" Style="{StaticResource SectionTitleTextStyle}" />
                        <Grid RowSpacing="12" ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="Gross sales" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:ConnectionId='40'                                                       Style="{StaticResource AmountTextStyle}" FontSize="20" /></StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1"><TextBlock Text="Discounts" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:ConnectionId='39'                                                      Style="{StaticResource AmountTextStyle}" FontSize="20" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="Returns" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:ConnectionId='38'                                                    Style="{StaticResource AmountTextStyle}" FontSize="20" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Net sales" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:ConnectionId='37'                                                     Style="{StaticResource AmountTextStyle}" FontSize="20" Foreground="{ThemeResource BrandPrimaryBrush}" /></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource DashboardPanelStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Insights" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock x:ConnectionId='30' Text="Insights appear as trading activity builds." Style="{StaticResource CaptionTextStyle}"                                                                                                                       />
                        <ItemsControl x:ConnectionId='31'                                          ><ItemsControl.ItemTemplate><DataTemplate                                          ><Grid x:ConnectionId='33' ColumnSpacing="10" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="9" Background="{ThemeResource BrandSubtleBrush}"><FontIcon x:ConnectionId='36'                        FontSize="13" Foreground="{ThemeResource BrandOnSubtleBrush}" /></Border><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:ConnectionId='34'                       FontWeight="SemiBold" /><TextBlock x:ConnectionId='35'                        Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" /></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Lightweight charts and best sellers, loaded after core KPIs -->
            <StackPanel x:ConnectionId='6' Spacing="10"                                                                                                    >
                <TextBlock Text="Performance" Style="{StaticResource SectionTitleTextStyle}" />
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource DashboardPanelStyle}">
                        <StackPanel Spacing="14"><TextBlock Text="Sales trend" Style="{StaticResource CardTitleTextStyle}" /><TextBlock Text="Recent daily sales" Style="{StaticResource CaptionTextStyle}" /><ItemsControl x:ConnectionId='29'                                             ItemTemplate="{StaticResource ChartBarItemTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource DashboardPanelStyle}">
                        <StackPanel Spacing="14"><TextBlock Text="Top-selling products" Style="{StaticResource CardTitleTextStyle}" /><TextBlock x:ConnectionId='21' Text="No products sold today." Style="{StaticResource CaptionTextStyle}"                                                                                                                          /><ItemsControl x:ConnectionId='22'                                                    ><ItemsControl.ItemTemplate><DataTemplate                                 ><Grid x:ConnectionId='24' ColumnSpacing="10" Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:ConnectionId='27'                             FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock x:ConnectionId='28'                             Style="{StaticResource CodeTextStyle}" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:ConnectionId='25'                                                                       Style="{StaticResource AmountTextStyle}" /><TextBlock x:ConnectionId='26'                                                                            Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" /></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource DashboardPanelStyle}">
                        <StackPanel Spacing="14"><TextBlock Text="Payment mix" Style="{StaticResource CardTitleTextStyle}" /><TextBlock Text="Today's tender distribution" Style="{StaticResource CaptionTextStyle}" /><ItemsControl x:ConnectionId='20'                                             ItemTemplate="{StaticResource ChartBarItemTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Recent invoices -->
            <StackPanel Spacing="10">
                <Grid><TextBlock Text="Recent invoices" Style="{StaticResource SectionTitleTextStyle}" /><Button x:ConnectionId='19' Content="View all" Tag="Reports"                                     HorizontalAlignment="Right"                                                                                                     /></Grid>
                <Border Style="{StaticResource DashboardPanelStyle}" Padding="0">
                    <StackPanel>
                        <Grid Padding="16,11" Background="{ThemeResource SurfaceAltBrush}" ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="INVOICE" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="1" Text="CUSTOMER / TIME" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="2" Text="PAYMENT" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="4" Text="AMOUNT" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock x:ConnectionId='9' Text="No invoices have been created yet." Padding="16,22" Style="{StaticResource CaptionTextStyle}"                                                                                                                             />
                        <ItemsControl x:ConnectionId='10'                                                ><ItemsControl.ItemTemplate><DataTemplate                                           ><Border x:ConnectionId='12' BorderBrush="{ThemeResource CardElevatedBorderBrush}" BorderThickness="0,0,0,1"><Grid Padding="16,12" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:ConnectionId='13' Grid.Column="0"                       FontWeight="SemiBold" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock x:ConnectionId='17'                          /><TextBlock x:ConnectionId='18'                          Style="{StaticResource CaptionTextStyle}" /></StackPanel><TextBlock x:ConnectionId='14' Grid.Column="2"                               Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" /><Border Grid.Column="3" Background="{ThemeResource PastelGreenBrush}" CornerRadius="12" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock x:ConnectionId='16'                        FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource PastelGreenOnBrush}" /></Border><TextBlock x:ConnectionId='15' Grid.Column="4"                        Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Operational devices; scanner monitoring is not invented when no API exists. -->
            <StackPanel Spacing="10">
                <TextBlock Text="Store systems" Style="{StaticResource SectionTitleTextStyle}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
