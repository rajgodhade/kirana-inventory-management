<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.PromotionEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save Promotion"
    CloseButtonText="Cancel"
    DefaultButton="Primary">
    <!-- ContentDialog ignores a child's requested width once WinUI's default dialog-width
         resource is reached.  Keep the host wide enough for the four-column promotion form so
         fields are arranged inside the viewport instead of being clipped by the ScrollViewer. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">980</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">980</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <Grid ColumnSpacing="12" Width="900">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:ConnectionId='2' x:Name="DialogTitleText"
                       Grid.Column="0"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <Button x:ConnectionId='3' Grid.Column="1"
                    Style="{StaticResource DialogCloseButtonStyle}"
                                        
                    AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>
    </ContentDialog.Title>
    <ScrollViewer MaxHeight="680"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel Width="900" Spacing="14">
            <InfoBar x:ConnectionId='4'                                                                                                         Severity="Error"                                                        />

            <Border Style="{StaticResource CardBorderStyle}"><StackPanel Spacing="10"><TextBlock Text="General" Style="{StaticResource SectionTitleTextStyle}" /><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><TextBox x:ConnectionId='38' Header="Promotion name *"                                                      /><TextBox x:ConnectionId='39' Grid.Column="1" Header="Code *"                                                      CharacterCasing="Upper" /><TextBox x:ConnectionId='40' Grid.Column="2" Header="Priority"                                                     /></Grid><TextBox x:ConnectionId='36' Header="Description"                                                    AcceptsReturn="True" MaxHeight="80" /><ComboBox x:ConnectionId='37' Header="Selection mode"                                                                                                                    HorizontalAlignment="Stretch" /></StackPanel></Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Schedule" Style="{StaticResource SectionTitleTextStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Start" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <CalendarDatePicker x:ConnectionId='34' Header="Date"                                                  HorizontalAlignment="Stretch" />
                                <TimePicker x:ConnectionId='35' Grid.Column="1" Header="Time"                                                  ClockIdentifier="12HourClock" HorizontalAlignment="Stretch" MinWidth="280" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="End" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <CalendarDatePicker x:ConnectionId='32' Header="Date"                                                HorizontalAlignment="Stretch" />
                                <TimePicker x:ConnectionId='33' Grid.Column="1" Header="Time"                                                ClockIdentifier="12HourClock" HorizontalAlignment="Stretch" MinWidth="280" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Times are saved against this computer's timezone and evaluated in UTC." Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}"><StackPanel Spacing="10"><TextBlock Text="Scope" Style="{StaticResource SectionTitleTextStyle}" />
                <!-- Explicit controls avoid the WinUI RadioButtons enum SelectedItem crash path. -->
                <StackPanel Orientation="Horizontal" Spacing="28">
                    <RadioButton x:ConnectionId='28' x:Name="EntireStoreScopeRadio" GroupName="PromotionScope" Content="Entire store" Tag="EntireStore"                               />
                    <RadioButton x:ConnectionId='29' x:Name="CategoryScopeRadio" GroupName="PromotionScope" Content="Category" Tag="Category"                               />
                    <RadioButton x:ConnectionId='30' x:Name="BrandScopeRadio" GroupName="PromotionScope" Content="Brand" Tag="Brand"                               />
                    <RadioButton x:ConnectionId='31' x:Name="ProductScopeRadio" GroupName="PromotionScope" Content="Product" Tag="Product"                               />
                </StackPanel>
                <ListView x:ConnectionId='20' x:Name="CategoryTargets" Header="Select categories"                                             SelectionMode="Multiple" MaxHeight="150" DisplayMemberPath="Name" Visibility="Collapsed" />
                <StackPanel x:ConnectionId='21' x:Name="BrandTargetsPanel" Visibility="Collapsed" Spacing="6">
                    <TextBox x:ConnectionId='26' x:Name="BrandSearchBox" PlaceholderText="Search brands"                                    />
                    <ListView x:ConnectionId='27' x:Name="BrandTargets" Header="Select brands"                                         SelectionMode="Multiple" MaxHeight="150" DisplayMemberPath="Name" />
                </StackPanel>
                <StackPanel x:ConnectionId='22'                                                                                                                   Spacing="6">
                    <TextBox x:ConnectionId='23' PlaceholderText="Search products by name, code or SKU..."                                      />
                    <ListView x:ConnectionId='24' x:Name="ProductTargets" Header="Select products"                                           SelectionMode="Multiple" MaxHeight="240">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="16" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ProductCode}" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding MrpText}" VerticalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SellingPriceText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="120">
                                        <TextBlock Text="{Binding PromotionPriceText}" FontWeight="Bold" Foreground="{ThemeResource PastelGreenOnBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding SavingText}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel></Border>

            <Border Style="{StaticResource CardBorderStyle}"><StackPanel Spacing="10"><TextBlock Text="Discount" Style="{StaticResource SectionTitleTextStyle}" /><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><ComboBox x:ConnectionId='15' Header="Discount type"                                                                                                                                                                   HorizontalAlignment="Stretch" /><TextBox x:ConnectionId='16' x:Name="PercentageInput" Grid.Column="1" Header="Percentage"                                                                                                                                                                                                           /><TextBox x:ConnectionId='17' x:Name="FlatAmountInput" Grid.Column="1" Header="Flat amount per unit"                                                                                                                                                                                                           /><TextBox x:ConnectionId='18' x:Name="FixedPriceInput" Grid.Column="1" Header="Fixed selling price"                                                                                                                                                                                                           /><ComboBox x:ConnectionId='19' Grid.Column="2" Header="Tax calculation"                                                                                                                                                                       HorizontalAlignment="Stretch" /></Grid></StackPanel></Border>

            <Border Style="{StaticResource CardBorderStyle}"><StackPanel Spacing="10"><TextBlock Text="Conditions" Style="{StaticResource SectionTitleTextStyle}" /><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBox x:ConnectionId='11' Header="Minimum quantity"                                                            /><TextBox x:ConnectionId='12' Grid.Column="1" Header="Minimum bill"                                                        /><TextBox x:ConnectionId='13' x:Name="MaximumDiscountInput" Grid.Column="2" Header="Maximum discount"                                                                                                /><TextBox x:ConnectionId='14' Grid.Column="3" Header="Maximum usage"                                                         /></Grid><StackPanel Orientation="Horizontal" Spacing="24"><CheckBox x:ConnectionId='9' Content="Allow stacking"                                                           /><CheckBox x:ConnectionId='10' Content="Activate after saving"                                                                 /></StackPanel></StackPanel></Border>

            <Border Background="{ThemeResource PastelGreenBrush}" BorderBrush="{ThemeResource PastelGreenBrush}" BorderThickness="1" CornerRadius="14" Padding="18"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Live preview" Style="{StaticResource SectionTitleTextStyle}" /><TextBox x:ConnectionId='8' x:Name="PreviewPriceInput" Header="Current selling price" Width="180" HorizontalAlignment="Left"                                                                                             /></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="CURRENT" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='7'                                                           FontSize="20" FontWeight="SemiBold" /></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" VerticalAlignment="Center" /><StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="FINAL PRICE" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='5'                                                         FontSize="26" FontWeight="Bold" Foreground="{ThemeResource PastelGreenOnBrush}" /><TextBlock x:ConnectionId='6'                                                           FontWeight="SemiBold" Foreground="{ThemeResource PastelGreenOnBrush}" /></StackPanel></Grid></Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

