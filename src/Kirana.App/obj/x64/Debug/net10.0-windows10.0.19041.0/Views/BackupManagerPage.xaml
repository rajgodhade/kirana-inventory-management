<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.BackupManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Backup Manager" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Every backup bundles the full database and store assets, and is verified before it is recorded."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <Button x:ConnectionId='22' Grid.Column="1"                        VerticalAlignment="Center"
                    AutomationProperties.Name="Refresh backup history">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>

            <Button x:ConnectionId='23' Grid.Column="2" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"
                                                                    
                                                                   
                    AutomationProperties.Name="Create backup now">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                    <TextBlock Text="Create Backup Now" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Padding="{StaticResource ToolbarPadding}" Spacing="8">
            <Border Style="{StaticResource CardBorderStyle}" Padding="16,12" Background="{ThemeResource SurfaceAltBrush}">
                <StackPanel Spacing="2">
                    <TextBlock Text="Backup location" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock x:ConnectionId='20'                                                      
                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:ConnectionId='21'                                                        
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ProgressBar x:ConnectionId='17' IsIndeterminate="True"
                                                                                                                                   />

            <InfoBar x:ConnectionId='18'                                                                                                        
                     Severity="Error"                                                        IsClosable="False" />
            <InfoBar x:ConnectionId='19'                                                                                                         
                     Severity="Success"                                                         IsClosable="False" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="24,0,24,24">
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="14,10" ColumnSpacing="16"
                          Background="{ThemeResource SurfaceAltBrush}"
                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" MinWidth="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TAKEN" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="TYPE" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="FILE" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="SIZE" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Center" />
                    </Grid>

                    <TextBlock x:ConnectionId='2' Grid.Row="1" Margin="24" Style="{StaticResource SecondaryTextStyle}"
                               Text="No backups yet. Use “Create Backup Now” to take the first one."
                                                                                                                                               />

                    <ListView x:ConnectionId='3' Grid.Row="1"                                          SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate                                           >
                                <Grid x:ConnectionId='5' Padding="14,12" ColumnSpacing="16"
                                      BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" MinWidth="180" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:ConnectionId='6' Grid.Column="0"                               
                                               Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />

                                    <TextBlock x:ConnectionId='7' Grid.Column="1"                          
                                               Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:ConnectionId='15'                          Style="{StaticResource CodeTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:ConnectionId='16'                       Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                                                                                                        />
                                    </StackPanel>

                                    <TextBlock x:ConnectionId='8' Grid.Column="3"                          
                                               Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center" />

                                    <Border x:ConnectionId='9' Grid.Column="4" Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Center"
                                            Background="{ThemeResource SuccessSubtleBrush}"
                                                                                                                                               >
                                        <TextBlock x:ConnectionId='14'                                          Style="{StaticResource BadgeTextStyle}"
                                                   Foreground="{ThemeResource SuccessBrush}" />
                                    </Border>

                                    <Border x:ConnectionId='10' Grid.Column="4" Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Center"
                                            Background="{ThemeResource DangerSubtleBrush}"
                                                                                                                                                      >
                                        <TextBlock x:ConnectionId='13'                                          Style="{StaticResource BadgeTextStyle}"
                                                   Foreground="{ThemeResource DangerBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:ConnectionId='11' Content="Validate"                                       
                                                                                />
                                        <Button x:ConnectionId='12' Content="Delete"                                      />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>

