<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.PurchasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:ConnectionId='16' Grid.Column="0" Content="◀ Management"                     Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="Purchases" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:ConnectionId='17' Grid.Column="2" Content="Lock &amp; Return to Billing"                     />
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Padding="20,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:ConnectionId='13' Grid.Column="0" PlaceholderText="Search purchase # / supplier invoice #…"
                                                                                                    />

            <CheckBox x:ConnectionId='14' Grid.Column="1" Content="Outstanding only" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                                                                                        />

            <Button x:ConnectionId='15' Grid.Column="3" Content="New Purchase" Style="{StaticResource AccentButtonStyle}"
                                                                                                 />
        </Grid>

        <!-- Results -->
        <Grid Grid.Row="2">
            <InfoBar x:ConnectionId='2'                                                                                                        
                     Severity="Error"                                                       
                     Margin="20,0,20,8" VerticalAlignment="Top" />

            <ListView x:ConnectionId='3'                                            Padding="20,0,20,20" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate                                     >
                        <Grid x:ConnectionId='5' Padding="12" ColumnSpacing="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="180" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:ConnectionId='6' Grid.Column="0"                                FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:ConnectionId='7' Grid.Column="1"                              VerticalAlignment="Center" />
                            <TextBlock x:ConnectionId='8' Grid.Column="2"                          FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" FontWeight="SemiBold" VerticalAlignment="Center">
                                <Run Text="₹" /><Run x:ConnectionId='12'                            />
                            </TextBlock>
                            <TextBlock Grid.Column="4" VerticalAlignment="Center">
                                <Run Text="₹" /><Run x:ConnectionId='11'                                   />
                            </TextBlock>

                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button x:ConnectionId='9' Content="Details"                                       />
                                <Button x:ConnectionId='10' Content="Pay"                                   />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>

