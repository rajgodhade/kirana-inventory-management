<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.PurchasesPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    xmlns:dom="using:Kirana.Domain.Entities">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <StackPanel Spacing="2">
                <TextBlock Text="Purchases" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Goods received from suppliers, with GST and batch detail." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <!-- ============================== SUMMARY CARDS ==============================
             Same pastel KPI language as the Dashboard: icon chip, quiet label, dominant value.
             Computed from the currently loaded/filtered list (see PurchasesViewModel) rather than
             a separate all-time query, so the numbers always match what's on screen below. -->
        <Grid Grid.Row="1" Padding="24,0,24,16" ColumnSpacing="{StaticResource SpacingL}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}"
                    Background="{ThemeResource PastelBlueBrush}" BorderBrush="{ThemeResource PastelBlueBrush}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                    <FontIcon Grid.Column="0" Glyph="&#xE7BF;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0"
                              HorizontalAlignment="Center" Foreground="{ThemeResource PastelBlueOnBrush}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="TOTAL PURCHASES" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}" />
                        <TextBlock x:ConnectionId='37'                                                                                                          
                                   Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}" />
                        <TextBlock Text="in current results" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}"
                    Background="{ThemeResource PastelRoseBrush}" BorderBrush="{ThemeResource PastelRoseBrush}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                    <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0"
                              HorizontalAlignment="Center" Foreground="{ThemeResource PastelRoseOnBrush}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="OUTSTANDING" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" />
                        <TextBlock x:ConnectionId='36'                                                                                                            
                                   Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" />
                        <TextBlock Text="still owed to suppliers" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}"
                    Background="{ThemeResource PastelGreenBrush}" BorderBrush="{ThemeResource PastelGreenBrush}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                    <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0"
                              HorizontalAlignment="Center" Foreground="{ThemeResource PastelGreenOnBrush}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="PAID" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}" />
                        <TextBlock x:ConnectionId='35'                                                                                                     
                                   Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}" />
                        <TextBlock Text="already settled" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}"
                    Background="{ThemeResource PastelVioletBrush}" BorderBrush="{ThemeResource PastelVioletBrush}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                    <FontIcon Grid.Column="0" Glyph="&#xE787;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0"
                              HorizontalAlignment="Center" Foreground="{ThemeResource PastelVioletOnBrush}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="THIS MONTH" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" />
                        <TextBlock x:ConnectionId='33'                                                                                                              
                                   Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" />
                        <TextBlock x:ConnectionId='34'                                                                    Style="{StaticResource KpiCaptionTextStyle}"
                                   Foreground="{ThemeResource PastelVioletOnBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================== TOOLBAR ================================== -->
        <Border Grid.Row="2" Style="{StaticResource FilterBarStyle}" Margin="24,0,24,16">
            <Grid ColumnSpacing="{StaticResource SpacingS}" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="132" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:ConnectionId='23' Grid.Column="0" PlaceholderText="Search purchase # / supplier invoice #…"
                                                                                                                                            
                                                           CornerRadius="{StaticResource RadiusMedium}"
                         AutomationProperties.Name="Search purchases" />

                <ComboBox x:ConnectionId='24' Grid.Column="1"                                                       
                                                                                               
                                                                      HorizontalAlignment="Stretch"
                          CornerRadius="{StaticResource RadiusMedium}"
                          AutomationProperties.Name="Filter by supplier">
                    <ComboBox.ItemTemplate>
                        <DataTemplate                          >
                            <TextBlock x:ConnectionId='32'                      TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox x:ConnectionId='25' Grid.Column="2"                                                     
                                                                                             
                                                                      HorizontalAlignment="Stretch"
                          CornerRadius="{StaticResource RadiusMedium}"
                          AutomationProperties.Name="Filter by payment status" />

                <CalendarDatePicker x:ConnectionId='26' Grid.Column="3" PlaceholderText="From"                                                      
                                                                      CornerRadius="{StaticResource RadiusMedium}"
                                    AutomationProperties.Name="From date" />

                <CalendarDatePicker x:ConnectionId='27' Grid.Column="4" PlaceholderText="To"                                                    
                                                                      CornerRadius="{StaticResource RadiusMedium}"
                                    AutomationProperties.Name="To date" />

                <CheckBox x:ConnectionId='28' Grid.Column="5" Content="Outstanding" VerticalAlignment="Center" Margin="2,0,0,0"
                                                                                     
                                                                                                  />

                <Button x:ConnectionId='29' Grid.Column="7"                        VerticalAlignment="Center"
                        CornerRadius="{StaticResource RadiusMedium}" Padding="8,7"
                        AutomationProperties.Name="Refresh purchases" ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>

                <Button x:ConnectionId='30' Grid.Column="8" Content="New Purchase" Style="{StaticResource AccentButtonStyle}"
                        CornerRadius="{StaticResource RadiusMedium}" Padding="12,7" FontSize="13"
                                                                                                     />
            </Grid>
        </Border>

        <!-- ================================== RESULTS =================================== -->
        <Grid Grid.Row="3" Margin="24,0,24,24">
            <Border Style="{StaticResource ElevatedCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="8,10" ColumnSpacing="6"
                          Background="{ThemeResource SurfaceAltBrush}"
                          CornerRadius="16,16,0,0"
                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="94" />
                            <ColumnDefinition Width="294" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PURCHASE NO." Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="SUPPLIER" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="DATE" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="4" Text="TOTAL" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="OUTSTANDING" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="ACTIONS" Style="{StaticResource ColumnHeaderTextStyle}"
                                   HorizontalAlignment="Left" />
                    </Grid>

                    <!-- Empty state -->
                    <StackPanel x:ConnectionId='3' Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                                                                    >
                        <FontIcon Glyph="&#xE7BF;" FontSize="32" Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No purchases found" Style="{StaticResource CardTitleTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Try clearing filters, or record a new purchase." Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- ScrollViewer.HorizontalScrollMode/BarVisibility MUST be explicitly Disabled:
                         a ScrollViewer (including a ListView's internal one) measures its content at
                         infinite width in any direction it can scroll, so the row template's fixed
                         + MinWidth columns were sizing to their natural width instead of this card's
                         actual width, pushing the Outstanding/Actions columns off the visible edge. -->
                    <ListView x:ConnectionId='4' Grid.Row="1"                                            SelectionMode="None"
                              IsItemClickEnabled="False" TabNavigation="Once"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="UseSystemFocusVisuals" Value="True" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate                                     >
                                <Grid x:ConnectionId='6'>
                                    <!-- Zebra base, painted once (Mode=OneTime is the default — the
                                         row's RowIndex never changes after it is added). -->
                                    <Border x:ConnectionId='7' Background="{ThemeResource SurfaceAltBrush}" Opacity="0.5"
                                                                                                                                       />

                                    <!-- Keep the normal zebra background on hover; inline actions provide
                                         the interaction affordance without tinting the full row. -->
                                    <Grid x:ConnectionId='8' Padding="8,11" ColumnSpacing="6" Background="Transparent"
                                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"
                                                                                         
                                                                                             >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="94" />
                                            <ColumnDefinition Width="294" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:ConnectionId='9' Grid.Column="0"                                Style="{StaticResource CardTitleTextStyle}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                        <!-- Supplier avatar chip + name. -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Width="30" Height="30" CornerRadius="{StaticResource RadiusPill}"
                                                    Background="{ThemeResource PastelVioletBrush}">
                                                <TextBlock x:ConnectionId='22'                                 FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource PastelVioletOnBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:ConnectionId='21'                              Style="{StaticResource BodyTextStyle}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock x:ConnectionId='10' Grid.Column="2"                          Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center" />

                                        <!-- Status badge: exactly one of the three is visible per row. -->
                                        <Border x:ConnectionId='11' Grid.Column="3" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Center"
                                                Background="{ThemeResource SuccessSubtleBrush}"
                                                                                                                                  >
                                            <TextBlock Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource SuccessBrush}">
                                                <Run Text="&#x1F7E2;" /><Run Text=" Paid" />
                                            </TextBlock>
                                        </Border>
                                        <Border x:ConnectionId='12' Grid.Column="3" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Center"
                                                Background="{ThemeResource WarningSubtleBrush}"
                                                                                                                                           >
                                            <TextBlock Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource WarningBrush}">
                                                <Run Text="&#x1F7E1;" /><Run Text=" Partially Paid" />
                                            </TextBlock>
                                        </Border>
                                        <Border x:ConnectionId='13' Grid.Column="3" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Center"
                                                Background="{ThemeResource DangerSubtleBrush}"
                                                                                                                                              >
                                            <TextBlock Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource DangerBrush}">
                                                <Run Text="&#x1F534;" /><Run Text=" Outstanding" />
                                            </TextBlock>
                                        </Border>

                                        <TextBlock x:ConnectionId='14' Grid.Column="4" Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center"
                                                                                                                            />

                                        <!-- Outstanding uses semantic colour only when there is
                                             something owed; a settled purchase shows a quiet dash. -->
                                        <TextBlock x:ConnectionId='15' Grid.Column="5" Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource DangerBrush}"
                                                                                                                                             
                                                                                                                                   />
                                        <TextBlock x:ConnectionId='16' Grid.Column="5" Text="—" Style="{StaticResource SecondaryTextStyle}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                                                                                                     />

                                        <!-- Frequent actions stay visible in the row so they are one click away.
                                             The existing handlers continue to enforce permissions and behavior. -->
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Button x:ConnectionId='17'                                    Padding="9,5" MinWidth="0" Height="32"
                                                    CornerRadius="{StaticResource RadiusMedium}"
                                                    AutomationProperties.Name="View purchase details">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="&#xE890;" FontSize="13" />
                                                    <TextBlock Text="View" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:ConnectionId='18'                                             Padding="9,5" MinWidth="0" Height="32"
                                                    CornerRadius="{StaticResource RadiusMedium}"
                                                    IsEnabled="{Binding ElementName=RootPage, Path=ViewModel.CanManagePurchases}"
                                                    AutomationProperties.Name="Record purchase payment">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="&#xE8C7;" FontSize="13" />
                                                    <TextBlock Text="Payment" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:ConnectionId='19'                                     Padding="8,5" MinWidth="0" Width="34" Height="32"
                                                    CornerRadius="{StaticResource RadiusMedium}"
                                                    ToolTipService.ToolTip="Print purchase"
                                                    AutomationProperties.Name="Print purchase">
                                                <FontIcon Glyph="&#xE749;" FontSize="13" />
                                            </Button>
                                            <Button x:ConnectionId='20'                                            Padding="9,5" MinWidth="0" Height="32"
                                                    CornerRadius="{StaticResource RadiusMedium}"
                                                    IsEnabled="{Binding ElementName=RootPage, Path=ViewModel.CanManagePurchases}"
                                                    AutomationProperties.Name="Create purchase return">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="&#xE7A7;" FontSize="13" />
                                                    <TextBlock Text="Return" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <InfoBar x:ConnectionId='2'                                                                                                        
                     Severity="Error"                                                       
                     VerticalAlignment="Top" Margin="0,0,0,8" />
        </Grid>
    </Grid>
</Page>

