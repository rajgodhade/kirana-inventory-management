<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.InvoicePreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Invoice Preview"
    PrimaryButtonText="Print"
    CloseButtonText="Close"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="420" MaxHeight="640">

        <ComboBox x:ConnectionId='2' Header="Format"                                                  
                                                                                />

        <InfoBar x:ConnectionId='3'                                                                                                        
                 Severity="Error"                                                        />
        <InfoBar x:ConnectionId='4'                                                                                                         
                 Severity="Success"                                                         />

        <ScrollViewer MaxHeight="480" HorizontalScrollBarVisibility="Auto" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <ContentControl x:ConnectionId='6'                                                          HorizontalContentAlignment="Center" />
        </ScrollViewer>

        <ProgressRing x:ConnectionId='5'                                                       HorizontalAlignment="Center" />
    </StackPanel>
</ContentDialog>

