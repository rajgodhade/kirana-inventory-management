<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.InvoicePreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Print"
    CloseButtonText="Close"
    DefaultButton="Primary">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Invoice Preview" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:ConnectionId='2' Grid.Column="1" Padding="6" Background="Transparent" BorderThickness="0"
                                             AutomationProperties.Name="Close">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <StackPanel Spacing="10" MinWidth="420" MaxHeight="640">

        <ComboBox x:ConnectionId='3' Header="Format"                                                  
                                                                                />

        <InfoBar x:ConnectionId='4'                                                                                                        
                 Severity="Error"                                                        />
        <InfoBar x:ConnectionId='5'                                                                                                         
                 Severity="Success"                                                         />

        <ScrollViewer MaxHeight="480" HorizontalScrollBarVisibility="Auto" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <ContentControl x:ConnectionId='7'                                                          HorizontalContentAlignment="Center" />
        </ScrollViewer>

        <ProgressRing x:ConnectionId='6'                                                       HorizontalAlignment="Center" />
    </StackPanel>
</ContentDialog>

