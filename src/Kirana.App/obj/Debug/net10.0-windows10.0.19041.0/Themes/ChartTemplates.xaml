<!--
    Shared chart item templates (Phase 10 Dashboard). Deliberately classic {Binding}, not compiled
    {x:Bind} — compiled bindings in a merged ResourceDictionary (rather than a Page/UserControl's
    own XAML) are untested territory in this codebase, and this project has a documented history of
    opaque XamlCompiler failures (see winui3_build_and_automation_gotchas memory), so the
    well-understood classic binding is the safer choice for a handful of small, non-hot-path
    item templates.

    Bar colours are plain {ThemeResource} lookups, which is what makes these charts "automatically
    respect Light/Dark" — WinUI re-resolves a ThemeResource on every element already in the live
    visual tree whenever the ancestor's theme changes, with zero code involved.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Vertical bar, primary chart hue — used for single-series trend/category/payment charts.
         The bar sits on a faint track so an empty/short bar still reads as "a column with a small
         value" rather than a rendering gap. -->
    <DataTemplate x:Key="ChartBarItemTemplate">
        <StackPanel Width="40" Spacing="6" HorizontalAlignment="Center"
                    ToolTipService.ToolTip="{Binding ValueText}">
            <Grid Height="140" VerticalAlignment="Bottom">
                <Border VerticalAlignment="Stretch" Width="22" CornerRadius="6"
                        Background="{ThemeResource ChartGridLineBrush}" Opacity="0.55" />
                <Border VerticalAlignment="Bottom" Width="22" Height="{Binding BarSize}"
                        Background="{ThemeResource ChartSeriesPrimaryBrush}" CornerRadius="6" />
            </Grid>
            <TextBlock Text="{Binding Label}" FontSize="10" Opacity="0.75" HorizontalAlignment="Center"
                       TextWrapping="NoWrap" MaxWidth="44" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </DataTemplate>

    <!-- Vertical bar, secondary hue — the second series in a paired chart (e.g. Expenses next to
         Sales), so the two series are distinguishable without a legend taking up space. -->
    <DataTemplate x:Key="ChartBarItemTemplateSecondary">
        <StackPanel Width="40" Spacing="6" HorizontalAlignment="Center"
                    ToolTipService.ToolTip="{Binding ValueText}">
            <Grid Height="140" VerticalAlignment="Bottom">
                <Border VerticalAlignment="Stretch" Width="22" CornerRadius="6"
                        Background="{ThemeResource ChartGridLineBrush}" Opacity="0.55" />
                <Border VerticalAlignment="Bottom" Width="22" Height="{Binding BarSize}"
                        Background="{ThemeResource ChartSeriesSecondaryBrush}" CornerRadius="6" />
            </Grid>
            <TextBlock Text="{Binding Label}" FontSize="10" Opacity="0.75" HorizontalAlignment="Center"
                       TextWrapping="NoWrap" MaxWidth="44" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </DataTemplate>

    <!-- Horizontal ranked bar — Top Customers / Top Suppliers. BarSize here is a pre-scaled width.
         The bar rides on a full-width track so every row shares a visual baseline, making relative
         lengths comparable at a glance instead of floating unanchored. -->
    <DataTemplate x:Key="RankingBarItemTemplate">
        <Grid ColumnSpacing="12" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Border Height="18" CornerRadius="9" HorizontalAlignment="Stretch"
                        Background="{ThemeResource ChartGridLineBrush}" Opacity="0.55" />
                <Border Height="18" CornerRadius="9" HorizontalAlignment="Left" Width="{Binding BarSize}"
                        Background="{ThemeResource ChartSeriesPrimaryBrush}" />
            </Grid>
            <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="11" Opacity="0.85"
                       VerticalAlignment="Center" FontWeight="SemiBold" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>

