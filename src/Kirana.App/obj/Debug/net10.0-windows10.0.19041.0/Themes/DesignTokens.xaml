<!--
    Kirana design tokens.

    Everything visual should reference a token from this file rather than hard-coding a colour,
    padding or font size, so the light/dark themes stay consistent and a future restyle is a
    one-file change. Brushes live in ThemeDictionaries (Light/Dark/HighContrast) and are resolved
    with {ThemeResource}; sizes and spacing are theme-independent and use {StaticResource}.

    Deliberately does NOT override the built-in system brushes — stock WinUI controls keep their
    own theming, and these tokens layer on top. Overriding system brushes wholesale tends to break
    control states (hover/pressed/disabled) in ways that only show up at runtime.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ============================ LIGHT (default) ============================ -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="BrandPrimaryColor">#0F766E</Color>
            <Color x:Key="BrandPrimaryHoverColor">#0D655E</Color>

            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#0F766E" />
            <SolidColorBrush x:Key="BrandSubtleBrush" Color="#E6F2F1" />
            <SolidColorBrush x:Key="BrandOnSubtleBrush" Color="#0B5A54" />

            <!-- Page/surface stack: page sits behind cards, cards sit above it. -->
            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F5F6F8" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FAFBFC" />
            <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#E3E6EA" />
            <SolidColorBrush x:Key="NavigationBackgroundBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#12161C" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C6672" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8B95A1" />

            <!-- Money: positive/neutral/owed. "Owed" is the one a shopkeeper must not miss. -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#E7F6EC" />
            <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="#FDF3E4" />
            <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="#FDECEA" />
            <SolidColorBrush x:Key="InfoBrush" Color="#1D4ED8" />
            <SolidColorBrush x:Key="InfoSubtleBrush" Color="#E8EEFC" />

            <!-- Accent overrides. These four are colour-only (no control templates), which is the
                 supported way to brand WinUI: without them AccentButtonStyle and the NavigationView
                 selection bar use the user's Windows accent colour, which clashes with the app's
                 own teal. Control hover/pressed/disabled states keep working because the styles
                 still resolve through these same keys. -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0F766E" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#116B64" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0D5B55" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F766E" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#116B64" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0D5B55" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#F0FFFD" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#0F766E" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#0F766E" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#0F766E" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#0F766E" />

            <!-- ===================== PASTEL DASHBOARD PALETTE =====================
                 Tinted card fills for KPI tiles and chart series. Each pastel has a matching
                 "On" foreground picked for AA contrast against its own fill, so a KPI's value
                 never has to fall back to the generic text brush and lose the colour coding.
                 Six hues, cycled deliberately rather than assigned at random: the same metric
                 keeps the same colour every time the dashboard loads. -->
            <SolidColorBrush x:Key="PastelTealBrush" Color="#DCF3F0" />
            <SolidColorBrush x:Key="PastelTealOnBrush" Color="#0B5A54" />
            <SolidColorBrush x:Key="PastelBlueBrush" Color="#E2EBFD" />
            <SolidColorBrush x:Key="PastelBlueOnBrush" Color="#1E40AF" />
            <SolidColorBrush x:Key="PastelVioletBrush" Color="#EBE6FB" />
            <SolidColorBrush x:Key="PastelVioletOnBrush" Color="#5B21B6" />
            <SolidColorBrush x:Key="PastelAmberBrush" Color="#FCF0DC" />
            <SolidColorBrush x:Key="PastelAmberOnBrush" Color="#92400E" />
            <SolidColorBrush x:Key="PastelRoseBrush" Color="#FBE4E6" />
            <SolidColorBrush x:Key="PastelRoseOnBrush" Color="#9F1239" />
            <SolidColorBrush x:Key="PastelGreenBrush" Color="#DFF3E6" />
            <SolidColorBrush x:Key="PastelGreenOnBrush" Color="#14663A" />

            <!-- Saturated companions for chart bars, where a pale fill would disappear. -->
            <SolidColorBrush x:Key="ChartSeriesPrimaryBrush" Color="#14B8A6" />
            <SolidColorBrush x:Key="ChartSeriesSecondaryBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="ChartSeriesTertiaryBrush" Color="#8B5CF6" />
            <SolidColorBrush x:Key="ChartGridLineBrush" Color="#EDF0F3" />

            <!-- Card chrome: a hairline border plus a genuinely soft shadow. Light mode carries
                 the shadow; dark mode leans on the border instead (see the Dark dictionary). -->
            <SolidColorBrush x:Key="CardElevatedBorderBrush" Color="#EAEDF1" />
            <Color x:Key="CardShadowColor">#1F2A37</Color>
        </ResourceDictionary>

        <!-- ================================= DARK ================================= -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="BrandPrimaryColor">#2DD4BF</Color>
            <Color x:Key="BrandPrimaryHoverColor">#5EE7D8</Color>

            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#2DD4BF" />
            <SolidColorBrush x:Key="BrandSubtleBrush" Color="#123A38" />
            <SolidColorBrush x:Key="BrandOnSubtleBrush" Color="#7FE9DC" />

            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#14181D" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1C2127" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#222831" />
            <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#2E353E" />
            <SolidColorBrush x:Key="NavigationBackgroundBrush" Color="#1A1F25" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F4F7" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6B0BC" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#78828E" />

            <!-- Lightened so they stay legible on dark surfaces. -->
            <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#16301F" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="#332612" />
            <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="#331B1B" />
            <SolidColorBrush x:Key="InfoBrush" Color="#7DA2FF" />
            <SolidColorBrush x:Key="InfoSubtleBrush" Color="#1A2338" />

            <!-- Dark-mode accent: lighter teal so it reads against dark surfaces, with dark text
                 on top for contrast (see the Light dictionary for why these are overridden). -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2DD4BF" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#3FDCC9" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#25B5A3" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#08201E" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#2DD4BF" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#3FDCC9" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#25B5A3" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#08201E" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#08201E" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#08201E" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#2DD4BF" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2DD4BF" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#1F8C80" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#2DD4BF" />

            <!-- Dark-mode pastels are deep tints, not pale ones: a literal pastel fill would glare
                 against a #14181D page and wash out the value sitting on it. Same six hues at low
                 luminance, with light "On" foregrounds — so a card keeps its colour identity across
                 themes while the contrast direction flips. -->
            <SolidColorBrush x:Key="PastelTealBrush" Color="#123A38" />
            <SolidColorBrush x:Key="PastelTealOnBrush" Color="#7FE9DC" />
            <SolidColorBrush x:Key="PastelBlueBrush" Color="#1A2338" />
            <SolidColorBrush x:Key="PastelBlueOnBrush" Color="#A9C2FF" />
            <SolidColorBrush x:Key="PastelVioletBrush" Color="#241E3A" />
            <SolidColorBrush x:Key="PastelVioletOnBrush" Color="#C4B5FD" />
            <SolidColorBrush x:Key="PastelAmberBrush" Color="#332612" />
            <SolidColorBrush x:Key="PastelAmberOnBrush" Color="#FCD34D" />
            <SolidColorBrush x:Key="PastelRoseBrush" Color="#341A20" />
            <SolidColorBrush x:Key="PastelRoseOnBrush" Color="#FDA4AF" />
            <SolidColorBrush x:Key="PastelGreenBrush" Color="#16301F" />
            <SolidColorBrush x:Key="PastelGreenOnBrush" Color="#86EFAC" />

            <SolidColorBrush x:Key="ChartSeriesPrimaryBrush" Color="#2DD4BF" />
            <SolidColorBrush x:Key="ChartSeriesSecondaryBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="ChartSeriesTertiaryBrush" Color="#A78BFA" />
            <SolidColorBrush x:Key="ChartGridLineBrush" Color="#2A313A" />

            <SolidColorBrush x:Key="CardElevatedBorderBrush" Color="#2E353E" />
            <!-- Near-black: a shadow on a dark surface should deepen, never glow. -->
            <Color x:Key="CardShadowColor">#000000</Color>
        </ResourceDictionary>

        <!-- ============================ HIGH CONTRAST ============================= -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="BrandSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BrandOnSubtleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="PageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NavigationBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="InfoBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="InfoSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <!-- High contrast deliberately discards the pastel identity entirely: colour-coding is
                 exactly what a high-contrast user has asked the OS to strip out, so every card
                 collapses to the system window/text pair and stays legible. -->
            <SolidColorBrush x:Key="PastelTealBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PastelTealOnBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PastelBlueBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PastelBlueOnBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PastelVioletBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PastelVioletOnBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PastelAmberBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PastelAmberOnBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PastelRoseBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PastelRoseOnBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PastelGreenBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PastelGreenOnBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="ChartSeriesPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChartSeriesSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ChartSeriesTertiaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChartGridLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="CardElevatedBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <Color x:Key="CardShadowColor">#000000</Color>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ============================== SPACING SCALE ============================== -->
    <!-- A 4pt scale. Use these instead of arbitrary numbers so rhythm stays consistent. -->
    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="PageHeaderPadding">24,20,24,16</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="CardPaddingLarge">20</Thickness>
    <Thickness x:Key="ListRowPadding">14,12</Thickness>
    <Thickness x:Key="ToolbarPadding">24,0,24,16</Thickness>

    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingS">8</x:Double>
    <x:Double x:Key="SpacingM">12</x:Double>
    <x:Double x:Key="SpacingL">16</x:Double>
    <x:Double x:Key="SpacingXL">24</x:Double>
    <x:Double x:Key="SpacingXXL">32</x:Double>

    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>

    <!-- Softer radii introduced for the modernized dashboard. Kept as new keys rather than
         re-pointing RadiusLarge, so every existing screen in the app keeps its current geometry
         and only the surfaces that opt in get the rounder look. -->
    <CornerRadius x:Key="RadiusXLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusXXLarge">20</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- ================================ TYPOGRAPHY ============================== -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="TextLineBounds" Value="Tight" />
    </Style>

    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>

    <!-- Column headers above list rows. -->
    <Style x:Key="ColumnHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>

    <!-- Product/invoice/customer codes. Tabular figures keep columns of numbers aligned. -->
    <Style x:Key="CodeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
    </Style>

    <Style x:Key="AmountTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="HorizontalTextAlignment" Value="Right" />
    </Style>

    <!-- The single biggest number on a screen (grand total, outstanding). -->
    <Style x:Key="MetricTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="MetricLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <!-- ================================ SURFACES ================================ -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- Divider between list rows; lighter than a full card border. -->
    <Style x:Key="RowSeparatorBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="{StaticResource ListRowPadding}" />
    </Style>

    <!-- Small status pill (Active / Low stock / Udhaar). -->
    <Style x:Key="BadgeBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSmall}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ======================= MODERNIZED DASHBOARD SURFACES =======================
         Additive styles for the pastel dashboard. Existing screens keep CardBorderStyle
         untouched; only surfaces that explicitly opt into these keys get the new look. -->

    <!-- Elevated white/dark card with a soft shadow. ThemeShadow needs a Translation with a
         non-zero Z to actually cast, which the consuming element sets — a Style can't set
         Translation (it isn't a dependency property on FrameworkElement in a settable-by-style
         way), so the shadow lives on the element and this style carries the rest. -->
    <Style x:Key="ElevatedCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardElevatedBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXLarge}" />
        <Setter Property="Padding" Value="{StaticResource CardPaddingLarge}" />
    </Style>

    <!-- Pastel KPI tile. Background/BorderBrush are supplied per-instance from the pastel
         palette so each metric keeps a stable colour identity; everything structural is here. -->
    <Style x:Key="KpiCardStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXLarge}" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="MinHeight" Value="104" />
    </Style>

    <!-- Circular icon chip inside a KPI tile. -->
    <Style x:Key="KpiIconChipStyle" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- KPI typography: small quiet label, large dominant value, tiny caption underneath. -->
    <Style x:Key="KpiLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="30" />
        <Setter Property="Opacity" Value="0.85" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="KpiValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="KpiCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Chart card header: title plus optional subtitle, consistent across all chart tiles. -->
    <Style x:Key="ChartCardTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="ChartCardSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Rounded container for the date-filter row, so the toolbar reads as one grouped control
         rather than three controls floating on the page background. -->
    <Style x:Key="FilterBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardElevatedBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXLarge}" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

</ResourceDictionary>

