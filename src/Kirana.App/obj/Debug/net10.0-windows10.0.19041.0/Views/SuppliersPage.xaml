<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.SuppliersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:ConnectionId='19' Grid.Column="0" Content="◀ Management"                     Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="Suppliers" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:ConnectionId='20' Grid.Column="2" Content="Lock &amp; Return to Billing"                     />
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Padding="20,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:ConnectionId='16' Grid.Column="0" PlaceholderText="Search name / ID / phone…"
                                                                                                    />

            <CheckBox x:ConnectionId='17' Grid.Column="1" Content="Show inactive" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                                                                                                 />

            <Button x:ConnectionId='18' Grid.Column="3" Content="Add Supplier" Style="{StaticResource AccentButtonStyle}"
                                                                                                 />
        </Grid>

        <!-- Results -->
        <Grid Grid.Row="2">
            <InfoBar x:ConnectionId='2'                                                                                                        
                     Severity="Error"                                                       
                     Margin="20,0,20,8" VerticalAlignment="Top" />

            <ListView x:ConnectionId='3'                                            Padding="20,0,20,20" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate                                     >
                        <Grid x:ConnectionId='5' Padding="12" ColumnSpacing="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="220" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:ConnectionId='14'                      FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:ConnectionId='15'                              Opacity="0.6" FontSize="12" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:ConnectionId='12'                               FontSize="12" />
                                <TextBlock x:ConnectionId='13'                       FontSize="12" Opacity="0.7" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" FontWeight="SemiBold" VerticalAlignment="Center">
                                <Run Text="₹" /><Run x:ConnectionId='11'                                    />
                            </TextBlock>

                            <TextBlock x:ConnectionId='6' Grid.Column="3" Text="Active" Foreground="Green" FontSize="11" VerticalAlignment="Center"
                                                                                                                            />

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button x:ConnectionId='7' Content="Ledger"                                      />
                                <Button x:ConnectionId='8' Content="Edit"                                    />
                                <Button x:ConnectionId='9' Content="Deactivate"                                           
                                                                                                                             />
                                <Button x:ConnectionId='10' Content="Reactivate"                                           
                                                                                                                                    />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>

