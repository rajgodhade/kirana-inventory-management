<UserControl x:ConnectionId='1'
    x:Class="Kirana.App.Views.Reports.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rpt="using:Kirana.Application.Reports">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20">

            <!-- Date filter -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:ConnectionId='48' Grid.Column="0"                                                        
                                                                                                      
                          HorizontalAlignment="Stretch"                                        />

                <CalendarDatePicker x:ConnectionId='49' Grid.Column="1" Header="From"                                                             
                                                                                                                                                                  
                                                                      />

                <CalendarDatePicker x:ConnectionId='50' Grid.Column="2" Header="To"                                                           
                                                                                                                                                                  
                                                                      />

                <Button x:ConnectionId='51' Grid.Column="4"                        VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar x:ConnectionId='2'                                                                                                        
                     Severity="Error"                                                        />

            <!-- KPI tiles -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Sales" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='47'                                                       Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Purchases" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='46'                                                           Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Expenses" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='45'                                                          Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource WarningBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Bills" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='44'                                                      Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>

                <Border x:ConnectionId='34' Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}"
                                                                                                                                        >
                    <StackPanel Spacing="4">
                        <TextBlock Text="Est. Gross Profit" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='43'                                                        Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource SuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border x:ConnectionId='35' Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}"
                                                                                                                                        >
                    <StackPanel Spacing="4">
                        <TextBlock Text="Est. Net Profit" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='42'                                                      Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource SuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Items Sold" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='41'                                                      Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Inventory Value (now)" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='40'                                                           Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Low Stock (now)" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='39'                                                          Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource WarningBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Out of Stock (now)" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='38'                                                            Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource DangerBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Customer Outstanding (now)" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='37'                                                                Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource DangerBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Supplier Outstanding (now)" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='36'                                                                Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource WarningBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Charts -->
            <TextBlock Text="Charts" Style="{StaticResource SectionTitleTextStyle}" />
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Daily Sales Trend" Style="{StaticResource CardTitleTextStyle}" />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl x:ConnectionId='33'                                                  ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Weekly Sales" Style="{StaticResource CardTitleTextStyle}" />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl x:ConnectionId='32'                                              ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Monthly Sales" Style="{StaticResource CardTitleTextStyle}" />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl x:ConnectionId='31'                                               ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Sales vs Expenses (6 mo)" Style="{StaticResource CardTitleTextStyle}" />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ItemsControl x:ConnectionId='30'                                                       ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl x:ConnectionId='29'                                                          ItemTemplate="{StaticResource ChartBarItemTemplateSecondary}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="10" Height="10" Background="{ThemeResource BrandPrimaryBrush}" CornerRadius="2" />
                                <TextBlock Text="Sales" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="10" Height="10" Background="{ThemeResource WarningBrush}" CornerRadius="2" />
                                <TextBlock Text="Expenses" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:ConnectionId='23' Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}"
                                                                                                                                        >
                    <StackPanel Spacing="10">
                        <TextBlock Text="Gross Profit Trend (6 mo)" Style="{StaticResource CardTitleTextStyle}" />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl x:ConnectionId='28'                                                   ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Payment Method Distribution" Style="{StaticResource CardTitleTextStyle}" />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl x:ConnectionId='27'                                                            ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Product Category Sales" Style="{StaticResource CardTitleTextStyle}" />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl x:ConnectionId='26'                                                       ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Top Customers" Style="{StaticResource CardTitleTextStyle}" />
                        <ItemsControl x:ConnectionId='25'                                                    ItemTemplate="{StaticResource RankingBarItemTemplate}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Top Suppliers" Style="{StaticResource CardTitleTextStyle}" />
                        <ItemsControl x:ConnectionId='24'                                                    ItemTemplate="{StaticResource RankingBarItemTemplate}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent activity -->
            <TextBlock Text="Recent Activity" Style="{StaticResource SectionTitleTextStyle}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Recent Sales" Style="{StaticResource CardTitleTextStyle}" />
                        <ItemsControl x:ConnectionId='18'                                             >
                            <ItemsControl.ItemTemplate>
                                <DataTemplate                               >
                                    <StackPanel x:ConnectionId='20' Margin="0,0,0,8">
                                        <TextBlock x:ConnectionId='21'                               Style="{StaticResource CodeTextStyle}" />
                                        <TextBlock x:ConnectionId='22'                                                                          Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Recent Purchases" Style="{StaticResource CardTitleTextStyle}" />
                        <ItemsControl x:ConnectionId='13'                                                 >
                            <ItemsControl.ItemTemplate>
                                <DataTemplate                                   >
                                    <StackPanel x:ConnectionId='15' Margin="0,0,0,8">
                                        <TextBlock x:ConnectionId='16'                                Style="{StaticResource CodeTextStyle}" />
                                        <TextBlock x:ConnectionId='17'                                                                          Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Recent Returns" Style="{StaticResource CardTitleTextStyle}" />
                        <ItemsControl x:ConnectionId='8'                                               >
                            <ItemsControl.ItemTemplate>
                                <DataTemplate                                 >
                                    <StackPanel x:ConnectionId='10' Margin="0,0,0,8">
                                        <TextBlock x:ConnectionId='11'                              Style="{StaticResource CodeTextStyle}" />
                                        <TextBlock x:ConnectionId='12'                                                                      Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Recent Expenses" Style="{StaticResource CardTitleTextStyle}" />
                        <ItemsControl x:ConnectionId='3'                                                >
                            <ItemsControl.ItemTemplate>
                                <DataTemplate                                  >
                                    <StackPanel x:ConnectionId='5' Margin="0,0,0,8">
                                        <TextBlock x:ConnectionId='6'                               Style="{StaticResource CodeTextStyle}" />
                                        <TextBlock x:ConnectionId='7'                                                                      Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

