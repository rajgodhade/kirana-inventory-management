<UserControl x:ConnectionId='1'
    x:Class="Kirana.App.Views.Reports.InventoryReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels.Reports">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:ConnectionId='19' Grid.Column="0" Header="Report"                                             
                                                                                           
                          HorizontalAlignment="Stretch"                                    />

                <ComboBox x:ConnectionId='20' Grid.Column="1"                                                        
                                                                                                      
                          HorizontalAlignment="Stretch"                                                           
                                                             />

                <CalendarDatePicker x:ConnectionId='21' Grid.Column="2" Header="From"                                                             
                                                                                                                                                                  
                                                                />

                <CalendarDatePicker x:ConnectionId='22' Grid.Column="3" Header="To"                                                           
                                                                                                                                                                  
                                                                />

                <Button x:ConnectionId='23' Grid.Column="5"                        VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="6" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:ConnectionId='24' Text="CSV"                          />
                            <MenuFlyoutItem x:ConnectionId='25' Text="Excel"                            />
                            <MenuFlyoutItem x:ConnectionId='26' Text="PDF"                          />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <InfoBar x:ConnectionId='2'                                                                                                        
                     Severity="Error"                                                        />

            <Grid x:ConnectionId='3' ColumnSpacing="12"                                                                                                                       >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total Stock Value" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='18'                                                           Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Products with Stock" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='17'                                                                  Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total Units on Hand" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='16'                                                           Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:ConnectionId='4' Style="{StaticResource CardBorderStyle}"                                                                                                                              >
                <ItemsControl x:ConnectionId='5'                                      >
                    <ItemsControl.ItemTemplate>
                        <DataTemplate                                          >
                            <Grid x:ConnectionId='7' Margin="0,0,0,10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock x:ConnectionId='14'                         Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock x:ConnectionId='15'                           Style="{StaticResource CodeTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:ConnectionId='12'                              Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock x:ConnectionId='13'                              Style="{StaticResource BodyTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock x:ConnectionId='10'                              Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock x:ConnectionId='11'                              Style="{StaticResource BodyTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="2">
                                    <TextBlock x:ConnectionId='8'                              Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock x:ConnectionId='9'                              Style="{StaticResource BodyTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

