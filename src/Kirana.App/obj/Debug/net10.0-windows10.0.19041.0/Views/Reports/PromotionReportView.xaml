<UserControl x:ConnectionId='1' x:Class="Kirana.App.Views.Reports.PromotionReportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:promo="using:Kirana.Application.Promotions">
    <ScrollViewer><StackPanel Padding="0,12,0,24" Spacing="14">
        <TextBlock Text="Promotion performance - this month" Style="{StaticResource SectionTitleTextStyle}" />
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelGreenBrush}"><StackPanel><TextBlock Text="REVENUE" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='16'                                                    Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelAmberBrush}"><StackPanel><TextBlock Text="DISCOUNT GIVEN" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='15'                                                     Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelBlueBrush}"><StackPanel><TextBlock Text="SALES" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='14'                                                  Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelVioletBrush}"><StackPanel><TextBlock Text="PRODUCTS SOLD" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='13'                                                     Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelRoseBrush}"><StackPanel><TextBlock Text="MOST USED" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='12'                                                     FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
        </Grid>
        <Border Style="{StaticResource CardBorderStyle}" Padding="0"><StackPanel><Grid Padding="14,10" Background="{ThemeResource SurfaceAltBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="140" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><TextBlock Text="PROMOTION" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="1" Text="REVENUE" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="2" Text="DISCOUNT" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="3" Text="SALES" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="4" Text="QTY" Style="{StaticResource ColumnHeaderTextStyle}" /></Grid><ItemsControl x:ConnectionId='3'                                      ><ItemsControl.ItemTemplate><DataTemplate                                           ><Grid x:ConnectionId='5' Padding="14,12" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="140" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:ConnectionId='10'                               FontWeight="SemiBold" /><TextBlock x:ConnectionId='11'                               Style="{StaticResource CodeTextStyle}" /></StackPanel><TextBlock x:ConnectionId='6' Grid.Column="1"                                                                       Style="{StaticResource AmountTextStyle}" /><TextBlock x:ConnectionId='7' Grid.Column="2"                                                                             Style="{StaticResource AmountTextStyle}" /><TextBlock x:ConnectionId='8' Grid.Column="3"                                /><TextBlock x:ConnectionId='9' Grid.Column="4"                                                                            /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        <InfoBar x:ConnectionId='2'                                                                                                         Severity="Error"                                                        />
    </StackPanel></ScrollViewer>
</UserControl>

