<UserControl x:ConnectionId='1'
    x:Class="Kirana.App.Views.Reports.SupplierReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dom="using:Kirana.Domain.Entities"
    xmlns:rpt="using:Kirana.Application.Reports">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:ConnectionId='17' Grid.Column="0" Header="Top Suppliers period"                                                        
                                                                                                      
                          HorizontalAlignment="Stretch"                                    />

                <CalendarDatePicker x:ConnectionId='18' Grid.Column="1" Header="From"                                                             
                                                                                                                                                                  
                                                                />

                <CalendarDatePicker x:ConnectionId='19' Grid.Column="2" Header="To"                                                           
                                                                                                                                                                  
                                                                />

                <Button x:ConnectionId='20' Grid.Column="4"                        VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="5" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:ConnectionId='21' Text="CSV"                          />
                            <MenuFlyoutItem x:ConnectionId='22' Text="Excel"                            />
                            <MenuFlyoutItem x:ConnectionId='23' Text="PDF"                          />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <InfoBar x:ConnectionId='2'                                                                                                        
                     Severity="Error"                                                        />

            <TextBlock Text="Outstanding Supplier Balance" Style="{StaticResource SectionTitleTextStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Total Outstanding" Style="{StaticResource MetricLabelTextStyle}" />
                    <TextBlock x:ConnectionId='16'                                                             Style="{StaticResource MetricTextStyle}" FontSize="20"
                               Foreground="{ThemeResource WarningBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <ItemsControl x:ConnectionId='9'                                                 >
                    <ItemsControl.ItemTemplate>
                        <DataTemplate                          >
                            <Grid x:ConnectionId='11' Margin="0,0,0,10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock x:ConnectionId='14'                      Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock x:ConnectionId='15'                              Style="{StaticResource CodeTextStyle}" />
                                </StackPanel>
                                <TextBlock x:ConnectionId='12' Grid.Column="1"                       Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                                <TextBlock x:ConnectionId='13' Grid.Column="2"                                                                                 
                                           Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="Top Suppliers" Style="{StaticResource SectionTitleTextStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <ItemsControl x:ConnectionId='3'                                              >
                    <ItemsControl.ItemTemplate>
                        <DataTemplate                                >
                            <Grid x:ConnectionId='5' Margin="0,0,0,8" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:ConnectionId='6' Grid.Column="0"                      Style="{StaticResource BodyTextStyle}" />
                                <TextBlock x:ConnectionId='7' Grid.Column="1"                                                                      Style="{StaticResource BodyTextStyle}" />
                                <TextBlock x:ConnectionId='8' Grid.Column="2"                                  Style="{StaticResource BodyTextStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

