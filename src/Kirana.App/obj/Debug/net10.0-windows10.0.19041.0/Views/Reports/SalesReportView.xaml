<UserControl x:ConnectionId='1'
    x:Class="Kirana.App.Views.Reports.SalesReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rpt="using:Kirana.Application.Reports">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:ConnectionId='38' Grid.Column="0"                                                        
                                                                                                      
                          HorizontalAlignment="Stretch"                                        />

                <CalendarDatePicker x:ConnectionId='39' Grid.Column="1" Header="From"                                                             
                                                                                                                                                                  
                                                                      />

                <CalendarDatePicker x:ConnectionId='40' Grid.Column="2" Header="To"                                                           
                                                                                                                                                                  
                                                                      />

                <Button x:ConnectionId='41' Grid.Column="4"                        VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="5" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutSubItem Text="Sales Summary">
                                <MenuFlyoutItem x:ConnectionId='45' Text="CSV"                               />
                                <MenuFlyoutItem x:ConnectionId='46' Text="Excel"                                 />
                                <MenuFlyoutItem x:ConnectionId='47' Text="PDF"                               />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="GST Report">
                                <MenuFlyoutItem x:ConnectionId='42' Text="CSV"                             />
                                <MenuFlyoutItem x:ConnectionId='43' Text="Excel"                               />
                                <MenuFlyoutItem x:ConnectionId='44' Text="PDF"                             />
                            </MenuFlyoutSubItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <InfoBar x:ConnectionId='2'                                                                                                        
                     Severity="Error"                                                        />

            <TextBlock Text="Sales Summary" Style="{StaticResource SectionTitleTextStyle}" />
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Gross Sales" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='37'                                                       Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Returns" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='36'                                                    Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource DangerBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Net Sales" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='35'                                                     Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="GST Collected" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='34'                                                         Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Item Discounts" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='33'                                                          Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Bill Discounts" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='32'                                                          Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total Discounts" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='31'                                                           Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Items Sold" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='30'                                                      Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Number of Bills" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='29'                                                      Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Average Bill Value" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock x:ConnectionId='28'                                                             Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Payment Method Breakdown" Style="{StaticResource SectionTitleTextStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <ItemsControl x:ConnectionId='23'                                                >
                    <ItemsControl.ItemTemplate>
                        <DataTemplate                                     >
                            <Grid x:ConnectionId='25' Margin="0,0,0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:ConnectionId='26' Grid.Column="0"                        Style="{StaticResource BodyTextStyle}" />
                                <TextBlock x:ConnectionId='27' Grid.Column="1"                                                                      Style="{StaticResource BodyTextStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="GST Report" Style="{StaticResource SectionTitleTextStyle}" />
            <TextBlock Text="CGST/SGST split assumes intra-state transactions; state-wise tax capture is not tracked."
                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Sales GST" Style="{StaticResource CardTitleTextStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Taxable Amount" Style="{StaticResource MetricLabelTextStyle}" />
                                <TextBlock x:ConnectionId='22'                                                         Style="{StaticResource MetricTextStyle}" FontSize="16" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="GST Collected" Style="{StaticResource MetricLabelTextStyle}" />
                                <TextBlock x:ConnectionId='21'                                                     Style="{StaticResource MetricTextStyle}" FontSize="16" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:ConnectionId='13'                                                >
                            <ItemsControl.ItemTemplate>
                                <DataTemplate                                  >
                                    <Grid x:ConnectionId='15' Margin="0,4,0,0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}"><Run x:ConnectionId='20'                             /><Run Text="%" /></TextBlock>
                                        <TextBlock x:ConnectionId='16' Grid.Column="1"                                                                             Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock x:ConnectionId='17' Grid.Column="2"                                                                    Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock x:ConnectionId='18' Grid.Column="3"                                                                    Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock x:ConnectionId='19' Grid.Column="4"                                                                         Style="{StaticResource CaptionTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Purchase GST" Style="{StaticResource CardTitleTextStyle}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Taxable Amount" Style="{StaticResource MetricLabelTextStyle}" />
                                <TextBlock x:ConnectionId='12'                                                            Style="{StaticResource MetricTextStyle}" FontSize="16" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="GST Paid" Style="{StaticResource MetricLabelTextStyle}" />
                                <TextBlock x:ConnectionId='11'                                                        Style="{StaticResource MetricTextStyle}" FontSize="16" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:ConnectionId='3'                                                   >
                            <ItemsControl.ItemTemplate>
                                <DataTemplate                                  >
                                    <Grid x:ConnectionId='5' Margin="0,4,0,0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource CaptionTextStyle}"><Run x:ConnectionId='10'                             /><Run Text="%" /></TextBlock>
                                        <TextBlock x:ConnectionId='6' Grid.Column="1"                                                                             Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock x:ConnectionId='7' Grid.Column="2"                                                                    Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock x:ConnectionId='8' Grid.Column="3"                                                                    Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock x:ConnectionId='9' Grid.Column="4"                                                                         Style="{StaticResource CaptionTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

