<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.PurchaseReturnsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Purchase Returns" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Goods sent back to suppliers, credited against their balance."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <Button x:ConnectionId='14' Grid.Column="1" Style="{StaticResource AccentButtonStyle}"                         
                    VerticalAlignment="Center"                                                  
                    AutomationProperties.Name="New Purchase Return">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                    <TextBlock Text="New Purchase Return" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Padding="{StaticResource ToolbarPadding}" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:ConnectionId='12' Grid.Column="0" PlaceholderText="Search return / purchase / supplier…"
                                                                                                
                                                       />
            <Button x:ConnectionId='13' Grid.Column="1"                       AutomationProperties.Name="Search purchase returns">
                <FontIcon Glyph="&#xE721;" FontSize="14" />
            </Button>
        </Grid>

        <Grid Grid.Row="2" Margin="24,0,24,24">
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="14,10" ColumnSpacing="16"
                          Background="{ThemeResource SurfaceAltBrush}"
                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" MinWidth="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="RETURN" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="PURCHASE" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="SUPPLIER" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="DATE" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="4" Text="CREDITED" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                    </Grid>

                    <ListView x:ConnectionId='3' Grid.Row="1"                                          SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate                                           >
                                <Grid x:ConnectionId='5' Padding="14,12" ColumnSpacing="16"
                                      BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" MinWidth="160" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" MinWidth="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:ConnectionId='6' Grid.Column="0"                              Style="{StaticResource CardTitleTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock x:ConnectionId='7' Grid.Column="1"                                Style="{StaticResource CodeTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock x:ConnectionId='8' Grid.Column="2"                              Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock x:ConnectionId='9' Grid.Column="3"                          Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock x:ConnectionId='10' Grid.Column="4"                           Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center" />
                                    <Button x:ConnectionId='11' Grid.Column="5" Content="Details"                                       VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <InfoBar x:ConnectionId='2'                                                                                                        
                     Severity="Error"                                                        VerticalAlignment="Top" />
        </Grid>
    </Grid>
</Page>

