<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.SupplierLedgerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:ConnectionId='15' Grid.Column="0" Content="◀ Suppliers"                     Margin="0,0,12,0" />
            <StackPanel Grid.Column="1">
                <TextBlock x:ConnectionId='17'                                                     FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:ConnectionId='18'                                                     Opacity="0.7" FontSize="12" />
            </StackPanel>
            <Button x:ConnectionId='16' Grid.Column="2" Content="Lock &amp; Return to Billing"                     />
        </Grid>

        <!-- Summary + actions -->
        <Grid Grid.Row="1" Padding="20,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="20" FontWeight="Bold" VerticalAlignment="Center">
                <Run Text="Outstanding: ₹" /><Run x:ConnectionId='14'                                                           />
            </TextBlock>
            <Button x:ConnectionId='13' Grid.Column="2" Content="Record Payment" Style="{StaticResource AccentButtonStyle}"
                                                                                                   />
        </Grid>

        <!-- Ledger -->
        <Grid Grid.Row="2">
            <InfoBar x:ConnectionId='2'                                                                                                        
                     Severity="Error"                                                       
                     Margin="20,0,20,8" VerticalAlignment="Top" />

            <ListView x:ConnectionId='3'                                          Padding="20,0,20,20" SelectionMode="None">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Date" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Reference" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Debit" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Credit" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" Text="Balance" FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate                                           >
                        <Grid x:ConnectionId='6' ColumnSpacing="12" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:ConnectionId='7' Grid.Column="0"                          FontSize="12" />
                            <TextBlock x:ConnectionId='8' Grid.Column="1"                           FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:ConnectionId='9' Grid.Column="2"                           FontSize="12" />
                            <TextBlock x:ConnectionId='10' Grid.Column="3"                           FontSize="12" />
                            <TextBlock x:ConnectionId='11' Grid.Column="4"                            FontSize="12" />
                            <TextBlock x:ConnectionId='12' Grid.Column="5"                                    FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>

