<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.CustomerLedgerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Customer Details" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Profile, ledger, purchase history and repayments." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:ConnectionId='37' Content="Print"                            />
                <Button Content="Export">
                    <Button.Flyout><MenuFlyout><MenuFlyoutItem x:ConnectionId='38' Text="Export Excel"                            />
                        <MenuFlyoutItem x:ConnectionId='39' Text="Export PDF"                          /></MenuFlyout></Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Profile + outstanding -->
        <Grid Grid.Row="1" Padding="20,16" ColumnSpacing="24" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock x:ConnectionId='31'                                                     FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:ConnectionId='32'                                                     FontSize="12" Opacity="0.6" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock FontSize="12" Opacity="0.8">
                        <Run Text="Phone:" /><Run Text=" " /><Run x:ConnectionId='36'                                              />
                    </TextBlock>
                    <TextBlock FontSize="12" Opacity="0.8">
                        <Run Text="Address:" /><Run Text=" " /><Run x:ConnectionId='35'                                                />
                    </TextBlock>
                    <TextBlock FontSize="12" Opacity="0.8">
                        <Run Text="GSTIN:" /><Run Text=" " /><Run x:ConnectionId='34'                                              />
                    </TextBlock>
                </StackPanel>
                <TextBlock x:ConnectionId='33'                                              FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                                                                                                                      />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="3">
                <TextBlock Text="Lifetime Sales" FontSize="11" Opacity="0.7" HorizontalAlignment="Right" />
                <TextBlock x:ConnectionId='29'                                                             FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Text="Outstanding Udhaar" FontSize="11" Opacity="0.7" HorizontalAlignment="Right" />
                <TextBlock x:ConnectionId='30'                                                          
                           FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </StackPanel>

            <Button x:ConnectionId='28' Grid.Column="2" Content="Record Repayment" Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Center"                               
                                                                               />
        </Grid>

        <!-- Tabs -->
        <Grid Grid.Row="2">
            <InfoBar x:ConnectionId='2'                                                                                                        
                     Severity="Error"                                                       
                     Margin="20,0,20,8" VerticalAlignment="Top" />

            <Pivot Padding="12,0,12,0">
                <PivotItem Header="Ledger">
                    <ListView x:ConnectionId='19'                                          SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate                                           >
                                <Grid x:ConnectionId='21' Padding="10" ColumnSpacing="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" MinWidth="140" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:ConnectionId='22' Grid.Column="0"                          FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock x:ConnectionId='23' Grid.Column="1"                           FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock x:ConnectionId='24' Grid.Column="2"                           FontSize="12" VerticalAlignment="Center" Opacity="0.8" />
                                    <TextBlock x:ConnectionId='25' Grid.Column="3"                           FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock x:ConnectionId='26' Grid.Column="4"                            FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock x:ConnectionId='27' Grid.Column="5"                                    FontWeight="SemiBold" FontSize="12"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </PivotItem>

                <PivotItem Header="Purchase History">
                    <ListView x:ConnectionId='11'                                            SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate                                           >
                                <Grid x:ConnectionId='13' Padding="10" ColumnSpacing="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" MinWidth="140" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:ConnectionId='14' Grid.Column="0"                          FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock x:ConnectionId='15' Grid.Column="1"                           FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock x:ConnectionId='16' Grid.Column="2"                           FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock x:ConnectionId='17' Grid.Column="3"                           FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock x:ConnectionId='18' Grid.Column="4"                            FontSize="12" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Opacity="0.8" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </PivotItem>

                <PivotItem Header="Payment History">
                    <ListView x:ConnectionId='3'                                             SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate                                           >
                                <Grid x:ConnectionId='5' Padding="10" ColumnSpacing="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" MinWidth="140" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:ConnectionId='6' Grid.Column="0"                          FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock x:ConnectionId='7' Grid.Column="1"                           FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock x:ConnectionId='8' Grid.Column="2"                           FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock x:ConnectionId='9' Grid.Column="3"                            FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <Button x:ConnectionId='10' Grid.Column="4" Content="Print Receipt"                                            />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </PivotItem>
            </Pivot>
        </Grid>
    </Grid>
</Page>

