<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.CashRegisterPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,20,24,28" Spacing="16">
                <Grid>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Cash Register" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Text="Opening cash, physical drawer movements, cashier closing and daily reports."
                                   Style="{StaticResource PageSubtitleTextStyle}" />
                    </StackPanel>
                    <Button x:ConnectionId='37' HorizontalAlignment="Right" VerticalAlignment="Center"                       
                            AutomationProperties.Name="Refresh cash register"><FontIcon Glyph="&#xE72C;" /></Button>
                </Grid>

                <InfoBar x:ConnectionId='2'                                                                                                        
                         Severity="Error"                                                        IsClosable="True" />
                <InfoBar x:ConnectionId='3'                                                                                                         
                         Severity="Success"                                                         IsClosable="True" />
                <ProgressBar x:ConnectionId='4' IsIndeterminate="True"                                                                                                           />

                <Border x:ConnectionId='5' Style="{StaticResource CardBorderStyle}"
                                                                                                                                        >
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="7" VerticalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="24" Background="{ThemeResource PastelAmberBrush}" HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE7B8;" Foreground="{ThemeResource PastelAmberOnBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Register is closed" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Confirm the physical cash in the drawer once, before the register session begins."
                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBox x:ConnectionId='35' x:Name="OpeningCashBox" Header="Opening Cash" PlaceholderText="0.00"
                                     InputScope="Number" AutomationProperties.Name="Opening cash amount" />
                            <Button x:ConnectionId='36' Content="Open Register" Style="{StaticResource AccentButtonStyle}"                            
                                                                                HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel x:ConnectionId='6' Spacing="14"                                                                                                          >
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="{ThemeResource SuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="REGISTER OPEN" Foreground="{ThemeResource SuccessBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock x:ConnectionId='32'                                                     Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock><Run Text="Opened by " /><Run x:ConnectionId='33'                                                 /><Run Text=" · " /><Run x:ConnectionId='34'                                                 /></TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="CURRENT EXPECTED CASH" Style="{StaticResource KpiLabelTextStyle}" HorizontalAlignment="Right" />
                                <TextBlock x:ConnectionId='31'                                                         FontSize="28" FontWeight="Bold" Foreground="{ThemeResource BrandPrimaryBrush}" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelBlueBrush}"><StackPanel><TextBlock Text="OPENING CASH" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='30'                                                        Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelGreenBrush}"><StackPanel><TextBlock Text="CASH SALES" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='29'                                                      Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelRoseBrush}"><StackPanel><TextBlock Text="CASH REFUNDS" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='28'                                                        Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
                        <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelVioletBrush}"><StackPanel><TextBlock Text="UDHAAR REPAYMENTS" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='27'                                                           Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
                        <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelGreenBrush}"><StackPanel><TextBlock Text="CASH IN" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='26'                                                   Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
                        <Border Grid.Column="5" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelAmberBrush}"><StackPanel><TextBlock Text="CASH OUT" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='25'                                                    Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
                    </Grid>

                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:ConnectionId='21' Content="X Report"                        />
                            <Button x:ConnectionId='22' Content="Cash In"                                                                />
                            <Button x:ConnectionId='23' Content="Cash Out"                                                                  />
                            <Button x:ConnectionId='24' Content="Close Register"                                                                         
                                    Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="Register History" Style="{StaticResource SectionTitleTextStyle}" Margin="18,16" />
                        <Grid Grid.Row="1" Padding="16,10" Background="{ThemeResource SurfaceAltBrush}" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="110" /><ColumnDefinition Width="90" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                            <TextBlock Text="DATE" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="1" Text="REGISTER" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="2" Text="OPENED" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="3" Text="CLOSED" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="4" Text="EXPECTED" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" /><TextBlock Grid.Column="5" Text="COUNTED" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" /><TextBlock Grid.Column="6" Text="DIFFERENCE" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" /><TextBlock Grid.Column="7" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="8" Text="REPORT" Style="{StaticResource ColumnHeaderTextStyle}" />
                        </Grid>
                        <ListView x:ConnectionId='7' Grid.Row="2"                                          MaxHeight="320" SelectionMode="None">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate><DataTemplate                                                >
                                <Grid x:ConnectionId='9' Padding="16,11" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="110" /><ColumnDefinition Width="90" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                    <TextBlock x:ConnectionId='10'                              /><TextBlock x:ConnectionId='11' Grid.Column="1"                              /><StackPanel Grid.Column="2"><TextBlock x:ConnectionId='19'                          /><TextBlock x:ConnectionId='20'                          Style="{StaticResource CaptionTextStyle}" /></StackPanel><StackPanel Grid.Column="3"><TextBlock x:ConnectionId='17'                          /><TextBlock x:ConnectionId='18'                          Style="{StaticResource CaptionTextStyle}" /></StackPanel><TextBlock x:ConnectionId='12' Grid.Column="4"                          HorizontalAlignment="Right" /><TextBlock x:ConnectionId='13' Grid.Column="5"                        HorizontalAlignment="Right" /><TextBlock x:ConnectionId='14' Grid.Column="6"                          HorizontalAlignment="Right" /><TextBlock x:ConnectionId='15' Grid.Column="7"                        /><Button x:ConnectionId='16' Grid.Column="8" Content="View"                                                                            />
                                </Grid>
                            </DataTemplate></ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

