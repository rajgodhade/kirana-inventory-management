<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.HeldBillsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:entities="using:Kirana.Domain.Entities"
    CloseButtonText="Cancel"
    DefaultButton="Close">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Resume Held Bill" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:ConnectionId='2' Grid.Column="1" Padding="6" Background="Transparent" BorderThickness="0"
                                             AutomationProperties.Name="Close">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <StackPanel Spacing="10" MinWidth="420" MaxHeight="480">
        <InfoBar x:ConnectionId='3'                                                                                                        
                 Severity="Error"                                                        />

        <ListView x:ConnectionId='4'                                            MaxHeight="400" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate                               >
                    <Grid x:ConnectionId='6' ColumnSpacing="10" Padding="0,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="Held at " /><Run x:ConnectionId='10'                           />
                            </TextBlock>
                            <TextBlock Opacity="0.7">
                                <Run Text="Items: " /><Run x:ConnectionId='8'                             />
                                <Run Text="  Customer: " /><Run x:ConnectionId='9'                               />
                            </TextBlock>
                        </StackPanel>
                        <Button x:ConnectionId='7' Grid.Column="1" Content="Resume"                                      />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>

