<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.NewPurchaseReturnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    xmlns:ret="using:Kirana.Application.Returns">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <StackPanel Spacing="2">
                <TextBlock Text="New Purchase Return" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Send goods back to a supplier. Stock reduces and their balance is credited."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Padding="24,0,24,12" Spacing="10">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="1 · Find the purchase" Style="{StaticResource SectionTitleTextStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:ConnectionId='29' x:Name="SearchBox" Grid.Column="0"
                                 PlaceholderText="Purchase number, supplier invoice, supplier or product"
                                                                                                                       
                                                                                             />
                        <Button x:ConnectionId='30' Grid.Column="1" Content="Search"                       />
                    </Grid>

                    <ListView x:ConnectionId='20'                                             MaxHeight="150"
                              SelectionMode="Single"                                       
                                                                                                                                                           >
                        <ListView.ItemTemplate>
                            <DataTemplate                                    >
                                <Grid x:ConnectionId='25' Padding="4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:ConnectionId='26' Grid.Column="0"                                FontWeight="SemiBold" />
                                    <TextBlock x:ConnectionId='27' Grid.Column="1"                              Opacity="0.75" />
                                    <TextBlock x:ConnectionId='28' Grid.Column="2"                                                                          />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid x:ConnectionId='21' ColumnSpacing="12"
                                                                                                                                                >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:ConnectionId='22' Grid.Column="0"                                                              
                                   Style="{StaticResource CardTitleTextStyle}" VerticalAlignment="Center" />
                        <Button x:ConnectionId='23' Grid.Column="1" Content="Choose a different purchase"                              />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid x:ConnectionId='2' Grid.Row="2" Margin="24,0,24,12"
                                                                                                                                    >
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="14,10" ColumnSpacing="12"
                          Background="{ThemeResource SurfaceAltBrush}"
                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="2 · PRODUCT" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="RECEIVED" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="COST" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="RETURN QTY" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="4" Text="BATCH" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="5" Text="LINE VALUE" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                    </Grid>

                    <ListView x:ConnectionId='8' Grid.Row="1"                                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate                                            >
                                <Grid x:ConnectionId='10' Padding="14,10" ColumnSpacing="12"
                                      BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="180" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:ConnectionId='18'                             Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock x:ConnectionId='19'                             Style="{StaticResource CodeTextStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:ConnectionId='15'                              Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock x:ConnectionId='16'                                Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock x:ConnectionId='17'                           Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>

                                    <TextBlock x:ConnectionId='11' Grid.Column="2"                           Style="{StaticResource BodyTextStyle}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <TextBox x:ConnectionId='12' Grid.Column="3"                                                                               
                                                                            TextAlignment="Center" VerticalAlignment="Center" />

                                    <TextBox x:ConnectionId='13' Grid.Column="4"                                          VerticalAlignment="Center"
                                             PlaceholderText="Batch" />

                                    <TextBlock x:ConnectionId='14' Grid.Column="5"                                           
                                               Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Padding="24,0,24,20" Spacing="10">
            <InfoBar x:ConnectionId='3'                                                                                                        
                     Severity="Error"                                                        />
            <InfoBar x:ConnectionId='4'                                                                                                         
                     Severity="Informational"                                                         />

            <Border x:ConnectionId='5' Style="{StaticResource CardBorderStyle}"
                                                                                                                                          >
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:ConnectionId='6' Grid.Column="0" Header="3 · Reason (optional)"                                               />
                    <Button x:ConnectionId='7' Grid.Column="1" Style="{StaticResource AccentButtonStyle}"                       
                            VerticalAlignment="Bottom" Padding="20,9"
                                                                             
                            AutomationProperties.Name="Process Return">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                            <TextBlock Text="Process Return" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>

