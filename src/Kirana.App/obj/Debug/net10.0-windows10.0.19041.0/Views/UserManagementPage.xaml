<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.UserManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Users" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Local accounts, roles and access." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <Button x:ConnectionId='19' Grid.Column="1" Style="{StaticResource AccentButtonStyle}"                        VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add User" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- List -->
        <Grid Grid.Row="1">
            <InfoBar x:ConnectionId='2'                                                                                                        
                     Severity="Error"                                                       
                     Margin="20,8,20,8" VerticalAlignment="Top" />

            <ListView x:ConnectionId='3'                                        Padding="20,0,20,20" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate                                 >
                        <Grid x:ConnectionId='5' Padding="12" ColumnSpacing="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="200" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock x:ConnectionId='17'                          FontWeight="SemiBold" />
                                <TextBlock x:ConnectionId='18'                          Opacity="0.7" FontSize="12" />
                            </StackPanel>

                            <TextBlock x:ConnectionId='6' Grid.Column="1"                          VerticalAlignment="Center" />

                            <TextBlock x:ConnectionId='7' Grid.Column="2"                               FontSize="12" Opacity="0.7" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:ConnectionId='14' Text="Active" Foreground="Green" FontSize="11"
                                                                                                                                />
                                <TextBlock x:ConnectionId='15' Text="Inactive" Foreground="Gray" FontSize="11"
                                                                                                                                       />
                                <TextBlock x:ConnectionId='16' Text="Locked" Foreground="Red" FontSize="11"
                                                                                                                                />
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button x:ConnectionId='8' Content="Edit"                                    />
                                <Button x:ConnectionId='9' Content="Reset Password"                                             />
                                <Button x:ConnectionId='10' Content="Set PIN"                                      />
                                <Button x:ConnectionId='11' Content="Unlock"                                     
                                                                                                                             />
                                <Button x:ConnectionId='12' Content="Deactivate"                                           
                                                                                                                             />
                                <Button x:ConnectionId='13' Content="Activate"                                           
                                                                                                                                    />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>

