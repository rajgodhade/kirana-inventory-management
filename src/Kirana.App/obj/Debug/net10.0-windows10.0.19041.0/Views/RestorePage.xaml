<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.RestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="{StaticResource PageHeaderPadding}" Spacing="2">
            <TextBlock Text="Restore" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Replace all current data with the contents of a backup. A safety backup of your current data is always taken first."
                       Style="{StaticResource PageSubtitleTextStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,0,24,24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

                <InfoBar IsOpen="True" Severity="Warning" IsClosable="False"
                         Title="Restoring replaces everything"
                         Message="All products, sales, purchases, customers, users and settings will be replaced by the backup's copy. Kirana will restart when it finishes." />

                <ProgressBar x:ConnectionId='2' IsIndeterminate="True"
                                                                                                                                       />

                <InfoBar x:ConnectionId='3'                                                                                                        
                         Severity="Error"                                                        IsClosable="False" />
                <InfoBar x:ConnectionId='4'                                                                                                         
                         Severity="Success"                                                         IsClosable="False" />

                <!-- Once the swap has happened the rest of this page is reading a database that is
                     no longer the live one, so it collapses down to the restart prompt. -->
                <Border x:ConnectionId='5' Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}"
                        Background="{ThemeResource SuccessSubtleBrush}"
                                                                                                                                           >
                    <StackPanel Spacing="12">
                        <TextBlock Text="Restore finished" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                                   Text="Kirana must restart to load the restored data." />
                        <Button x:ConnectionId='24' Content="Restart Kirana now" Style="{StaticResource AccentButtonStyle}"
                                                       HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <StackPanel x:ConnectionId='6' Spacing="16"
                                                                                                                                                      >

                    <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="1 · Choose a backup" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                                           Text="Pick one Kirana took, or browse for a backup file copied from another machine." />
                            </StackPanel>

                            <Button x:ConnectionId='15'                                                                 HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock Text="Browse for a backup file…" />
                                </StackPanel>
                            </Button>

                            <TextBlock x:ConnectionId='16' Style="{StaticResource SecondaryTextStyle}"
                                       Text="No backups are available on this machine."
                                                                                                                                                       />

                            <ListView x:ConnectionId='17'                                                   SelectionMode="None" MaxHeight="260">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate                                           >
                                        <Grid x:ConnectionId='19' Padding="12,10" ColumnSpacing="16"
                                              BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:ConnectionId='20' Grid.Column="0"                               
                                                       Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                                            <TextBlock x:ConnectionId='21' Grid.Column="1"                          
                                                       Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                            <TextBlock x:ConnectionId='22' Grid.Column="2"                          
                                                       Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                            <Button x:ConnectionId='23' Grid.Column="3" Content="Select"                                            />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border x:ConnectionId='7' Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}"
                                                                                                                                                >
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="2 · Check what it contains" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock x:ConnectionId='14'                                                             
                                           Style="{StaticResource PageSubtitleTextStyle}" />
                            </StackPanel>

                            <TextBlock x:ConnectionId='10'                                                          
                                       Style="{StaticResource CodeTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                            <ItemsControl x:ConnectionId='11'                                                        >
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate                      >
                                        <TextBlock x:ConnectionId='13'                 Style="{StaticResource SecondaryTextStyle}" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border x:ConnectionId='8' Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}"
                                                                                                                                                >
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="3 · Confirm the restore" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                                           Text="You will be asked for an Owner PIN, then to confirm. A safety backup is taken before anything is replaced." />
                            </StackPanel>

                            <Button x:ConnectionId='9' Content="Restore this backup"                       
                                                                              HorizontalAlignment="Left"
                                    Background="{ThemeResource DangerBrush}" Foreground="White" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

