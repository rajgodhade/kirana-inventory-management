<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.PosShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Page.Resources>
        <MenuFlyout x:Key="SearchFlyout" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:ConnectionId='28' Grid.Column="0"                                                  FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:ConnectionId='29' Grid.Column="1" Content="Dashboard 🔒"                          />
        </Grid>

        <!-- Scan / search bar + customer -->
        <Grid Grid.Row="1" Margin="20,12,20,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:ConnectionId='25' x:Name="ScanSearchBox" Grid.Column="0" FontSize="18"
                     PlaceholderText="Scan Barcode / Product ID / SKU / Name (F2)"
                                                                                           />

            <Button x:ConnectionId='26' Grid.Column="1"                        >
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE77B;" FontSize="16" />
                    <TextBlock x:ConnectionId='27'                                                            />
                    <TextBlock Text="(F4)" Opacity="0.6" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar x:ConnectionId='2' Grid.Row="1" Margin="20,0,20,0" VerticalAlignment="Bottom"
                                                                                                                        
                 Severity="Error"                                                        />

        <!-- Cart -->
        <Grid Grid.Row="2" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <ListView x:ConnectionId='8' Grid.Column="0"                                            SelectionMode="None">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8" Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Product" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Qty" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Price" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Disc %" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Line Total" FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate                                  >
                        <Grid x:ConnectionId='17' ColumnSpacing="8" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:ConnectionId='23'                             TextWrapping="Wrap" />
                                <TextBlock x:ConnectionId='24'                             Opacity="0.6" FontSize="11" />
                            </StackPanel>

                            <TextBox x:ConnectionId='18' Grid.Column="1"                                                                                          />
                            <TextBlock x:ConnectionId='19' Grid.Column="2"                           VerticalAlignment="Center" />
                            <TextBox x:ConnectionId='20' Grid.Column="3"                                                                                                 />
                            <TextBlock x:ConnectionId='21' Grid.Column="4"                                        VerticalAlignment="Center" FontWeight="SemiBold" />
                            <Button x:ConnectionId='22' Grid.Column="5" Content="✕"                                          />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Totals panel -->
            <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="6" VerticalAlignment="Top">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Subtotal" />
                    <TextBlock x:ConnectionId='14' Grid.Column="1"                                                 />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Item Discounts" />
                    <TextBlock x:ConnectionId='13' Grid.Column="1"                                                          />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Bill Discount" />
                    <TextBlock x:ConnectionId='12' Grid.Column="1"                                                           />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="GST" />
                    <TextBlock x:ConnectionId='11' Grid.Column="1"                                                 />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Round Off" />
                    <TextBlock x:ConnectionId='10' Grid.Column="1"                                                       />
                </Grid>

                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,8" />

                <TextBlock FontSize="34" FontWeight="Bold" HorizontalAlignment="Right">
                    <Run Text="₹" /><Run x:ConnectionId='9'                                                   />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Action bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Padding="20,0,20,12" HorizontalAlignment="Right">
            <Button x:ConnectionId='4' Content="Hold (F6)"                     />
            <Button x:ConnectionId='5' Content="Resume (F7)"                       />
            <Button x:ConnectionId='6' Content="Discount (F8)"                         />
            <Button x:ConnectionId='7' Content="Payment / Complete Sale (F9)" Style="{StaticResource AccentButtonStyle}"                        />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="16" Padding="20,0,20,16" HorizontalAlignment="Left">
            <TextBlock x:ConnectionId='3'                                                       Opacity="0.7" />
            <TextBlock Text="held bill(s)" Opacity="0.7" />
        </StackPanel>
    </Grid>
</Page>

