<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.BarcodeLabelDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Barcode Labels" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:ConnectionId='2' Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                                             AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <StackPanel Spacing="10" MinWidth="580" MaxHeight="620">

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:ConnectionId='14' Grid.Column="0" Header="Label width (mm)"                                                         />
            <TextBox x:ConnectionId='15' Grid.Column="1" Header="Label height (mm)"                                                          />
            <Button x:ConnectionId='16' Grid.Column="2" Content="Print" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom"
                                                             
                                                                                                                            />
        </Grid>

        <InfoBar x:ConnectionId='3'                                                                                                        
                 Severity="Error"                                                        />

        <ListView x:ConnectionId='4'                                        MaxHeight="440" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate                                     >
                    <Grid x:ConnectionId='6' ColumnSpacing="8" Padding="0,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Image x:ConnectionId='7' Grid.Column="0"                                             Height="40" Width="120" Stretch="Fill"
                                                                                                                                     />

                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock x:ConnectionId='12'                             FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:ConnectionId='13'                           FontSize="11" Opacity="0.7" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBox x:ConnectionId='10'                                      PlaceholderText="Scan or type…" Width="160" />
                            <Button x:ConnectionId='11' Content="Generate"                                       
                                                                                                                                    />
                        </StackPanel>

                        <TextBox x:ConnectionId='8' Grid.Column="3"                                           />

                        <Button x:ConnectionId='9' Grid.Column="4" Content="✕"                                      ToolTipService.ToolTip="Remove" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>

