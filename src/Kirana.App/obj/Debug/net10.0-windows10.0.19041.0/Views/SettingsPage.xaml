<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kirana.App.Views.Controls"
    xmlns:viewModels="using:Kirana.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <StackPanel Spacing="2">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Appearance, security and store preferences." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,0,24,24" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">

                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Device Status" Style="{StaticResource SectionTitleTextStyle}" />
                        <controls:DeviceStatusWidget x:ConnectionId='49' Title="Receipt printer" Glyph="&#xE749;"
                                                                                     
                                                                                      />
                        <controls:DeviceStatusWidget x:ConnectionId='50' Title="Barcode scanner" Glyph="&#xE8BD;"
                                                                                     
                                                                                      />
                    </StackPanel>
                </Border>

                <!-- Appearance. Unlike the other settings this is a per-install display preference,
                     so it is deliberately not gated behind the settings permission. -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Cloud Backup" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" TextWrapping="Wrap"
                                       Text="Keep validated .kbak backups in your own Google Drive or OneDrive. Cloud backup never blocks billing or changes live data." />
                        </StackPanel>
                        <ComboBox x:ConnectionId='23' Header="Provider"                                                      
                                                                                              
                                                                                   />
                        <Border x:ConnectionId='24' Background="{ThemeResource SuccessSubtleBrush}" CornerRadius="10" Padding="12"
                                                                                                                                                   >
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SuccessBrush}" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Google Drive connected" FontWeight="SemiBold" Foreground="{ThemeResource SuccessBrush}" />
                                    <TextBlock x:ConnectionId='47'                                                            Style="{StaticResource PageSubtitleTextStyle}" />
                                    <TextBlock x:ConnectionId='48'                                                            Style="{StaticResource PageSubtitleTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:ConnectionId='25' Background="{ThemeResource WarningSubtleBrush}" CornerRadius="10" Padding="12"
                                                                                                                                                      >
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE783;" Foreground="{ThemeResource WarningBrush}" FontSize="17" />
                                <TextBlock Text="No cloud account connected" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:ConnectionId='43' Content="Connect Google Drive" Style="{StaticResource AccentButtonStyle}"                                                 
                                                                                                        
                                                                                                                                                           />
                            <Button x:ConnectionId='44' Content="Disconnect"                                                                                                                         
                                                                                                                                                        />
                            <Button x:ConnectionId='45'                                                                 Style="{StaticResource AccentButtonStyle}"                                                                                                                   />
                            <Button x:ConnectionId='46' Content="View cloud backups"                                                                                                                      />
                        </StackPanel>
                        <StackPanel x:ConnectionId='26' Spacing="6"                                                                                                                        >
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Uploading backup to Google Drive..." FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Please wait" Style="{StaticResource PageSubtitleTextStyle}" />
                            </Grid>
                            <ProgressBar IsIndeterminate="True" Height="4" />
                            <TextBlock Text="Kirana remains available while the validated backup is uploaded."
                                       Style="{StaticResource PageSubtitleTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border x:ConnectionId='27' Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="12"
                                                                                                                                                   >
                            <StackPanel Spacing="10">
                                <Grid>
                                    <TextBlock Text="Cloud backups" FontWeight="SemiBold" />
                                    <TextBlock x:ConnectionId='42' HorizontalAlignment="Right"                                                            
                                               Style="{StaticResource PageSubtitleTextStyle}" />
                                </Grid>
                                <ProgressRing x:ConnectionId='34'                                                                    
                                              Width="28" Height="28" HorizontalAlignment="Center"
                                                                                                                                                                          />
                                <StackPanel x:ConnectionId='35' HorizontalAlignment="Center" Spacing="3"
                                                                                                                                                                >
                                    <FontIcon Glyph="&#xE753;" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="No cloud backups found." FontWeight="SemiBold" />
                                    <TextBlock Text="Create a backup, then refresh this list." Style="{StaticResource PageSubtitleTextStyle}" />
                                </StackPanel>
                                <ItemsControl x:ConnectionId='36'                                                           
                                                                                                                                                                >
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate                                            >
                                            <Grid x:ConnectionId='38' Padding="8" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock x:ConnectionId='40'                          FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:ConnectionId='41'                                Style="{StaticResource PageSubtitleTextStyle}" />
                                                </StackPanel>
                                                <TextBlock x:ConnectionId='39' Grid.Column="1"                          VerticalAlignment="Center"
                                                           Style="{StaticResource PageSubtitleTextStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <ToggleSwitch x:ConnectionId='28' Header="Enable automatic cloud backup"                                                                                                                     />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:ConnectionId='31' Header="Frequency" Width="160"                                                                                                                             />
                            <TextBox x:ConnectionId='32' Header="Time" Width="120"                                                        />
                            <TextBox x:ConnectionId='33' Header="Keep" Width="90"                                                                 />
                        </StackPanel>
                        <InfoBar x:ConnectionId='29'                                                                                                                    Severity="Error"                                                                   />
                        <InfoBar x:ConnectionId='30'                                                                                                                     Severity="Success"                                                                    />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Appearance" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Choose how Kirana looks. Light is the default; dark is easier on the eyes in a dim shop."
                                       Style="{StaticResource PageSubtitleTextStyle}" />
                        </StackPanel>

                        <RadioButtons x:ConnectionId='22' x:Name="ThemeChoice" SelectedIndex="0"                                        >
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                            <x:String>Use Windows setting</x:String>
                        </RadioButtons>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Dashboard Security" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Automatically lock the Dashboard and return to Billing after a period of inactivity."
                                       Style="{StaticResource PageSubtitleTextStyle}" />
                        </StackPanel>

                        <ComboBox x:ConnectionId='17' Header="Inactivity auto-lock"                                                 
                                                                                                       
                                                                                   HorizontalAlignment="Stretch" />

                        <TextBox x:ConnectionId='18' Header="Custom duration (minutes)"                                                         
                                                                                                                                                    
                                                                                  />

                        <Button x:ConnectionId='19' Content="Save" Style="{StaticResource AccentButtonStyle}"                                         
                                                                                 HorizontalAlignment="Left" />

                        <InfoBar x:ConnectionId='20'                                                                                                        
                                 Severity="Error"                                                        />
                        <InfoBar x:ConnectionId='21'                                                                                                         
                                 Severity="Success"                                                         />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Billing Authorization" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" TextWrapping="Wrap"
                                       Text="Owner-only. Turn off a manager PIN prompt for stores where the Owner runs billing alone — each change saves immediately." />
                        </StackPanel>

                        <ToggleSwitch x:ConnectionId='12' Header="Require PIN to change selling price at billing"
                                                                                                       
                                                                                       />

                        <ToggleSwitch x:ConnectionId='13' Header="Require PIN to approve large discounts at billing"
                                                                                                       
                                                                                       />

                        <ToggleSwitch x:ConnectionId='14' Header="Require PIN to reprint an invoice"
                                                                                                 
                                                                                       />

                        <InfoBar x:ConnectionId='15'                                                                                                                 
                                 Severity="Error"                                                                 />
                        <InfoBar x:ConnectionId='16'                                                                                                                  
                                 Severity="Success"                                                                  />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Backup &amp; Export" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" TextWrapping="Wrap"
                                       Text="Where backups are kept, how often they are taken automatically, and how many to keep. Each change saves immediately." />
                        </StackPanel>

                        <ToggleSwitch x:ConnectionId='2' Header="Take backups automatically"
                                                                                                   
                                                                                       />

                        <ComboBox x:ConnectionId='3' Header="Automatic backup frequency"                                                        
                                                                                                         
                                                                                   HorizontalAlignment="Stretch" />

                        <TextBox x:ConnectionId='4' Header="Backup folder" IsReadOnly="True"
                                                                                       
                                                                                                 />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:ConnectionId='10' Content="Choose folder…"                                  
                                                                                     />
                            <Button x:ConnectionId='11' Content="Use default"                                                           
                                                                                     />
                        </StackPanel>

                        <TextBox x:ConnectionId='5' Header="Backups to keep"
                                                                                                                                
                                                                                  />
                        <Button x:ConnectionId='6' Content="Save retention"                                                  
                                                                                 HorizontalAlignment="Left" />

                        <ComboBox x:ConnectionId='7' Header="Preferred export format"                                                     
                                                                                                    
                                                                                   HorizontalAlignment="Stretch" />

                        <InfoBar x:ConnectionId='8'                                                                                                                      
                                 Severity="Error"                                                                      />
                        <InfoBar x:ConnectionId='9'                                                                                                                       
                                 Severity="Success"                                                                       />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

