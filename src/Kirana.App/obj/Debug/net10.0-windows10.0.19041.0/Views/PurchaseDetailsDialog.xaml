<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.PurchaseDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    CloseButtonText="Close"
    DefaultButton="Close">

    <!-- ContentDialogMaxWidth/MinWidth theme resources, not Width/MaxWidth on the element itself,
         are what actually control a ContentDialog's rendered size (WinUI3 gotcha) — without this
         override the item table below clips at WinUI's ~548px default. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">720</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center">
                <Run Text="Purchase " /><Run x:ConnectionId='3'                                          />
            </TextBlock>
            <Button x:ConnectionId='2' Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                                             AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <ScrollViewer MaxHeight="600">
        <StackPanel Spacing="16" MinWidth="640">

            <!-- ============================== HEADER CARD ============================== -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="{StaticResource SpacingM}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{StaticResource RadiusPill}"
                            Background="{ThemeResource PastelVioletBrush}" VerticalAlignment="Center">
                        <TextBlock x:ConnectionId='33'                                           FontSize="15" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PastelVioletOnBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleTextStyle}">
                            <Run x:ConnectionId='31'                                        />
                            <Run x:ConnectionId='32'                                                     Foreground="{ThemeResource TextTertiaryBrush}" FontWeight="Normal" />
                        </TextBlock>
                        <TextBlock x:ConnectionId='27'                                    Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:ConnectionId='28' Style="{StaticResource CaptionTextStyle}"
                                                                                                                                                 >
                            <Run Text="Supplier Invoice #: " /><Run x:ConnectionId='30'                                                 />
                        </TextBlock>
                        <TextBlock x:ConnectionId='29'                                 Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                                                                                                                  />
                    </StackPanel>

                    <!-- Status badge — exactly one of the three is visible, same classification the
                         Purchases list row uses, so this can never disagree with it. -->
                    <Border x:ConnectionId='24' Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Top"
                            Background="{ThemeResource SuccessSubtleBrush}"
                                                                                                                        >
                        <TextBlock Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource SuccessBrush}">
                            <Run Text="&#x1F7E2;" /><Run Text=" Paid" />
                        </TextBlock>
                    </Border>
                    <Border x:ConnectionId='25' Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Top"
                            Background="{ThemeResource WarningSubtleBrush}"
                                                                                                                                 >
                        <TextBlock Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource WarningBrush}">
                            <Run Text="&#x1F7E1;" /><Run Text=" Partially Paid" />
                        </TextBlock>
                    </Border>
                    <Border x:ConnectionId='26' Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Top"
                            Background="{ThemeResource DangerSubtleBrush}"
                                                                                                                                    >
                        <TextBlock Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource DangerBrush}">
                            <Run Text="&#x1F534;" /><Run Text=" Outstanding" />
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================== ITEMS TABLE ============================== -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="14,10" ColumnSpacing="12"
                          Background="{ThemeResource SurfaceAltBrush}"
                          CornerRadius="12,12,0,0"
                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PRODUCT" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="QTY" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="PRICE" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="TOTAL" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                    </Grid>

                    <ItemsControl x:ConnectionId='13' Grid.Row="1"                                       >
                        <ItemsControl.ItemTemplate>
                            <DataTemplate                                             >
                                <Grid x:ConnectionId='15' Padding="14,10" ColumnSpacing="12"
                                      BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:ConnectionId='20'                             Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:ConnectionId='21'                             Style="{StaticResource CodeTextStyle}" />
                                            <TextBlock x:ConnectionId='22' Style="{StaticResource CaptionTextStyle}"
                                                                                                                                           >
                                                <Run Text="Batch: " /><Run x:ConnectionId='23'                             />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:ConnectionId='18'                              Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" />
                                        <TextBlock x:ConnectionId='19'                          Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock x:ConnectionId='16' Grid.Column="2"                                                                        
                                               Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <TextBlock x:ConnectionId='17' Grid.Column="3"                                                                        
                                               Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- ============================== TOTALS ============================== -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Subtotal" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:ConnectionId='12' Grid.Column="1"                                                                                  Style="{StaticResource BodyTextStyle}" />
                    </Grid>
                    <Grid x:ConnectionId='4' ColumnSpacing="8"                                                                                                  >
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Discount" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:ConnectionId='11' Grid.Column="1"                                                                                       Style="{StaticResource BodyTextStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="GST" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:ConnectionId='10' Grid.Column="1"                                                                                  Style="{StaticResource BodyTextStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Round Off" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:ConnectionId='9' Grid.Column="1"                                                                                        Style="{StaticResource BodyTextStyle}" />
                    </Grid>

                    <Border BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,4" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="GRAND TOTAL" Style="{StaticResource ColumnHeaderTextStyle}" VerticalAlignment="Center" />
                        <TextBlock x:ConnectionId='8' Grid.Column="1"                                                                                   
                                   Style="{StaticResource MetricTextStyle}" FontSize="24" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Amount Paid" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:ConnectionId='7' Grid.Column="1"                                                                                    Style="{StaticResource BodyTextStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Outstanding" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:ConnectionId='5' Grid.Column="1"                                                                                          
                                   Style="{StaticResource AmountTextStyle}" Foreground="{ThemeResource DangerBrush}"
                                                                                                                                        />
                        <TextBlock x:ConnectionId='6' Grid.Column="1" Text="—" Style="{StaticResource SecondaryTextStyle}"
                                                                                                                                               />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

