<Page
    x:Class="Kirana.App.Views.ExpenseDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock x:ConnectionId='12' x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:ConnectionId='13' x:Name="SubtitleText" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <Button x:ConnectionId='11' Grid.Column="1"                      VerticalAlignment="Center" AutomationProperties.Name="Print Voucher">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE749;" FontSize="14" />
                    <TextBlock Text="Print Voucher" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,0,24,24" Spacing="16" MaxWidth="640" HorizontalAlignment="Left">
                <InfoBar x:ConnectionId='2' x:Name="ErrorBar" IsOpen="False" Severity="Error" />

                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="14">
                        <StackPanel>
                            <TextBlock Text="Amount" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock x:ConnectionId='10' x:Name="AmountText" Style="{StaticResource MetricTextStyle}"
                                       Foreground="{ThemeResource WarningBrush}" />
                        </StackPanel>

                        <Grid ColumnSpacing="32" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Category" Style="{StaticResource MetricLabelTextStyle}" />
                                <TextBlock x:ConnectionId='9' x:Name="CategoryText" Style="{StaticResource CardTitleTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="Date" Style="{StaticResource MetricLabelTextStyle}" />
                                <TextBlock x:ConnectionId='8' x:Name="DateText" Style="{StaticResource CardTitleTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Paid by" Style="{StaticResource MetricLabelTextStyle}" />
                                <TextBlock x:ConnectionId='7' x:Name="MethodText" Style="{StaticResource CardTitleTextStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Reference" Style="{StaticResource MetricLabelTextStyle}" />
                                <TextBlock x:ConnectionId='6' x:Name="ReferenceText" Style="{StaticResource BodyTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                                <TextBlock Text="Recorded by" Style="{StaticResource MetricLabelTextStyle}" />
                                <TextBlock x:ConnectionId='5' x:Name="RecordedByText" Style="{StaticResource BodyTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock x:ConnectionId='3' x:Name="DescriptionText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:ConnectionId='4' x:Name="NotesText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

