<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.ProductImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    CloseButtonText="Close"
                                                                         
                                                                      
                                             
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1320</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">980</x:Double>
        <SolidColorBrush x:Key="PreviewTableHeaderBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="PreviewTableBorderBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="PreviewTableTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="PreviewTableSecondaryBrush" Color="#6B7280" />
        <Style x:Key="PreviewFixButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0F766E" /><Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0F766E" /><Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="PreviewRemoveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#374151" />
            <Setter Property="BorderBrush" Value="#D1D5DB" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" /><Setter Property="CornerRadius" Value="6" />
        </Style>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Import Products" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Review every change before products are saved." Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <Button x:ConnectionId='2' Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                                             AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <ScrollViewer MaxHeight="680" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <!-- Wizard progress is textual as well as visual, so it works with keyboard and screen-reader navigation. -->
            <Grid ColumnSpacing="8" AutomationProperties.Name="Import progress: select file, preview and validation, import, results">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource PastelTealBrush}"><TextBlock Text="1  SELECT FILE" Foreground="{ThemeResource PastelTealOnBrush}" Style="{StaticResource BadgeTextStyle}" /></Border>
                <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource PastelBlueBrush}"><TextBlock Text="2  PREVIEW &amp; VALIDATION" Foreground="{ThemeResource PastelBlueOnBrush}" Style="{StaticResource BadgeTextStyle}" /></Border>
                <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource PastelAmberBrush}"><TextBlock Text="3  IMPORT" Foreground="{ThemeResource PastelAmberOnBrush}" Style="{StaticResource BadgeTextStyle}" /></Border>
                <Border Grid.Column="3" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource PastelGreenBrush}"><TextBlock Text="4  RESULTS" Foreground="{ThemeResource PastelGreenOnBrush}" Style="{StaticResource BadgeTextStyle}" /></Border>
            </Grid>

            <Border x:ConnectionId='3' Style="{StaticResource ElevatedCardStyle}" Padding="16" AllowDrop="True"                                            
                    AutomationProperties.Name="Drop a CSV or XLSX product file here, or choose a file">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource PastelBlueBrush}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" Foreground="{ThemeResource PastelBlueOnBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="Drop your product file here" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock Text="CSV or XLSX · drag and drop, or browse your computer" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:ConnectionId='54'                                                            Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:ConnectionId='52'                                 AutomationProperties.Name="Download CSV sample template"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE896;" /><TextBlock Text="Sample template" /></StackPanel></Button>
                        <Button x:ConnectionId='53'                           Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Choose product import file"><TextBlock Text="Choose file" /></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel x:ConnectionId='4' Spacing="6"                                                                                                          >
                <TextBlock Text="Importing products..." Style="{StaticResource SecondaryTextStyle}" />
                <ProgressBar IsIndeterminate="True" Height="4" />
            </StackPanel>
            <InfoBar x:ConnectionId='5'                                                                                                         Severity="Error"                                                        />

            <Border x:ConnectionId='6' Style="{StaticResource CardBorderStyle}"                                                                                                           >
                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3"><TextBlock Text="Selected file" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:ConnectionId='51'                                                 Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="File size" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:ConnectionId='50'                                                     Style="{StaticResource BodyTextStyle}" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="Rows found" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:ConnectionId='49'                                                 Style="{StaticResource BodyTextStyle}" /></StackPanel>
                    <StackPanel Grid.Column="3" Spacing="3"><TextBlock Text="Import readiness" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:ConnectionId='48'                                                            Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" /></StackPanel>
                </Grid>
            </Border>

            <StackPanel x:ConnectionId='7' Spacing="12"                                                                                                              >
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2"><TextBlock Text="Preview &amp; validation" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock Text="Review rows below. Errors are skipped by the existing import rules until you fix them." Style="{StaticResource SecondaryTextStyle}" /></StackPanel>
                    <TextBlock x:ConnectionId='47' Grid.Column="1"                                                    Style="{StaticResource CardTitleTextStyle}" VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelGreenBrush}" BorderBrush="{ThemeResource PastelGreenBrush}"><StackPanel><TextBlock Text="NEW PRODUCTS" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}" /><TextBlock x:ConnectionId='46'                                                 Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}" /></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}"><StackPanel><TextBlock Text="EXISTING TO UPDATE" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" /><TextBlock x:ConnectionId='45'                                                    Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" /></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelVioletBrush}" BorderBrush="{ThemeResource PastelVioletBrush}"><StackPanel><TextBlock Text="DUPLICATE PRODUCTS" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" /><TextBlock x:ConnectionId='44'                                                    Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" /></StackPanel></Border>
                    <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelRoseBrush}" BorderBrush="{ThemeResource PastelRoseBrush}"><StackPanel><TextBlock Text="ROWS WITH ERRORS" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" /><TextBlock x:ConnectionId='43'                                                   Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" /></StackPanel></Border>
                </Grid>
                <Border x:ConnectionId='22' Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12"
                                                                                                                                              >
                    <StackPanel Spacing="6"><TextBlock Text="New reference data" Foreground="#1D4ED8" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock x:ConnectionId='42'                                                             Foreground="#475569" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                                                                                 />
                    </StackPanel>
                </Border>
                <TextBlock x:ConnectionId='23'                                                             Foreground="{ThemeResource WarningBrush}" Style="{StaticResource SecondaryTextStyle}"                                                                                                                     />

                <Border Background="White" BorderBrush="{StaticResource PreviewTableBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="360" /></Grid.RowDefinitions>
                        <!-- The header lives outside the ListView, so it remains visible while a large preview scrolls. -->
                        <Grid Grid.Row="0" Padding="18,12" Background="{StaticResource PreviewTableHeaderBrush}" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="150" /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="ROW" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="1" Text="PRODUCT NAME" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="2" Text="PRODUCT CODE" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="3" Text="BARCODE" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="4" Text="SELLING PRICE" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="6" Text="VALIDATION / ERROR" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="7" Text="ACTIONS" Style="{StaticResource ColumnHeaderTextStyle}" />
                        </Grid>
                        <ListView x:ConnectionId='24' Grid.Row="1"                                       SelectionMode="None"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="MinHeight" Value="66" /></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate                                          >
                            <Border x:ConnectionId='26' Padding="18,13" BorderBrush="#FECACA"                                                                                                                                                                                                                             ><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="150" /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:ConnectionId='27'                           Foreground="{StaticResource PreviewTableSecondaryBrush}" Style="{StaticResource CodeTextStyle}" VerticalAlignment="Center" /><TextBlock x:ConnectionId='28' Grid.Column="1"                      Foreground="{StaticResource PreviewTableTextBrush}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center" /><TextBlock x:ConnectionId='29' Grid.Column="2"                             Foreground="{StaticResource PreviewTableSecondaryBrush}" Style="{StaticResource CodeTextStyle}" VerticalAlignment="Center" /><TextBlock x:ConnectionId='30' Grid.Column="3"                         Foreground="{StaticResource PreviewTableSecondaryBrush}" Style="{StaticResource CodeTextStyle}" VerticalAlignment="Center" /><TextBlock x:ConnectionId='31' Grid.Column="4"                              Foreground="{StaticResource PreviewTableTextBrush}" Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center" />
                                <Border x:ConnectionId='32' Grid.Column="5" Background="#DCFCE7" CornerRadius="999" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center"                                                                                  ><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#15803D" /><TextBlock Text="Ready" Foreground="#15803D" FontSize="12" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border x:ConnectionId='33' Grid.Column="5" Background="#FEF3C7" CornerRadius="999" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center"                                                                                     ><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE777;" FontSize="12" Foreground="#B45309" /><TextBlock Text="Update" Foreground="#B45309" FontSize="12" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border x:ConnectionId='34' Grid.Column="5" Background="#FEE2E2" CornerRadius="999" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center"                                                                                    ><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xEA39;" FontSize="12" Foreground="#DC2626" /><TextBlock Text="Error" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" /></StackPanel></Border>
                                <StackPanel x:ConnectionId='35' Grid.Column="6" Spacing="3" VerticalAlignment="Center"                                                                                    ><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="#EA580C" /><TextBlock Text="Needs review" Foreground="#9A3412" FontWeight="SemiBold" FontSize="12" /></StackPanel><TextBlock x:ConnectionId='41'                              Foreground="#9A3412" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"                                                /></StackPanel><TextBlock x:ConnectionId='36' Grid.Column="6" Text="Validated and ready to import" Foreground="{StaticResource PreviewTableSecondaryBrush}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"                                                                                            />
                                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button x:ConnectionId='37' Content="Fix"                                      Style="{StaticResource PreviewFixButtonStyle}"                                                                                     /><Button x:ConnectionId='38' Content="As new"                                           Style="{StaticResource PreviewRemoveButtonStyle}"                                                                                                   /><Button x:ConnectionId='39' Content="Remove"                                         Style="{StaticResource PreviewRemoveButtonStyle}"                                                                                         /><Button x:ConnectionId='40' Content="Undo"                                          Style="{StaticResource PreviewRemoveButtonStyle}"                                                                                       /></StackPanel>
                            </Grid></Border>
                        </DataTemplate></ListView.ItemTemplate></ListView>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel x:ConnectionId='8' Spacing="12"                                                                                                              >
                <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE73E;" FontSize="28" Foreground="#15803D" /><StackPanel><TextBlock Text="Import completed successfully" FontSize="17" FontWeight="SemiBold" Foreground="#166534" /><TextBlock x:ConnectionId='21'                                                       Foreground="#166534" TextWrapping="Wrap" /></StackPanel></StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="16"><Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="IMPORTED" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:ConnectionId='20'                                                     Style="{StaticResource MetricTextStyle}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="UPDATED" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:ConnectionId='19'                                                     Style="{StaticResource MetricTextStyle}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="SKIPPED" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:ConnectionId='18'                                                     Style="{StaticResource MetricTextStyle}" /></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="FAILED" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="0" Style="{StaticResource MetricTextStyle}" /></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="NEW CATEGORIES" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:ConnectionId='17'                                                          Style="{StaticResource MetricTextStyle}" /></StackPanel><StackPanel Grid.Column="5"><TextBlock Text="NEW BRANDS" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:ConnectionId='16'                                                      Style="{StaticResource MetricTextStyle}" /></StackPanel><StackPanel Grid.Column="6"><TextBlock Text="TIME TAKEN" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:ConnectionId='15'                                                    Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" /></StackPanel>
                </Grid></Border>
                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="✓ Successfully imported" Foreground="#166534" FontWeight="SemiBold" /><TextBlock x:ConnectionId='13'                                                       Foreground="#166534" Style="{StaticResource CaptionTextStyle}" /><TextBlock x:ConnectionId='14'                                                      Foreground="#166534" Style="{StaticResource CaptionTextStyle}" /></StackPanel></Border>
                <InfoBar x:ConnectionId='9'                                                         Severity="Warning" IsClosable="False" Title="Some rows were skipped" Message="Review the highlighted rows in the preview before importing another file." />
                <StackPanel Orientation="Horizontal" Spacing="8"><Button x:ConnectionId='10' Content="View Products"                             Style="{StaticResource AccentButtonStyle}" /><Button x:ConnectionId='11' Content="Import Another File"                                  /><Button x:ConnectionId='12' Content="Close"                          /></StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

