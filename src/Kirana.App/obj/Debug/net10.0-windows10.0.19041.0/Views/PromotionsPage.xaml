<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.PromotionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">
    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <StackPanel><TextBlock Text="Promotions &amp; Offers" Style="{StaticResource PageTitleTextStyle}" /><TextBlock Text="Schedule reusable offers across the store, categories, brands and products." Style="{StaticResource PageSubtitleTextStyle}" /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Import (coming later)" IsEnabled="False" ToolTipService.ToolTip="Promotion import is reserved for a future phase." />
                <Button x:ConnectionId='30' Content="Create Promotion" Style="{StaticResource AccentButtonStyle}"                                                                />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,0,24,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelBlueBrush}" BorderBrush="{ThemeResource PastelBlueBrush}"><StackPanel><TextBlock Text="TOTAL" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='29'                                                  Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelGreenBrush}" BorderBrush="{ThemeResource PastelGreenBrush}"><StackPanel><TextBlock Text="RUNNING" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='28'                                                    Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelVioletBrush}" BorderBrush="{ThemeResource PastelVioletBrush}"><StackPanel><TextBlock Text="UPCOMING" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='27'                                                     Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}"><StackPanel><TextBlock Text="EXPIRED" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='26'                                                    Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelRoseBrush}" BorderBrush="{ThemeResource PastelRoseBrush}"><StackPanel><TextBlock Text="DISABLED" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='25'                                                     Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
        </Grid>

        <Grid Grid.Row="2" Padding="{StaticResource ToolbarPadding}" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="160" /><ColumnDefinition Width="160" /><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:ConnectionId='19' Grid.Column="0" PlaceholderText="Search name, code, target…"                                                                             />
            <ComboBox x:ConnectionId='20' Grid.Column="1"                                                                                                              HorizontalAlignment="Stretch" />
            <ComboBox x:ConnectionId='21' Grid.Column="2"                                                                                                            HorizontalAlignment="Stretch" />
            <ComboBox x:ConnectionId='22' Grid.Column="3"                                                                                                          HorizontalAlignment="Stretch" />
            <CheckBox x:ConnectionId='23' Grid.Column="4" Content="Running only"                                                         VerticalAlignment="Center" />
            <Button x:ConnectionId='24' Grid.Column="6" Content="Apply filters"                       />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0" Margin="24,0,24,24">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="14,10" Background="{ThemeResource SurfaceAltBrush}" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="100" /><ColumnDefinition Width="70" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PROMOTION" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="1" Text="TYPE" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="2" Text="SCOPE" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="3" Text="DISCOUNT" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="4" Text="START" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="5" Text="END" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="6" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="7" Text="PRIORITY" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="8" Text="ACTIONS" Style="{StaticResource ColumnHeaderTextStyle}" />
                </Grid>
                <ListView x:ConnectionId='2' Grid.Row="1"                                             SelectionMode="None">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="MinHeight" Value="0" /></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate><DataTemplate                                      ><Grid x:ConnectionId='6' Padding="14,12" ColumnSpacing="12" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="100" /><ColumnDefinition Width="70" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:ConnectionId='17'                      FontWeight="SemiBold" /><TextBlock x:ConnectionId='18'                      Style="{StaticResource CodeTextStyle}" /></StackPanel><TextBlock x:ConnectionId='7' Grid.Column="1"                      Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" /><Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource BrandSubtleBrush}"><TextBlock x:ConnectionId='16'                       Style="{StaticResource BadgeTextStyle}" /></Border><TextBlock x:ConnectionId='8' Grid.Column="3"                          FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock x:ConnectionId='9' Grid.Column="4"                       Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" /><TextBlock x:ConnectionId='10' Grid.Column="5"                     Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" /><Border Grid.Column="6" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource PastelGreenBrush}"><TextBlock x:ConnectionId='15'                        Style="{StaticResource BadgeTextStyle}" /></Border><TextBlock x:ConnectionId='11' Grid.Column="7"                          HorizontalAlignment="Center" VerticalAlignment="Center" /><StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6"><Button x:ConnectionId='12' Content="Edit"                                    /><Button x:ConnectionId='13'                                                                    /><Button x:ConnectionId='14' Content="Delete"                                      /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <InfoBar x:ConnectionId='3'                                                                                                         Severity="Error"                                                        VerticalAlignment="Top" />
                <ProgressRing x:ConnectionId='4'                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>

