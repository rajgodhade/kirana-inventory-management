<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.ReprintInvoiceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="View &amp; Print"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Reprint Invoice" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:ConnectionId='2' Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                                             AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <StackPanel Spacing="10" MinWidth="380">

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:ConnectionId='6' Grid.Column="0" PlaceholderText="Invoice number, e.g. INV-2026-000001"
                                                                                                               />
            <Button x:ConnectionId='7' Grid.Column="1" Content="Search"                       />
        </Grid>

        <InfoBar x:ConnectionId='3'                                                                                                        
                 Severity="Error"                                                        />

        <Border x:ConnectionId='4'                                                                                                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Padding="12">
            <TextBlock x:ConnectionId='5'                                                      TextWrapping="Wrap" />
        </Border>

        <TextBlock Text="Reprinting requires manager/owner authorization." Opacity="0.7" FontSize="12" />
    </StackPanel>
</ContentDialog>

