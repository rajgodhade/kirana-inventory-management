<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.CustomerEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:ConnectionId='2' x:Name="DialogTitleText" Grid.Column="0" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:ConnectionId='3' Grid.Column="1" Padding="6" Background="Transparent" BorderThickness="0"
                                             AutomationProperties.Name="Close">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <ScrollViewer MaxHeight="460">
        <StackPanel Spacing="10" MinWidth="380">
            <TextBlock x:ConnectionId='4'                                        FontSize="12" Opacity="0.6"
                                                                                                                             />

            <TextBox x:ConnectionId='5' Header="Name *"                                                                                  />
            <TextBox x:ConnectionId='6' Header="Phone"                                                                                   />
            <TextBox x:ConnectionId='7' Header="Address"                                                                                    
                     AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
            <TextBox x:ConnectionId='8' Header="GSTIN (optional)"                                                                                   />
            <TextBox x:ConnectionId='9' Header="Notes"                                                                                  
                     AcceptsReturn="True" TextWrapping="Wrap" Height="70" />

            <InfoBar x:ConnectionId='10'                                                                                                        
                     Severity="Error"                                                        />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

