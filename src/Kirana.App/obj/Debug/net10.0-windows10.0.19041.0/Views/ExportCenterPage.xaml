<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.ExportCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="{StaticResource PageHeaderPadding}" Spacing="2">
            <TextBlock Text="Export Center" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Save a full copy of any data set as CSV or Excel. You can only export data you are allowed to see elsewhere in Kirana."
                       Style="{StaticResource PageSubtitleTextStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Padding="{StaticResource ToolbarPadding}" Spacing="8">
            <ProgressBar x:ConnectionId='12' IsIndeterminate="True"
                                                                                                                                   />
            <InfoBar x:ConnectionId='13'                                                                                                        
                     Severity="Error"                                                        IsClosable="False" />
            <InfoBar x:ConnectionId='14'                                                                                                         
                     Severity="Success"                                                         IsClosable="False" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,0,24,24" Spacing="12">

                <TextBlock x:ConnectionId='2' Style="{StaticResource SecondaryTextStyle}"
                           Text="Your role does not allow exporting any data set."
                                                                                                                               />

                <ItemsControl x:ConnectionId='3'                                          >
                    <ItemsControl.ItemTemplate>
                        <DataTemplate                                       >
                            <Border x:ConnectionId='7' Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}" Margin="0,0,0,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:ConnectionId='10'                       Style="{StaticResource CardTitleTextStyle}" />
                                        <TextBlock x:ConnectionId='11'                             Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:ConnectionId='8' Content="CSV"                                        
                                                AutomationProperties.Name="Export as CSV" />
                                        <Button x:ConnectionId='9' Content="Excel"                                          
                                                Style="{StaticResource AccentButtonStyle}"
                                                AutomationProperties.Name="Export as Excel" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Reports already export to CSV, Excel and PDF from their own screens, each with
                     its own date filter — sending the user there beats duplicating that here. -->
                <Border x:ConnectionId='4' Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}"
                        Background="{ThemeResource SurfaceAltBrush}"
                                                                                                                            >
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Reports" Style="{StaticResource CardTitleTextStyle}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                       Text="Sales, GST, inventory, profit and expense reports export to CSV, Excel and PDF from the Reports screen, where you can also set a date range." />
                        </StackPanel>

                        <Button x:ConnectionId='5' Grid.Column="1" Content="Go to Reports"                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

