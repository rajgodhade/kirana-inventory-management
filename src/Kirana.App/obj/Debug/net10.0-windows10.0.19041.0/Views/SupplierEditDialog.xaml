<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.SupplierEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:ConnectionId='2' x:Name="DialogTitleText" Grid.Column="0" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:ConnectionId='3' Grid.Column="1" Padding="6" Background="Transparent" BorderThickness="0"
                                             AutomationProperties.Name="Close">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <ScrollViewer MaxHeight="480">
        <StackPanel Spacing="10" MinWidth="380">
            <TextBox x:ConnectionId='4' Header="Business / Name"                                             />
            <TextBox x:ConnectionId='5' Header="GSTIN"                                              />
            <TextBox x:ConnectionId='6' Header="Contact Person"                                                      />
            <TextBox x:ConnectionId='7' Header="Phone"                                              />
            <TextBox x:ConnectionId='8' Header="Email"                                              />
            <TextBox x:ConnectionId='9' Header="Address"                                                AcceptsReturn="True" TextWrapping="Wrap" Height="60" />

            <InfoBar x:ConnectionId='10'                                                                                                        
                     Severity="Error"                                                        />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

