<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.SupplierEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ScrollViewer MaxHeight="480">
        <StackPanel Spacing="10" MinWidth="380">
            <TextBox x:ConnectionId='2' Header="Business / Name"                                             />
            <TextBox x:ConnectionId='3' Header="GSTIN"                                              />
            <TextBox x:ConnectionId='4' Header="Contact Person"                                                      />
            <TextBox x:ConnectionId='5' Header="Phone"                                              />
            <TextBox x:ConnectionId='6' Header="Email"                                              />
            <TextBox x:ConnectionId='7' Header="Address"                                                AcceptsReturn="True" TextWrapping="Wrap" Height="60" />

            <InfoBar x:ConnectionId='8'                                                                                                        
                     Severity="Error"                                                        />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

