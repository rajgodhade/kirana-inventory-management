<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.UserEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:ConnectionId='2' x:Name="DialogTitleText" Grid.Column="0" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:ConnectionId='3' Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                                             AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <StackPanel Spacing="10" MinWidth="360">

        <TextBox x:ConnectionId='4' Header="Username"                                                
                                                                                                                         />

        <TextBox x:ConnectionId='5' Header="Full Name"                                                 />

        <ComboBox x:ConnectionId='6' Header="Role"                                        DisplayMemberPath="Name"
                                                                              />

        <PasswordBox x:ConnectionId='7' Header="Password"                                                    
                                                                                                                                          />

        <PasswordBox x:ConnectionId='8' Header="PIN (optional, 4-6 digits)"                                               
                                                                                                                                          />

        <InfoBar x:ConnectionId='9'                                                                                                        
                 Severity="Error"                                                        />
    </StackPanel>
</ContentDialog>

