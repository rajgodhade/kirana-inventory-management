<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.UserEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="360">

        <TextBox x:ConnectionId='2' Header="Username"                                                
                                                                                                                         />

        <TextBox x:ConnectionId='3' Header="Full Name"                                                 />

        <ComboBox x:ConnectionId='4' Header="Role"                                        DisplayMemberPath="Name"
                                                                              />

        <PasswordBox x:ConnectionId='5' Header="Password"                                                    
                                                                                                                                          />

        <PasswordBox x:ConnectionId='6' Header="PIN (optional, 4-6 digits)"                                               
                                                                                                                                          />

        <InfoBar x:ConnectionId='7'                                                                                                        
                 Severity="Error"                                                        />
    </StackPanel>
</ContentDialog>

