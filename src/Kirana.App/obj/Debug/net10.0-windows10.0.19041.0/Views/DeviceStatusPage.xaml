<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.DeviceStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Padding="{StaticResource PageHeaderPadding}">
            <StackPanel><TextBlock Text="Device Status" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Live Windows device discovery with honest status and last-seen information." Style="{StaticResource PageSubtitleTextStyle}" /></StackPanel>
            <Button x:ConnectionId='14' Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Center"                        />
        </Grid>
        <InfoBar x:ConnectionId='2' Grid.Row="1" Margin="24,0,24,12"                                                                                                        
                 Severity="Warning"                                                        />
        <ListView x:ConnectionId='3' Grid.Row="2" Margin="24,0,24,24"                                          SelectionMode="None">
            <ListView.ItemTemplate><DataTemplate                                         >
                <Border x:ConnectionId='5' Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,8">
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock x:ConnectionId='12'                      FontWeight="SemiBold" FontSize="16" /><TextBlock x:ConnectionId='13'                             Foreground="{ThemeResource BrandPrimaryBrush}" FontWeight="SemiBold" /></StackPanel><TextBlock x:ConnectionId='11'                                   Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="TYPE / CONNECTION" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock><Run x:ConnectionId='9'                      /><Run Text=" · " /><Run x:ConnectionId='10'                            /></TextBlock></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="LAST SEEN" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock x:ConnectionId='8'                              /></StackPanel>
                        <Border x:ConnectionId='6' Grid.Column="3"                                                                                            CornerRadius="12" Padding="10,5"><TextBlock x:ConnectionId='7'                            FontWeight="SemiBold"                                                                                            /></Border>
                    </Grid>
                </Border>
            </DataTemplate></ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

