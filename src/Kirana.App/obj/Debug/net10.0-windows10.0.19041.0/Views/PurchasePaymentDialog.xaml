<ContentDialog
    x:Class="Kirana.App.Views.PurchasePaymentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Record Payment" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:ConnectionId='2' Grid.Column="1" Padding="6" Background="Transparent" BorderThickness="0"
                                             AutomationProperties.Name="Close">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <StackPanel Spacing="10" MinWidth="360">
        <TextBox x:ConnectionId='3' x:Name="AmountBox" Header="Amount" PlaceholderText="0.00" />

        <ComboBox x:ConnectionId='4' x:Name="MethodBox" Header="Payment Method" SelectedIndex="0">
            <ComboBoxItem Content="Cash" Tag="Cash" />
            <ComboBoxItem Content="UPI" Tag="Upi" />
            <ComboBoxItem Content="Card" Tag="Card" />
        </ComboBox>

        <TextBox x:ConnectionId='5' x:Name="ReferenceBox" Header="Reference # (optional)" />

        <InfoBar x:ConnectionId='6' x:Name="ErrorBar" IsOpen="False" Severity="Error" />
    </StackPanel>
</ContentDialog>

