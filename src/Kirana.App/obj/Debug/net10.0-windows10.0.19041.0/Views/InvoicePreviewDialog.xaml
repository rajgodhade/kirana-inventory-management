<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.InvoicePreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Print"
    CloseButtonText="Close"
    DefaultButton="Primary">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1080</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <Grid x:ConnectionId='2' ColumnSpacing="8"                                                           >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Invoice Preview" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:ConnectionId='3' Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                                             AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <StackPanel x:ConnectionId='4' Spacing="10"                                                           >
        <ComboBox x:ConnectionId='5' Header="Print format"                                                  
                                                                               
                  HorizontalAlignment="Left" MinWidth="175" />

        <InfoBar x:ConnectionId='6'                                                                                                        
                 Severity="Error"                                                        />
        <InfoBar x:ConnectionId='7'                                                                                                         
                 Severity="Success"                                                         />

        <ScrollViewer x:ConnectionId='8'                                                             
                                                                                          
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalContentAlignment="Center">
            <Border Background="#FF252525" Padding="12" CornerRadius="4">
                <ContentControl x:ConnectionId='10'                                                         
                                HorizontalContentAlignment="Center" />
            </Border>
        </ScrollViewer>

        <ProgressRing x:ConnectionId='9'                                                       HorizontalAlignment="Center" />
    </StackPanel>
</ContentDialog>

