<ContentDialog x:ConnectionId='1'
    x:Class="Kirana.App.Views.InvoicePreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Print"
    CloseButtonText="Close"
    DefaultButton="Primary">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1080</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <Grid x:ConnectionId='2' ColumnSpacing="8"                                                           >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Invoice Preview" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button x:ConnectionId='3' Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                                             AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <StackPanel x:ConnectionId='4' Spacing="10"                                                           >

        <ComboBox x:ConnectionId='5' Header="Format"                                                  
                                                                                />

        <InfoBar x:ConnectionId='6'                                                                                                        
                 Severity="Error"                                                        />
        <InfoBar x:ConnectionId='7'                                                                                                         
                 Severity="Success"                                                         />

        <!-- Scrolling itself already worked here (confirmed via UIA ScrollPattern — a 22-line bill
             correctly reported VerticallyScrollable=True and scrolled on request). The real gap was
             discoverability: WinUI's default "Auto" scrollbar is a thin, auto-hiding sliver that's
             easy to miss on a bill that's cut off mid-list, especially for someone who isn't
             already expecting a preview to scroll. VerticalScrollBarVisibility="Visible" keeps the
             track permanently on-screen instead of only appearing on hover/drag. -->
        <ScrollViewer x:ConnectionId='8'                                                             
                                                                                          
                      VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto"
                      Background="{ThemeResource LayerFillColorDefaultBrush}">
            <ContentControl x:ConnectionId='10'                                                          HorizontalContentAlignment="Center" />
        </ScrollViewer>

        <ProgressRing x:ConnectionId='9'                                                       HorizontalAlignment="Center" />
    </StackPanel>
</ContentDialog>

