<Page x:ConnectionId='1'
    x:Class="Kirana.App.Views.BarcodeScanTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <StackPanel Spacing="2">
                <TextBlock Text="Barcode Scan" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Test a scanner and check which product a barcode resolves to." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <!-- Scan input -->
        <StackPanel Grid.Row="1" Padding="20,16" Spacing="6">
            <TextBlock Text="Scan a product barcode with a USB scanner, or type it and press Enter."
                       Opacity="0.7" />
            <TextBox x:ConnectionId='13' x:Name="ScanInputBox" PlaceholderText="Click here, then scan…"
                     FontSize="18"                                                             />
        </StackPanel>

        <!-- Result -->
        <StackPanel Grid.Row="2" Padding="20" Spacing="12">
            <TextBlock x:ConnectionId='2'                                                      FontSize="16" />
            <TextBlock Opacity="0.6" FontSize="12">
                <Run Text="Last scanned value: " /><Run x:ConnectionId='12'                                                           />
            </TextBlock>

            <Border x:ConnectionId='3'                                                                                                                
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20" MaxWidth="480" HorizontalAlignment="Left">
                <StackPanel Spacing="6">
                    <TextBlock x:ConnectionId='5'                                                          FontSize="20" FontWeight="SemiBold" />
                    <TextBlock FontSize="13" Opacity="0.7">
                        <Run x:ConnectionId='10'                                                                 />
                        <Run Text=" · SKU: " /><Run x:ConnectionId='11'                                                         />
                    </TextBlock>
                    <TextBlock FontSize="13">
                        <Run Text="Barcode: " /><Run x:ConnectionId='9'                                                             />
                    </TextBlock>
                    <TextBlock FontSize="16" FontWeight="SemiBold">
                        <Run Text="Selling price: " /><Run x:ConnectionId='8'                                                                                                                />
                    </TextBlock>
                    <TextBlock FontSize="13">
                        <Run Text="MRP: " /><Run x:ConnectionId='7'                                                                                                       />
                    </TextBlock>
                    <TextBlock FontSize="13">
                        <Run Text="Current stock: " /><Run x:ConnectionId='6'                                                                              />
                    </TextBlock>
                </StackPanel>
            </Border>

            <InfoBar x:ConnectionId='4'                                                       Severity="Warning"
                     Title="Not found" Message="No active product matches that barcode." MaxWidth="480" HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</Page>

