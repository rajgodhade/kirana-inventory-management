<Window
    x:Class="Kirana.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ThemeRoot exists so the theme can be switched at runtime: RequestedTheme is set on this
        element, because a Window has no RequestedTheme of its own and Application.RequestedTheme
        can only be set during startup. Everything themed must live inside it.
    -->
    <Grid x:Name="ThemeRoot" Background="{ThemeResource PageBackgroundBrush}">
        <Frame x:Name="RootFrame" />
    </Grid>
</Window>
