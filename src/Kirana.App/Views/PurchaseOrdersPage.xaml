<Page x:Class="Kirana.App.Views.PurchaseOrdersPage" x:Name="RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:Kirana.App.ViewModels">
    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Purchase Orders" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="Plan supplier orders without receiving stock or creating payables." Style="{StaticResource PageSubtitleTextStyle}"/></StackPanel>
            <Button Grid.Column="1" Content="New Purchase Order" Style="{StaticResource AccentButtonStyle}" Click="OnNewClick"/>
        </Grid>
        <Grid Grid.Row="1" Margin="24,0,24,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelBlueBrush}" BorderBrush="{ThemeResource PastelBlueBrush}"><StackPanel><TextBlock Text="TOTAL ORDERS" Style="{StaticResource KpiLabelTextStyle}"/><TextBlock Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"/><TextBlock Text="in current results" Style="{StaticResource KpiCaptionTextStyle}"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}"><StackPanel><TextBlock Text="DRAFTS" Style="{StaticResource KpiLabelTextStyle}"/><TextBlock Text="{x:Bind ViewModel.DraftCount, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"/><TextBlock Text="still editable" Style="{StaticResource KpiCaptionTextStyle}"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelGreenBrush}" BorderBrush="{ThemeResource PastelGreenBrush}"><StackPanel><TextBlock Text="SUBMITTED" Style="{StaticResource KpiLabelTextStyle}"/><TextBlock Text="{x:Bind ViewModel.SubmittedCount, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"/><TextBlock Text="ordered from suppliers" Style="{StaticResource KpiCaptionTextStyle}"/></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelVioletBrush}" BorderBrush="{ThemeResource PastelVioletBrush}"><StackPanel><TextBlock Text="EXPECTED TOTAL" Style="{StaticResource KpiLabelTextStyle}"/><TextBlock Text="{x:Bind ViewModel.ExpectedTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource KpiValueTextStyle}"/><TextBlock Text="non-posting estimate" Style="{StaticResource KpiCaptionTextStyle}"/></StackPanel></Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource FilterBarStyle}" Margin="24,0,24,16">
            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="150"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search PO number / supplier…"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{x:Bind ViewModel.SearchSuggestions}" TextChanged="OnSearchTextChanged"
                                SuggestionChosen="OnSuggestionChosen" QuerySubmitted="OnSearchQuerySubmitted" GotFocus="OnSearchGotFocus"
                                AutomationProperties.Name="Search purchase orders">
                    <AutoSuggestBox.ItemTemplate><DataTemplate x:DataType="vm:SearchSuggestionItem"><StackPanel Padding="4,2"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextStyle}"/></StackPanel></DataTemplate></AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.StatusOptions}" SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}" SelectionChanged="OnFilterChanged"/>
                <CalendarDatePicker Grid.Column="2" PlaceholderText="From" Date="{x:Bind ViewModel.FromDate, Mode=TwoWay}" DateChanged="OnDateChanged"/>
                <CalendarDatePicker Grid.Column="3" PlaceholderText="To" Date="{x:Bind ViewModel.ToDate, Mode=TwoWay}" DateChanged="OnDateChanged"/>
                <ComboBox Grid.Column="4" ItemsSource="{x:Bind ViewModel.SortOptions}" SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" SelectionChanged="OnFilterChanged"/>
                <Button Grid.Column="6" Content="Clear filters" Click="OnClearClick"/>
            </Grid>
        </Border>
        <Border Grid.Row="3" Margin="24,0,24,24" Style="{StaticResource ElevatedCardStyle}" Padding="0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Padding="16,12" Background="{ThemeResource SurfaceAltBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/><ColumnDefinition Width="160"/><ColumnDefinition Width="140"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
                    <TextBlock Text="PO NUMBER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="1" Text="SUPPLIER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="2" Text="DATE" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="4" Text="EXPECTED TOTAL" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/><TextBlock Grid.Column="5" Text="CREATED BY" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="6" Text="ACTIONS" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/>
                </Grid>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"><FontIcon Glyph="&#xE8A5;" FontSize="34"/><TextBlock Text="No purchase orders found." FontWeight="SemiBold"/><Button Content="Create Purchase Order" Click="OnNewClick"/></StackPanel>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Orders}" SelectionMode="None" Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="IsTabStop" Value="False"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate x:DataType="vm:PurchaseOrderRowViewModel">
                    <Grid Padding="16,12" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/><ColumnDefinition Width="160"/><ColumnDefinition Width="140"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Number}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{x:Bind Supplier}"/><TextBlock Grid.Column="2" Text="{x:Bind Date}"/><Border Grid.Column="3" Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Left"><TextBlock Text="{x:Bind Status}" Style="{StaticResource BadgeTextStyle}"/></Border><TextBlock Grid.Column="4" Text="{x:Bind Total, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="SemiBold"/><TextBlock Grid.Column="5" Text="{x:Bind CreatedBy}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"><Button Content="View" Tag="{x:Bind}" Click="OnViewClick"/><Button Content="Reconcile" Tag="{x:Bind}" Click="OnReconcileClick" Visibility="{x:Bind CanReconcile, Converter={StaticResource BoolToVisibilityConverter}}"/><Button Content="Receive" Tag="{x:Bind}" Click="OnReceiveClick" Visibility="{x:Bind CanReceive, Converter={StaticResource BoolToVisibilityConverter}}"/><Button Content="Edit" Tag="{x:Bind}" Click="OnEditClick" Visibility="{x:Bind IsDraft, Converter={StaticResource BoolToVisibilityConverter}}"/><Button Content="Submit" Tag="{x:Bind}" Click="OnSubmitClick" Visibility="{x:Bind IsDraft, Converter={StaticResource BoolToVisibilityConverter}}"/><Button Content="Cancel" Tag="{x:Bind}" Click="OnCancelOrderClick" Visibility="{x:Bind CanCancel, Converter={StaticResource BoolToVisibilityConverter}}"/></StackPanel>
                    </Grid></DataTemplate></ListView.ItemTemplate></ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
