<Page
    x:Class="Kirana.App.Views.RestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="{StaticResource PageHeaderPadding}" Spacing="2">
            <TextBlock Text="Restore" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Replace all current data with the contents of a backup. A safety backup of your current data is always taken first."
                       Style="{StaticResource PageSubtitleTextStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,0,24,24" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">

                <InfoBar IsOpen="True" Severity="Warning" IsClosable="False"
                         Title="Restoring replaces everything"
                         Message="All products, sales, purchases, customers, users and settings will be replaced by the backup's copy. Kirana will restart when it finishes." />

                <ProgressBar IsIndeterminate="True"
                             Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                         Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />
                <InfoBar IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                         Severity="Success" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" IsClosable="False" />

                <!-- Once the swap has happened the rest of this page is reading a database that is
                     no longer the live one, so it collapses down to the restart prompt. -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}"
                        Background="{ThemeResource SuccessSubtleBrush}"
                        Visibility="{x:Bind ViewModel.RestoreCompleted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Restore finished" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                                   Text="Kirana must restart to load the restored data." />
                        <Button Content="Restart Kirana now" Style="{StaticResource AccentButtonStyle}"
                                Click="OnRestartClick" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="16"
                            Visibility="{x:Bind ViewModel.RestoreCompleted, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                    <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="1 · Choose a backup" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                                           Text="Pick one Kirana took, or browse for a backup file copied from another machine." />
                            </StackPanel>

                            <Button Click="OnBrowseClick" IsEnabled="{x:Bind ViewModel.CanRestore}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock Text="Browse for a backup file…" />
                                </StackPanel>
                            </Button>

                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Text="No backups are available on this machine."
                                       Visibility="{x:Bind ViewModel.HasNoBackups, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <ListView ItemsSource="{x:Bind ViewModel.AvailableBackups}" SelectionMode="None" MaxHeight="260">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BackupHistoryItemViewModel">
                                        <Grid Padding="12,10" ColumnSpacing="16"
                                              BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind CreatedAtLocal}"
                                                       Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind TypeLabel}"
                                                       Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind SizeLabel}"
                                                       Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Content="Select" Click="OnSelectBackupClick" Tag="{x:Bind}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}"
                            Visibility="{x:Bind ViewModel.HasSelectedBackup, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="2 · Check what it contains" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedBackupSummary, Mode=OneWay}"
                                           Style="{StaticResource PageSubtitleTextStyle}" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind ViewModel.SelectedBackupPath, Mode=OneWay}"
                                       Style="{StaticResource CodeTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedBackupContents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" Style="{StaticResource SecondaryTextStyle}" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}"
                            Visibility="{x:Bind ViewModel.HasSelectedBackup, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="3 · Confirm the restore" Style="{StaticResource SectionTitleTextStyle}" />
                                <TextBlock Style="{StaticResource PageSubtitleTextStyle}"
                                           Text="You will be asked for an Owner PIN, then to confirm. A safety backup is taken before anything is replaced." />
                            </StackPanel>

                            <Button Content="Restore this backup" Click="OnRestoreClick"
                                    IsEnabled="{x:Bind ViewModel.CanRestore}" HorizontalAlignment="Left"
                                    Background="{ThemeResource DangerBrush}" Foreground="White" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
