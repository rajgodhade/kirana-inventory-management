<Page
    x:Class="Kirana.App.Views.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page heading + the one number that matters most on this screen. The shell supplies the
             app bar, so there is no local header/back button. -->
        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Customers &amp; Udhaar" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Customer records, credit balances and repayments."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16,10"
                    Background="{ThemeResource DangerSubtleBrush}" BorderThickness="0">
                <StackPanel Spacing="1">
                    <TextBlock Text="Total Outstanding Udhaar" Style="{StaticResource MetricLabelTextStyle}" />
                    <TextBlock Style="{StaticResource MetricTextStyle}" Foreground="{ThemeResource DangerBrush}" FontSize="24">
                        <Run Text="{x:Bind ViewModel.TotalOutstandingDisplay, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                    </TextBlock>
                    <TextBlock Text="{x:Bind ViewModel.OutstandingCustomerCountDisplay, Mode=OneWay}"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Padding="{StaticResource ToolbarPadding}" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="210" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" PlaceholderText="Search Customer ID / phone / name…"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" KeyDown="OnSearchBoxKeyDown"
                     TextChanged="OnSearchTextChanged">
                <TextBox.Resources>
                    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
                </TextBox.Resources>
            </TextBox>

            <Button Grid.Column="1" Click="OnSearchClick" AutomationProperties.Name="Search customers">
                <FontIcon Glyph="&#xE721;" FontSize="14" />
            </Button>

            <CheckBox Grid.Column="2" Content="Show inactive" VerticalAlignment="Center" Margin="8,0,0,0"
                      IsChecked="{x:Bind ViewModel.ShowInactive, Mode=TwoWay}"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged" />

            <CheckBox Grid.Column="3" Content="Only with Udhaar" VerticalAlignment="Center"
                      IsChecked="{x:Bind ViewModel.ShowOnlyOutstanding, Mode=TwoWay}"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged" />

            <Button Grid.Column="5" Style="{StaticResource AccentButtonStyle}" Click="OnAddCustomerClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add Customer" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Results -->
        <Grid Grid.Row="2" Margin="24,0,24,24">
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="14,10" ColumnSpacing="16"
                          Background="{ThemeResource SurfaceAltBrush}"
                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" MinWidth="210" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CUSTOMER" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="PHONE" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="UDHAAR" Style="{StaticResource ColumnHeaderTextStyle}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Customers}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CustomerRowViewModel">
                                <Grid Padding="14,12" ColumnSpacing="16"
                                      BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="Auto" MinWidth="210" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind CustomerCode}" Style="{StaticResource CodeTextStyle}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{x:Bind Phone}" Style="{StaticResource SecondaryTextStyle}"
                                               VerticalAlignment="Center" />

                                    <!-- Two TextBlocks rather than a brush converter: {ThemeResource}
                                         in XAML resolves against the element's theme, a converter
                                         reaching into app resources would not. -->
                                    <TextBlock Grid.Column="2" Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource DangerBrush}"
                                               Visibility="{x:Bind HasOutstanding, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Run Text="{x:Bind OutstandingDisplay, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="—" Style="{StaticResource SecondaryTextStyle}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Visibility="{x:Bind HasOutstanding, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                                    <Border Grid.Column="3" Style="{StaticResource BadgeBorderStyle}"
                                            Background="{ThemeResource SuccessSubtleBrush}"
                                            Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Active" Style="{StaticResource BadgeTextStyle}"
                                                   Foreground="{ThemeResource SuccessBrush}" />
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource BadgeBorderStyle}"
                                            Background="{ThemeResource SurfaceAltBrush}"
                                            Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock Text="Inactive" Style="{StaticResource BadgeTextStyle}"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" />
                                    </Border>

                                    <!-- Two primary actions inline; the rarer, riskier one lives in an
                                         overflow menu. Keeps the row narrow enough that actions never
                                         clip at small window widths. -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button Content="Ledger" Click="OnLedgerClick" Tag="{x:Bind}" />
                                        <Button Content="Edit" Click="OnEditClick" Tag="{x:Bind}" />
                                        <Button Padding="9,5" AutomationProperties.Name="More actions">
                                            <FontIcon Glyph="&#xE712;" FontSize="13" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Deactivate" Click="OnToggleActiveClick" Tag="{x:Bind}"
                                                                    Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <MenuFlyoutItem Text="Reactivate" Click="OnToggleActiveClick" Tag="{x:Bind}"
                                                                    Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     VerticalAlignment="Top" Margin="0,0,0,8" />
        </Grid>
    </Grid>
</Page>
