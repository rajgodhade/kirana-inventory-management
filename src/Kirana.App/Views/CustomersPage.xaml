<Page
    x:Class="Kirana.App.Views.CustomersPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:interaction="using:Kirana.App.Interaction"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <StackPanel Spacing="2">
                <TextBlock Text="Customers &amp; Udhaar" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Customer records, credit balances and repayment history." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <!-- A compact commercial snapshot. The cards only change the current view. -->
        <Grid Grid.Row="1" Padding="24,0,24,16" ColumnSpacing="{StaticResource SpacingL}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="OnAllCustomersClick" Padding="0" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    AutomationProperties.Name="Show all customers">
                <Border Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelBlueBrush}" BorderBrush="{ThemeResource PastelBlueBrush}">
                    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                        <FontIcon Glyph="&#xE77B;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{ThemeResource PastelBlueOnBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="TOTAL CUSTOMERS" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalCustomersText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}" />
                            <TextBlock Text="customer records" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}" /></StackPanel>
                    </Grid>
                </Border>
            </Button>
            <Button Grid.Column="1" Click="OnOutstandingCustomersClick" Padding="0" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    AutomationProperties.Name="Show customers with outstanding Udhaar">
                <Border Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}">
                    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                        <FontIcon Glyph="&#xE77B;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{ThemeResource PastelAmberOnBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="OUTSTANDING UDHAAR" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalOutstanding, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" />
                            <TextBlock Text="currently owed by customers" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" /></StackPanel>
                    </Grid>
                </Border>
            </Button>
            <Button Grid.Column="2" Click="OnOverdueCustomersClick" Padding="0" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    AutomationProperties.Name="Show overdue customers">
                <Border Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelRoseBrush}" BorderBrush="{ThemeResource PastelRoseBrush}">
                    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                        <FontIcon Glyph="&#xE7BA;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{ThemeResource PastelRoseOnBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="OVERDUE CUSTOMERS" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.OverdueCustomersText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" />
                            <TextBlock Text="Udhaar open for 30+ days" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" /></StackPanel>
                    </Grid>
                </Border>
            </Button>
            <Button Grid.Column="3" Click="OnAllCustomersClick" Padding="0" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    AutomationProperties.Name="Show all customers">
                <Border Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelVioletBrush}" BorderBrush="{ThemeResource PastelVioletBrush}">
                    <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                        <FontIcon Glyph="&#xE710;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{ThemeResource PastelVioletOnBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="NEW THIS MONTH" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.NewCustomersThisMonthText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" />
                            <TextBlock Text="customers added this month" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" /></StackPanel>
                    </Grid>
                </Border>
            </Button>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource FilterBarStyle}" Margin="24,0,24,16">
            <Grid ColumnSpacing="{StaticResource SpacingS}" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" /><ColumnDefinition Width="148" /><ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="142" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox PlaceholderText="Search name / mobile / customer ID..." Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSearchBoxKeyDown" TextChanged="OnSearchTextChanged" CornerRadius="{StaticResource RadiusMedium}"
                         AutomationProperties.Name="Search customers" />
                <ComboBox x:Name="StatusFilterBox" Grid.Column="1" ItemsSource="{x:Bind ViewModel.StatusFilterOptions}" SelectedItem="{x:Bind ViewModel.SelectedStatusFilter, Mode=TwoWay}"
                          SelectionChanged="OnFilterChanged" CornerRadius="{StaticResource RadiusMedium}" AutomationProperties.Name="Filter customer status" />
                <CheckBox Grid.Column="2" Content="Outstanding only" IsChecked="{x:Bind ViewModel.OutstandingOnly, Mode=TwoWay}"
                          Checked="OnFilterChanged" Unchecked="OnFilterChanged" VerticalAlignment="Center" />
                <ComboBox x:Name="SortFilterBox" Grid.Column="3" ItemsSource="{x:Bind ViewModel.SortOptions}" SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}"
                          SelectionChanged="OnFilterChanged" CornerRadius="{StaticResource RadiusMedium}" AutomationProperties.Name="Sort customers" />
                <Button Grid.Column="5" Content="Add Customer" Style="{StaticResource AccentButtonStyle}" Padding="12,7"
                        Click="OnAddCustomerClick" IsEnabled="{x:Bind ViewModel.CanManageCustomers}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="24,0,24,24">
            <Border Style="{StaticResource ElevatedCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="12,10" ColumnSpacing="12" Background="{ThemeResource SurfaceAltBrush}"
                          CornerRadius="16,16,0,0" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="220" /><ColumnDefinition Width="160" /><ColumnDefinition Width="112" />
                            <ColumnDefinition Width="112" /><ColumnDefinition Width="122" /><ColumnDefinition Width="130" />
                            <ColumnDefinition Width="86" /><ColumnDefinition Width="274" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CUSTOMER" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="CONTACT" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="LAST PURCHASE" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="LAST PAYMENT" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="4" Text="LIFETIME SALES" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="OUTSTANDING" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="7" Text="ACTIONS" Style="{StaticResource ColumnHeaderTextStyle}" />
                    </Grid>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                                Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE77B;" FontSize="36" Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No customers found." Style="{StaticResource CardTitleTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Try changing the filters, or add a new customer." Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <Button Content="Add Customer" Style="{StaticResource AccentButtonStyle}" Click="OnAddCustomerClick" IsEnabled="{x:Bind ViewModel.CanManageCustomers}" />
                            <Button Content="Import Customers" IsEnabled="False" ToolTipService.ToolTip="Customer import is not available yet." />
                        </StackPanel>
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Customers}" SelectionMode="None" TabNavigation="Once"
                              Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" /><Setter Property="UseSystemFocusVisuals" Value="True" /></Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CustomerRowViewModel">
                                <!-- Opaque base deliberately prevents the ListView hover fill: row navigation is signalled by cursor/focus only. -->
                                <Border Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid Padding="12,11" ColumnSpacing="12" Tag="{x:Bind}" Tapped="OnCustomerRowTapped"
                                          interaction:ActionCursor.IsActionable="True" AutomationProperties.Name="{x:Bind Name}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="220" /><ColumnDefinition Width="160" /><ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="112" /><ColumnDefinition Width="122" /><ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="86" /><ColumnDefinition Width="274" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="{StaticResource RadiusPill}" Background="{ThemeResource PastelVioletBrush}">
                                                <TextBlock Text="{x:Bind Initial}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource PastelVioletOnBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{x:Bind CustomerCode}" Style="{StaticResource CodeTextStyle}" />
                                                    <Border Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource PastelVioletBrush}" Padding="6,2"><TextBlock Text="{x:Bind CustomerTag}" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" /></Border></StackPanel></StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{x:Bind PhoneText}" Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="Mobile" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind LastPurchaseText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind LastPaymentText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind LifetimePurchaseValue, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        <Border Grid.Column="5" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource SuccessSubtleBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                Visibility="{x:Bind IsPaid, Converter={StaticResource BoolToVisibilityConverter}}"><TextBlock Text="₹0.00 · Paid" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource SuccessBrush}" /></Border>
                                        <Border Grid.Column="5" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource WarningSubtleBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                Visibility="{x:Bind IsOutstanding, Converter={StaticResource BoolToVisibilityConverter}}"><TextBlock Text="{x:Bind OutstandingBalance, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource WarningBrush}" /></Border>
                                        <Border Grid.Column="5" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource DangerSubtleBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                Visibility="{x:Bind IsOverdue, Converter={StaticResource BoolToVisibilityConverter}}"><TextBlock Text="{x:Bind OutstandingBalance, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource DangerBrush}" /></Border>
                                        <Border Grid.Column="6" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource SuccessSubtleBrush}" VerticalAlignment="Center"
                                                Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}"><TextBlock Text="Active" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource SuccessBrush}" /></Border>
                                        <Border Grid.Column="6" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource SurfaceAltBrush}" VerticalAlignment="Center"
                                                Visibility="{x:Bind IsActive, Converter={StaticResource InverseBoolToVisibilityConverter}}"><TextBlock Text="Inactive" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource TextSecondaryBrush}" /></Border>
                                        <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="Ledger" Tag="{x:Bind}" Click="OnLedgerClick" Padding="9,5" Height="32" MinWidth="0" CornerRadius="{StaticResource RadiusMedium}" />
                                            <Button Content="Receive" Tag="{x:Bind}" Click="OnReceivePaymentClick" Padding="9,5" Height="32" MinWidth="0" CornerRadius="{StaticResource RadiusMedium}"
                                                    IsEnabled="{x:Bind CanReceivePayment}" />
                                            <Button Tag="{x:Bind}" Padding="8,5" Width="34" Height="32" MinWidth="0" CornerRadius="{StaticResource RadiusMedium}" AutomationProperties.Name="More customer actions"><FontIcon Glyph="&#xE712;" FontSize="15" />
                                                <Button.Flyout><MenuFlyout Placement="Bottom">
                                                    <MenuFlyoutItem Text="Edit" Click="OnEditClick" Tag="{x:Bind}" IsEnabled="{Binding ElementName=RootPage, Path=ViewModel.CanManageCustomers}" />
                                                    <MenuFlyoutItem Text="Purchase History" Click="OnLedgerClick" Tag="{x:Bind}" />
                                                    <MenuFlyoutItem Text="Deactivate" Click="OnToggleActiveClick" Tag="{x:Bind}" IsEnabled="{Binding ElementName=RootPage, Path=ViewModel.CanManageCustomers}"
                                                                    Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <MenuFlyoutItem Text="Reactivate" Click="OnToggleActiveClick" Tag="{x:Bind}" IsEnabled="{Binding ElementName=RootPage, Path=ViewModel.CanManageCustomers}"
                                                                    Visibility="{x:Bind IsActive, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Export Ledger" IsEnabled="False" ToolTipService.ToolTip="Use Export Center to export customer data." />
                                                    <MenuFlyoutItem Text="Delete" IsEnabled="False" ToolTipService.ToolTip="Customer deletion is not supported." />
                                                </MenuFlyout></Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}" Severity="Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" VerticalAlignment="Top" Margin="0,0,0,8" />
        </Grid>
    </Grid>
</Page>
