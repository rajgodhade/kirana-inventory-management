<ContentDialog
    x:Class="Kirana.App.Views.HeldBillsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:entities="using:Kirana.Domain.Entities"
    CloseButtonText="Cancel"
    DefaultButton="Close">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Resume Held Bill" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                    Click="OnCloseIconClick" AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <StackPanel Spacing="10" MinWidth="420" MaxHeight="480">
        <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <ListView ItemsSource="{x:Bind ViewModel.HeldBills}" MaxHeight="400" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="entities:HeldBill">
                    <Grid ColumnSpacing="10" Padding="0,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="Held at " /><Run Text="{x:Bind HeldAtUtc}" />
                            </TextBlock>
                            <TextBlock Opacity="0.7">
                                <Run Text="Items: " /><Run Text="{x:Bind Items.Count}" />
                                <Run Text="  Customer: " /><Run Text="{x:Bind Customer.Name}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Resume" Click="OnResumeClick" Tag="{x:Bind}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
