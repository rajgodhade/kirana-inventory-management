<Page
    x:Class="Kirana.App.Views.SuppliersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="◀ Management" Click="OnBackClick" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="Suppliers" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Lock &amp; Return to Billing" Click="OnLockClick" />
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Padding="20,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" PlaceholderText="Search name / ID / phone…"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" KeyDown="OnSearchBoxKeyDown" />

            <CheckBox Grid.Column="1" Content="Show inactive" VerticalAlignment="Center" Margin="8,0,0,0"
                      IsChecked="{x:Bind ViewModel.ShowInactive, Mode=TwoWay}" Checked="OnShowInactiveChanged" Unchecked="OnShowInactiveChanged" />

            <Button Grid.Column="3" Content="Add Supplier" Style="{StaticResource AccentButtonStyle}"
                    Click="OnAddSupplierClick" IsEnabled="{x:Bind ViewModel.CanManagePurchases}" />
        </Grid>

        <!-- Results -->
        <Grid Grid.Row="2">
            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Margin="20,0,20,8" VerticalAlignment="Top" />

            <ListView ItemsSource="{x:Bind ViewModel.Suppliers}" Padding="20,0,20,20" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SupplierRowViewModel">
                        <Grid Padding="12" ColumnSpacing="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="220" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind SupplierCode}" Opacity="0.6" FontSize="12" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind ContactPerson}" FontSize="12" />
                                <TextBlock Text="{x:Bind Phone}" FontSize="12" Opacity="0.7" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" FontWeight="SemiBold" VerticalAlignment="Center">
                                <Run Text="₹" /><Run Text="{x:Bind OutstandingBalance}" />
                            </TextBlock>

                            <TextBlock Grid.Column="3" Text="Active" Foreground="Green" FontSize="11" VerticalAlignment="Center"
                                       Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content="Ledger" Click="OnLedgerClick" Tag="{x:Bind}" />
                                <Button Content="Edit" Click="OnEditClick" Tag="{x:Bind}" />
                                <Button Content="Deactivate" Click="OnToggleActiveClick" Tag="{x:Bind}"
                                        Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="Reactivate" Click="OnToggleActiveClick" Tag="{x:Bind}"
                                        Visibility="{x:Bind IsActive, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
