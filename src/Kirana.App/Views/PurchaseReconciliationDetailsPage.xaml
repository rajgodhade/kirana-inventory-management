<Page x:Class="Kirana.App.Views.PurchaseReconciliationDetailsPage" x:Name="RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:Kirana.App.ViewModels">
    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24" Spacing="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Purchase Reconciliation Details" Style="{StaticResource PageTitleTextStyle}"/>
                        <TextBlock><Run Text="{x:Bind ViewModel.PurchaseOrderNumber, Mode=OneWay}"/><Run Text=" · "/><Run Text="{x:Bind ViewModel.Supplier, Mode=OneWay}"/></TextBlock>
                        <TextBlock Text="{x:Bind ViewModel.CalculatedAt, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="View Purchase Order" Click="OnViewPurchaseOrderClick"/>
                        <Button Content="Refresh" Click="OnRefreshClick" Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error" Title="Could not load reconciliation" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False"/>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelBlueBrush}" BorderBrush="{ThemeResource PastelBlueBrush}"><StackPanel><TextBlock Text="ORDERED" Style="{StaticResource KpiLabelTextStyle}"/><TextBlock Text="{x:Bind ViewModel.Ordered, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="purchase order quantity" Style="{StaticResource KpiCaptionTextStyle}"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelTealBrush}" BorderBrush="{ThemeResource PastelTealBrush}"><StackPanel><TextBlock Text="RECEIVED" Style="{StaticResource KpiLabelTextStyle}"/><TextBlock Text="{x:Bind ViewModel.Received, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="completed GRNs" Style="{StaticResource KpiCaptionTextStyle}"/></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelGreenBrush}" BorderBrush="{ThemeResource PastelGreenBrush}"><StackPanel><TextBlock Text="PURCHASED" Style="{StaticResource KpiLabelTextStyle}"/><TextBlock Text="{x:Bind ViewModel.Purchased, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="posted supplier purchases" Style="{StaticResource KpiCaptionTextStyle}"/></StackPanel></Border>
                    <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}"><StackPanel><TextBlock Text="PENDING RECEIPT" Style="{StaticResource KpiLabelTextStyle}"/><TextBlock Text="{x:Bind ViewModel.PendingReceiptText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="ordered minus received" Style="{StaticResource KpiCaptionTextStyle}"/></StackPanel></Border>
                    <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelVioletBrush}" BorderBrush="{ThemeResource PastelVioletBrush}"><StackPanel><TextBlock Text="PENDING PURCHASE" Style="{StaticResource KpiLabelTextStyle}"/><TextBlock Text="{x:Bind ViewModel.PendingInvoiceText, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="received minus invoiced" Style="{StaticResource KpiCaptionTextStyle}"/></StackPanel></Border>
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource ElevatedCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Value comparison" Style="{StaticResource SectionTitleTextStyle}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Expected purchase value" Style="{StaticResource SecondaryTextStyle}"/><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ExpectedValue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold"/></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Actual posted value" Style="{StaticResource SecondaryTextStyle}"/><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActualValue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold"/></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Expected / actual discount" Style="{StaticResource SecondaryTextStyle}"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"><TextBlock Text="{x:Bind ViewModel.ExpectedDiscount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"/><TextBlock Text="/"/><TextBlock Text="{x:Bind ViewModel.ActualDiscount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold"/></StackPanel></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Discount variance" Style="{StaticResource SecondaryTextStyle}"/><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DiscountVariance, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold"/></Grid>
                            <Border BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Total variance" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalVariance, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold"/></Grid></Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource ElevatedCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="GST comparison" Style="{StaticResource SectionTitleTextStyle}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Expected GST" Style="{StaticResource SecondaryTextStyle}"/><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ExpectedTax, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold"/></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Actual GST" Style="{StaticResource SecondaryTextStyle}"/><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActualTax, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold"/></Grid>
                            <Border BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tax variance" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TaxVariance, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold"/></Grid></Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource ElevatedCardStyle}" Background="{ThemeResource WarningSubtleBrush}" Visibility="{x:Bind ViewModel.HasIssues, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="8"><TextBlock Text="Needs review" Style="{StaticResource SectionTitleTextStyle}"/><ItemsControl ItemsSource="{x:Bind ViewModel.Issues}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="• "/><Run Text="{Binding}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                </Border>
                <InfoBar IsOpen="{x:Bind ViewModel.HasIssues, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" Severity="Success" Title="Fully reconciled" Message="Ordered, received and purchased quantities, costs and GST agree." IsClosable="False"/>

                <Border Style="{StaticResource ElevatedCardStyle}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="Line reconciliation" Style="{StaticResource SectionTitleTextStyle}" Margin="18,16,18,10"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Grid MinWidth="1710">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Padding="14,11" Background="{ThemeResource SurfaceAltBrush}" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="105"/><ColumnDefinition Width="105"/><ColumnDefinition Width="105"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="PRODUCT" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="1" Text="UNIT" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="2" Text="ORDERED" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="3" Text="RECEIVED" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="4" Text="PURCHASED" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="5" Text="PEND. RECEIPT" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="6" Text="PEND. PURCHASE" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="7" Text="EXPECTED COST" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="8" Text="ACTUAL COST" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="9" Text="COST VAR." Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="10" Text="EXPECTED TOTAL" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="11" Text="ACTUAL TOTAL" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="12" Text="EXPECTED GST" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="13" Text="ACTUAL GST" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="14" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}"/>
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.Lines}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PurchaseReconciliationLineViewModel">
                                    <Grid Padding="14,12" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="105"/><ColumnDefinition Width="105"/><ColumnDefinition Width="105"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{x:Bind Product}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind ProductCode}" Style="{StaticResource CaptionTextStyle}"/></StackPanel><TextBlock Grid.Column="1" Text="{x:Bind Unit}"/><TextBlock Grid.Column="2" Text="{x:Bind Ordered}"/><TextBlock Grid.Column="3" Text="{x:Bind Received}"/><TextBlock Grid.Column="4" Text="{x:Bind Purchased}"/><TextBlock Grid.Column="5" Text="{x:Bind PendingReceipt}"/><TextBlock Grid.Column="6" Text="{x:Bind PendingInvoice}"/><TextBlock Grid.Column="7" Text="{x:Bind ExpectedCost, Converter={StaticResource CurrencyConverter}}"/><TextBlock Grid.Column="8" Text="{x:Bind ActualCost}"/><TextBlock Grid.Column="9" Text="{x:Bind CostVariance}"/><TextBlock Grid.Column="10" Text="{x:Bind ExpectedTotal, Converter={StaticResource CurrencyConverter}}"/><TextBlock Grid.Column="11" Text="{x:Bind ActualTotal, Converter={StaticResource CurrencyConverter}}"/><TextBlock Grid.Column="12" Text="{x:Bind ExpectedTax, Converter={StaticResource CurrencyConverter}}"/><TextBlock Grid.Column="13" Text="{x:Bind ActualTax, Converter={StaticResource CurrencyConverter}}"/><TextBlock Grid.Column="14" Text="{x:Bind Status}" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ElevatedCardStyle}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="Source documents" Style="{StaticResource SectionTitleTextStyle}" Margin="18,16,18,10"/>
                        <Grid Padding="14,10" Background="{ThemeResource SurfaceAltBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="TYPE" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="1" Text="NUMBER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="2" Text="DATE" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="4" Text="QUANTITY" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="5" Text="ACTION" Style="{StaticResource ColumnHeaderTextStyle}"/></Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Documents}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PurchaseReconciliationDocumentViewModel"><Grid Padding="14,11" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Type}"/><TextBlock Grid.Column="1" Text="{x:Bind Number}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{x:Bind Date}"/><TextBlock Grid.Column="3" Text="{x:Bind Status}"/><TextBlock Grid.Column="4" Text="{x:Bind Quantity}"/><Button Grid.Column="5" Content="View" Tag="{x:Bind}" Click="OnViewDocumentClick"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Page>
