<ContentDialog
    x:Class="Kirana.App.Views.SupplierPaymentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Record Supplier Payment"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="360">
        <TextBox x:Name="AmountBox" Header="Amount" PlaceholderText="0.00" />

        <ComboBox x:Name="MethodBox" Header="Payment Method" SelectedIndex="0">
            <ComboBoxItem Content="Cash" Tag="Cash" />
            <ComboBoxItem Content="UPI" Tag="Upi" />
            <ComboBoxItem Content="Card" Tag="Card" />
        </ComboBox>

        <TextBox x:Name="ReferenceBox" Header="Reference # (optional)" />
        <TextBox x:Name="NotesBox" Header="Notes (optional)" />

        <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" />
    </StackPanel>
</ContentDialog>
