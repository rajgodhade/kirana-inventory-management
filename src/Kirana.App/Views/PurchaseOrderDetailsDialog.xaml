<ContentDialog x:Class="Kirana.App.Views.PurchaseOrderDetailsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dom="using:Kirana.Domain.Entities" PrimaryButtonText="Print" CloseButtonText="Close">
    <ContentDialog.Resources><x:Double x:Key="ContentDialogMaxWidth">900</x:Double><x:Double x:Key="ContentDialogMinWidth">760</x:Double></ContentDialog.Resources>
    <ContentDialog.Title><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Purchase Order" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="{x:Bind Order.PurchaseOrderNumber}" Style="{StaticResource CodeTextStyle}"/></StackPanel><Button Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}" Click="OnCloseClick" AutomationProperties.Name="Close dialog"><FontIcon Glyph="&#xE711;" FontSize="14"/></Button></Grid></ContentDialog.Title>
    <ScrollViewer MaxHeight="620"><StackPanel Spacing="14"><Border Style="{StaticResource ElevatedCardStyle}" Padding="16"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SUPPLIER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind Order.SupplierNameSnapshot}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Order.SupplierCodeSnapshot}" Style="{StaticResource CodeTextStyle}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="DATE" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock x:Name="DateText"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind Order.Status}" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="EXPECTED TOTAL" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind Order.GrandTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="18"/></StackPanel></Grid></Border>
        <Border Style="{StaticResource ElevatedCardStyle}" Padding="0"><StackPanel><Grid Padding="14,10" Background="{ThemeResource SurfaceAltBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="PRODUCT" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="1" Text="QTY" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="2" Text="COST" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="3" Text="TOTAL" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/></Grid><ItemsControl ItemsSource="{x:Bind Order.Items}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="dom:PurchaseOrderItem"><Grid Padding="14,10" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind ProductNameSnapshot}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ProductCodeSnapshot}" Style="{StaticResource CodeTextStyle}"/></StackPanel><TextBlock Grid.Column="1" Text="{x:Bind OrderedQuantity}"/><TextBlock Grid.Column="2" Text="{x:Bind UnitCost, Converter={StaticResource CurrencyConverter}}"/><TextBlock Grid.Column="3" Text="{x:Bind LineTotal, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="10"><StackPanel><TextBlock Text="Notes" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind Order.Notes}" TextWrapping="Wrap"/></StackPanel><Button x:Name="ReconciliationButton" Content="View Reconciliation" HorizontalAlignment="Left" Click="OnReconciliationClick"/></StackPanel><StackPanel Grid.Column="1" Width="260" Spacing="6"><Grid><TextBlock Text="Subtotal"/><TextBlock Text="{x:Bind Order.SubTotal, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right"/></Grid><Grid><TextBlock Text="Discount"/><TextBlock Text="{x:Bind Order.DiscountTotal, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right"/></Grid><Grid><TextBlock Text="GST"/><TextBlock Text="{x:Bind Order.TaxTotal, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right"/></Grid><Grid><TextBlock Text="Expected Total" FontWeight="Bold"/><TextBlock Text="{x:Bind Order.GrandTotal, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="Bold"/></Grid></StackPanel></Grid>
    </StackPanel></ScrollViewer>
</ContentDialog>
