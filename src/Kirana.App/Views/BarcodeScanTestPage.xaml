<Page
    x:Class="Kirana.App.Views.BarcodeScanTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <StackPanel Spacing="2">
                <TextBlock Text="Barcode Scan" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Test a scanner and check which product a barcode resolves to." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <!-- Scan input -->
        <StackPanel Grid.Row="1" Padding="20,16" Spacing="6">
            <TextBlock Text="Scan a product barcode with a USB scanner, or type it and press Enter."
                       Opacity="0.7" />
            <TextBox x:Name="ScanInputBox" PlaceholderText="Click here, then scan…"
                     FontSize="18" CharacterReceived="OnCharacterReceived" KeyDown="OnKeyDown" />
        </StackPanel>

        <!-- Result -->
        <StackPanel Grid.Row="2" Padding="20" Spacing="12">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="16" />
            <TextBlock Opacity="0.6" FontSize="12">
                <Run Text="Last scanned value: " /><Run Text="{x:Bind ViewModel.LastScannedBarcode, Mode=OneWay}" />
            </TextBlock>

            <Border Visibility="{x:Bind ViewModel.FoundProduct, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20" MaxWidth="480" HorizontalAlignment="Left">
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind ViewModel.FoundProduct.Name, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock FontSize="13" Opacity="0.7">
                        <Run Text="{x:Bind ViewModel.FoundProduct.ProductCode, Mode=OneWay}" />
                        <Run Text=" · SKU: " /><Run Text="{x:Bind ViewModel.FoundProduct.Sku, Mode=OneWay}" />
                    </TextBlock>
                    <!-- Phase 13B: which code was scanned, what kind it is, whether it's the
                         product's primary, and whether it would actually scan at billing. -->
                    <TextBlock FontSize="13">
                        <Run Text="Barcode: " /><Run Text="{x:Bind ViewModel.LastScannedBarcode, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="13">
                        <Run Text="Barcode type: " /><Run Text="{x:Bind ViewModel.SymbologyText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="13">
                        <Run Text="Barcode role: " /><Run Text="{x:Bind ViewModel.RoleText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="13">
                        <Run Text="Status: " /><Run Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="16" FontWeight="SemiBold">
                        <Run Text="Selling price: " /><Run Text="{x:Bind ViewModel.FoundProduct.SellingPrice, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                    </TextBlock>
                    <TextBlock FontSize="13">
                        <Run Text="MRP: " /><Run Text="{x:Bind ViewModel.FoundProduct.Mrp, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                    </TextBlock>
                    <TextBlock FontSize="13">
                        <Run Text="Current stock: " /><Run Text="{x:Bind ViewModel.FoundProduct.Inventory.QuantityOnHand, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Phase 13B: the code IS known, so "not found" would be a lie. Say what's actually
                 wrong — retired barcode, or discontinued product — so the operator can fix it. -->
            <InfoBar IsOpen="{x:Bind ViewModel.ShowBlockedWarning, Mode=OneWay}" Severity="Warning" IsClosable="False"
                     Title="Will not scan at billing" Message="{x:Bind ViewModel.BlockedReason, Mode=OneWay}"
                     MaxWidth="480" HorizontalAlignment="Left" />

            <InfoBar IsOpen="{x:Bind ViewModel.ShowNotFound, Mode=OneWay}" Severity="Warning"
                     Title="Not found" Message="No product in the catalogue has that barcode." MaxWidth="480" HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</Page>
