<Page
    x:Class="Kirana.App.Views.BarcodeScanTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="◀ Management" Click="OnBackClick" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="Barcode Scan" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Lock &amp; Return to Billing" Click="OnLockClick" />
        </Grid>

        <!-- Scan input -->
        <StackPanel Grid.Row="1" Padding="20,16" Spacing="6">
            <TextBlock Text="Scan a product barcode with a USB scanner, or type it and press Enter."
                       Opacity="0.7" />
            <TextBox x:Name="ScanInputBox" PlaceholderText="Click here, then scan…"
                     FontSize="18" CharacterReceived="OnCharacterReceived" KeyDown="OnKeyDown" />
        </StackPanel>

        <!-- Result -->
        <StackPanel Grid.Row="2" Padding="20" Spacing="12">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="16" />
            <TextBlock Opacity="0.6" FontSize="12">
                <Run Text="Last scanned value: " /><Run Text="{x:Bind ViewModel.LastScannedBarcode, Mode=OneWay}" />
            </TextBlock>

            <Border Visibility="{x:Bind ViewModel.FoundProduct, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20" MaxWidth="480" HorizontalAlignment="Left">
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind ViewModel.FoundProduct.Name, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock FontSize="13" Opacity="0.7">
                        <Run Text="{x:Bind ViewModel.FoundProduct.ProductCode, Mode=OneWay}" />
                        <Run Text=" · SKU: " /><Run Text="{x:Bind ViewModel.FoundProduct.Sku, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="13">
                        <Run Text="Barcode: " /><Run Text="{x:Bind ViewModel.FoundProduct.Barcode, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="16" FontWeight="SemiBold">
                        <Run Text="Selling price: ₹" /><Run Text="{x:Bind ViewModel.FoundProduct.SellingPrice, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="13">
                        <Run Text="MRP: ₹" /><Run Text="{x:Bind ViewModel.FoundProduct.Mrp, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="13">
                        <Run Text="Current stock: " /><Run Text="{x:Bind ViewModel.FoundProduct.Inventory.QuantityOnHand, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <InfoBar IsOpen="{x:Bind ViewModel.ShowNotFound, Mode=OneWay}" Severity="Warning"
                     Title="Not found" Message="No active product matches that barcode." MaxWidth="480" HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</Page>
