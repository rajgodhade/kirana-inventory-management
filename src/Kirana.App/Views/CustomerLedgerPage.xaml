<Page
    x:Class="Kirana.App.Views.CustomerLedgerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Customer Details" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Profile, ledger, purchase history and repayments." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Print" Click="OnPrintLedgerClick" />
                <Button Content="Export">
                    <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Export Excel" Click="OnExportExcelClick" />
                        <MenuFlyoutItem Text="Export PDF" Click="OnExportPdfClick" /></MenuFlyout></Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Profile + outstanding -->
        <Grid Grid.Row="1" Padding="20,16" ColumnSpacing="24" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="{x:Bind ViewModel.CustomerName, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.CustomerCode, Mode=OneWay}" FontSize="12" Opacity="0.6" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock FontSize="12" Opacity="0.8">
                        <Run Text="Phone:" /><Run Text=" " /><Run Text="{x:Bind ViewModel.Phone, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="12" Opacity="0.8">
                        <Run Text="Address:" /><Run Text=" " /><Run Text="{x:Bind ViewModel.Address, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock FontSize="12" Opacity="0.8">
                        <Run Text="GSTIN:" /><Run Text=" " /><Run Text="{x:Bind ViewModel.Gstin, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.Notes, Mode=OneWay}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.Notes, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="3">
                <TextBlock Text="Lifetime Sales" FontSize="11" Opacity="0.7" HorizontalAlignment="Right" />
                <TextBlock Text="{x:Bind ViewModel.LifetimeSalesDisplay, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Text="Outstanding Udhaar" FontSize="11" Opacity="0.7" HorizontalAlignment="Right" />
                <TextBlock Text="{x:Bind ViewModel.OutstandingDisplay, Mode=OneWay}"
                           FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Right" />
            </StackPanel>

            <Button Grid.Column="2" Content="Record Repayment" Style="{StaticResource AccentButtonStyle}"
                    VerticalAlignment="Center" Click="OnRecordRepaymentClick"
                    IsEnabled="{x:Bind ViewModel.HasOutstanding, Mode=OneWay}" />
        </Grid>

        <!-- Tabs -->
        <Grid Grid.Row="2">
            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Margin="20,0,20,8" VerticalAlignment="Top" />

            <Pivot Padding="12,0,12,0">
                <PivotItem Header="Ledger">
                    <ListView ItemsSource="{x:Bind ViewModel.Entries}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CustomerLedgerRowViewModel">
                                <Grid Padding="10" ColumnSpacing="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" MinWidth="140" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind DateText}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind EntryType}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Reference}" FontSize="12" VerticalAlignment="Center" Opacity="0.8" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind DebitText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind CreditText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind RunningBalanceText}" FontWeight="SemiBold" FontSize="12"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </PivotItem>

                <PivotItem Header="Purchase History">
                    <ListView ItemsSource="{x:Bind ViewModel.Purchases}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CustomerLedgerRowViewModel">
                                <Grid Padding="10" ColumnSpacing="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" MinWidth="140" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind DateText}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind EntryType}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Reference}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind DebitText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind CreditText}" FontSize="12" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Opacity="0.8" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </PivotItem>

                <PivotItem Header="Payment History">
                    <ListView ItemsSource="{x:Bind ViewModel.Repayments}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CustomerLedgerRowViewModel">
                                <Grid Padding="10" ColumnSpacing="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" MinWidth="140" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind DateText}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind EntryType}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Reference}" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind CreditText}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    <Button Grid.Column="4" Content="Print Receipt" Click="OnPrintReceiptClick" Tag="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </PivotItem>
            </Pivot>
        </Grid>
    </Grid>
</Page>
