<Page
    x:Class="Kirana.App.Views.SetupWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="48" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left" Spacing="12">

            <TextBlock Text="Set up your store" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="This information appears on invoices and is used across the app."
                       Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBlock Text="Store name *" />
            <TextBox Text="{x:Bind ViewModel.StoreName, Mode=TwoWay}" />

            <TextBlock Text="Owner name *" />
            <TextBox Text="{x:Bind ViewModel.OwnerName, Mode=TwoWay}" />

            <TextBlock Text="GSTIN (optional)" />
            <TextBox Text="{x:Bind ViewModel.Gstin, Mode=TwoWay}" />

            <TextBlock Text="Address" />
            <TextBox Text="{x:Bind ViewModel.Address, Mode=TwoWay}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="City" Text="{x:Bind ViewModel.City, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Header="State" Text="{x:Bind ViewModel.State, Mode=TwoWay}" />
                <TextBox Grid.Column="2" Header="PIN code" Text="{x:Bind ViewModel.PinCode, Mode=TwoWay}" />
            </Grid>

            <TextBox Header="Contact number" Text="{x:Bind ViewModel.ContactNumber, Mode=TwoWay}" />
            <TextBox Header="Email" Text="{x:Bind ViewModel.Email, Mode=TwoWay}" />

            <CheckBox Content="Enable GST billing" IsChecked="{x:Bind ViewModel.IsGstEnabled, Mode=TwoWay}" Margin="0,8,0,0" />
            <TextBox Header="Invoice prefix" Text="{x:Bind ViewModel.InvoicePrefix, Mode=TwoWay}" />

            <TextBlock Text="Admin account" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,0" />
            <TextBlock Text="You'll use this to unlock the management area from the billing screen."
                       Opacity="0.7" TextWrapping="Wrap" />

            <TextBox Header="Admin full name *" Text="{x:Bind ViewModel.AdminFullName, Mode=TwoWay}" />
            <TextBox Header="Admin username *" Text="{x:Bind ViewModel.AdminUsername, Mode=TwoWay}" />
            <PasswordBox Header="Admin password *" Password="{x:Bind ViewModel.AdminPassword, Mode=TwoWay}" />
            <PasswordBox Header="Quick-access PIN (optional)" Password="{x:Bind ViewModel.AdminPin, Mode=TwoWay}" />

            <InfoBar
                IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                Severity="Error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Margin="0,12,0,0" />

            <Button
                Content="Finish setup"
                Command="{x:Bind ViewModel.CompleteSetupCommand}"
                IsEnabled="{x:Bind ViewModel.IsSubmitting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Left"
                Margin="0,20,0,40" />

        </StackPanel>
    </ScrollViewer>
</Page>
