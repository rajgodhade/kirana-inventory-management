<Page
    x:Class="Kirana.App.Views.ManagementShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls="using:Kirana.App.Views.Controls">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Dedicated strip for the centered branding, on its own row above the app bar rather than
             overlaid on it. The app-bar's Column 1 ("*") stretches wide enough that the true header
             center lands inside the "Back to Billing" button's bounds — unlike the POS shell's
             simpler header, so the same ColumnSpan-overlay trick used there causes real visual
             overlap here. A dedicated full-width row sidesteps that without touching any existing
             app-bar control's position. -->
        <Border Grid.Row="0" Padding="0,4" Background="{ThemeResource NavigationBackgroundBrush}"
                BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
            <controls:HeaderBranding HorizontalAlignment="Center" />
        </Border>

        <!-- App bar: store identity on the left, session actions on the right. Persistent across
             every management screen, which is the point of the shell. -->
        <Grid Grid.Row="1" Padding="20,10" Background="{ThemeResource NavigationBackgroundBrush}"
              BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="{StaticResource RadiusMedium}"
                    Background="{ThemeResource BrandPrimaryBrush}" VerticalAlignment="Center">
                <TextBlock Text="K" FontSize="17" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                <TextBlock x:Name="StoreNameText" FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="Management" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>

            <Button Grid.Column="2" Click="OnBackToBillingClick" VerticalAlignment="Center" Padding="10,6"
                    CornerRadius="{StaticResource RadiusMedium}" AutomationProperties.Name="Back to Billing">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE7BF;" FontSize="14" />
                    <TextBlock Text="Back to Billing" />
                </StackPanel>
            </Button>

            <!-- Live store clock is persistent, so management users can stay oriented without
                 relying on the desktop taskbar. -->
            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock x:Name="CurrentDayDateText" Style="{StaticResource SecondaryTextStyle}"
                           HorizontalAlignment="Right" />
                <TextBlock x:Name="CurrentTimeText" Style="{StaticResource CaptionTextStyle}"
                           HorizontalAlignment="Right" />
            </StackPanel>

            <!-- Signed-in user, so it's never ambiguous whose actions are being audited. -->
            <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,4,0">
                <TextBlock x:Name="UserNameText" Style="{StaticResource SecondaryTextStyle}"
                           HorizontalAlignment="Right" />
                <TextBlock x:Name="UserRoleText" Style="{StaticResource CaptionTextStyle}"
                           HorizontalAlignment="Right" />
            </StackPanel>

            <Button Grid.Column="6" Click="OnThemeToggleClick" VerticalAlignment="Center"
                    AutomationProperties.Name="Toggle light and dark theme"
                    ToolTipService.ToolTip="Switch between light and dark">
                <FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="15" />
            </Button>

            <Button Grid.Column="7" Click="OnLockClick" VerticalAlignment="Center"
                    AutomationProperties.Name="Lock and return to billing">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72E;" FontSize="14" />
                    <TextBlock Text="Lock" />
                </StackPanel>
            </Button>
        </Grid>

        <muxc:NavigationView
            x:Name="Nav"
            Grid.Row="2"
            PaneDisplayMode="Left"
            OpenPaneLength="228"
            IsSettingsVisible="False"
            IsBackButtonVisible="Auto"
            IsPaneToggleButtonVisible="True"
            Background="Transparent"
            SelectionChanged="OnNavSelectionChanged"
            BackRequested="OnNavBackRequested">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Home" Tag="Home">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader Content="Catalogue" />

                <muxc:NavigationViewItem x:Name="NavProducts" Content="Products" Tag="Products">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BF;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavPromotions" Content="Promotions &amp; Offers" Tag="Promotions">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8EC;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavStockCounts" Content="Stock Counting" Tag="StockCounts">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavBarcodes" Content="Barcode Scan" Tag="Barcodes">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C1;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader x:Name="NavTradeHeader" Content="Trade" />

                <muxc:NavigationViewItem x:Name="NavInvoices" Content="Invoices" Tag="Invoices">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavCustomers" Content="Customers &amp; Udhaar" Tag="Customers">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavSuppliers" Content="Suppliers" Tag="Suppliers">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavPurchases" Content="Purchases" Tag="Purchases">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader x:Name="NavReturnsHeader" Content="Returns &amp; Money" />

                <muxc:NavigationViewItem x:Name="NavSalesReturns" Content="Sales Returns" Tag="SalesReturns">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7A7;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavPurchaseReturns" Content="Purchase Returns" Tag="PurchaseReturns">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B9;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavCashRegister" Content="Cash Register" Tag="CashRegister">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavExpenses" Content="Expenses" Tag="Expenses">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C7;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader x:Name="NavAdminHeader" Content="Administration" />

                <muxc:NavigationViewItem x:Name="NavUsers" Content="Users" Tag="Users">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavAudit" Content="Audit Log" Tag="Audit">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavReports" Content="Reports" Tag="Reports">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavSettings" Content="Settings" Tag="Settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavDeviceStatus" Content="Device Status" Tag="DeviceStatus">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavHardwareSettings" Content="Hardware Settings" Tag="HardwareSettings">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavHardwareDiagnostics" Content="Hardware Diagnostics" Tag="HardwareDiagnostics">
                    <muxc:NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItemHeader x:Name="NavDataHeader" Content="Data" />

                <muxc:NavigationViewItem x:Name="NavBackupManager" Content="Backup Manager" Tag="BackupManager">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavRestore" Content="Restore" Tag="Restore">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE777;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavExportCenter" Content="Export Center" Tag="ExportCenter">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEDE1;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem x:Name="NavDatabaseMaintenance" Content="Database Maintenance" Tag="DatabaseMaintenance">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F5;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </muxc:NavigationView>
    </Grid>
</Page>
