<UserControl
    x:Class="Kirana.App.Views.Reports.ProductReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels.Reports">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" Header="Report" ItemsSource="{x:Bind ViewModel.ReportTypes}"
                          SelectedItem="{x:Bind ViewModel.SelectedReportType, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" SelectionChanged="OnFilterChanged" />

                <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.DateFilter.PresetNames}"
                          SelectedItem="{x:Bind ViewModel.DateFilter.SelectedPresetName, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" SelectionChanged="OnFilterChanged" />

                <CalendarDatePicker Grid.Column="2" Header="From" Date="{x:Bind ViewModel.DateFilter.CustomFrom, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.DateFilter.IsCustomSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    DateChanged="OnDateChanged" />

                <CalendarDatePicker Grid.Column="3" Header="To" Date="{x:Bind ViewModel.DateFilter.CustomTo, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.DateFilter.IsCustomSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    DateChanged="OnDateChanged" />

                <Button Grid.Column="5" Click="OnRefreshClick" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="6" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="CSV" Click="OnExportCsvClick" />
                            <MenuFlyoutItem Text="Excel" Click="OnExportExcelClick" />
                            <MenuFlyoutItem Text="PDF" Click="OnExportPdfClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GenericReportRowViewModel">
                            <Grid Margin="0,0,0,10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind Primary}" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock Text="{x:Bind Secondary}" Style="{StaticResource CodeTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Column1Label}" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{x:Bind Column1Value}" Style="{StaticResource BodyTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="{x:Bind Column2Label}" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{x:Bind Column2Value}" Style="{StaticResource BodyTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="2">
                                    <TextBlock Text="{x:Bind Column3Label}" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Text="{x:Bind Column3Value}" Style="{StaticResource BodyTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
