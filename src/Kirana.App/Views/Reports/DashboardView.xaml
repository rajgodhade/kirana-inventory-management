<UserControl
    x:Class="Kirana.App.Views.Reports.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rpt="using:Kirana.Application.Reports">

    <UserControl.Resources>
        <!-- Chart tile chrome, defined once. Every chart card below is the same shape: elevated
             surface, 16px radius, generous inner padding — so the grid reads as one consistent
             family rather than nine individually-tuned boxes. -->
        <Style x:Key="ChartCardStyle" TargetType="Border" BasedOn="{StaticResource ElevatedCardStyle}">
            <Setter Property="Padding" Value="20,18" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================ COMPACT TOOLBAR ============================
             Sits flush, edge-to-edge, directly under the tab bar — visually connected to the
             page header/tabs above it rather than floating inside the scrollable content. -->
        <Border Grid.Row="0" Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource CardElevatedBorderBrush}" BorderThickness="0,0,0,1"
                Padding="24,8">
            <Grid ColumnSpacing="{StaticResource SpacingM}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE787;" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock Text="Period" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.DateFilter.PresetNames}"
                          SelectedItem="{x:Bind ViewModel.DateFilter.SelectedPresetName, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          CornerRadius="6" Padding="10,6"
                          SelectionChanged="OnDateFilterChanged"
                          AutomationProperties.Name="Report period" />

                <CalendarDatePicker Grid.Column="2" Date="{x:Bind ViewModel.DateFilter.CustomFrom, Mode=TwoWay}"
                                    PlaceholderText="From" VerticalAlignment="Center" CornerRadius="6"
                                    Visibility="{x:Bind ViewModel.DateFilter.IsCustomSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    DateChanged="OnDateFilterChanged"
                                    AutomationProperties.Name="Custom range start date" />

                <CalendarDatePicker Grid.Column="3" Date="{x:Bind ViewModel.DateFilter.CustomTo, Mode=TwoWay}"
                                    PlaceholderText="To" VerticalAlignment="Center" CornerRadius="6"
                                    Visibility="{x:Bind ViewModel.DateFilter.IsCustomSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    DateChanged="OnDateFilterChanged"
                                    AutomationProperties.Name="Custom range end date" />

                <ProgressRing Grid.Column="4" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" />

                <Button Grid.Column="5" Click="OnRefreshClick" VerticalAlignment="Center"
                        CornerRadius="6" Padding="12,6"
                        AutomationProperties.Name="Refresh dashboard">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        <TextBlock Text="Refresh" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpacingXL}">

            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <!-- ============================== KPI TILES ==============================
                 Each tile: icon chip, small uppercase-ish label, large value. Colour is assigned
                 by meaning (money in = green/teal, money out = amber, risk = rose) and stays
                 stable across loads so a shopkeeper learns the layout by position and hue. -->
            <Grid ColumnSpacing="{StaticResource SpacingL}" RowSpacing="{StaticResource SpacingL}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0 -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource KpiCardStyle}"
                        Background="{ThemeResource PastelGreenBrush}" BorderBrush="{ThemeResource PastelGreenBrush}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                        <FontIcon Grid.Column="0" Glyph="&#xE7BF;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0"
                                  HorizontalAlignment="Center" Foreground="{ThemeResource PastelGreenOnBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="SALES" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalSalesText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"
                                       Foreground="{ThemeResource PastelGreenOnBrush}" />
                            <TextBlock Text="in selected period" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource KpiCardStyle}"
                        Background="{ThemeResource PastelBlueBrush}" BorderBrush="{ThemeResource PastelBlueBrush}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                        <FontIcon Grid.Column="0" Glyph="&#xE7B8;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0"
                                  HorizontalAlignment="Center" Foreground="{ThemeResource PastelBlueOnBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="PURCHASES" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalPurchasesText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"
                                       Foreground="{ThemeResource PastelBlueOnBrush}" />
                            <TextBlock Text="stock bought in" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource KpiCardStyle}"
                        Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                        <FontIcon Grid.Column="0" Glyph="&#xE8C7;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0"
                                  HorizontalAlignment="Center" Foreground="{ThemeResource PastelAmberOnBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="EXPENSES" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TotalExpensesText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"
                                       Foreground="{ThemeResource PastelAmberOnBrush}" />
                            <TextBlock Text="money spent" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource KpiCardStyle}"
                        Background="{ThemeResource PastelVioletBrush}" BorderBrush="{ThemeResource PastelVioletBrush}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                        <FontIcon Grid.Column="0" Glyph="&#xE9F9;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0"
                                  HorizontalAlignment="Center" Foreground="{ThemeResource PastelVioletOnBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="BILLS" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.BillCountText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"
                                       Foreground="{ThemeResource PastelVioletOnBrush}" />
                            <TextBlock Text="invoices issued" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1 -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource KpiCardStyle}"
                        Background="{ThemeResource PastelTealBrush}" BorderBrush="{ThemeResource PastelTealBrush}"
                        Visibility="{x:Bind ViewModel.CanViewProfit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                        <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0"
                                  HorizontalAlignment="Center" Foreground="{ThemeResource PastelTealOnBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="EST. GROSS PROFIT" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelTealOnBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.GrossProfitText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"
                                       Foreground="{ThemeResource PastelTealOnBrush}" />
                            <TextBlock Text="estimated" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelTealOnBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource KpiCardStyle}"
                        Background="{ThemeResource PastelTealBrush}" BorderBrush="{ThemeResource PastelTealBrush}"
                        Visibility="{x:Bind ViewModel.CanViewProfit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                        <FontIcon Grid.Column="0" Glyph="&#xE9D2;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0"
                                  HorizontalAlignment="Center" Foreground="{ThemeResource PastelTealOnBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="EST. NET PROFIT" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelTealOnBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.NetProfitText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"
                                       Foreground="{ThemeResource PastelTealOnBrush}" />
                            <TextBlock Text="after expenses" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelTealOnBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource KpiCardStyle}"
                        Background="{ThemeResource PastelBlueBrush}" BorderBrush="{ThemeResource PastelBlueBrush}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                        <FontIcon Grid.Column="0" Glyph="&#xE7B8;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0"
                                  HorizontalAlignment="Center" Foreground="{ThemeResource PastelBlueOnBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="ITEMS SOLD" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ItemsSoldText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"
                                       Foreground="{ThemeResource PastelBlueOnBrush}" />
                            <TextBlock Text="units" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource KpiCardStyle}"
                        Background="{ThemeResource PastelVioletBrush}" BorderBrush="{ThemeResource PastelVioletBrush}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                        <FontIcon Grid.Column="0" Glyph="&#xE821;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0"
                                  HorizontalAlignment="Center" Foreground="{ThemeResource PastelVioletOnBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="INVENTORY VALUE" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.InventoryValueText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"
                                       Foreground="{ThemeResource PastelVioletOnBrush}" />
                            <TextBlock Text="as of now" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 2 — the "needs attention" band, all in warning/risk hues. -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource KpiCardStyle}"
                        Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                        <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0"
                                  HorizontalAlignment="Center" Foreground="{ThemeResource PastelAmberOnBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="LOW STOCK" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.LowStockCountText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"
                                       Foreground="{ThemeResource PastelAmberOnBrush}" />
                            <TextBlock Text="products at or below minimum" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource KpiCardStyle}"
                        Background="{ThemeResource PastelRoseBrush}" BorderBrush="{ThemeResource PastelRoseBrush}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                        <FontIcon Grid.Column="0" Glyph="&#xEA39;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0"
                                  HorizontalAlignment="Center" Foreground="{ThemeResource PastelRoseOnBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="OUT OF STOCK" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.OutOfStockCountText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"
                                       Foreground="{ThemeResource PastelRoseOnBrush}" />
                            <TextBlock Text="needs reordering" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource KpiCardStyle}"
                        Background="{ThemeResource PastelRoseBrush}" BorderBrush="{ThemeResource PastelRoseBrush}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                        <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0"
                                  HorizontalAlignment="Center" Foreground="{ThemeResource PastelRoseOnBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="CUSTOMER UDHAAR" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.CustomerOutstandingText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"
                                       Foreground="{ThemeResource PastelRoseOnBrush}" />
                            <TextBlock Text="owed to you now" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource KpiCardStyle}"
                        Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity="0.65" />
                        <FontIcon Grid.Column="0" Glyph="&#xE7B8;" FontSize="16" VerticalAlignment="Top" Margin="0,10,0,0"
                                  HorizontalAlignment="Center" Foreground="{ThemeResource PastelAmberOnBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="SUPPLIER PAYABLE" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SupplierOutstandingText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"
                                       Foreground="{ThemeResource PastelAmberOnBrush}" />
                            <TextBlock Text="you owe now" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================== WIDGETS ============================== -->
            <TextBlock Text="At a glance" Style="{StaticResource SectionTitleTextStyle}" />
            <Grid ColumnSpacing="{StaticResource SpacingL}" RowSpacing="{StaticResource SpacingL}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Top Selling Products -->
                <Border Grid.Column="0" Style="{StaticResource ChartCardStyle}">
                    <StackPanel Spacing="{StaticResource SpacingM}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{ThemeResource ChartSeriesPrimaryBrush}" />
                            <TextBlock Text="Top Selling Products" Style="{StaticResource ChartCardTitleTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.TopSellingEmptyText, Mode=OneWay}"
                                   Style="{StaticResource ChartCardSubtitleTextStyle}"
                                   Visibility="{x:Bind ViewModel.TopSellingEmptyText, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopSellingProducts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rpt:ProductSalesRow">
                                    <Grid ColumnSpacing="10" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="1">
                                            <TextBlock Text="{x:Bind ProductName}" Style="{StaticResource BodyTextStyle}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{x:Bind ProductCode}" Style="{StaticResource CodeTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind Revenue, Converter={StaticResource CurrencyConverter}}"
                                                       Style="{StaticResource AmountTextStyle}" FontSize="13" />
                                            <TextBlock Text="{x:Bind QuantitySold, Converter={StaticResource QuantityConverter}}"
                                                       Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Low Stock -->
                <Border Grid.Column="1" Style="{StaticResource ChartCardStyle}">
                    <StackPanel Spacing="{StaticResource SpacingM}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource WarningBrush}" />
                            <TextBlock Text="Low Stock" Style="{StaticResource ChartCardTitleTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="Everything is above its minimum level." Style="{StaticResource ChartCardSubtitleTextStyle}"
                                   Visibility="{x:Bind ViewModel.HasNoLowStock, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.LowStockItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rpt:InventoryRow">
                                    <Grid ColumnSpacing="10" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="1">
                                            <TextBlock Text="{x:Bind ProductName}" Style="{StaticResource BodyTextStyle}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{x:Bind ProductCode}" Style="{StaticResource CodeTextStyle}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}"
                                                CornerRadius="{StaticResource RadiusPill}"
                                                Background="{ThemeResource PastelAmberBrush}">
                                            <TextBlock Text="{x:Bind QuantityOnHand, Converter={StaticResource QuantityConverter}}"
                                                       Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Recent Sales -->
                <Border Grid.Column="2" Style="{StaticResource ChartCardStyle}">
                    <StackPanel Spacing="{StaticResource SpacingM}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BF;" FontSize="14" Foreground="{ThemeResource SuccessBrush}" />
                            <TextBlock Text="Recent Sales" Style="{StaticResource ChartCardTitleTextStyle}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RecentSales}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rpt:RecentSaleRow">
                                    <Grid ColumnSpacing="10" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind InvoiceNumber}" Style="{StaticResource CodeTextStyle}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind GrandTotal, Converter={StaticResource CurrencyConverter}}"
                                                   Style="{StaticResource AmountTextStyle}" FontSize="13" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Device Status -->
                <Border Grid.Column="3" Style="{StaticResource ChartCardStyle}">
                    <StackPanel Spacing="{StaticResource SpacingM}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE772;" FontSize="14" Foreground="{ThemeResource InfoBrush}" />
                            <TextBlock Text="Device Status" Style="{StaticResource ChartCardTitleTextStyle}" />
                        </StackPanel>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="8" Height="8" CornerRadius="{StaticResource RadiusPill}"
                                    VerticalAlignment="Center" Background="{ThemeResource SuccessBrush}" />
                            <StackPanel Grid.Column="1" Spacing="0">
                                <TextBlock Text="Database" Style="{StaticResource BodyTextStyle}" FontSize="13" />
                                <TextBlock Text="{x:Bind ViewModel.DatabaseStatusText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Green only when a printer genuinely exists; amber otherwise. Never
                                 shows a healthy dot it hasn't actually verified. -->
                            <Border Grid.Column="0" Width="8" Height="8" CornerRadius="{StaticResource RadiusPill}"
                                    VerticalAlignment="Center" Background="{ThemeResource SuccessBrush}"
                                    Visibility="{x:Bind ViewModel.HasPrinter, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Border Grid.Column="0" Width="8" Height="8" CornerRadius="{StaticResource RadiusPill}"
                                    VerticalAlignment="Center" Background="{ThemeResource WarningBrush}"
                                    Visibility="{x:Bind ViewModel.HasPrinter, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            <StackPanel Grid.Column="1" Spacing="0">
                                <TextBlock Text="{x:Bind ViewModel.PrinterCountText, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" FontSize="13" />
                                <TextBlock Text="{x:Bind ViewModel.DefaultPrinterText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- =============================== CHARTS =============================== -->
            <TextBlock Text="Trends &amp; breakdowns" Style="{StaticResource SectionTitleTextStyle}" />
            <Grid ColumnSpacing="{StaticResource SpacingL}" RowSpacing="{StaticResource SpacingL}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ChartCardStyle}">
                    <StackPanel Spacing="{StaticResource SpacingM}">
                        <StackPanel Spacing="1">
                            <TextBlock Text="Daily Sales Trend" Style="{StaticResource ChartCardTitleTextStyle}" />
                            <TextBlock Text="Revenue per day in the selected period" Style="{StaticResource ChartCardSubtitleTextStyle}" />
                        </StackPanel>
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DailySalesTrend}" ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ChartCardStyle}">
                    <StackPanel Spacing="{StaticResource SpacingM}">
                        <StackPanel Spacing="1">
                            <TextBlock Text="Weekly Sales" Style="{StaticResource ChartCardTitleTextStyle}" />
                            <TextBlock Text="Grouped by week" Style="{StaticResource ChartCardSubtitleTextStyle}" />
                        </StackPanel>
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.WeeklySales}" ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ChartCardStyle}">
                    <StackPanel Spacing="{StaticResource SpacingM}">
                        <StackPanel Spacing="1">
                            <TextBlock Text="Monthly Sales" Style="{StaticResource ChartCardTitleTextStyle}" />
                            <TextBlock Text="Grouped by month" Style="{StaticResource ChartCardSubtitleTextStyle}" />
                        </StackPanel>
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.MonthlySales}" ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChartCardStyle}">
                    <StackPanel Spacing="{StaticResource SpacingM}">
                        <StackPanel Spacing="1">
                            <TextBlock Text="Sales vs Expenses" Style="{StaticResource ChartCardTitleTextStyle}" />
                            <TextBlock Text="Last 6 months" Style="{StaticResource ChartCardSubtitleTextStyle}" />
                        </StackPanel>
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SalesVsExpensesSales}" ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SalesVsExpensesExpenses}" ItemTemplate="{StaticResource ChartBarItemTemplateSecondary}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" Background="{ThemeResource ChartSeriesPrimaryBrush}" CornerRadius="{StaticResource RadiusPill}" />
                                <TextBlock Text="Sales" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" Background="{ThemeResource ChartSeriesSecondaryBrush}" CornerRadius="{StaticResource RadiusPill}" />
                                <TextBlock Text="Expenses" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ChartCardStyle}"
                        Visibility="{x:Bind ViewModel.CanViewProfit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="{StaticResource SpacingM}">
                        <StackPanel Spacing="1">
                            <TextBlock Text="Gross Profit Trend" Style="{StaticResource ChartCardTitleTextStyle}" />
                            <TextBlock Text="Last 6 months, estimated" Style="{StaticResource ChartCardSubtitleTextStyle}" />
                        </StackPanel>
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.GrossProfitTrend}" ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ChartCardStyle}">
                    <StackPanel Spacing="{StaticResource SpacingM}">
                        <StackPanel Spacing="1">
                            <TextBlock Text="Payment Methods" Style="{StaticResource ChartCardTitleTextStyle}" />
                            <TextBlock Text="How customers paid" Style="{StaticResource ChartCardSubtitleTextStyle}" />
                        </StackPanel>
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PaymentMethodDistribution}" ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ChartCardStyle}">
                    <StackPanel Spacing="{StaticResource SpacingM}">
                        <StackPanel Spacing="1">
                            <TextBlock Text="Category Sales" Style="{StaticResource ChartCardTitleTextStyle}" />
                            <TextBlock Text="Revenue by product category" Style="{StaticResource ChartCardSubtitleTextStyle}" />
                        </StackPanel>
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ProductCategorySales}" ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ChartCardStyle}">
                    <StackPanel Spacing="{StaticResource SpacingM}">
                        <StackPanel Spacing="1">
                            <TextBlock Text="Top Customers" Style="{StaticResource ChartCardTitleTextStyle}" />
                            <TextBlock Text="By revenue in this period" Style="{StaticResource ChartCardSubtitleTextStyle}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopCustomersChart}" ItemTemplate="{StaticResource RankingBarItemTemplate}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ChartCardStyle}">
                    <StackPanel Spacing="{StaticResource SpacingM}">
                        <StackPanel Spacing="1">
                            <TextBlock Text="Top Suppliers" Style="{StaticResource ChartCardTitleTextStyle}" />
                            <TextBlock Text="By purchase value" Style="{StaticResource ChartCardSubtitleTextStyle}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopSuppliersChart}" ItemTemplate="{StaticResource RankingBarItemTemplate}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- =========================== RECENT ACTIVITY =========================== -->
            <TextBlock Text="Recent activity" Style="{StaticResource SectionTitleTextStyle}" />
            <Grid ColumnSpacing="{StaticResource SpacingL}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ChartCardStyle}">
                    <StackPanel Spacing="{StaticResource SpacingM}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7B8;" FontSize="14" Foreground="{ThemeResource ChartSeriesTertiaryBrush}" />
                            <TextBlock Text="Recent Purchases" Style="{StaticResource ChartCardTitleTextStyle}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RecentPurchases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rpt:RecentPurchaseRow">
                                    <Grid ColumnSpacing="10" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind PurchaseNumber}" Style="{StaticResource CodeTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind GrandTotal, Converter={StaticResource CurrencyConverter}}"
                                                   Style="{StaticResource AmountTextStyle}" FontSize="13" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ChartCardStyle}">
                    <StackPanel Spacing="{StaticResource SpacingM}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7A7;" FontSize="14" Foreground="{ThemeResource DangerBrush}" />
                            <TextBlock Text="Recent Returns" Style="{StaticResource ChartCardTitleTextStyle}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RecentReturns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rpt:RecentReturnRow">
                                    <Grid ColumnSpacing="10" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind ReturnNumber}" Style="{StaticResource CodeTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}"
                                                   Style="{StaticResource AmountTextStyle}" FontSize="13" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ChartCardStyle}">
                    <StackPanel Spacing="{StaticResource SpacingM}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C7;" FontSize="14" Foreground="{ThemeResource WarningBrush}" />
                            <TextBlock Text="Recent Expenses" Style="{StaticResource ChartCardTitleTextStyle}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RecentExpenses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rpt:RecentExpenseRow">
                                    <Grid ColumnSpacing="10" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind ExpenseNumber}" Style="{StaticResource CodeTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}"
                                                   Style="{StaticResource AmountTextStyle}" FontSize="13" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
