<UserControl
    x:Class="Kirana.App.Views.Reports.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rpt="using:Kirana.Application.Reports">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20">

            <!-- Date filter -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" ItemsSource="{x:Bind ViewModel.DateFilter.PresetNames}"
                          SelectedItem="{x:Bind ViewModel.DateFilter.SelectedPresetName, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" SelectionChanged="OnDateFilterChanged" />

                <CalendarDatePicker Grid.Column="1" Header="From" Date="{x:Bind ViewModel.DateFilter.CustomFrom, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.DateFilter.IsCustomSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    DateChanged="OnDateFilterChanged" />

                <CalendarDatePicker Grid.Column="2" Header="To" Date="{x:Bind ViewModel.DateFilter.CustomTo, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.DateFilter.IsCustomSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    DateChanged="OnDateFilterChanged" />

                <Button Grid.Column="4" Click="OnRefreshClick" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <!-- KPI tiles -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Sales" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalSalesText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Purchases" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalPurchasesText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Expenses" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalExpensesText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource WarningBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Bills" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.BillCountText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}"
                        Visibility="{x:Bind ViewModel.CanViewProfit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Est. Gross Profit" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.GrossProfitText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource SuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}"
                        Visibility="{x:Bind ViewModel.CanViewProfit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Est. Net Profit" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.NetProfitText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource SuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Items Sold" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ItemsSoldText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Inventory Value (now)" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.InventoryValueText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Low Stock (now)" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.LowStockCountText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource WarningBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Out of Stock (now)" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.OutOfStockCountText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource DangerBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Customer Outstanding (now)" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CustomerOutstandingText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource DangerBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Supplier Outstanding (now)" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SupplierOutstandingText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource WarningBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Charts -->
            <TextBlock Text="Charts" Style="{StaticResource SectionTitleTextStyle}" />
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Daily Sales Trend" Style="{StaticResource CardTitleTextStyle}" />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DailySalesTrend}" ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Weekly Sales" Style="{StaticResource CardTitleTextStyle}" />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.WeeklySales}" ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Monthly Sales" Style="{StaticResource CardTitleTextStyle}" />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.MonthlySales}" ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Sales vs Expenses (6 mo)" Style="{StaticResource CardTitleTextStyle}" />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SalesVsExpensesSales}" ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SalesVsExpensesExpenses}" ItemTemplate="{StaticResource ChartBarItemTemplateSecondary}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="10" Height="10" Background="{ThemeResource BrandPrimaryBrush}" CornerRadius="2" />
                                <TextBlock Text="Sales" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="10" Height="10" Background="{ThemeResource WarningBrush}" CornerRadius="2" />
                                <TextBlock Text="Expenses" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}"
                        Visibility="{x:Bind ViewModel.CanViewProfit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Gross Profit Trend (6 mo)" Style="{StaticResource CardTitleTextStyle}" />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.GrossProfitTrend}" ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Payment Method Distribution" Style="{StaticResource CardTitleTextStyle}" />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.PaymentMethodDistribution}" ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Product Category Sales" Style="{StaticResource CardTitleTextStyle}" />
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ProductCategorySales}" ItemTemplate="{StaticResource ChartBarItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Top Customers" Style="{StaticResource CardTitleTextStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopCustomersChart}" ItemTemplate="{StaticResource RankingBarItemTemplate}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Top Suppliers" Style="{StaticResource CardTitleTextStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TopSuppliersChart}" ItemTemplate="{StaticResource RankingBarItemTemplate}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent activity -->
            <TextBlock Text="Recent Activity" Style="{StaticResource SectionTitleTextStyle}" />
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Recent Sales" Style="{StaticResource CardTitleTextStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RecentSales}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rpt:RecentSaleRow">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{x:Bind InvoiceNumber}" Style="{StaticResource CodeTextStyle}" />
                                        <TextBlock Text="{x:Bind GrandTotal, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Recent Purchases" Style="{StaticResource CardTitleTextStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RecentPurchases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rpt:RecentPurchaseRow">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{x:Bind PurchaseNumber}" Style="{StaticResource CodeTextStyle}" />
                                        <TextBlock Text="{x:Bind GrandTotal, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Recent Returns" Style="{StaticResource CardTitleTextStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RecentReturns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rpt:RecentReturnRow">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{x:Bind ReturnNumber}" Style="{StaticResource CodeTextStyle}" />
                                        <TextBlock Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Recent Expenses" Style="{StaticResource CardTitleTextStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RecentExpenses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rpt:RecentExpenseRow">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{x:Bind ExpenseNumber}" Style="{StaticResource CodeTextStyle}" />
                                        <TextBlock Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource BodyTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
