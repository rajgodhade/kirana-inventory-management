<UserControl
    x:Class="Kirana.App.Views.Reports.ProfitReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" ItemsSource="{x:Bind ViewModel.DateFilter.PresetNames}"
                          SelectedItem="{x:Bind ViewModel.DateFilter.SelectedPresetName, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" SelectionChanged="OnDateFilterChanged" />

                <CalendarDatePicker Grid.Column="1" Header="From" Date="{x:Bind ViewModel.DateFilter.CustomFrom, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.DateFilter.IsCustomSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    DateChanged="OnDateFilterChanged" />

                <CalendarDatePicker Grid.Column="2" Header="To" Date="{x:Bind ViewModel.DateFilter.CustomTo, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.DateFilter.IsCustomSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    DateChanged="OnDateFilterChanged" />

                <Button Grid.Column="4" Click="OnRefreshClick" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="5" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="CSV" Click="OnExportCsvClick" />
                            <MenuFlyoutItem Text="Excel" Click="OnExportExcelClick" />
                            <MenuFlyoutItem Text="PDF" Click="OnExportPdfClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <TextBlock Text="Estimated: cost of goods sold uses the product's current purchase price, since sale records do not snapshot historical cost."
                       Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Gross Sales" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.GrossSalesText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Returns" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ReturnsText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource DangerBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Revenue (Net Sales)" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.RevenueText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Est. Cost of Goods Sold" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CogsText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Est. Gross Profit" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.GrossProfitText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource SuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Expenses" Style="{StaticResource MetricLabelTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ExpensesText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20"
                                   Foreground="{ThemeResource WarningBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Est. Net Profit" Style="{StaticResource MetricLabelTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.NetProfitText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="28"
                               Foreground="{ThemeResource SuccessBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
