<UserControl
    x:Class="Kirana.App.Views.Reports.CustomerReportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cust="using:Kirana.Application.Customers"
    xmlns:rpt="using:Kirana.Application.Reports">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20">

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" Header="Top Customers period" ItemsSource="{x:Bind ViewModel.DateFilter.PresetNames}"
                          SelectedItem="{x:Bind ViewModel.DateFilter.SelectedPresetName, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" SelectionChanged="OnFilterChanged" />

                <CalendarDatePicker Grid.Column="1" Header="From" Date="{x:Bind ViewModel.DateFilter.CustomFrom, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.DateFilter.IsCustomSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    DateChanged="OnDateChanged" />

                <CalendarDatePicker Grid.Column="2" Header="To" Date="{x:Bind ViewModel.DateFilter.CustomTo, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.DateFilter.IsCustomSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    DateChanged="OnDateChanged" />

                <Button Grid.Column="4" Click="OnRefreshClick" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="5" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="Export" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="CSV" Click="OnExportCsvClick" />
                            <MenuFlyoutItem Text="Excel" Click="OnExportExcelClick" />
                            <MenuFlyoutItem Text="PDF" Click="OnExportPdfClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <TextBlock Text="Outstanding Udhaar" Style="{StaticResource SectionTitleTextStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Total Outstanding" Style="{StaticResource MetricLabelTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.TotalOutstandingText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" FontSize="20"
                               Foreground="{ThemeResource DangerBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.OutstandingRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="cust:CustomerOutstandingSummary">
                            <Grid Margin="0,0,0,10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock Text="{x:Bind CustomerCode}" Style="{StaticResource CodeTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind Phone}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind OutstandingAmount, Converter={StaticResource CurrencyConverter}}"
                                           Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind OpenCreditCount}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="Top Customers" Style="{StaticResource SectionTitleTextStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.TopCustomers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="rpt:RankedPartyRow">
                            <Grid Margin="0,0,0,8" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind TransactionCount}" Style="{StaticResource BodyTextStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
