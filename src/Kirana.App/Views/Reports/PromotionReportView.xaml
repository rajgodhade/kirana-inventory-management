<UserControl x:Class="Kirana.App.Views.Reports.PromotionReportView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:promo="using:Kirana.Application.Promotions">
    <ScrollViewer><StackPanel Padding="0,12,0,24" Spacing="14">
        <TextBlock Text="Promotion performance - this month" Style="{StaticResource SectionTitleTextStyle}" />
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelGreenBrush}"><StackPanel><TextBlock Text="REVENUE" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock Text="{x:Bind ViewModel.RevenueText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelAmberBrush}"><StackPanel><TextBlock Text="DISCOUNT GIVEN" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock Text="{x:Bind ViewModel.DiscountText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelBlueBrush}"><StackPanel><TextBlock Text="SALES" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock Text="{x:Bind ViewModel.SalesText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelVioletBrush}"><StackPanel><TextBlock Text="PRODUCTS SOLD" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock Text="{x:Bind ViewModel.ProductsText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelRoseBrush}"><StackPanel><TextBlock Text="MOST USED" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock Text="{x:Bind ViewModel.MostUsedText, Mode=OneWay}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
        </Grid>
        <Border Style="{StaticResource CardBorderStyle}" Padding="0"><StackPanel><Grid Padding="14,10" Background="{ThemeResource SurfaceAltBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="140" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><TextBlock Text="PROMOTION" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="1" Text="REVENUE" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="2" Text="DISCOUNT" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="3" Text="SALES" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="4" Text="QTY" Style="{StaticResource ColumnHeaderTextStyle}" /></Grid><ItemsControl ItemsSource="{x:Bind ViewModel.Rows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="promo:PromotionPerformanceRow"><Grid Padding="14,12" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="140" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind PromotionName}" FontWeight="SemiBold" /><TextBlock Text="{x:Bind PromotionCode}" Style="{StaticResource CodeTextStyle}" /></StackPanel><TextBlock Grid.Column="1" Text="{x:Bind Revenue, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource AmountTextStyle}" /><TextBlock Grid.Column="2" Text="{x:Bind DiscountGiven, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource AmountTextStyle}" /><TextBlock Grid.Column="3" Text="{x:Bind SalesGenerated}" /><TextBlock Grid.Column="4" Text="{x:Bind ProductsSold, Converter={StaticResource QuantityConverter}}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
    </StackPanel></ScrollViewer>
</UserControl>
