<Page
    x:Class="Kirana.App.Views.NewSalesReturnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    xmlns:ret="using:Kirana.Application.Returns">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <StackPanel Spacing="2">
                <TextBlock Text="New Sales Return" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Find the original invoice, choose what is coming back, then refund."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <!-- Step 1: find the sale -->
        <StackPanel Grid.Row="1" Padding="24,0,24,12" Spacing="10">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="1 · Find the invoice" Style="{StaticResource SectionTitleTextStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Grid.Column="0"
                                 PlaceholderText="Invoice number, barcode, product or customer"
                                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnSearchKeyDown" TextChanged="OnSearchTextChanged" />
                        <Button Grid.Column="1" Content="Search" Click="OnSearchClick" />
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.Candidates}" MaxHeight="150"
                              SelectionMode="Single" SelectionChanged="OnCandidateSelected"
                              Visibility="{x:Bind ViewModel.HasSelectedSale, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="ret:ReturnableSale">
                                <Grid Padding="4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind InvoiceNumber}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind CustomerName}" Opacity="0.75" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind GrandTotal, Converter={StaticResource CurrencyConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid ColumnSpacing="12"
                          Visibility="{x:Bind ViewModel.HasSelectedSale, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SelectedSaleHeader, Mode=OneWay}"
                                   Style="{StaticResource CardTitleTextStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Choose a different invoice" Click="OnClearSaleClick" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Step 2: pick lines -->
        <Grid Grid.Row="2" Margin="24,0,24,12"
              Visibility="{x:Bind ViewModel.HasSelectedSale, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="14,10" ColumnSpacing="12"
                          Background="{ThemeResource SurfaceAltBrush}"
                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="2 · PRODUCT" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="SOLD" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="PRICE" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="RETURN QTY" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="4" Text="CONDITION" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="5" Text="LINE VALUE" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Lines}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReturnLineViewModel">
                                <Grid Padding="14,10" ColumnSpacing="12"
                                      BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="180" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ProductName}" Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ProductCode}" Style="{StaticResource CodeTextStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind SoldText}" Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock Text="{x:Bind ReturnableText}" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{x:Bind UnitPriceText}" Style="{StaticResource BodyTextStyle}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <TextBox Grid.Column="3" Text="{x:Bind QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{x:Bind CanReturn}" TextAlignment="Center" VerticalAlignment="Center" />

                                    <CheckBox Grid.Column="4" Content="Damaged" IsChecked="{x:Bind IsDamaged, Mode=TwoWay}"
                                              IsEnabled="{x:Bind CanReturn}" VerticalAlignment="Center"
                                              ToolTipService.ToolTip="Damaged goods do not go back into sellable stock" />

                                    <TextBlock Grid.Column="5" Text="{x:Bind LineTotalText, Mode=OneWay}"
                                               Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Step 3: refund -->
        <StackPanel Grid.Row="3" Padding="24,0,24,20" Spacing="10">
            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Informational" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <Border Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.HasSelectedSale, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" Header="3 · Refund method" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.RefundMethods}"
                              SelectedItem="{x:Bind ViewModel.SelectedRefundMethod, Mode=TwoWay}" />

                    <TextBox Grid.Column="1" Header="Reference # (optional)"
                             Text="{x:Bind ViewModel.RefundReference, Mode=TwoWay}" />

                    <TextBox Grid.Column="2" Header="Reason (optional)" Text="{x:Bind ViewModel.Reason, Mode=TwoWay}" />

                    <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnProcessClick"
                            VerticalAlignment="Bottom" Padding="20,9"
                            IsEnabled="{x:Bind ViewModel.CanProcessReturns}"
                            AutomationProperties.Name="Process Return">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                            <TextBlock Text="Process Return" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
