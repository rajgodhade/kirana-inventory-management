<UserControl
    x:Class="Kirana.App.Views.Controls.HeaderBranding"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Product identity + "powered by" credit, shared by the POS and Management shell headers
        (rather than duplicated XAML in each) so both stay in sync automatically. Static content —
        no DependencyProperties needed, unlike DeviceStatusWidget.

        This is the LEADING half of the header lockup: it sits at the far left of the header row and
        ends in a divider, with each shell's own store badge/name following it in the next columns.
        It is deliberately no longer centered across the header — the previous version was overlaid
        with Grid.ColumnSpan so it could center against the full row width, which made it collide
        with whatever the shell put in the middle columns. Left-aligning removes that whole class of
        problem: the lockup reads as one continuous "product | store" line and the shells can size
        their own columns freely.
    -->
    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">

        <StackPanel Spacing="0" VerticalAlignment="Center">
            <!-- Two Runs, not one string: the wordmark sets "OS" in the brand colour against a
                 neutral "VYAPAR". Runs (rather than two TextBlocks) keep it a single text flow, so
                 the two halves stay on one baseline with no seam at any font scale.

                 The two Runs MUST stay on one line with no whitespace between the tags — XAML
                 collapses inter-Run whitespace into a real space and the wordmark renders as
                 "VYAPAR OS". -->
            <TextBlock FontSize="20" FontWeight="Bold" CharacterSpacing="20" LineHeight="24"><Run Text="VYAPAR" Foreground="{ThemeResource TextPrimaryBrush}" /><Run Text="OS" Foreground="{ThemeResource BrandPrimaryBrush}" /></TextBlock>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <!-- CharacterSpacing is in 1/1000 em; the wide tracking is what makes a 10pt
                     uppercase line read as a credit rather than as cramped body text. -->
                <TextBlock Text="POWERED BY" FontSize="10" FontWeight="SemiBold"
                           CharacterSpacing="60"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />

                <!-- HyperlinkButton.NavigateUri launches the system default browser on click with no
                     code-behind required. Padding/MinWidth/MinHeight zeroed out — the stock Button
                     chrome it inherits would otherwise add visible bulk in this compact header row. -->
                <HyperlinkButton NavigateUri="https://www.stackveil.com/"
                                 Padding="0" MinWidth="0" MinHeight="0" Margin="0" Background="Transparent"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="Powered by StackVeil"
                                 ToolTipService.ToolTip="Visit StackVeil website">
                    <TextBlock Text="STACKVEIL" FontSize="10" FontWeight="SemiBold"
                               CharacterSpacing="60"
                               Foreground="{ThemeResource BrandPrimaryBrush}" />
                </HyperlinkButton>
            </StackPanel>
        </StackPanel>

        <!-- Separates the product lockup from the store identity that follows. Fixed height rather
             than Stretch so it stays a short rule against the two text lines instead of growing to
             the full header padding. -->
        <Rectangle Width="1" Height="36" VerticalAlignment="Center"
                   Fill="{ThemeResource SurfaceBorderBrush}" />
    </StackPanel>
</UserControl>
