<UserControl
    x:Class="Kirana.App.Views.Controls.HeaderBranding"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Product identity + "powered by" credit, shared by the POS and Management shell headers
        (rather than duplicated XAML in each) so both stay in sync automatically. Static content —
        no DependencyProperties needed, unlike DeviceStatusWidget.

        HorizontalAlignment="Center" here only centers this StackPanel *within whatever cell it's
        placed in* — true centering relative to the whole header (independent of how wide the
        store-info block on the left or the toolbar buttons on the right happen to be) is the
        consuming header's job: it must place this control with Grid.ColumnSpan covering every
        column in that header's Grid, so the span (not just this element) is centered against the
        full row width.
    -->
    <StackPanel Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="VyaparOS" FontSize="16" FontWeight="Bold"
                   Foreground="{ThemeResource TextPrimaryBrush}"
                   HorizontalAlignment="Center" TextAlignment="Center" />

        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="Powered by" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />

            <!-- HyperlinkButton.NavigateUri launches the system default browser on click with no
                 code-behind required. Padding/MinWidth/MinHeight zeroed out — the stock Button
                 chrome it inherits would otherwise add visible bulk in this compact header row. -->
            <HyperlinkButton NavigateUri="https://www.stackveil.com/"
                             Padding="0" MinWidth="0" MinHeight="0" Margin="0" Background="Transparent"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="Powered by StackVeil"
                             ToolTipService.ToolTip="Visit StackVeil website">
                <TextBlock Text="StackVeil" FontSize="11" FontWeight="SemiBold"
                           Foreground="{ThemeResource BrandPrimaryBrush}" />
            </HyperlinkButton>
        </StackPanel>
    </StackPanel>
</UserControl>
