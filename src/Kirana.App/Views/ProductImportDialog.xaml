<ContentDialog
    x:Class="Kirana.App.Views.ProductImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    CloseButtonText="Close"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanCommit, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1320</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">980</x:Double>
        <SolidColorBrush x:Key="PreviewTableHeaderBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="PreviewTableBorderBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="PreviewTableTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="PreviewTableSecondaryBrush" Color="#6B7280" />
        <Style x:Key="PreviewFixButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0F766E" /><Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0F766E" /><Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="PreviewRemoveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#374151" />
            <Setter Property="BorderBrush" Value="#D1D5DB" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" /><Setter Property="CornerRadius" Value="6" />
        </Style>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Import Products" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Review every change before products are saved." Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                    Click="OnCloseIconClick" AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <ScrollViewer MaxHeight="680" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <!-- Wizard progress is textual as well as visual, so it works with keyboard and screen-reader navigation. -->
            <Grid ColumnSpacing="8" AutomationProperties.Name="Import progress: select file, preview and validation, import, results">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource PastelTealBrush}"><TextBlock Text="1  SELECT FILE" Foreground="{ThemeResource PastelTealOnBrush}" Style="{StaticResource BadgeTextStyle}" /></Border>
                <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource PastelBlueBrush}"><TextBlock Text="2  PREVIEW &amp; VALIDATION" Foreground="{ThemeResource PastelBlueOnBrush}" Style="{StaticResource BadgeTextStyle}" /></Border>
                <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource PastelAmberBrush}"><TextBlock Text="3  IMPORT" Foreground="{ThemeResource PastelAmberOnBrush}" Style="{StaticResource BadgeTextStyle}" /></Border>
                <Border Grid.Column="3" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource PastelGreenBrush}"><TextBlock Text="4  RESULTS" Foreground="{ThemeResource PastelGreenOnBrush}" Style="{StaticResource BadgeTextStyle}" /></Border>
            </Grid>

            <Border Style="{StaticResource ElevatedCardStyle}" Padding="16" AllowDrop="True" DragOver="OnFileDragOver" Drop="OnFileDrop"
                    AutomationProperties.Name="Drop a CSV or XLSX product file here, or choose a file">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource PastelBlueBrush}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" Foreground="{ThemeResource PastelBlueOnBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="Drop your product file here" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock Text="CSV or XLSX · drag and drop, or browse your computer" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.ImportReadinessText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Click="OnDownloadTemplateClick" AutomationProperties.Name="Download CSV sample template"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE896;" /><TextBlock Text="Sample template" /></StackPanel></Button>
                        <Button Click="OnChooseFileClick" Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Choose product import file"><TextBlock Text="Choose file" /></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Importing products..." Style="{StaticResource SecondaryTextStyle}" />
                <ProgressBar IsIndeterminate="True" Height="4" />
            </StackPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind ViewModel.HasFile, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3"><TextBlock Text="Selected file" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="File size" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{x:Bind ViewModel.FileSizeText, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3"><TextBlock Text="Rows found" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{x:Bind ViewModel.RowCount, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" /></StackPanel>
                    <StackPanel Grid.Column="3" Spacing="3"><TextBlock Text="Import readiness" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{x:Bind ViewModel.ImportReadinessText, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" /></StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2"><TextBlock Text="Preview &amp; validation" Style="{StaticResource SectionTitleTextStyle}" /><TextBlock Text="Review rows below. Errors are skipped by the existing import rules until you fix them." Style="{StaticResource SecondaryTextStyle}" /></StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" Style="{StaticResource CardTitleTextStyle}" VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelGreenBrush}" BorderBrush="{ThemeResource PastelGreenBrush}"><StackPanel><TextBlock Text="NEW PRODUCTS" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}" /><TextBlock Text="{x:Bind ViewModel.NewCount, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}" /></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}"><StackPanel><TextBlock Text="EXISTING TO UPDATE" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" /><TextBlock Text="{x:Bind ViewModel.UpdateCount, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" /></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelVioletBrush}" BorderBrush="{ThemeResource PastelVioletBrush}"><StackPanel><TextBlock Text="DUPLICATE PRODUCTS" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" /><TextBlock Text="{x:Bind ViewModel.UpdateCount, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" /></StackPanel></Border>
                    <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelRoseBrush}" BorderBrush="{ThemeResource PastelRoseBrush}"><StackPanel><TextBlock Text="ROWS WITH ERRORS" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" /><TextBlock Text="{x:Bind ViewModel.ErrorCount, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" /></StackPanel></Border>
                </Grid>
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12"
                        Visibility="{x:Bind ViewModel.HasNewReferenceData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="6"><TextBlock Text="New reference data" Foreground="#1D4ED8" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.NewReferenceDataText, Mode=OneWay}" Foreground="#475569" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.NewReferenceDataText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{x:Bind ViewModel.CommitDisabledReason, Mode=OneWay}" Foreground="{ThemeResource WarningBrush}" Style="{StaticResource SecondaryTextStyle}" Visibility="{x:Bind ViewModel.CanCommit, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                <Border Background="White" BorderBrush="{StaticResource PreviewTableBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="0">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="360" /></Grid.RowDefinitions>
                        <!-- The header lives outside the ListView, so it remains visible while a large preview scrolls. -->
                        <Grid Grid.Row="0" Padding="18,12" Background="{StaticResource PreviewTableHeaderBrush}" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="150" /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="ROW" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="1" Text="PRODUCT NAME" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="2" Text="PRODUCT CODE" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="3" Text="BARCODE" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="4" Text="SELLING PRICE" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="6" Text="VALIDATION / ERROR" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="7" Text="ACTIONS" Style="{StaticResource ColumnHeaderTextStyle}" />
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="MinHeight" Value="66" /></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate x:DataType="vm:ProductImportRowViewModel">
                            <Border Padding="18,13" BorderBrush="#FECACA" BorderThickness="{x:Bind IsError, Converter={StaticResource ErrorRowBorderConverter}}" Background="{x:Bind TableSurface, Converter={StaticResource ErrorRowBackgroundConverter}}" Opacity="{x:Bind RowOpacity, Mode=OneWay}"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="150" /><ColumnDefinition Width="130" /><ColumnDefinition Width="130" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind RowNumber}" Foreground="{StaticResource PreviewTableSecondaryBrush}" Style="{StaticResource CodeTextStyle}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{StaticResource PreviewTableTextBrush}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{x:Bind ProductCode}" Foreground="{StaticResource PreviewTableSecondaryBrush}" Style="{StaticResource CodeTextStyle}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="{x:Bind Barcode}" Foreground="{StaticResource PreviewTableSecondaryBrush}" Style="{StaticResource CodeTextStyle}" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="{x:Bind SellingPrice}" Foreground="{StaticResource PreviewTableTextBrush}" Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center" />
                                <Border Grid.Column="5" Background="#DCFCE7" CornerRadius="999" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{x:Bind IsNew, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#15803D" /><TextBlock Text="Ready" Foreground="#15803D" FontSize="12" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Grid.Column="5" Background="#FEF3C7" CornerRadius="999" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{x:Bind IsUpdate, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE777;" FontSize="12" Foreground="#B45309" /><TextBlock Text="Update" Foreground="#B45309" FontSize="12" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Grid.Column="5" Background="#FEE2E2" CornerRadius="999" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{x:Bind IsError, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xEA39;" FontSize="12" Foreground="#DC2626" /><TextBlock Text="Error" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" /></StackPanel></Border>
                                <StackPanel Grid.Column="6" Spacing="3" VerticalAlignment="Center" Visibility="{x:Bind IsError, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="#EA580C" /><TextBlock Text="Needs review" Foreground="#9A3412" FontWeight="SemiBold" FontSize="12" /></StackPanel><TextBlock Text="{x:Bind ErrorSummary}" Foreground="#9A3412" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ErrorSummary}" /></StackPanel><TextBlock Grid.Column="6" Text="Validated and ready to import" Foreground="{StaticResource PreviewTableSecondaryBrush}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Visibility="{x:Bind IsError, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button Content="Fix" Click="OnFixRowClick" Tag="{x:Bind}" Style="{StaticResource PreviewFixButtonStyle}" Visibility="{x:Bind IsError, Converter={StaticResource BoolToVisibilityConverter}}" /><Button Content="As new" Click="OnImportAsNewClick" Tag="{x:Bind}" Style="{StaticResource PreviewRemoveButtonStyle}" Visibility="{x:Bind IsDuplicateOfExisting, Converter={StaticResource BoolToVisibilityConverter}}" /><Button Content="Remove" Click="OnRemoveRowClick" Tag="{x:Bind}" Style="{StaticResource PreviewRemoveButtonStyle}" Visibility="{x:Bind ShowActions, Converter={StaticResource BoolToVisibilityConverter}}" /><Button Content="Undo" Click="OnUndoRemoveClick" Tag="{x:Bind}" Style="{StaticResource PreviewRemoveButtonStyle}" Visibility="{x:Bind IsRemoved, Converter={StaticResource BoolToVisibilityConverter}}" /></StackPanel>
                            </Grid></Border>
                        </DataTemplate></ListView.ItemTemplate></ListView>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="12" Padding="16">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE73E;" FontSize="28" Foreground="#15803D" /><StackPanel><TextBlock Text="Import completed successfully" FontSize="17" FontWeight="SemiBold" Foreground="#166534" /><TextBlock Text="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" Foreground="#166534" TextWrapping="Wrap" /></StackPanel></StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="16"><Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="IMPORTED" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{x:Bind ViewModel.CreatedCount, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="UPDATED" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{x:Bind ViewModel.UpdatedCount, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="SKIPPED" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{x:Bind ViewModel.SkippedCount, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" /></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="FAILED" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="0" Style="{StaticResource MetricTextStyle}" /></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="NEW CATEGORIES" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{x:Bind ViewModel.CategoriesCreated, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" /></StackPanel><StackPanel Grid.Column="5"><TextBlock Text="NEW BRANDS" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{x:Bind ViewModel.BrandsCreated, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" /></StackPanel><StackPanel Grid.Column="6"><TextBlock Text="TIME TAKEN" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" /></StackPanel>
                </Grid></Border>
                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="✓ Successfully imported" Foreground="#166534" FontWeight="SemiBold" /><TextBlock Text="{x:Bind ViewModel.ImportedAtText, Mode=OneWay}" Foreground="#166534" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{x:Bind ViewModel.RowsProcessed, Mode=OneWay}" Foreground="#166534" Style="{StaticResource CaptionTextStyle}" /></StackPanel></Border>
                <InfoBar IsOpen="{x:Bind ViewModel.HasSkippedRows, Mode=OneWay}" Severity="Warning" IsClosable="False" Title="Some rows were skipped" Message="Review the highlighted rows in the preview before importing another file." />
                <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="View Products" Click="OnViewProductsClick" Style="{StaticResource AccentButtonStyle}" /><Button Content="Import Another File" Click="OnImportAnotherFileClick" /><Button Content="Close" Click="OnCloseIconClick" /></StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
