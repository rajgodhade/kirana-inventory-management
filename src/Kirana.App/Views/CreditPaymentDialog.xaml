<ContentDialog
    x:Class="Kirana.App.Views.CreditPaymentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Receive Payment"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Record Udhaar Repayment" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                    Click="OnCloseIconClick" AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <StackPanel Spacing="12" MinWidth="400">
        <Grid Padding="14" Background="{ThemeResource SuccessSubtleBrush}" CornerRadius="{StaticResource RadiusMedium}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock x:Name="CustomerNameText" FontWeight="SemiBold" />
                <TextBlock x:Name="CustomerCodeText" FontSize="12" Opacity="0.6" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="OUTSTANDING AMOUNT" Style="{StaticResource KpiLabelTextStyle}" HorizontalAlignment="Right" />
                <TextBlock x:Name="OutstandingText" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <TextBox x:Name="AmountBox" Header="Payment amount" PlaceholderText="0.00" InputScope="Number" />
        <Button x:Name="PayFullButton" Content="Full payment" Click="OnPayFullClick" HorizontalAlignment="Left" />

        <ComboBox x:Name="MethodBox" Header="Payment Method" SelectedIndex="0" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Cash" Tag="Cash" />
            <ComboBoxItem Content="UPI" Tag="Upi" />
            <ComboBoxItem Content="Card" Tag="Card" />
        </ComboBox>

        <TextBox x:Name="ReferenceBox" Header="Reference number (optional)" />
        <TextBox x:Name="NotesBox" Header="Notes (optional)" />
        <CheckBox x:Name="PrintReceiptCheck" Content="Print receipt after saving" IsChecked="True" />

        <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" />
    </StackPanel>
</ContentDialog>
