<ContentDialog
    x:Class="Kirana.App.Views.ResetPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Reset Password"
    PrimaryButtonText="Reset"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="320">
        <PasswordBox x:Name="NewPasswordBox" Header="New password (min. 6 characters)" />
        <PasswordBox x:Name="ConfirmPasswordBox" Header="Confirm new password" />
        <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" />
    </StackPanel>
</ContentDialog>
