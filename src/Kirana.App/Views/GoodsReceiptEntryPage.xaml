<Page x:Class="Kirana.App.Views.GoodsReceiptEntryPage" x:Name="RootPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Kirana.App.ViewModels">
    <Grid Background="{ThemeResource PageBackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}"><StackPanel><TextBlock Text="Receive Goods" Style="{StaticResource PageTitleTextStyle}"/><TextBlock Text="Record what physically arrived. Inventory changes only after Create Purchase is finalized." Style="{StaticResource PageSubtitleTextStyle}"/></StackPanel></Grid>
        <Border Grid.Row="1" Margin="24,0,24,16" Style="{StaticResource ElevatedCardStyle}"><Grid ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PURCHASE ORDER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind ViewModel.PurchaseOrderNumber, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="SUPPLIER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind ViewModel.SupplierName, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="PO DATE" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind ViewModel.OrderDate, Mode=OneWay}"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"/></StackPanel></Grid></Border>
        <Border Grid.Row="2" Margin="24,0,24,16" Style="{StaticResource ElevatedCardStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Padding="16,12" Background="{ThemeResource SurfaceAltBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Text="PRODUCT" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="1" Text="ORDERED" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="2" Text="PREVIOUSLY RECEIVED" Style="{StaticResource ColumnHeaderTextStyle}" TextWrapping="Wrap"/><TextBlock Grid.Column="3" Text="RECEIVE NOW" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="4" Text="REMAINING" Style="{StaticResource ColumnHeaderTextStyle}"/></Grid>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Lines}" SelectionMode="None"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate x:DataType="vm:GoodsReceiptLineViewModel"><Grid Padding="16,12" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind ProductName}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ProductCode}" Style="{StaticResource CodeTextStyle}"/></StackPanel><TextBlock Grid.Column="1"><Run Text="{x:Bind Ordered}"/><Run Text=" "/><Run Text="{x:Bind Unit}"/></TextBlock><TextBlock Grid.Column="2" Text="{x:Bind PreviouslyReceived}"/><TextBox Grid.Column="3" Text="{x:Bind ReceivedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Bind}" TextChanged="OnQuantityChanged" AutomationProperties.Name="Received quantity"/><TextBlock Grid.Column="4" Text="{x:Bind RemainingAfter, Mode=OneWay}" FontWeight="SemiBold"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
            <Grid Grid.Row="2" Padding="16" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CalendarDatePicker Header="Received date" Date="{x:Bind ViewModel.ReceivedDate, Mode=TwoWay}"/><TextBox Grid.Column="1" Header="Notes" Text="{x:Bind ViewModel.Notes, Mode=TwoWay}"/><StackPanel Grid.Column="2"><TextBlock Text="TOTAL RECEIVED" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind ViewModel.TotalReceived, Mode=OneWay}" FontWeight="Bold" FontSize="18"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="REMAINING AFTER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind ViewModel.TotalRemaining, Mode=OneWay}" FontWeight="Bold" FontSize="18"/></StackPanel></Grid>
        </Grid></Border>
        <Grid Grid.Row="3" Margin="24,0,24,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource DangerBrush}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Cancel" Margin="0,0,8,0" Click="OnCancelClick"/><Button Grid.Column="2" Content="Review Receipt" Style="{StaticResource AccentButtonStyle}" Click="OnReviewClick"/></Grid>
    </Grid>
</Page>
