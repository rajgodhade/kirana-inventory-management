<ContentDialog
    x:Class="Kirana.App.Views.ProductEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <!-- Width comes from the template's theme resources, NOT from Width/MaxWidth on the element —
         setting those on a ContentDialog has no effect (see the product-import dialog, which hit
         the same trap). Two columns need roughly double the old 480px content, plus padding. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1120</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">1040</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DialogTitleText" Grid.Column="0" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                    Click="OnCloseIconClick" AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <ScrollViewer MaxHeight="620" HorizontalScrollBarVisibility="Disabled">
        <!-- Two columns: WHAT the product is on the left (identity, classification, the barcodes
             that identify it), WHAT IT COSTS AND HOW MUCH on the right (pricing, tax, stock).
             Splitting this way keeps related fields together instead of interleaving them, and
             halves the scrolling on a form this long. -->
        <Grid ColumnSpacing="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================ LEFT ============================ -->
            <StackPanel Grid.Column="0" Spacing="10">

            <TextBox Header="Name *" Text="{x:Bind ViewModel.Name, Mode=TwoWay}" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="SKU" Text="{x:Bind ViewModel.Sku, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Header="HSN code" Text="{x:Bind ViewModel.HsnCode, Mode=TwoWay}" />
            </Grid>

            <!-- ===================== Barcodes (Phase 13B) =====================
                 A product can carry several codes — manufacturer EAN, repack EAN, internal code —
                 and every active one scans to it. The starred row is the primary: what label
                 printing and exports default to. -->
            <StackPanel Spacing="6" Margin="0,8,0,0">
                <TextBlock Text="Barcodes" FontWeight="SemiBold" />

                <TextBlock Text="Changes here save immediately."
                           Style="{StaticResource CaptionTextStyle}"
                           Visibility="{x:Bind ViewModel.ShowImmediateSaveHint, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.Barcodes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProductBarcodeRowViewModel">
                            <Grid ColumnSpacing="8" Padding="0,4" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{x:Bind PrimaryGlyph, Mode=OneWay}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{ThemeResource BrandPrimaryBrush}" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Value, Mode=OneWay}" Style="{StaticResource CodeTextStyle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{x:Bind SymbologyLabel, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="•" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{x:Bind RoleLabel, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="•" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2" Content="Set primary" Padding="8,4" FontSize="12"
                                        Click="OnSetPrimaryBarcodeClick" Tag="{x:Bind}"
                                        IsEnabled="{x:Bind CanSetPrimary, Mode=OneWay}"
                                        AutomationProperties.Name="Set as primary barcode" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                    <Button Content="{x:Bind ActivateToggleLabel, Mode=OneWay}" Padding="8,4" FontSize="12"
                                            Click="OnToggleBarcodeActiveClick" Tag="{x:Bind}"
                                            AutomationProperties.Name="Retire or restore barcode" />
                                    <Button Content="✕" Padding="8,4" FontSize="12"
                                            Click="OnRemoveBarcodeClick" Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Remove permanently — prefer Retire for codes already printed"
                                            AutomationProperties.Name="Remove barcode" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.NewBarcodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Scan or type a barcode…" AutomationProperties.Name="New barcode" />
                    <Button Grid.Column="1" Content="Generate" Command="{x:Bind ViewModel.GenerateBarcodeCommand}"
                            IsEnabled="{x:Bind ViewModel.IsGeneratingBarcode, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                    <Button Grid.Column="2" Content="Add" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.AddBarcodeCommand}" AutomationProperties.Name="Add barcode" />
                </Grid>
            </StackPanel>

            <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.BarcodePreviewImage, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="{x:Bind ViewModel.BarcodePreviewImage, Mode=OneWay}" Width="180" Height="60" Stretch="Fill" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.BarcodeStatusText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8" FontSize="12" TextWrapping="Wrap" />
            </Grid>

            <TextBox Header="Description" Text="{x:Bind ViewModel.Description, Mode=TwoWay}" AcceptsReturn="True" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Header="Category" PlaceholderText="(none)"
                          ItemsSource="{x:Bind ViewModel.Categories}" DisplayMemberPath="Name"
                          SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                <ComboBox Grid.Column="1" Header="Brand" PlaceholderText="(none)"
                          ItemsSource="{x:Bind ViewModel.Brands}" DisplayMemberPath="Name"
                          SelectedItem="{x:Bind ViewModel.SelectedBrand, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                <ComboBox Grid.Column="2" Header="Unit"
                          ItemsSource="{x:Bind ViewModel.Units}"
                          SelectedItem="{x:Bind ViewModel.SelectedUnit, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            </Grid>

            <TextBox Header="Unit display text (optional)" PlaceholderText="e.g. 500g Pack — shown on POS/receipts instead of the plain unit name"
                     Text="{x:Bind ViewModel.UnitDisplayTextInput, Mode=TwoWay}" />

            <!-- Optional purchase pack (Phase 13A) — collapsed behind a checkbox since most
                 products never need it. Only affects Purchase Entry; selling/stock/billing always
                 stay in Unit above. -->
            <CheckBox Content="This product is purchased in a bulk pack (e.g. buying by the Box)"
                      IsChecked="{x:Bind ViewModel.HasPurchasePack, Mode=TwoWay}" />
            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.HasPurchasePack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Header="Purchase pack unit"
                          ItemsSource="{x:Bind ViewModel.Units}"
                          SelectedItem="{x:Bind ViewModel.SelectedPackUnit, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                <TextBox Grid.Column="1" Header="{x:Bind ViewModel.PackSizeHeader, Mode=OneWay}"
                         Text="{x:Bind ViewModel.PackSizeText, Mode=TwoWay}" />
            </Grid>

            </StackPanel>

            <!-- ============================ RIGHT ============================ -->
            <StackPanel Grid.Column="1" Spacing="10">

                <TextBlock Text="Pricing" FontWeight="SemiBold" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Header="Purchase price"
                             Visibility="{x:Bind ViewModel.ShowPurchasePrice, Converter={StaticResource BoolToVisibilityConverter}}"
                             Text="{x:Bind ViewModel.PurchasePriceText, Mode=TwoWay}" />
                    <TextBox Grid.Column="1" Header="Wholesale price" Text="{x:Bind ViewModel.WholesalePriceText, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Header="MRP *" Text="{x:Bind ViewModel.MrpText, Mode=TwoWay}" />
                    <TextBox Grid.Column="1" Header="Selling price *" Text="{x:Bind ViewModel.SellingPriceText, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Header="GST rate %" PlaceholderText="0, 5, 12, 18, 28"
                             Text="{x:Bind ViewModel.GstRatePercentText, Mode=TwoWay}" />
                    <ComboBox Grid.Column="1" Header="Pricing type"
                              ItemsSource="{x:Bind ViewModel.PricingTypes}"
                              SelectedItem="{x:Bind ViewModel.SelectedPricingType, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />
                    <TextBox Grid.Column="2" Header="Default discount %" Text="{x:Bind ViewModel.DefaultDiscountPercentText, Mode=TwoWay}" />
                </Grid>

                <TextBlock Text="{x:Bind ViewModel.PricingTypeHelpText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,-4,0,0" />

                <TextBlock Text="Inventory" FontWeight="SemiBold" Margin="0,8,0,0" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Header="{x:Bind ViewModel.OpeningStockHeader, Mode=OneWay}" Text="{x:Bind ViewModel.OpeningStockText, Mode=TwoWay}"
                             IsEnabled="{x:Bind ViewModel.IsEditMode, Converter={StaticResource InverseBoolConverter}}" />
                    <TextBox Grid.Column="1" Header="Current stock" Text="{x:Bind ViewModel.CurrentStockText, Mode=OneWay}" IsReadOnly="True" />
                </Grid>

                <Border Style="{StaticResource ElevatedCardStyle}" Padding="14" Margin="0,4,0,0">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <CheckBox Content="Enable replenishment planning"
                                      IsChecked="{x:Bind ViewModel.ReplenishmentEnabled, Mode=TwoWay}" />
                            <TextBlock Text="Recommendation only; never orders automatically."
                                       Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Header="{x:Bind ViewModel.MinimumStockHeader, Mode=OneWay}"
                                     Text="{x:Bind ViewModel.MinimumStockText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1" Header="{x:Bind ViewModel.ReorderQuantityHeader, Mode=OneWay}"
                                     Text="{x:Bind ViewModel.ReorderQuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <ComboBox Header="Preferred supplier (optional)" ItemsSource="{x:Bind ViewModel.Suppliers}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPreferredSupplier, Mode=TwoWay}"
                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="CURRENT STOCK" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind ViewModel.CurrentStockText, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="SUGGESTED REORDER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind ViewModel.SuggestedReorderText, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <CheckBox Content="Track batches / expiry for this product" IsChecked="{x:Bind ViewModel.TracksBatches, Mode=TwoWay}" />

                <StackPanel Spacing="4"
                            Visibility="{x:Bind ViewModel.ShowExpiryField, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <CalendarDatePicker Header="Expiry date"
                                        Date="{x:Bind ViewModel.ExpiryDate, Mode=TwoWay}"
                                        IsEnabled="{x:Bind ViewModel.CanEditExpiryInline, Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Product batch expiry date" />
                    <TextBlock Text="{x:Bind ViewModel.ExpiryHelpText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Errors live at the bottom of the right column so Save/Cancel (in the dialog's
                     own footer, directly below) are the next thing the eye reaches. -->
                <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                         Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</ContentDialog>
