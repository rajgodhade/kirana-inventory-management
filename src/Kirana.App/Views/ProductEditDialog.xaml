<ContentDialog
    x:Class="Kirana.App.Views.ProductEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ScrollViewer MaxHeight="520" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10" MinWidth="440" MaxWidth="480">

            <TextBox Header="Name *" Text="{x:Bind ViewModel.Name, Mode=TwoWay}" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="SKU" Text="{x:Bind ViewModel.Sku, Mode=TwoWay}" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Barcode" />
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.Barcode, Mode=TwoWay}" PlaceholderText="Scan or type…" />
                        <Button Grid.Column="1" Content="Generate" Command="{x:Bind ViewModel.GenerateBarcodeCommand}"
                                IsEnabled="{x:Bind ViewModel.IsGeneratingBarcode, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.BarcodePreviewImage, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="{x:Bind ViewModel.BarcodePreviewImage, Mode=OneWay}" Width="180" Height="60" Stretch="Fill" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.BarcodeStatusText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8" FontSize="12" TextWrapping="Wrap" />
            </Grid>

            <TextBox Header="Description" Text="{x:Bind ViewModel.Description, Mode=TwoWay}" AcceptsReturn="True" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Header="Category" PlaceholderText="(none)"
                          ItemsSource="{x:Bind ViewModel.Categories}" DisplayMemberPath="Name"
                          SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                <ComboBox Grid.Column="1" Header="Brand" PlaceholderText="(none)"
                          ItemsSource="{x:Bind ViewModel.Brands}" DisplayMemberPath="Name"
                          SelectedItem="{x:Bind ViewModel.SelectedBrand, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                <ComboBox Grid.Column="2" Header="Unit"
                          ItemsSource="{x:Bind ViewModel.Units}"
                          SelectedItem="{x:Bind ViewModel.SelectedUnit, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            </Grid>

            <TextBlock Text="Pricing" FontWeight="SemiBold" Margin="0,8,0,0" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="Purchase price"
                         Visibility="{x:Bind ViewModel.ShowPurchasePrice, Converter={StaticResource BoolToVisibilityConverter}}"
                         Text="{x:Bind ViewModel.PurchasePriceText, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Header="MRP *" Text="{x:Bind ViewModel.MrpText, Mode=TwoWay}" />
                <TextBox Grid.Column="2" Header="Selling price *" Text="{x:Bind ViewModel.SellingPriceText, Mode=TwoWay}" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="Wholesale price" Text="{x:Bind ViewModel.WholesalePriceText, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Header="Default discount %" Text="{x:Bind ViewModel.DefaultDiscountPercentText, Mode=TwoWay}" />
                <TextBox Grid.Column="2" Header="GST rate %" Text="{x:Bind ViewModel.GstRatePercentText, Mode=TwoWay}" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="HSN code" Text="{x:Bind ViewModel.HsnCode, Mode=TwoWay}" />
                <CheckBox Grid.Column="1" Content="Price is tax-inclusive" VerticalAlignment="Bottom"
                          IsChecked="{x:Bind ViewModel.IsTaxInclusive, Mode=TwoWay}" />
            </Grid>

            <TextBlock Text="Inventory" FontWeight="SemiBold" Margin="0,8,0,0" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Header="Minimum stock" Text="{x:Bind ViewModel.MinimumStockText, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Header="Reorder quantity" Text="{x:Bind ViewModel.ReorderQuantityText, Mode=TwoWay}" />
                <TextBox Grid.Column="2" Header="Opening stock" Text="{x:Bind ViewModel.OpeningStockText, Mode=TwoWay}"
                         IsEnabled="{x:Bind ViewModel.IsEditMode, Converter={StaticResource InverseBoolConverter}}" />
            </Grid>

            <CheckBox Content="Track batches / expiry for this product" IsChecked="{x:Bind ViewModel.TracksBatches, Mode=TwoWay}" />

            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
