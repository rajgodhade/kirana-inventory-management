<Page x:Class="Kirana.App.Views.PurchaseReconciliationsPage" x:Name="RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:Kirana.App.ViewModels">
    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Purchase Reconciliation" Style="{StaticResource PageTitleTextStyle}"/>
                <TextBlock Text="Compare ordered, received and supplier-invoiced quantities without changing purchasing data."
                           Style="{StaticResource PageSubtitleTextStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Refresh" Click="OnRefreshClick"/>
                <Button Content="Export" Style="{StaticResource AccentButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="CSV" Click="OnExportCsvClick"/>
                            <MenuFlyoutItem Text="Excel" Click="OnExportExcelClick"/>
                            <MenuFlyoutItem Text="Print / PDF" Click="OnExportPdfClick"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,0,24,14" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelBlueBrush}" BorderBrush="{ThemeResource PastelBlueBrush}" Tag="All" Tapped="OnKpiTapped">
                <StackPanel><TextBlock Text="TOTAL POS" Style="{StaticResource KpiLabelTextStyle}"/><TextBlock Text="{x:Bind ViewModel.TotalPurchaseOrders, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"/><TextBlock Text="submitted procurement orders" Style="{StaticResource KpiCaptionTextStyle}"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelGreenBrush}" BorderBrush="{ThemeResource PastelGreenBrush}" Tag="Fully reconciled" Tapped="OnKpiTapped">
                <StackPanel><TextBlock Text="RECONCILED" Style="{StaticResource KpiLabelTextStyle}"/><TextBlock Text="{x:Bind ViewModel.FullyReconciled, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"/><TextBlock Text="quantity, price and tax matched" Style="{StaticResource KpiCaptionTextStyle}"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}" Tag="Pending receipt" Tapped="OnKpiTapped">
                <StackPanel><TextBlock Text="PENDING RECEIPT" Style="{StaticResource KpiLabelTextStyle}"/><TextBlock Text="{x:Bind ViewModel.PendingReceipt, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"/><TextBlock Text="goods still expected" Style="{StaticResource KpiCaptionTextStyle}"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelVioletBrush}" BorderBrush="{ThemeResource PastelVioletBrush}" Tag="Pending purchase" Tapped="OnKpiTapped">
                <StackPanel><TextBlock Text="PENDING PURCHASE" Style="{StaticResource KpiLabelTextStyle}"/><TextBlock Text="{x:Bind ViewModel.PendingPurchase, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"/><TextBlock Text="received but not invoiced" Style="{StaticResource KpiCaptionTextStyle}"/></StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelRoseBrush}" BorderBrush="{ThemeResource PastelRoseBrush}" Tag="Exceptions" Tapped="OnKpiTapped">
                <StackPanel><TextBlock Text="EXCEPTIONS" Style="{StaticResource KpiLabelTextStyle}"/><TextBlock Text="{x:Bind ViewModel.Exceptions, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"/><TextBlock Text="quantity, price or tax review" Style="{StaticResource KpiCaptionTextStyle}"/></StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="24,0,24,14" Style="{StaticResource ElevatedCardStyle}" Padding="16,12">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="EXPECTED VALUE" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind ViewModel.ExpectedValue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="ACTUAL VALUE" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind ViewModel.ActualValue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="VALUE VARIANCE" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind ViewModel.Variance, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Right"><TextBlock Text="EXCEPTION BREAKDOWN" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/><TextBlock HorizontalAlignment="Right"><Run Text="Quantity "/><Run Text="{x:Bind ViewModel.QuantityExceptions, Mode=OneWay}"/><Run Text="  ·  Price "/><Run Text="{x:Bind ViewModel.PriceExceptions, Mode=OneWay}"/><Run Text="  ·  Tax "/><Run Text="{x:Bind ViewModel.TaxExceptions, Mode=OneWay}"/></TextBlock><TextBlock Text="{x:Bind ViewModel.CalculatedAt, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="24,0,24,14" Style="{StaticResource FilterBarStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="125"/><ColumnDefinition Width="125"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search PO, GRN, purchase or supplier..."
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{x:Bind ViewModel.SearchSuggestions}" TextChanged="OnSearchTextChanged"
                                SuggestionChosen="OnSuggestionChosen" QuerySubmitted="OnSearchQuerySubmitted" GotFocus="OnSearchGotFocus"
                                AutomationProperties.Name="Search purchase reconciliation">
                    <AutoSuggestBox.ItemTemplate><DataTemplate x:DataType="vm:SearchSuggestionItem"><StackPanel Padding="4,2"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextStyle}"/></StackPanel></DataTemplate></AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <ComboBox Grid.Column="1" PlaceholderText="All suppliers" ItemsSource="{x:Bind ViewModel.Suppliers}" SelectedItem="{x:Bind ViewModel.SelectedSupplier, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="OnFilterChanged"/>
                <ComboBox Grid.Column="2" ItemsSource="{x:Bind ViewModel.FilterOptions}" SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}" SelectionChanged="OnFilterChanged"/>
                <CalendarDatePicker Grid.Column="3" PlaceholderText="From" Date="{x:Bind ViewModel.FromDate, Mode=TwoWay}" DateChanged="OnDateChanged"/>
                <CalendarDatePicker Grid.Column="4" PlaceholderText="To" Date="{x:Bind ViewModel.ToDate, Mode=TwoWay}" DateChanged="OnDateChanged"/>
                <ComboBox Grid.Column="5" ItemsSource="{x:Bind ViewModel.SortOptions}" SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" SelectionChanged="OnFilterChanged"/>
                <Button Grid.Column="7" Content="Clear filters" Click="OnClearClick"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Margin="24,0,24,24" Style="{StaticResource ElevatedCardStyle}" Padding="0">
            <Grid>
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE9D5;" FontSize="36" Opacity="0.65"/>
                    <TextBlock Text="No purchase reconciliations found." FontWeight="SemiBold"/>
                    <TextBlock Text="Try clearing filters or complete a submitted purchase order." Style="{StaticResource SecondaryTextStyle}"/>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid MinWidth="1540">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Padding="14,11" Background="{ThemeResource SurfaceAltBrush}" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="190"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="145"/><ColumnDefinition Width="145"/><ColumnDefinition Width="115"/><ColumnDefinition Width="115"/><ColumnDefinition Width="110"/><ColumnDefinition Width="180"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                            <TextBlock Text="PO" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="1" Text="SUPPLIER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="2" Text="ORDERED" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="3" Text="RECEIVED" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="4" Text="PURCHASED" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="5" Text="PENDING RECEIPT" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="6" Text="PENDING PURCHASE" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="7" Text="EXPECTED" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/><TextBlock Grid.Column="8" Text="ACTUAL" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/><TextBlock Grid.Column="9" Text="VARIANCE" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/><TextBlock Grid.Column="10" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="11" Text="ACTION" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Records}" SelectionMode="None">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="IsTabStop" Value="False"/></Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PurchaseReconciliationRowViewModel">
                                    <Grid Padding="14,12" ColumnSpacing="12" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="190"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="145"/><ColumnDefinition Width="145"/><ColumnDefinition Width="115"/><ColumnDefinition Width="115"/><ColumnDefinition Width="110"/><ColumnDefinition Width="180"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{x:Bind PurchaseOrderNumber}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Date}" Style="{StaticResource CaptionTextStyle}"/></StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Supplier}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Ordered}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{x:Bind Received}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{x:Bind Purchased}" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{x:Bind PendingReceipt}" VerticalAlignment="Center"/><TextBlock Grid.Column="6" Text="{x:Bind PendingInvoice}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="{x:Bind Expected, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Column="8" Text="{x:Bind Actual, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Column="9" Text="{x:Bind Variance, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <Border Grid.Column="10" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource WarningSubtleBrush}" VerticalAlignment="Center"><TextBlock Text="{x:Bind Status}" Style="{StaticResource BadgeTextStyle}" TextWrapping="Wrap"/></Border>
                                        <Button Grid.Column="11" Content="View" Tag="{x:Bind}" Click="OnViewClick" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
