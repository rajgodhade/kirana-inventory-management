<Page
    x:Class="Kirana.App.Views.ReportsHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:reports="using:Kirana.App.Views.Reports">

    <Page.Resources>
        <!-- Segmented / Fluent-style tab header. Pivot's stock header is an underlined text run;
             this re-templates just the header item into a compact, evenly-aligned segment: no
             capsule fill, a subtle pastel background + bold text + a 3px teal underline for the
             active tab, and a lighter pastel wash on hover. Only the header template is replaced —
             Pivot's own selection/animation/keyboard behaviour (arrow keys, Ctrl+Tab, header click)
             is untouched, so navigation and accessibility keep working exactly as before. -->
        <Style x:Key="SegmentedPivotHeaderItemStyle" TargetType="PivotHeaderItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,9,14,7" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="2" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PivotHeaderItem">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}"
                              CornerRadius="6,6,0,0"
                              Padding="{TemplateBinding Padding}"
                              Margin="{TemplateBinding Margin}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.12" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Unselected" />
                                    <VisualState x:Name="UnselectedLocked" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource BrandSubtleBrush}" />
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource BrandOnSubtleBrush}" />
                                            <Setter Target="ContentPresenter.FontWeight" Value="Bold" />
                                            <Setter Target="Underline.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UnselectedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource BrandSubtleBrush}" />
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource BrandOnSubtleBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource BrandSubtleBrush}" />
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource BrandOnSubtleBrush}" />
                                            <Setter Target="ContentPresenter.FontWeight" Value="Bold" />
                                            <Setter Target="Underline.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="UnselectedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource BrandSubtleBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="SelectedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource BrandSubtleBrush}" />
                                            <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource BrandOnSubtleBrush}" />
                                            <Setter Target="ContentPresenter.FontWeight" Value="Bold" />
                                            <Setter Target="Underline.Opacity" Value="1" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="Underline" Height="3" CornerRadius="1.5"
                                    Background="{ThemeResource BrandPrimaryBrush}"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                    Margin="4,0,4,0" Opacity="0" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,20,24,0">
            <StackPanel Spacing="2">
                <TextBlock Text="Dashboard &amp; Reports" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Business KPIs, charts and the full report suite." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <Pivot x:Name="Tabs" Grid.Row="1" Padding="24,8,24,0" Margin="0,4,0,0" SelectionChanged="OnTabSelected">
            <Pivot.Resources>
                <!-- Applied via the implicit-style key Pivot uses for its header items. -->
                <Style TargetType="PivotHeaderItem" BasedOn="{StaticResource SegmentedPivotHeaderItemStyle}" />
            </Pivot.Resources>
            <PivotItem Header="Dashboard">
                <reports:DashboardView x:Name="DashboardTab" />
            </PivotItem>
            <PivotItem Header="Sales &amp; GST">
                <reports:SalesReportView x:Name="SalesTab" />
            </PivotItem>
            <PivotItem Header="Products">
                <reports:ProductReportView x:Name="ProductsTab" />
            </PivotItem>
            <PivotItem Header="Inventory">
                <reports:InventoryReportView x:Name="InventoryTab" />
            </PivotItem>
            <PivotItem Header="Customers">
                <reports:CustomerReportView x:Name="CustomersTab" />
            </PivotItem>
            <PivotItem Header="Suppliers">
                <reports:SupplierReportView x:Name="SuppliersTab" />
            </PivotItem>
            <PivotItem Header="Expenses">
                <reports:ExpenseReportView x:Name="ExpensesTab" />
            </PivotItem>
            <PivotItem Header="Promotions">
                <reports:PromotionReportView x:Name="PromotionsTab" />
            </PivotItem>
            <PivotItem x:Name="ProfitPivotItem" Header="Profit">
                <reports:ProfitReportView x:Name="ProfitTab" />
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
