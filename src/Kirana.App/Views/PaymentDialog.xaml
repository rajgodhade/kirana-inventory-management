<ContentDialog
    x:Class="Kirana.App.Views.PaymentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    xmlns:printing="using:Kirana.Application.Printing"
    PrimaryButtonText="Complete Sale"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.IsReadyToComplete, Mode=OneWay}">

    <!-- ContentDialogMaxWidth/MinWidth theme resources, not Width/MaxWidth on the element itself,
         are what actually control a ContentDialog's rendered size (WinUI3 gotcha hit before on the
         Product Import dialog) — without this override the dialog silently clamps to WinUI's ~548px
         default regardless of the content StackPanel's own MinWidth, clipping the last column. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">680</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{ThemeResource TitleTextBlockStyle}">
                <Run Text="Payment — " /><Run Text="{x:Bind ViewModel.CustomerDisplayText}" />
            </TextBlock>
            <Button Grid.Column="1" Padding="6" Background="Transparent" BorderThickness="0"
                    Click="OnCloseIconClick" AutomationProperties.Name="Close payment dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
        <StackPanel Spacing="{StaticResource SpacingL}" HorizontalAlignment="Stretch" Padding="0,0,4,0">

            <!-- Grand Total: the one number every decision on this screen serves — kept visually
                 dominant (largest text in the dialog, brand-accented card) per the redesign brief. -->
            <Border Style="{StaticResource CardBorderStyle}" Background="{ThemeResource BrandSubtleBrush}"
                    BorderThickness="0" Padding="{StaticResource CardPaddingLarge}" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="AMOUNT DUE" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.GrandTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                               FontSize="34" FontWeight="Bold" Foreground="{ThemeResource BrandOnSubtleBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{x:Bind ViewModel.PaymentLines}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="{StaticResource SpacingM}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PaymentLineViewModel">
                        <!-- Each payment method gets its own clearly bordered card, per the redesign
                             brief's "make split payments visually obvious" — a cashier looking at a
                             multi-method split should never have to guess where one line ends and
                             the next begins. -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                            <StackPanel Spacing="{StaticResource SpacingM}">

                                <Grid ColumnSpacing="{StaticResource SpacingS}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0" Header="Payment Method" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind AvailableMethods}"
                                              SelectedItem="{x:Bind Method, Mode=TwoWay}" SelectionChanged="OnPaymentFieldChanged"
                                              AutomationProperties.Name="Payment method">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource PaymentMethodConverter}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OnRemoveLineClick" Tag="{x:Bind}"
                                            AutomationProperties.Name="Remove this payment method">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>

                                <!-- Amount + the one method-specific companion field, side by side.
                                     Shared across all methods because every method has an amount;
                                     only the right-hand field and the extras below it differ. -->
                                <Grid ColumnSpacing="{StaticResource SpacingM}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Editable amount: shown for every line the cashier actually
                                         controls (i.e. all but the auto-balancing last one). -->
                                    <TextBox Grid.Column="0" Header="{x:Bind AmountFieldLabel, Mode=OneWay}" Tag="{x:Bind}"
                                             Visibility="{x:Bind IsAmountLocked, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                             Text="{x:Bind AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="OnPaymentFieldTextChanged"
                                             AutomationProperties.Name="Payment amount" />

                                    <!-- Auto-calculated amount: deliberately NOT a disabled-looking
                                         TextBox. A read-only box that still looks like an input is
                                         exactly what made this field feel broken — it invited typing
                                         and silently swallowed it. Rendering it as a plain read-out
                                         with an explicit caption makes "this is computed for you"
                                         unmistakable at a glance. -->
                                    <StackPanel Grid.Column="0" Spacing="2"
                                                Visibility="{x:Bind IsAmountLocked, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind AmountFieldLabel, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                                        <Border Background="{ThemeResource SurfaceAltBrush}" CornerRadius="{StaticResource RadiusSmall}"
                                                BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="1" Padding="12,7">
                                            <TextBlock Text="{x:Bind Amount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                                       Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"
                                                       AutomationProperties.Name="Automatically calculated amount" />
                                        </Border>
                                    </StackPanel>

                                    <TextBox Grid.Column="1" Header="Cash Received" Tag="{x:Bind}"
                                             Visibility="{x:Bind IsCash, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                             Text="{x:Bind AmountTenderedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="OnPaymentFieldTextChanged" AutomationProperties.Name="Cash received" />

                                    <TextBox Grid.Column="1" Header="Transaction ID"
                                             Visibility="{x:Bind IsUpiOrCard, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                             Text="{x:Bind ReferenceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="OnPaymentFieldTextChanged" AutomationProperties.Name="Transaction ID" />
                                </Grid>

                                <TextBlock Style="{StaticResource CaptionTextStyle}"
                                           Visibility="{x:Bind IsAmountLocked, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Text="Automatically covers the balance the other payment method(s) don't. Change the other amounts to adjust it." />

                                <!-- ===== Cash extras: quick tender + live change ===== -->
                                <StackPanel Spacing="{StaticResource SpacingM}"
                                            Visibility="{x:Bind IsCash, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">
                                        <Button Content="₹100" Tag="{x:Bind}" Click="OnQuickTender100Click" AutomationProperties.Name="Tender ₹100" />
                                        <Button Content="₹200" Tag="{x:Bind}" Click="OnQuickTender200Click" AutomationProperties.Name="Tender ₹200" />
                                        <Button Content="₹500" Tag="{x:Bind}" Click="OnQuickTender500Click" AutomationProperties.Name="Tender ₹500" />
                                        <Button Content="₹1000" Tag="{x:Bind}" Click="OnQuickTender1000Click" AutomationProperties.Name="Tender ₹1000" />
                                        <Button Content="Exact Amount" Tag="{x:Bind}" Click="OnExactAmountClick" AutomationProperties.Name="Tender exact amount" />
                                    </StackPanel>

                                    <!-- Two TextBlocks toggled by visibility rather than a converter-computed
                                         Foreground: a converter reading a theme brush resolves against the app
                                         theme and can return the wrong brush for this dialog's actual theme
                                         (documented gotcha from the Phase 8/9 UI work). -->
                                    <TextBlock Style="{StaticResource BodyTextStyle}"
                                               Visibility="{x:Bind ShowNormalChange, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Run Text="Change: " /><Run FontWeight="SemiBold" Text="{x:Bind ChangeGiven, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                                    </TextBlock>
                                    <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"
                                               Visibility="{x:Bind IsUnderpaid, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Run Text="Short by: " /><Run Text="{x:Bind ShortfallAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" /><Run Text=" — add another payment method to cover it." />
                                    </TextBlock>
                                </StackPanel>

                                <!-- ===== UPI / Card extras ===== -->
                                <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource DangerBrush}"
                                           Visibility="{x:Bind HasMissingTransactionId, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Text="Enter a Transaction ID before completing the sale." />

                                <!-- ===== Customer Credit extras: live outstanding math ===== -->
                                <Border Background="{ThemeResource SurfaceAltBrush}" CornerRadius="{StaticResource RadiusMedium}"
                                        Padding="{StaticResource CardPadding}"
                                        Visibility="{x:Bind IsCustomerCredit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid ColumnSpacing="{StaticResource SpacingS}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="0">
                                            <TextBlock Text="Current Outstanding" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{x:Bind CurrentOutstandingBalance, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                                       Style="{StaticResource BodyTextStyle}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="+" VerticalAlignment="Bottom" Style="{StaticResource BodyTextStyle}" />

                                        <StackPanel Grid.Column="2" Spacing="0">
                                            <TextBlock Text="This Credit" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{x:Bind Amount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                                       Style="{StaticResource BodyTextStyle}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Text="=" VerticalAlignment="Bottom" Style="{StaticResource BodyTextStyle}" />

                                        <StackPanel Grid.Column="4" Spacing="0">
                                            <TextBlock Text="Outstanding After Sale" Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{x:Bind OutstandingAfterSale, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                                       Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="+ Add Payment Method" Command="{x:Bind ViewModel.AddPaymentLineCommand}" HorizontalAlignment="Left"
                    AutomationProperties.Name="Add another payment method" />

            <!-- Live Payment Summary — these rows come from PaymentSummaryBuilder, the very same
                 code that renders the printed receipt's Payment Summary, so the two cannot drift
                 apart. That also means no misleading aggregate "Paid" figure: each method reports
                 what it actually contributes. -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                <StackPanel Spacing="{StaticResource SpacingS}">
                    <TextBlock Text="Payment Summary" Style="{StaticResource SectionTitleTextStyle}" />

                    <Grid ColumnSpacing="{StaticResource SpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Grand Total" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.GrandTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                   Style="{StaticResource AmountTextStyle}" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.PaymentSummaryLines, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="printing:InvoicePaymentSummaryLine">
                                <Grid ColumnSpacing="{StaticResource SpacingM}" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Label}" Style="{StaticResource SecondaryTextStyle}"
                                               Margin="{x:Bind IsDetail, Converter={StaticResource DetailIndentConverter}}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnSpacing="{StaticResource SpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Remaining" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RemainingAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>

                    <!-- Validation status — the single line that tells a cashier, at a glance,
                         whether Complete Sale is going to work. Two TextBlocks toggled by
                         visibility, same theme-brush reasoning as the change-due feedback above. -->
                    <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{ThemeResource SuccessBrush}"
                               Visibility="{x:Bind ViewModel.IsReadyToComplete, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Run Text="✔ " /><Run Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.IsReadyToComplete, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Run Text="⚠ " /><Run Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
