<ContentDialog
    x:Class="Kirana.App.Views.PaymentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    Title="Payment"
    PrimaryButtonText="Complete Sale"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="520" MaxHeight="560">

        <TextBlock FontSize="28" FontWeight="Bold" HorizontalAlignment="Center">
            <Run Text="Total: ₹" /><Run Text="{x:Bind ViewModel.GrandTotal, Mode=OneWay}" />
        </TextBlock>

        <ListView ItemsSource="{x:Bind ViewModel.PaymentLines}" MaxHeight="280" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PaymentLineViewModel">
                    <Grid ColumnSpacing="6" Padding="0,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" ItemsSource="{x:Bind AvailableMethods}"
                                  SelectedItem="{x:Bind Method, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" PlaceholderText="Amount" Text="{x:Bind AmountText, Mode=TwoWay}" />
                        <TextBox Grid.Column="2" PlaceholderText="Cash tendered" Text="{x:Bind AmountTenderedText, Mode=TwoWay}" />
                        <TextBox Grid.Column="3" PlaceholderText="Reference #" Text="{x:Bind ReferenceNumber, Mode=TwoWay}" />
                        <Button Grid.Column="4" Content="✕" Click="OnRemoveLineClick" Tag="{x:Bind}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Content="+ Add Payment (Split)" Command="{x:Bind ViewModel.AddPaymentLineCommand}" HorizontalAlignment="Left" />

        <TextBlock FontSize="16">
            <Run Text="Remaining: ₹" /><Run Text="{x:Bind ViewModel.RemainingAmount, Mode=OneWay}" />
        </TextBlock>

        <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
