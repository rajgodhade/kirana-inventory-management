<Page
    x:Class="Kirana.App.Views.NewPurchaseReturnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    xmlns:ret="using:Kirana.Application.Returns">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <StackPanel Spacing="2">
                <TextBlock Text="New Purchase Return" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Send goods back to a supplier. Stock reduces and their balance is credited."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Padding="24,0,24,12" Spacing="10">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="1 · Find the purchase" Style="{StaticResource SectionTitleTextStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Grid.Column="0"
                                 PlaceholderText="Purchase number, supplier invoice, supplier or product"
                                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnSearchKeyDown" TextChanged="OnSearchTextChanged" />
                        <Button Grid.Column="1" Content="Search" Click="OnSearchClick" />
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.Candidates}" MaxHeight="150"
                              SelectionMode="Single" SelectionChanged="OnCandidateSelected"
                              Visibility="{x:Bind ViewModel.HasSelectedPurchase, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="ret:ReturnablePurchase">
                                <Grid Padding="4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind PurchaseNumber}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind SupplierName}" Opacity="0.75" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind GrandTotal, Converter={StaticResource CurrencyConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid ColumnSpacing="12"
                          Visibility="{x:Bind ViewModel.HasSelectedPurchase, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.SelectedPurchaseHeader, Mode=OneWay}"
                                   Style="{StaticResource CardTitleTextStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Choose a different purchase" Click="OnClearPurchaseClick" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="24,0,24,12"
              Visibility="{x:Bind ViewModel.HasSelectedPurchase, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="14,10" ColumnSpacing="12"
                          Background="{ThemeResource SurfaceAltBrush}"
                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="2 · PRODUCT" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="RECEIVED" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="COST" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="RETURN QTY" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="4" Text="BATCH" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="5" Text="LINE VALUE" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Lines}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PurchaseReturnLineViewModel">
                                <Grid Padding="14,10" ColumnSpacing="12"
                                      BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="180" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ProductName}" Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ProductCode}" Style="{StaticResource CodeTextStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ReceivedText}" Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock Text="{x:Bind ReturnableText}" Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Text="{x:Bind StockText}" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{x:Bind PriceText}" Style="{StaticResource BodyTextStyle}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <TextBox Grid.Column="3" Text="{x:Bind QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{x:Bind CanReturn}" TextAlignment="Center" VerticalAlignment="Center" />

                                    <TextBox Grid.Column="4" Text="{x:Bind BatchNumber, Mode=TwoWay}" VerticalAlignment="Center"
                                             PlaceholderText="Batch" />

                                    <TextBlock Grid.Column="5" Text="{x:Bind LineTotalText, Mode=OneWay}"
                                               Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Padding="24,0,24,20" Spacing="10">
            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Informational" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <Border Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.HasSelectedPurchase, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Header="3 · Reason (optional)" Text="{x:Bind ViewModel.Reason, Mode=TwoWay}" />
                    <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnProcessClick"
                            VerticalAlignment="Bottom" Padding="20,9"
                            IsEnabled="{x:Bind ViewModel.CanManagePurchases}"
                            AutomationProperties.Name="Process Return">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" />
                            <TextBlock Text="Process Return" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
