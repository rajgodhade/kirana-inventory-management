<Page
    x:Class="Kirana.App.Views.PurchaseEntryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="◀ Purchases" Click="OnBackClick" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="New Purchase" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </Grid>

        <!-- Supplier + scan/search + invoice fields -->
        <Grid Grid.Row="1" Margin="20,12,20,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="OnSupplierClick">
                <TextBlock Text="{x:Bind ViewModel.SupplierDisplayText, Mode=OneWay}" />
            </Button>

            <TextBox x:Name="ScanSearchBox" Grid.Column="1" PlaceholderText="Scan Barcode / Product ID / SKU / Name"
                     CharacterReceived="OnCharacterReceived" KeyDown="OnScanSearchKeyDown" />

            <!-- Scanners and typists submit with Enter; this gives mouse/touch users and pasted
                 codes the same affordance, matching the Search buttons elsewhere in the app. -->
            <Button Grid.Column="2" Content="Add Item" Click="OnAddItemClick" Margin="4,0,0,0" />

            <TextBox Grid.Column="3" PlaceholderText="Supplier Invoice #" Text="{x:Bind ViewModel.SupplierInvoiceNumber, Mode=TwoWay}" />
        </Grid>

        <InfoBar Grid.Row="1" Margin="20,0,20,0" VerticalAlignment="Bottom"
                 IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <!-- Lines -->
        <Grid Grid.Row="2" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" ItemsSource="{x:Bind ViewModel.Lines}" SelectionMode="None">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="6" Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Product" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Qty" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Price" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Disc %" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Batch #" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" Text="Expiry" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="6" Text="Line Total" FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PurchaseLineViewModel">
                        <Grid ColumnSpacing="6" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Bind ProductName}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ProductCode}" Opacity="0.6" FontSize="11" />
                            </StackPanel>

                            <TextBox Grid.Column="1" Text="{x:Bind QuantityText, Mode=TwoWay}" Tag="{x:Bind}" LostFocus="OnLineFieldLostFocus" />
                            <TextBox Grid.Column="2" Text="{x:Bind UnitPriceText, Mode=TwoWay}" Tag="{x:Bind}" LostFocus="OnLineFieldLostFocus" />
                            <TextBox Grid.Column="3" Text="{x:Bind DiscountPercentText, Mode=TwoWay}" Tag="{x:Bind}" LostFocus="OnLineFieldLostFocus" />
                            <TextBox Grid.Column="4" Text="{x:Bind BatchNumberText, Mode=TwoWay}"
                                     Visibility="{x:Bind TracksBatches, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBox Grid.Column="5" PlaceholderText="yyyy-mm-dd" Text="{x:Bind ExpiryDateText, Mode=TwoWay}"
                                     Visibility="{x:Bind TracksBatches, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Grid.Column="6" Text="{x:Bind LineTotal, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <Button Grid.Column="7" Content="✕" Click="OnRemoveLineClick" Tag="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Totals -->
            <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="6" VerticalAlignment="Top">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Subtotal" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SubTotal, Mode=OneWay}" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Discount" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DiscountTotal, Mode=OneWay}" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="GST" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TaxTotal, Mode=OneWay}" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Round Off" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RoundOffAmount, Mode=OneWay}" />
                </Grid>

                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,8" />

                <TextBlock FontSize="28" FontWeight="Bold" HorizontalAlignment="Right">
                    <Run Text="₹" /><Run Text="{x:Bind ViewModel.GrandTotal, Mode=OneWay}" />
                </TextBlock>

                <TextBox Header="Amount Paid Now" Text="{x:Bind ViewModel.AmountPaidText, Mode=TwoWay}" Margin="0,12,0,0" />
                <ComboBox Header="Payment Method" ItemsSource="{x:Bind ViewModel.PaymentMethods}"
                          SelectedItem="{x:Bind ViewModel.SelectedPaymentMethod, Mode=TwoWay}" />
                <TextBox Header="Payment Reference #" Text="{x:Bind ViewModel.PaymentReferenceNumber, Mode=TwoWay}" />
                <TextBox Header="Notes" Text="{x:Bind ViewModel.Notes, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <!-- Action bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Padding="20,0,20,16" HorizontalAlignment="Right">
            <Button Content="Complete Purchase" Style="{StaticResource AccentButtonStyle}" Click="OnCompletePurchaseClick" />
        </StackPanel>
    </Grid>
</Page>
