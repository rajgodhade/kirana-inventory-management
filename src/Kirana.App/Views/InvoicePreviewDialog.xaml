<ContentDialog
    x:Class="Kirana.App.Views.InvoicePreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Print"
    CloseButtonText="Close"
    DefaultButton="Primary">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1080</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <Grid ColumnSpacing="8" Width="{x:Bind ViewModel.DialogContentWidth, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Invoice Preview" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                    Click="OnCloseIconClick" AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <StackPanel Spacing="10" Width="{x:Bind ViewModel.DialogContentWidth, Mode=OneWay}">
        <ComboBox Header="Print format" ItemsSource="{x:Bind ViewModel.AvailableFormats}"
                  SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}"
                  HorizontalAlignment="Left" MinWidth="175" />

        <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        <InfoBar IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Success" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

        <ScrollViewer Width="{x:Bind ViewModel.PreviewViewportWidth, Mode=OneWay}"
                      MaxHeight="{x:Bind ViewModel.PreviewViewportMaxHeight, Mode=OneWay}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalContentAlignment="Center">
            <Border Background="#FF252525" Padding="12" CornerRadius="4">
                <ContentControl Content="{x:Bind ViewModel.PreviewElement, Mode=OneWay}"
                                HorizontalContentAlignment="Center" />
            </Border>
        </ScrollViewer>

        <ProgressRing IsActive="{x:Bind ViewModel.IsPrinting, Mode=OneWay}" HorizontalAlignment="Center" />
    </StackPanel>
</ContentDialog>
