<ContentDialog
    x:Class="Kirana.App.Views.InvoicePreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Print"
    CloseButtonText="Close"
    DefaultButton="Primary">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Invoice Preview" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Padding="6" Background="Transparent" BorderThickness="0"
                    Click="OnCloseIconClick" AutomationProperties.Name="Close">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <StackPanel Spacing="10" MinWidth="420">

        <ComboBox Header="Format" ItemsSource="{x:Bind ViewModel.AvailableFormats}"
                  SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}" />

        <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        <InfoBar IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Success" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

        <!-- Scrolling itself already worked here (confirmed via UIA ScrollPattern — a 22-line bill
             correctly reported VerticallyScrollable=True and scrolled on request). The real gap was
             discoverability: WinUI's default "Auto" scrollbar is a thin, auto-hiding sliver that's
             easy to miss on a bill that's cut off mid-list, especially for someone who isn't
             already expecting a preview to scroll. VerticalScrollBarVisibility="Visible" keeps the
             track permanently on-screen instead of only appearing on hover/drag. -->
        <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto"
                      Background="{ThemeResource LayerFillColorDefaultBrush}">
            <ContentControl Content="{x:Bind ViewModel.PreviewElement, Mode=OneWay}" HorizontalContentAlignment="Center" />
        </ScrollViewer>

        <ProgressRing IsActive="{x:Bind ViewModel.IsPrinting, Mode=OneWay}" HorizontalAlignment="Center" />
    </StackPanel>
</ContentDialog>
