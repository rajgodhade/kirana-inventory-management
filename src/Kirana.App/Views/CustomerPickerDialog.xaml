<ContentDialog
    x:Class="Kirana.App.Views.CustomerPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:entities="using:Kirana.Domain.Entities"
    Title="Select Customer"
    PrimaryButtonText="Select"
    SecondaryButtonText="Walk-in Customer"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="380" MaxHeight="520">

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" PlaceholderText="Search by name or phone"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" KeyDown="OnSearchBoxKeyDown" />
            <Button Grid.Column="1" Content="Search" Click="OnSearchClick" />
        </Grid>

        <ListView x:Name="ResultsList" ItemsSource="{x:Bind ViewModel.Results}" MaxHeight="200"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnResultClicked">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="entities:Customer">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind Phone}" Opacity="0.7" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Text="Add new customer" FontWeight="SemiBold" Margin="0,8,0,0" />
        <TextBox PlaceholderText="Name" Text="{x:Bind ViewModel.NewCustomerName, Mode=TwoWay}" />
        <TextBox PlaceholderText="Phone" Text="{x:Bind ViewModel.NewCustomerPhone, Mode=TwoWay}" />
        <Button Content="Create &amp; Select" Command="{x:Bind ViewModel.CreateCustomerCommand}" HorizontalAlignment="Left" />

        <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
