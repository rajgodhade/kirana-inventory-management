<ContentDialog
    x:Class="Kirana.App.Views.ManagementLoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Unlock"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Management Access" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Padding="6" Background="Transparent" BorderThickness="0"
                    Click="OnCloseIconClick" AutomationProperties.Name="Close">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <StackPanel Spacing="12" MinWidth="320">
        <TextBox x:Name="UsernameBox" Header="Username" />
        <PasswordBox x:Name="PasswordBox" Header="Password / PIN" />
        <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" />
    </StackPanel>
</ContentDialog>
