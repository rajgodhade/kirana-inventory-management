<ContentDialog
    x:Class="Kirana.App.Views.PurchaseDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    CloseButtonText="Close"
    DefaultButton="Close">

    <!-- ContentDialogMaxWidth/MinWidth theme resources, not Width/MaxWidth on the element itself,
         are what actually control a ContentDialog's rendered size (WinUI3 gotcha) — without this
         override the item table below clips at WinUI's ~548px default. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">720</x:Double>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center">
                <Run Text="Purchase " /><Run Text="{x:Bind ViewModel.PurchaseNumber}" />
            </TextBlock>
            <Button Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                    Click="OnCloseIconClick" AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <ScrollViewer MaxHeight="600">
        <StackPanel Spacing="16" MinWidth="640">

            <!-- ============================== HEADER CARD ============================== -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="{StaticResource SpacingM}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{StaticResource RadiusPill}"
                            Background="{ThemeResource PastelVioletBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.SupplierInitial}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{ThemeResource PastelVioletOnBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitleTextStyle}">
                            <Run Text="{x:Bind ViewModel.SupplierName}" />
                            <Run Text="{x:Bind ViewModel.SupplierCodeParenthesized}" Foreground="{ThemeResource TextTertiaryBrush}" FontWeight="Normal" />
                        </TextBlock>
                        <TextBlock Text="{x:Bind ViewModel.DateText}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.HasSupplierGstIdentity, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run Text="GSTIN: " /><Run Text="{x:Bind ViewModel.SupplierGstin, FallbackValue=—}" />
                            <Run Text="  ·  State: " /><Run Text="{x:Bind ViewModel.SupplierState, FallbackValue=—}" />
                            <Run Text="  ·  Registration: " /><Run Text="{x:Bind ViewModel.SupplierRegistrationType, FallbackValue=—}" />
                        </TextBlock>
                        <TextBlock Text="{x:Bind ViewModel.SupplierAddress}" Style="{StaticResource CaptionTextStyle}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.HasSupplierGstIdentity, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.HasStoreIdentity, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run Text="Buying store: " /><Run Text="{x:Bind ViewModel.StoreIdentity}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   Visibility="{x:Bind ViewModel.HasSupplierInvoiceNumber, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run Text="Supplier Invoice #: " /><Run Text="{x:Bind ViewModel.SupplierInvoiceNumber}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   Visibility="{x:Bind ViewModel.HasProcurementSource, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Run Text="GRN: " /><Run Text="{x:Bind ViewModel.GoodsReceiptNumber}" />
                            <Run Text="  ·  PO: " /><Run Text="{x:Bind ViewModel.PurchaseOrderNumber}" />
                        </TextBlock>
                        <TextBlock Text="{x:Bind ViewModel.Notes}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.HasNotes, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Status badge — exactly one of the three is visible, same classification the
                         Purchases list row uses, so this can never disagree with it. -->
                    <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Top"
                            Background="{ThemeResource SuccessSubtleBrush}"
                            Visibility="{x:Bind ViewModel.IsPaid, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource SuccessBrush}">
                            <Run Text="&#x1F7E2;" /><Run Text=" Paid" />
                        </TextBlock>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Top"
                            Background="{ThemeResource WarningSubtleBrush}"
                            Visibility="{x:Bind ViewModel.IsPartiallyPaid, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource WarningBrush}">
                            <Run Text="&#x1F7E1;" /><Run Text=" Partially Paid" />
                        </TextBlock>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Top"
                            Background="{ThemeResource DangerSubtleBrush}"
                            Visibility="{x:Bind ViewModel.IsFullyOutstanding, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource DangerBrush}">
                            <Run Text="&#x1F534;" /><Run Text=" Outstanding" />
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================== ITEMS TABLE ============================== -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="14,10" ColumnSpacing="12"
                          Background="{ThemeResource SurfaceAltBrush}"
                          CornerRadius="12,12,0,0"
                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PRODUCT" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="QTY" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="PRICE" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="TOTAL" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PurchaseDetailsLineViewModel">
                                <Grid Padding="14,10" ColumnSpacing="12"
                                      BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ProductName}" Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind ProductCode}" Style="{StaticResource CodeTextStyle}" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                                       Visibility="{x:Bind HasBatch, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Run Text="Batch: " /><Run Text="{x:Bind BatchNumber}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind QuantityText}" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{x:Bind UnitText}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{x:Bind UnitPrice, Converter={StaticResource CurrencyConverter}}"
                                               Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="3" Text="{x:Bind LineTotal, Converter={StaticResource CurrencyConverter}}"
                                               Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- ============================== TOTALS ============================== -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Subtotal" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SubTotal, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource BodyTextStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Discount" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DiscountTotal, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource BodyTextStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="GST" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TaxTotal, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource BodyTextStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Round Off" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RoundOffAmount, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource BodyTextStyle}" />
                    </Grid>

                    <Border BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,4" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="GRAND TOTAL" Style="{StaticResource ColumnHeaderTextStyle}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.GrandTotal, Converter={StaticResource CurrencyConverter}}"
                                   Style="{StaticResource MetricTextStyle}" FontSize="24" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Amount Paid" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AmountPaid, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource BodyTextStyle}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Outstanding" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.OutstandingAmount, Converter={StaticResource CurrencyConverter}}"
                                   Style="{StaticResource AmountTextStyle}" Foreground="{ThemeResource DangerBrush}"
                                   Visibility="{x:Bind ViewModel.HasOutstanding, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Grid.Column="1" Text="—" Style="{StaticResource SecondaryTextStyle}"
                                   Visibility="{x:Bind ViewModel.HasOutstanding, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
