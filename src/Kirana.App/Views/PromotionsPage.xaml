<Page
    x:Class="Kirana.App.Views.PromotionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">
    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <StackPanel><TextBlock Text="Promotions &amp; Offers" Style="{StaticResource PageTitleTextStyle}" /><TextBlock Text="Schedule reusable offers across the store, categories, brands and products." Style="{StaticResource PageSubtitleTextStyle}" /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Import (coming later)" IsEnabled="False" ToolTipService.ToolTip="Promotion import is reserved for a future phase." />
                <Button Content="Create Promotion" Style="{StaticResource AccentButtonStyle}" Click="OnCreateClick" IsEnabled="{x:Bind ViewModel.CanManage}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,0,24,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelBlueBrush}" BorderBrush="{ThemeResource PastelBlueBrush}"><StackPanel><TextBlock Text="TOTAL" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelGreenBrush}" BorderBrush="{ThemeResource PastelGreenBrush}"><StackPanel><TextBlock Text="RUNNING" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock Text="{x:Bind ViewModel.RunningText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelVioletBrush}" BorderBrush="{ThemeResource PastelVioletBrush}"><StackPanel><TextBlock Text="UPCOMING" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock Text="{x:Bind ViewModel.UpcomingText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}"><StackPanel><TextBlock Text="EXPIRED" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock Text="{x:Bind ViewModel.ExpiredText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelRoseBrush}" BorderBrush="{ThemeResource PastelRoseBrush}"><StackPanel><TextBlock Text="DISABLED" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock Text="{x:Bind ViewModel.DisabledText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" /></StackPanel></Border>
        </Grid>

        <Grid Grid.Row="2" Padding="{StaticResource ToolbarPadding}" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="160" /><ColumnDefinition Width="160" /><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" PlaceholderText="Search name, code, target…" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" KeyDown="OnSearchKeyDown" />
            <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.StatusFilters}" SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            <ComboBox Grid.Column="2" ItemsSource="{x:Bind ViewModel.ScopeFilters}" SelectedItem="{x:Bind ViewModel.SelectedScope, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            <ComboBox Grid.Column="3" ItemsSource="{x:Bind ViewModel.TypeFilters}" SelectedItem="{x:Bind ViewModel.SelectedType, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            <CheckBox Grid.Column="4" Content="Running only" IsChecked="{x:Bind ViewModel.RunningOnly, Mode=TwoWay}" VerticalAlignment="Center" />
            <Button Grid.Column="6" Content="Apply filters" Click="OnFilterClick" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0" Margin="24,0,24,24">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="14,10" Background="{ThemeResource SurfaceAltBrush}" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="100" /><ColumnDefinition Width="70" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PROMOTION" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="1" Text="TYPE" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="2" Text="SCOPE" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="3" Text="DISCOUNT" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="4" Text="START" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="5" Text="END" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="6" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="7" Text="PRIORITY" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="8" Text="ACTIONS" Style="{StaticResource ColumnHeaderTextStyle}" />
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Promotions}" SelectionMode="None">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="MinHeight" Value="0" /></Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate><DataTemplate x:DataType="vm:PromotionRowViewModel"><Grid Padding="14,12" ColumnSpacing="12" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" /><ColumnDefinition Width="100" /><ColumnDefinition Width="70" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" /><TextBlock Text="{x:Bind Code}" Style="{StaticResource CodeTextStyle}" /></StackPanel><TextBlock Grid.Column="1" Text="{x:Bind Type}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" /><Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource BrandSubtleBrush}"><TextBlock Text="{x:Bind Scope}" Style="{StaticResource BadgeTextStyle}" /></Border><TextBlock Grid.Column="3" Text="{x:Bind Discount}" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="{x:Bind Start}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" /><TextBlock Grid.Column="5" Text="{x:Bind End}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" /><Border Grid.Column="6" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource PastelGreenBrush}"><TextBlock Text="{x:Bind Status}" Style="{StaticResource BadgeTextStyle}" /></Border><TextBlock Grid.Column="7" Text="{x:Bind Priority}" HorizontalAlignment="Center" VerticalAlignment="Center" /><StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6"><Button Content="Edit" Click="OnEditClick" Tag="{x:Bind}" /><Button Content="{x:Bind ActionText}" Click="OnToggleClick" Tag="{x:Bind}" /><Button Content="Delete" Click="OnDeleteClick" Tag="{x:Bind}" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" VerticalAlignment="Top" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>
