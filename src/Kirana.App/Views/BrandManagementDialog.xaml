<ContentDialog
    x:Class="Kirana.App.Views.BrandManagementDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:entities="using:Kirana.Domain.Entities"
    CloseButtonText="Done"
    DefaultButton="Close">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Manage Brands" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                    Click="OnCloseIconClick" AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <StackPanel Spacing="10" MinWidth="360" MaxHeight="480">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" PlaceholderText="New brand name" Text="{x:Bind ViewModel.NewBrandName, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="Add" Command="{x:Bind ViewModel.AddCommand}" />
        </Grid>

        <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <ListView ItemsSource="{x:Bind ViewModel.Brands}" MaxHeight="360">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="entities:Brand">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" VerticalAlignment="Center" />

                        <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Center"
                                Background="{ThemeResource SuccessSubtleBrush}"
                                Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Active" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource SuccessBrush}" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" VerticalAlignment="Center"
                                Background="{ThemeResource SurfaceAltBrush}"
                                Visibility="{x:Bind IsActive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="Inactive" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource TextTertiaryBrush}" />
                        </Border>

                        <Button Grid.Column="2" Content="Deactivate" Click="OnToggleActiveClick" Tag="{x:Bind}"
                                Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button Grid.Column="2" Content="Reactivate" Click="OnToggleActiveClick" Tag="{x:Bind}"
                                Visibility="{x:Bind IsActive, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
