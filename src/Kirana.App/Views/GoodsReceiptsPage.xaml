<Page x:Class="Kirana.App.Views.GoodsReceiptsPage" x:Name="RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:Kirana.App.ViewModels">
    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}"><StackPanel><TextBlock Text="Goods Receipts" Style="{StaticResource PageTitleTextStyle}"/><TextBlock Text="Record physical deliveries against submitted purchase orders without posting stock twice." Style="{StaticResource PageSubtitleTextStyle}"/></StackPanel></Grid>
        <Grid Grid.Row="1" Margin="24,0,24,16" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelBlueBrush}" BorderBrush="{ThemeResource PastelBlueBrush}"><StackPanel><TextBlock Text="TOTAL RECEIPTS" Style="{StaticResource KpiLabelTextStyle}"/><TextBlock Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"/><TextBlock Text="in current results" Style="{StaticResource KpiCaptionTextStyle}"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelGreenBrush}" BorderBrush="{ThemeResource PastelGreenBrush}"><StackPanel><TextBlock Text="COMPLETED" Style="{StaticResource KpiLabelTextStyle}"/><TextBlock Text="{x:Bind ViewModel.CompletedCount, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"/><TextBlock Text="physical receipts recorded" Style="{StaticResource KpiCaptionTextStyle}"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}"><StackPanel><TextBlock Text="AWAITING PURCHASE" Style="{StaticResource KpiLabelTextStyle}"/><TextBlock Text="{x:Bind ViewModel.PendingPurchaseCount, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}"/><TextBlock Text="ready to post" Style="{StaticResource KpiCaptionTextStyle}"/></StackPanel></Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource FilterBarStyle}" Margin="24,0,24,16"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="180"/><ColumnDefinition Width="140"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search GRN / PO / supplier..."
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{x:Bind ViewModel.SearchSuggestions}" TextChanged="OnSearchTextChanged"
                            SuggestionChosen="OnSuggestionChosen" QuerySubmitted="OnSearchQuerySubmitted" GotFocus="OnSearchGotFocus"
                            AutomationProperties.Name="Search goods receipts">
                <AutoSuggestBox.ItemTemplate><DataTemplate x:DataType="vm:SearchSuggestionItem"><StackPanel Padding="4,2"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextStyle}"/></StackPanel></DataTemplate></AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
            <ComboBox Grid.Column="1" PlaceholderText="All suppliers" ItemsSource="{x:Bind ViewModel.Suppliers}" SelectedItem="{x:Bind ViewModel.SelectedSupplier, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="OnFilterChanged"/>
            <ComboBox Grid.Column="2" ItemsSource="{x:Bind ViewModel.StatusOptions}" SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}" SelectionChanged="OnFilterChanged"/>
            <CalendarDatePicker Grid.Column="3" PlaceholderText="From" Date="{x:Bind ViewModel.FromDate, Mode=TwoWay}" DateChanged="OnDateChanged"/>
            <CalendarDatePicker Grid.Column="4" PlaceholderText="To" Date="{x:Bind ViewModel.ToDate, Mode=TwoWay}" DateChanged="OnDateChanged"/>
            <ComboBox Grid.Column="5" ItemsSource="{x:Bind ViewModel.SortOptions}" SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}" SelectionChanged="OnFilterChanged"/>
            <Button Grid.Column="7" Content="Clear filters" Click="OnClearClick"/>
        </Grid></Border>
        <Border Grid.Row="3" Margin="24,0,24,24" Style="{StaticResource ElevatedCardStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Padding="16,12" Background="{ThemeResource SurfaceAltBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="110"/><ColumnDefinition Width="100"/><ColumnDefinition Width="140"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
                <TextBlock Text="GRN NUMBER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="1" Text="PO NUMBER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="2" Text="SUPPLIER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="3" Text="RECEIVED" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="5" Text="ITEMS" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="6" Text="CREATED BY" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="7" Text="ACTIONS" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/>
            </Grid>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"><FontIcon Glyph="&#xE8B0;" FontSize="36"/><TextBlock Text="No goods receipts found." FontWeight="SemiBold"/><TextBlock Text="Open a submitted purchase order and choose Receive Goods." Style="{StaticResource SecondaryTextStyle}"/></StackPanel>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Receipts}" SelectionMode="None" Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="IsTabStop" Value="False"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate x:DataType="vm:GoodsReceiptRowViewModel">
                <Grid Padding="16,12" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="110"/><ColumnDefinition Width="100"/><ColumnDefinition Width="140"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Number}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{x:Bind PurchaseOrderNumber}"/><TextBlock Grid.Column="2" Text="{x:Bind Supplier}"/><TextBlock Grid.Column="3" Text="{x:Bind ReceivedDate}"/><Border Grid.Column="4" Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Left"><TextBlock Text="{x:Bind Status}" Style="{StaticResource BadgeTextStyle}"/></Border><TextBlock Grid.Column="5" Text="{x:Bind TotalItems}"/><TextBlock Grid.Column="6" Text="{x:Bind CreatedBy}"/>
                    <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"><Button Content="View" Tag="{x:Bind}" Click="OnViewClick"/><Button Content="Reconcile" Tag="{x:Bind}" Click="OnReconcileClick"/><Button Content="Create Purchase" Tag="{x:Bind}" Click="OnCreatePurchaseClick" Visibility="{x:Bind CanCreatePurchase, Converter={StaticResource BoolToVisibilityConverter}}"/><Button Content="Cancel" Tag="{x:Bind}" Click="OnCancelClick" Visibility="{x:Bind IsDraft, Converter={StaticResource BoolToVisibilityConverter}}"/></StackPanel>
                </Grid></DataTemplate></ListView.ItemTemplate></ListView>
        </Grid></Border>
    </Grid>
</Page>
