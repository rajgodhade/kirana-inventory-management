<Page x:Class="Kirana.App.Views.PurchaseOrderEntryPage" x:Name="RootPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Kirana.App.ViewModels" xmlns:dom="using:Kirana.Domain.Entities">
    <Grid Background="{ThemeResource PageBackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Button x:Name="FocusSink" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" IsTabStop="True" TabIndex="32767"
                HorizontalAlignment="Left" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw"/>
        <Grid Padding="{StaticResource PageHeaderPadding}"><StackPanel><TextBlock x:Name="PageTitle" Text="New Purchase Order" Style="{StaticResource PageTitleTextStyle}"/><TextBlock Text="Expected procurement only — saving or submitting does not receive stock or create a payable." Style="{StaticResource PageSubtitleTextStyle}"/></StackPanel></Grid>
        <ScrollViewer Grid.Row="1"><Grid Margin="24,0,24,18" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="14">
                <Border Style="{StaticResource ElevatedCardStyle}" Padding="16"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="SupplierSearch" Grid.Column="0" Header="Supplier *" PlaceholderText="Search supplier name or code…"
                                    Text="{x:Bind ViewModel.SupplierSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ItemsSource="{x:Bind ViewModel.SupplierSuggestions}" TextChanged="OnSupplierSearchTextChanged"
                                    IsSuggestionListOpen="{x:Bind ViewModel.IsSupplierSuggestionsOpen, Mode=TwoWay}"
                                    SuggestionChosen="OnSupplierSuggestionChosen" GotFocus="OnSupplierSearchGotFocus" LostFocus="OnSupplierSearchLostFocus"
                                    KeyDown="OnSupplierSearchKeyDown"
                                    AutomationProperties.Name="Search and select supplier">
                        <AutoSuggestBox.ItemTemplate><DataTemplate x:DataType="vm:SearchSuggestionItem"><StackPanel Padding="4,2"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextStyle}"/></StackPanel></DataTemplate></AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                    <CalendarDatePicker Grid.Column="1" Header="Order date" Date="{x:Bind ViewModel.OrderDate, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                </Grid></Border>
                <Border Style="{StaticResource ElevatedCardStyle}" Padding="16">
                    <StackPanel Spacing="0">
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ProductSearch" PlaceholderText="Search product name / SKU / code / barcode…"
                                     Text="{x:Bind ViewModel.ProductSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="OnProductSearchTextChanged" GotFocus="OnProductSearchGotFocus"
                                     KeyDown="OnProductSearchKeyDown" AutomationProperties.Name="Search products to add"/>
                            <Button Grid.Column="1" Content="Add Product" Style="{StaticResource AccentButtonStyle}" Click="OnAddProductClick"/>
                        </Grid>

                        <!-- Deliberately part of the page tree rather than a Popup: a Popup is hosted in
                             the popup root, outside the themed window subtree, where its {ThemeResource}
                             lookups and compiled item bindings do not resolve. It still reads as a
                             dropdown by sitting directly under the search box. -->
                        <Border x:Name="ProductPickerRoot" Margin="0,8,0,0"
                                Visibility="{x:Bind ViewModel.IsProductPickerOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                Background="{ThemeResource SurfaceBrush}"
                                BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="10"
                                Padding="0" MaxHeight="360"
                                AutomationProperties.Name="Product picker, multiple selection">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <ListView x:Name="ProductPickerList" ItemsSource="{x:Bind ViewModel.ProductPickerItems}"
                                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnProductItemClick"
                                              KeyDown="OnProductPickerKeyDown" Padding="6"
                                              AutomationProperties.Name="Product results">
                                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,1"/><Setter Property="MinHeight" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                                        <!-- Runtime bindings are intentional. WinUI recycles ListView containers;
                                             compiled bindings retained values from the previous row, causing blank
                                             names, stale checks and an "Already added" badge on unrelated products. -->
                                        <ListView.ItemTemplate><DataTemplate>
                                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Border Height="1" Background="{ThemeResource SurfaceBorderBrush}" Margin="4,8,4,7" Visibility="{Binding ShowGroupDivider, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Grid.Row="1" Text="{Binding GroupHeading}" Style="{StaticResource ColumnHeaderTextStyle}" Visibility="{Binding GroupHeading, Converter={StaticResource StringToVisibilityConverter}}" Margin="10,4,0,5"/>
                                                <Border Grid.Row="2" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="6" MinHeight="58">
                                                    <Grid>
                                                        <Border Background="{ThemeResource PastelTealBrush}" Opacity="0.55" CornerRadius="6" Visibility="{Binding IsReplenishmentSuggestion, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <Border Width="3" Background="{ThemeResource BrandPrimaryBrush}" CornerRadius="3" HorizontalAlignment="Left" Visibility="{Binding IsReplenishmentSuggestion, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        <Grid Padding="10,7" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSelectable}" MinWidth="0" VerticalAlignment="Center"
                                                                      AutomationProperties.Name="{Binding AccessibleName}"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Background="{ThemeResource PastelAmberBrush}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center" Visibility="{Binding IsAlreadyAdded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="Already added" Foreground="{ThemeResource PastelAmberOnBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate></ListView.ItemTemplate>
                                    </ListView>

                                    <Grid Grid.Row="1" Padding="12,10" ColumnSpacing="8" Background="{ThemeResource SurfaceAltBrush}" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,1,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedProductCount, Mode=OneWay, Converter={StaticResource SelectedCountConverter}}" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"/>
                                        <Button Grid.Column="1" Content="Select All" Click="OnSelectAllProductsClick"/>
                                        <Button Grid.Column="2" Content="Clear" Click="OnClearProductSelectionClick" IsEnabled="{x:Bind ViewModel.HasProductSelection, Mode=OneWay}"/>
                                        <Button Grid.Column="3" Content="{x:Bind ViewModel.AddSelectedLabel, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"
                                                Click="OnAddSelectedProductsClick" IsEnabled="{x:Bind ViewModel.HasProductSelection, Mode=OneWay}"/>
                                    </Grid>
                                </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ElevatedCardStyle}" Padding="0" MinHeight="280"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Padding="16,12" Background="{ThemeResource SurfaceAltBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><TextBlock Text="PRODUCT" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="1" Text="QTY" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="2" Text="EXPECTED COST" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="3" Text="DISC %" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="4" Text="LINE TOTAL" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/></Grid>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasLines, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"><TextBlock Text="No products added yet." FontWeight="SemiBold"/><TextBlock Text="Search by product, SKU, code, or active barcode." Style="{StaticResource CaptionTextStyle}"/></StackPanel>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Lines}" SelectionMode="None" Visibility="{x:Bind ViewModel.HasLines, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate x:DataType="vm:PurchaseOrderLineViewModel"><Grid Padding="16,10" ColumnSpacing="8" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/><ColumnDefinition Width="120"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind ProductName}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ProductCode}" Style="{StaticResource CodeTextStyle}"/></StackPanel><TextBox Grid.Column="1" Text="{x:Bind QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Bind}" TextChanged="OnLineChanged"/><TextBox Grid.Column="2" Text="{x:Bind UnitCostText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Bind}" TextChanged="OnLineChanged"/><TextBox Grid.Column="3" Text="{x:Bind DiscountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Bind}" TextChanged="OnLineChanged"/><TextBlock Grid.Column="4" Text="{x:Bind LineTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/><Button Grid.Column="5" Content="×" Tag="{x:Bind}" Click="OnRemoveClick" AutomationProperties.Name="Remove product"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                </Grid></Border>
                <TextBox Header="Notes" AcceptsReturn="True" MinHeight="72" Text="{x:Bind ViewModel.Notes, Mode=TwoWay}"/>
                <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource ElevatedCardStyle}" Padding="20" VerticalAlignment="Top"><StackPanel Spacing="12"><TextBlock Text="Expected totals" Style="{StaticResource SectionTitleTextStyle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="10"><TextBlock Text="Subtotal"/><TextBlock Text="Discount"/><TextBlock Text="GST"/><TextBlock Text="Round off"/><TextBlock Text="Expected Total" FontWeight="Bold" FontSize="18" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1" Spacing="10" HorizontalAlignment="Right"><TextBlock Text="{x:Bind ViewModel.SubTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"/><TextBlock Text="{x:Bind ViewModel.DiscountTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"/><TextBlock Text="{x:Bind ViewModel.TaxTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"/><TextBlock Text="{x:Bind ViewModel.RoundOff, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"/><TextBlock Text="{x:Bind ViewModel.GrandTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="18" Margin="0,8,0,0"/></StackPanel></Grid><Border Background="{ThemeResource PastelBlueBrush}" Padding="12" CornerRadius="10"><TextBlock Text="No stock, supplier balance, or accounting entry is created until goods are received through the purchase workflow." TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}"/></Border></StackPanel></Border>
        </Grid></ScrollViewer>
        <Grid Grid.Row="2" Padding="24,10" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Grid.Column="1" Content="Cancel" Click="OnCancelClick"/><Button Grid.Column="2" Content="Save Draft" Margin="8,0,0,0" Click="OnSaveDraftClick"/><Button Grid.Column="3" Content="Submit Order" Margin="8,0,0,0" Style="{StaticResource AccentButtonStyle}" Click="OnSubmitClick"/></Grid>
    </Grid>
</Page>
