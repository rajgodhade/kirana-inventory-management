<Page
    x:Class="Kirana.App.Views.BackupManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Backup Manager" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Every backup bundles the full database and store assets, and is verified before it is recorded."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <Button Grid.Column="1" Click="OnRefreshClick" VerticalAlignment="Center"
                    AutomationProperties.Name="Refresh backup history">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.CreateBackupCommand}"
                    IsEnabled="{x:Bind ViewModel.CanManageBackups}"
                    AutomationProperties.Name="Create backup now">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                    <TextBlock Text="Create Backup Now" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Padding="{StaticResource ToolbarPadding}" Spacing="8">
            <Border Style="{StaticResource CardBorderStyle}" Padding="16,12" Background="{ThemeResource SurfaceAltBrush}">
                <StackPanel Spacing="2">
                    <TextBlock Text="Backup location" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.BackupLocation, Mode=OneWay}"
                               Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="{x:Bind ViewModel.RetentionSummary, Mode=OneWay}"
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />
            <InfoBar IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Success" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" IsClosable="False" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="24,0,24,24">
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="14,10" ColumnSpacing="16"
                          Background="{ThemeResource SurfaceAltBrush}"
                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" MinWidth="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TAKEN" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="TYPE" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="FILE" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="SIZE" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Center" />
                    </Grid>

                    <TextBlock Grid.Row="1" Margin="24" Style="{StaticResource SecondaryTextStyle}"
                               Text="No backups yet. Use “Create Backup Now” to take the first one."
                               Visibility="{x:Bind ViewModel.HasNoBackups, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.History}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BackupHistoryItemViewModel">
                                <Grid Padding="14,12" ColumnSpacing="16"
                                      BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" MinWidth="200" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" MinWidth="180" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind CreatedAtLocal}"
                                               Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1" Text="{x:Bind TypeLabel}"
                                               Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FileName}" Style="{StaticResource CodeTextStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Notes}" Style="{StaticResource CaptionTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{x:Bind HasNotes, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{x:Bind SizeLabel}"
                                               Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center" />

                                    <Border Grid.Column="4" Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Center"
                                            Background="{ThemeResource SuccessSubtleBrush}"
                                            Visibility="{x:Bind IsVerified, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}" Style="{StaticResource BadgeTextStyle}"
                                                   Foreground="{ThemeResource SuccessBrush}" />
                                    </Border>

                                    <Border Grid.Column="4" Style="{StaticResource BadgeBorderStyle}" HorizontalAlignment="Center"
                                            Background="{ThemeResource DangerSubtleBrush}"
                                            Visibility="{x:Bind IsVerified, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}" Style="{StaticResource BadgeTextStyle}"
                                                   Foreground="{ThemeResource DangerBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Validate" Click="OnValidateClick" Tag="{x:Bind}"
                                                IsEnabled="{x:Bind FileExists}" />
                                        <Button Content="Delete" Click="OnDeleteClick" Tag="{x:Bind}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
