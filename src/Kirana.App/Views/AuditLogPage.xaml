<Page
    x:Class="Kirana.App.Views.AuditLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="◀ Management" Click="OnBackClick" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="Audit Log" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Lock &amp; Return to Billing" Click="OnLockClick" />
        </Grid>

        <!-- Filters -->
        <Grid Grid.Row="1" Padding="20,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" Header="User" PlaceholderText="All users"
                      ItemsSource="{x:Bind ViewModel.Users}" DisplayMemberPath="FullName"
                      SelectedItem="{x:Bind ViewModel.SelectedUser, Mode=TwoWay}" />

            <ComboBox Grid.Column="1" Header="Action" PlaceholderText="All actions"
                      ItemsSource="{x:Bind ViewModel.Actions}"
                      SelectedItem="{x:Bind ViewModel.SelectedAction, Mode=TwoWay}" />

            <TextBox Grid.Column="2" Header="Entity" PlaceholderText="e.g. Sale, Product"
                     Text="{x:Bind ViewModel.EntityText, Mode=TwoWay}" />

            <CalendarDatePicker Grid.Column="3" Header="From" PlaceholderText="Any"
                                Date="{x:Bind ViewModel.FromDate, Mode=TwoWay}" />

            <CalendarDatePicker Grid.Column="4" Header="To" PlaceholderText="Any"
                                 Date="{x:Bind ViewModel.ToDate, Mode=TwoWay}" />

            <Button Grid.Column="6" Content="Search" Command="{x:Bind ViewModel.SearchCommand}" VerticalAlignment="Bottom" />
            <Button Grid.Column="7" Content="Clear" Click="OnClearClick" VerticalAlignment="Bottom" Margin="8,0,0,0" />
        </Grid>

        <!-- Results -->
        <Grid Grid.Row="2">
            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Margin="20,0,20,8" VerticalAlignment="Top" />

            <ListView ItemsSource="{x:Bind ViewModel.Results}" Padding="20,0,20,20" SelectionMode="None">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Timestamp" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="User" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Action" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Entity" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Details" FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AuditLogRowViewModel">
                        <Grid ColumnSpacing="12" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind TimestampText}" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{x:Bind UserDisplay}" FontSize="12" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Action}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Entity}" FontSize="12" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Details}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
