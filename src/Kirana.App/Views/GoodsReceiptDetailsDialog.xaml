<ContentDialog x:Class="Kirana.App.Views.GoodsReceiptDetailsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dom="using:Kirana.Domain.Entities" CloseButtonText="Close">
    <ContentDialog.Resources><x:Double x:Key="ContentDialogMaxWidth">860</x:Double><x:Double x:Key="ContentDialogMinWidth">720</x:Double></ContentDialog.Resources>
    <ContentDialog.Title><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Goods Receipt" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="{x:Bind Receipt.GoodsReceiptNumber}" Style="{StaticResource CodeTextStyle}"/></StackPanel><Button Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}" Click="OnCloseClick" AutomationProperties.Name="Close dialog"><FontIcon Glyph="&#xE711;" FontSize="14"/></Button></Grid></ContentDialog.Title>
    <ScrollViewer MaxHeight="620"><StackPanel Spacing="14"><Border Style="{StaticResource ElevatedCardStyle}"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PURCHASE ORDER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind Receipt.PurchaseOrder.PurchaseOrderNumber}" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="SUPPLIER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind Receipt.SupplierNameSnapshot}" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="RECEIVED" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock x:Name="ReceivedDateText"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind Receipt.Status}" FontWeight="SemiBold"/></StackPanel></Grid></Border>
        <Border Style="{StaticResource ElevatedCardStyle}" Padding="0"><StackPanel><Grid Padding="14,10" Background="{ThemeResource SurfaceAltBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="PRODUCT" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="1" Text="ORDERED" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="2" Text="RECEIVED" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="3" Text="UNIT" Style="{StaticResource ColumnHeaderTextStyle}"/></Grid><ItemsControl ItemsSource="{x:Bind Receipt.Items}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="dom:GoodsReceiptItem"><Grid Padding="14,10" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind ProductNameSnapshot}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ProductCodeSnapshot}" Style="{StaticResource CodeTextStyle}"/></StackPanel><TextBlock Grid.Column="1" Text="{x:Bind OrderedQuantitySnapshot}"/><TextBlock Grid.Column="2" Text="{x:Bind ReceivedQuantity}" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="{x:Bind UnitSnapshot}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        <TextBlock Text="Inventory and supplier payable remain unchanged until an actual Purchase is finalized." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="View Purchase Order" Click="OnViewPurchaseOrderClick"/><Button x:Name="ViewPurchaseButton" Content="View Purchase" Click="OnViewPurchaseClick"/><Button Content="View Reconciliation" Click="OnReconciliationClick"/></StackPanel>
    </StackPanel></ScrollViewer>
</ContentDialog>
