<Page x:Class="Kirana.App.Views.InvoicesPage" x:Name="RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:dom="using:Kirana.Domain.Entities"
      xmlns:vm="using:Kirana.App.ViewModels"
      xmlns:interaction="using:Kirana.App.Interaction">
    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}"><StackPanel Spacing="2"><TextBlock Text="Invoices" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Completed sales, receipts, returns and invoice history." Style="{StaticResource PageSubtitleTextStyle}" /></StackPanel></Grid>

        <Grid Grid.Row="1" Padding="24,0,24,16" ColumnSpacing="{StaticResource SpacingL}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="OnTodayClick" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><Border Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelBlueBrush}" BorderBrush="{ThemeResource PastelBlueBrush}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity=".65"/><FontIcon Glyph="&#xE8C7;" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="{ThemeResource PastelBlueOnBrush}"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="TODAY'S SALES" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}"/><TextBlock Text="{x:Bind ViewModel.TodaySales, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}"/><TextBlock Text="completed today" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}"/></StackPanel></Grid></Border></Button>
            <Button Grid.Column="1" Click="OnTodayClick" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><Border Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelGreenBrush}" BorderBrush="{ThemeResource PastelGreenBrush}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity=".65"/><FontIcon Glyph="&#xE7C3;" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="{ThemeResource PastelGreenOnBrush}"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="TODAY'S BILLS" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}"/><TextBlock Text="{x:Bind ViewModel.TodayBillsText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}"/><TextBlock Text="in the current view" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}"/></StackPanel></Grid></Border></Button>
            <Button Grid.Column="2" Click="OnTodayClick" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><Border Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelVioletBrush}" BorderBrush="{ThemeResource PastelVioletBrush}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity=".65"/><FontIcon Glyph="&#xEAF4;" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="{ThemeResource PastelVioletOnBrush}"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="AVERAGE BILL VALUE" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}"/><TextBlock Text="{x:Bind ViewModel.AverageBillValue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}"/><TextBlock Text="today" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}"/></StackPanel></Grid></Border></Button>
            <Button Grid.Column="3" Click="OnClearDatesClick" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"><Border Style="{StaticResource KpiCardStyle}" Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource KpiIconChipStyle}" Background="{ThemeResource SurfaceBrush}" Opacity=".65"/><FontIcon Glyph="&#xE9D9;" Margin="0,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="{ThemeResource PastelAmberOnBrush}"/><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="TOTAL SALES" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}"/><TextBlock Text="{x:Bind ViewModel.SelectedPeriodSales, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}"/><TextBlock Text="selected period" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}"/></StackPanel></Grid></Border></Button>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource FilterBarStyle}" Margin="24,0,24,16"><StackPanel Spacing="8"><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBox PlaceholderText="Search invoice / customer / mobile..." Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnSearchTextChanged" KeyDown="OnSearchKeyDown" />
            <CalendarDatePicker Grid.Column="1" PlaceholderText="From date" Date="{x:Bind ViewModel.FromDateFilter, Mode=TwoWay}" DateChanged="OnDateChanged" />
            <CalendarDatePicker Grid.Column="2" PlaceholderText="To date" Date="{x:Bind ViewModel.ToDateFilter, Mode=TwoWay}" DateChanged="OnDateChanged" />
            <ComboBox Grid.Column="3" ItemsSource="{x:Bind ViewModel.PaymentMethodOptions}" SelectedItem="{x:Bind ViewModel.SelectedPaymentMethod, Mode=TwoWay}" SelectionChanged="OnFilterChanged" />
            <ComboBox Grid.Column="4" ItemsSource="{x:Bind ViewModel.CustomerFilterOptions}" SelectedItem="{x:Bind ViewModel.SelectedCustomerFilter, Mode=TwoWay}" SelectionChanged="OnFilterChanged"><ComboBox.ItemTemplate><DataTemplate x:DataType="dom:Customer"><TextBlock Text="{x:Bind Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        </Grid><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="130"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{x:Bind ViewModel.CashierFilterOptions}" DisplayMemberPath="Name" SelectedItem="{x:Bind ViewModel.SelectedCashierFilter, Mode=TwoWay}" SelectionChanged="OnFilterChanged"/>
            <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.PromotionFilterOptions}" SelectedItem="{x:Bind ViewModel.SelectedPromotionFilter, Mode=TwoWay}" SelectionChanged="OnFilterChanged"/>
            <ComboBox Grid.Column="2" ItemsSource="{x:Bind ViewModel.StatusFilterOptions}" SelectedItem="{x:Bind ViewModel.SelectedStatusFilter, Mode=TwoWay}" SelectionChanged="OnFilterChanged"/>
            <ComboBox Grid.Column="3" ItemsSource="{x:Bind ViewModel.SortOptions}" SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}" SelectionChanged="OnFilterChanged"/>
            <Button Grid.Column="5" Content="Clear dates" Click="OnClearDatesClick" />
            <Button Grid.Column="6" Content="Clear filters" Click="OnClearFiltersClick" />
            <Button Grid.Column="7" Content="Export" Click="OnExportClick" IsEnabled="{x:Bind ViewModel.CanExport}" />
        </Grid></StackPanel></Border>

        <Grid Grid.Row="3" Margin="24,0,24,24"><Border Style="{StaticResource ElevatedCardStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="12,10" ColumnSpacing="12" Background="{ThemeResource SurfaceAltBrush}" CornerRadius="16,16,0,0" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*" MinWidth="160"/><ColumnDefinition Width="120"/><ColumnDefinition Width="145"/><ColumnDefinition Width="80"/><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><TextBlock Text="INVOICE" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="1" Text="CUSTOMER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="2" Text="CASHIER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="3" Text="DATE &amp; TIME" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="4" Text="ITEMS" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="5" Text="PAYMENT / PROMO" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="6" Text="TOTAL" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/><TextBlock Grid.Column="7" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="8" Text="ACTIONS" Style="{StaticResource ColumnHeaderTextStyle}"/></Grid>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"><FontIcon Glyph="&#xE8C7;" FontSize="36" Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="No invoices found." Style="{StaticResource CardTitleTextStyle}" HorizontalAlignment="Center"/><TextBlock Text="Try changing the filters or date range." Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center"/></StackPanel>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Invoices}" SelectionMode="None" Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="0"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate x:DataType="vm:InvoiceRowViewModel"><Border Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"><Grid Padding="12,11" ColumnSpacing="12" Tag="{x:Bind}" Tapped="OnRowTapped" interaction:ActionCursor.IsActionable="True"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*" MinWidth="160"/><ColumnDefinition Width="120"/><ColumnDefinition Width="145"/><ColumnDefinition Width="80"/><ColumnDefinition Width="150"/><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind InvoiceNumber}" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{x:Bind CustomerName}" Style="{StaticResource BodyTextStyle}"/><TextBlock Text="{x:Bind CustomerPhoneText}" Style="{StaticResource CaptionTextStyle}"/></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind CashierName}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{x:Bind DateTimeText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{x:Bind TotalItemsText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/><StackPanel Grid.Column="5" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{x:Bind PaymentMethodText}" Style="{StaticResource CaptionTextStyle}"/><Border Background="{ThemeResource PastelVioletBrush}" Style="{StaticResource BadgeBorderStyle}" Visibility="{x:Bind HasPromotion, Converter={StaticResource BoolToVisibilityConverter}}"><TextBlock Text="{x:Bind PromotionText}" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}"/></Border></StackPanel><TextBlock Grid.Column="6" Text="{x:Bind GrandTotal, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource AmountTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/><Border Grid.Column="7" Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource SuccessSubtleBrush}" VerticalAlignment="Center"><TextBlock Text="{x:Bind StatusText}" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource SuccessBrush}"/></Border><StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button Content="View" Tag="{x:Bind}" Click="OnViewClick"/><Button Content="Print" Tag="{x:Bind}" Click="OnPrintClick"/><Button Tag="{x:Bind}" Width="34" Padding="8,5" AutomationProperties.Name="More invoice actions"><FontIcon Glyph="&#xE712;"/><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="Print GST invoice" Tag="{x:Bind}" Click="OnPrintGstClick" IsEnabled="{Binding ElementName=RootPage, Path=ViewModel.CanReprint}"/><MenuFlyoutItem Text="Duplicate copy" Tag="{x:Bind}" Click="OnDuplicateClick" IsEnabled="{Binding ElementName=RootPage, Path=ViewModel.CanReprint}"/><MenuFlyoutItem Text="Return items" Tag="{x:Bind}" Click="OnReturnClick" IsEnabled="{Binding ElementName=RootPage, Path=ViewModel.CanRefund}"/><MenuFlyoutItem Text="Refund" IsEnabled="False" ToolTipService.ToolTip="Use Return items to process supported refunds."/><MenuFlyoutSeparator/><MenuFlyoutItem Text="Export PDF" Click="OnExportPdfClick" IsEnabled="{Binding ElementName=RootPage, Path=ViewModel.CanExport}"/><MenuFlyoutItem Text="Export Excel" Click="OnExportExcelClick" IsEnabled="{Binding ElementName=RootPage, Path=ViewModel.CanExport}"/><MenuFlyoutItem Text="Share (coming soon)" IsEnabled="False"/><MenuFlyoutItem Text="Audit history" Tag="{x:Bind}" Click="OnViewClick"/></MenuFlyout></Button.Flyout></Button></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
        </Grid></Border><InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" VerticalAlignment="Top" Margin="0,0,0,8"/></Grid>
    </Grid>
</Page>
