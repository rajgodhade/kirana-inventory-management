<Page
    x:Class="Kirana.App.Views.SupplierLedgerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="◀ Suppliers" Click="OnBackClick" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{x:Bind ViewModel.SupplierName, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.SupplierCode, Mode=OneWay}" Opacity="0.7" FontSize="12" />
            </StackPanel>
            <Button Grid.Column="2" Content="Lock &amp; Return to Billing" Click="OnLockClick" />
        </Grid>

        <!-- Summary + actions -->
        <Grid Grid.Row="1" Padding="20,12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="20" FontWeight="Bold" VerticalAlignment="Center">
                <Run Text="Outstanding: ₹" /><Run Text="{x:Bind ViewModel.OutstandingBalance, Mode=OneWay}" />
            </TextBlock>
            <Button Grid.Column="2" Content="Record Payment" Style="{StaticResource AccentButtonStyle}"
                    Click="OnRecordPaymentClick" IsEnabled="{x:Bind ViewModel.CanManagePurchases}" />
        </Grid>

        <!-- Ledger -->
        <Grid Grid.Row="2">
            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Margin="20,0,20,8" VerticalAlignment="Top" />

            <ListView ItemsSource="{x:Bind ViewModel.Entries}" Padding="20,0,20,20" SelectionMode="None">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Date" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Reference" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Debit" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Credit" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="5" Text="Balance" FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SupplierLedgerRowViewModel">
                        <Grid ColumnSpacing="12" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind DateText}" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{x:Bind EntryType}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Reference}" FontSize="12" />
                            <TextBlock Grid.Column="3" Text="{x:Bind DebitText}" FontSize="12" />
                            <TextBlock Grid.Column="4" Text="{x:Bind CreditText}" FontSize="12" />
                            <TextBlock Grid.Column="5" Text="{x:Bind RunningBalanceText}" FontSize="12" FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
