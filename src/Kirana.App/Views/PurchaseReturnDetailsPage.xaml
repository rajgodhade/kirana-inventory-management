<Page
    x:Class="Kirana.App.Views.PurchaseReturnDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:entities="using:Kirana.Domain.Entities">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <StackPanel Spacing="2">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,0,24,24" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
                <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" />

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <StackPanel>
                            <TextBlock Text="Credited to supplier" Style="{StaticResource MetricLabelTextStyle}" />
                            <TextBlock x:Name="TotalText" Style="{StaticResource MetricTextStyle}" FontSize="22" />
                        </StackPanel>
                        <TextBlock x:Name="SupplierText" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="ReasonText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="10">
                    <TextBlock Text="Returned items" Style="{StaticResource SectionTitleTextStyle}" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                        <ItemsControl x:Name="LinesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="entities:PurchaseReturnItem">
                                    <Grid Padding="14,12" ColumnSpacing="16"
                                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="200" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind ProductNameSnapshot}" Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ProductCodeSnapshot}" Style="{StaticResource CodeTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center">
                                            <Run Text="{x:Bind Quantity, Converter={StaticResource QuantityConverter}}" /><Run Text=" " /><Run Text="{x:Bind UnitSnapshot}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{x:Bind BatchNumber}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind LineReturnAmount, Converter={StaticResource CurrencyConverter}}"
                                                   Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
