<Page
    x:Class="Kirana.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <StackPanel Spacing="2">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Appearance, security and store preferences." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,0,24,24" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">

                <!-- Appearance. Unlike the other settings this is a per-install display preference,
                     so it is deliberately not gated behind the settings permission. -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Appearance" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Choose how Kirana looks. Light is the default; dark is easier on the eyes in a dim shop."
                                       Style="{StaticResource PageSubtitleTextStyle}" />
                        </StackPanel>

                        <RadioButtons x:Name="ThemeChoice" SelectedIndex="0" SelectionChanged="OnThemeChoiceChanged">
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                            <x:String>Use Windows setting</x:String>
                        </RadioButtons>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Dashboard Security" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Automatically lock the Dashboard and return to Billing after a period of inactivity."
                                       Style="{StaticResource PageSubtitleTextStyle}" />
                        </StackPanel>

                        <ComboBox Header="Inactivity auto-lock" ItemsSource="{x:Bind ViewModel.DurationOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDurationOption, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanChangeSettings}" HorizontalAlignment="Stretch" />

                        <TextBox Header="Custom duration (minutes)" Text="{x:Bind ViewModel.CustomMinutesText, Mode=TwoWay}"
                                 Visibility="{x:Bind ViewModel.IsCustomSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsEnabled="{x:Bind ViewModel.CanChangeSettings}" />

                        <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}"
                                IsEnabled="{x:Bind ViewModel.CanChangeSettings}" HorizontalAlignment="Left" />

                        <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                                 Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                        <InfoBar IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                                 Severity="Success" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
