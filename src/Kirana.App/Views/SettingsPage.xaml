<Page
    x:Class="Kirana.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Kirana.App.Views.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <StackPanel Spacing="2">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Appearance, security and store preferences." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,0,24,24" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">

                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Device Status" Style="{StaticResource SectionTitleTextStyle}" />
                        <controls:DeviceStatusWidget Title="Receipt printer" Glyph="&#xE749;"
                            Detail="{x:Bind DeviceStatus.PrinterDetail, Mode=OneWay}"
                            Status="{x:Bind DeviceStatus.PrinterStatus, Mode=OneWay}" />
                        <controls:DeviceStatusWidget Title="Barcode scanner" Glyph="&#xE8BD;"
                            Detail="{x:Bind DeviceStatus.ScannerDetail, Mode=OneWay}"
                            Status="{x:Bind DeviceStatus.ScannerStatus, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- Appearance. Unlike the other settings this is a per-install display preference,
                     so it is deliberately not gated behind the settings permission. -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Cloud Backup" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" TextWrapping="Wrap"
                                       Text="Keep validated .kbak backups in your own Google Drive or OneDrive. Cloud backup never blocks billing or changes live data." />
                        </StackPanel>
                        <ComboBox Header="Provider" ItemsSource="{x:Bind ViewModel.CloudProviderOptions}"
                                  SelectedItem="{x:Bind ViewModel.CloudProvider, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanChangeSettings}" />
                        <Border Background="{ThemeResource SuccessSubtleBrush}" CornerRadius="10" Padding="12"
                                Visibility="{x:Bind ViewModel.CloudIsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SuccessBrush}" FontSize="18" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Google Drive connected" FontWeight="SemiBold" Foreground="{ThemeResource SuccessBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.CloudAccountDisplay, Mode=OneWay}" Style="{StaticResource PageSubtitleTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.LastCloudBackupText, Mode=OneWay}" Style="{StaticResource PageSubtitleTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="{ThemeResource WarningSubtleBrush}" CornerRadius="10" Padding="12"
                                Visibility="{x:Bind ViewModel.CloudIsDisconnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE783;" Foreground="{ThemeResource WarningBrush}" FontSize="17" />
                                <TextBlock Text="No cloud account connected" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Connect Google Drive" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ConnectCloudCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanChangeSettings}"
                                    Visibility="{x:Bind ViewModel.CloudIsDisconnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button Content="Disconnect" Command="{x:Bind ViewModel.DisconnectCloudCommand}" IsEnabled="{x:Bind ViewModel.CanChangeSettings}"
                                    Visibility="{x:Bind ViewModel.CloudIsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <Button Content="Backup now" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.BackupToCloudCommand}" IsEnabled="{x:Bind ViewModel.CloudIsConnected, Mode=OneWay}" />
                            <Button Content="View cloud backups" Command="{x:Bind ViewModel.ViewCloudBackupsCommand}" IsEnabled="{x:Bind ViewModel.CloudIsConnected, Mode=OneWay}" />
                        </StackPanel>
                        <ToggleSwitch Header="Enable automatic cloud backup" IsOn="{x:Bind ViewModel.CloudAutomaticBackupEnabled, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChangeSettings}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Header="Frequency" Width="160" ItemsSource="{x:Bind ViewModel.BackupFrequencyOptions}" SelectedItem="{x:Bind ViewModel.CloudBackupFrequency, Mode=TwoWay}" />
                            <TextBox Header="Time" Width="120" Text="{x:Bind ViewModel.CloudBackupTime, Mode=TwoWay}" />
                            <TextBox Header="Keep" Width="90" Text="{x:Bind ViewModel.CloudBackupRetentionText, Mode=TwoWay}" />
                        </StackPanel>
                        <InfoBar IsOpen="{x:Bind ViewModel.CloudBackupErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}" Severity="Error" Message="{x:Bind ViewModel.CloudBackupErrorMessage, Mode=OneWay}" />
                        <InfoBar IsOpen="{x:Bind ViewModel.CloudBackupStatusMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}" Severity="Success" Message="{x:Bind ViewModel.CloudBackupStatusMessage, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Appearance" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Choose how Kirana looks. Light is the default; dark is easier on the eyes in a dim shop."
                                       Style="{StaticResource PageSubtitleTextStyle}" />
                        </StackPanel>

                        <RadioButtons x:Name="ThemeChoice" SelectedIndex="0" SelectionChanged="OnThemeChoiceChanged">
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                            <x:String>Use Windows setting</x:String>
                        </RadioButtons>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Dashboard Security" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Automatically lock the Dashboard and return to Billing after a period of inactivity."
                                       Style="{StaticResource PageSubtitleTextStyle}" />
                        </StackPanel>

                        <ComboBox Header="Inactivity auto-lock" ItemsSource="{x:Bind ViewModel.DurationOptions}"
                                  SelectedItem="{x:Bind ViewModel.SelectedDurationOption, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanChangeSettings}" HorizontalAlignment="Stretch" />

                        <TextBox Header="Custom duration (minutes)" Text="{x:Bind ViewModel.CustomMinutesText, Mode=TwoWay}"
                                 Visibility="{x:Bind ViewModel.IsCustomSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsEnabled="{x:Bind ViewModel.CanChangeSettings}" />

                        <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}"
                                IsEnabled="{x:Bind ViewModel.CanChangeSettings}" HorizontalAlignment="Left" />

                        <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                                 Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
                        <InfoBar IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                                 Severity="Success" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Billing Authorization" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" TextWrapping="Wrap"
                                       Text="Owner-only. Turn off a manager PIN prompt for stores where the Owner runs billing alone — each change saves immediately." />
                        </StackPanel>

                        <ToggleSwitch Header="Require PIN to change selling price at billing"
                                      IsOn="{x:Bind ViewModel.RequirePinForPriceOverride, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanChangeSettings}" />

                        <ToggleSwitch Header="Require PIN to approve large discounts at billing"
                                      IsOn="{x:Bind ViewModel.RequirePinForLargeDiscount, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanChangeSettings}" />

                        <ToggleSwitch Header="Require PIN to reprint an invoice"
                                      IsOn="{x:Bind ViewModel.RequirePinForReprint, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanChangeSettings}" />

                        <InfoBar IsOpen="{x:Bind ViewModel.PinToggleErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                                 Severity="Error" Message="{x:Bind ViewModel.PinToggleErrorMessage, Mode=OneWay}" />
                        <InfoBar IsOpen="{x:Bind ViewModel.PinToggleStatusMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                                 Severity="Success" Message="{x:Bind ViewModel.PinToggleStatusMessage, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Backup &amp; Export" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" TextWrapping="Wrap"
                                       Text="Where backups are kept, how often they are taken automatically, and how many to keep. Each change saves immediately." />
                        </StackPanel>

                        <ToggleSwitch Header="Take backups automatically"
                                      IsOn="{x:Bind ViewModel.AutomaticBackupEnabled, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanChangeSettings}" />

                        <ComboBox Header="Automatic backup frequency" ItemsSource="{x:Bind ViewModel.BackupFrequencyOptions}"
                                  SelectedItem="{x:Bind ViewModel.AutomaticBackupFrequency, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanChangeSettings}" HorizontalAlignment="Stretch" />

                        <TextBox Header="Backup folder" IsReadOnly="True"
                                 Text="{x:Bind ViewModel.BackupDirectory, Mode=OneWay}"
                                 PlaceholderText="{x:Bind ViewModel.BackupDirectoryPlaceholder}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Choose folder…" Click="OnChooseBackupFolderClick"
                                    IsEnabled="{x:Bind ViewModel.CanChangeSettings}" />
                            <Button Content="Use default" Command="{x:Bind ViewModel.UseDefaultBackupFolderCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanChangeSettings}" />
                        </StackPanel>

                        <TextBox Header="Backups to keep"
                                 Text="{x:Bind ViewModel.BackupRetentionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind ViewModel.CanChangeSettings}" />
                        <Button Content="Save retention" Command="{x:Bind ViewModel.SaveRetentionCommand}"
                                IsEnabled="{x:Bind ViewModel.CanChangeSettings}" HorizontalAlignment="Left" />

                        <ComboBox Header="Preferred export format" ItemsSource="{x:Bind ViewModel.ExportFormatOptions}"
                                  SelectedItem="{x:Bind ViewModel.DefaultExportFormat, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanChangeSettings}" HorizontalAlignment="Stretch" />

                        <InfoBar IsOpen="{x:Bind ViewModel.BackupSettingsErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                                 Severity="Error" Message="{x:Bind ViewModel.BackupSettingsErrorMessage, Mode=OneWay}" />
                        <InfoBar IsOpen="{x:Bind ViewModel.BackupSettingsStatusMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                                 Severity="Success" Message="{x:Bind ViewModel.BackupSettingsStatusMessage, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
