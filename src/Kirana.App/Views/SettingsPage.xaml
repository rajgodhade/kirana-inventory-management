<Page
    x:Class="Kirana.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="◀ Management" Click="OnBackClick" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Lock &amp; Return to Billing" Click="OnLockClick" />
        </Grid>

        <StackPanel Grid.Row="1" Padding="20" Spacing="12" MaxWidth="420" HorizontalAlignment="Left">
            <TextBlock Text="Dashboard Security" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Automatically lock the Dashboard and return to Billing after a period of inactivity."
                       Opacity="0.7" TextWrapping="Wrap" />

            <ComboBox Header="Inactivity auto-lock" ItemsSource="{x:Bind ViewModel.DurationOptions}"
                      SelectedItem="{x:Bind ViewModel.SelectedDurationOption, Mode=TwoWay}"
                      IsEnabled="{x:Bind ViewModel.CanChangeSettings}" />

            <TextBox Header="Custom duration (minutes)" Text="{x:Bind ViewModel.CustomMinutesText, Mode=TwoWay}"
                     Visibility="{x:Bind ViewModel.IsCustomSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                     IsEnabled="{x:Bind ViewModel.CanChangeSettings}" />

            <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}"
                    IsEnabled="{x:Bind ViewModel.CanChangeSettings}" HorizontalAlignment="Left" />

            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Success" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
