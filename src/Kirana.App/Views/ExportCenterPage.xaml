<Page
    x:Class="Kirana.App.Views.ExportCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="{StaticResource PageHeaderPadding}" Spacing="2">
            <TextBlock Text="Export Center" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Save a full copy of any data set as CSV or Excel. You can only export data you are allowed to see elsewhere in Kirana."
                       Style="{StaticResource PageSubtitleTextStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Padding="{StaticResource ToolbarPadding}" Spacing="8">
            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" IsClosable="False" />
            <InfoBar IsOpen="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Success" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" IsClosable="False" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,0,24,24" Spacing="12">

                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                           Text="Your role does not allow exporting any data set."
                           Visibility="{x:Bind ViewModel.HasNoDatasets, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.Datasets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExportDatasetViewModel">
                            <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}" Margin="0,0,0,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleTextStyle}" />
                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="CSV" Click="OnExportCsvClick" Tag="{x:Bind}"
                                                AutomationProperties.Name="Export as CSV" />
                                        <Button Content="Excel" Click="OnExportExcelClick" Tag="{x:Bind}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                AutomationProperties.Name="Export as Excel" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Reports already export to CSV, Excel and PDF from their own screens, each with
                     its own date filter — sending the user there beats duplicating that here. -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}"
                        Background="{ThemeResource SurfaceAltBrush}"
                        Visibility="{x:Bind ViewModel.CanViewReports, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Reports" Style="{StaticResource CardTitleTextStyle}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                       Text="Sales, GST, inventory, profit and expense reports export to CSV, Excel and PDF from the Reports screen, where you can also set a date range." />
                        </StackPanel>

                        <Button Grid.Column="1" Content="Go to Reports" Click="OnGoToReportsClick" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
