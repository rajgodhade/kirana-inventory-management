<Page
    x:Class="Kirana.App.Views.DeviceStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Padding="{StaticResource PageHeaderPadding}">
            <StackPanel><TextBlock Text="Device Status" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Live Windows device discovery with honest status and last-seen information." Style="{StaticResource PageSubtitleTextStyle}" /></StackPanel>
            <Button Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRefreshClick" />
        </Grid>
        <InfoBar Grid.Row="1" Margin="24,0,24,12" IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Warning" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        <ListView Grid.Row="2" Margin="24,0,24,24" ItemsSource="{x:Bind ViewModel.Devices}" SelectionMode="None">
            <ListView.ItemTemplate><DataTemplate x:DataType="vm:DeviceStatusRowViewModel">
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,0,8">
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="{x:Bind DefaultText}" Foreground="{ThemeResource BrandPrimaryBrush}" FontWeight="SemiBold" /></StackPanel><TextBlock Text="{x:Bind ManufacturerModel}" Style="{StaticResource CaptionTextStyle}" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="TYPE / CONNECTION" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock><Run Text="{x:Bind Type}" /><Run Text=" · " /><Run Text="{x:Bind Connection}" /></TextBlock></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="LAST SEEN" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock Text="{x:Bind LastSeenText}" /></StackPanel>
                        <Border Grid.Column="3" Background="{x:Bind Status, Converter={StaticResource HardwareStatusBackgroundConverter}}" CornerRadius="12" Padding="10,5"><TextBlock Text="{x:Bind StatusText}" FontWeight="SemiBold" Foreground="{x:Bind Status, Converter={StaticResource HardwareStatusForegroundConverter}}" /></Border>
                    </Grid>
                </Border>
            </DataTemplate></ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
