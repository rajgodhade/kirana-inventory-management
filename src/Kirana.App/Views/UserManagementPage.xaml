<Page
    x:Class="Kirana.App.Views.UserManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Users" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Local accounts, roles and access." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnAddUserClick" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add User" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- List -->
        <Grid Grid.Row="1">
            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Margin="20,8,20,8" VerticalAlignment="Top" />

            <ListView ItemsSource="{x:Bind ViewModel.Users}" Padding="20,0,20,20" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:UserRowViewModel">
                        <Grid Padding="12" ColumnSpacing="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="200" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{x:Bind FullName}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Username}" Opacity="0.7" FontSize="12" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{x:Bind RoleName}" VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2" Text="{x:Bind LastLoginText}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Active" Foreground="Green" FontSize="11"
                                           Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="Inactive" Foreground="Gray" FontSize="11"
                                           Visibility="{x:Bind IsActive, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <TextBlock Text="Locked" Foreground="Red" FontSize="11"
                                           Visibility="{x:Bind IsLocked, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content="Edit" Click="OnEditClick" Tag="{x:Bind}" />
                                <Button Content="Reset Password" Click="OnResetPasswordClick" Tag="{x:Bind}" />
                                <Button Content="Set PIN" Click="OnSetPinClick" Tag="{x:Bind}" />
                                <Button Content="Unlock" Click="OnUnlockClick" Tag="{x:Bind}"
                                        Visibility="{x:Bind IsLocked, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="Deactivate" Click="OnToggleActiveClick" Tag="{x:Bind}"
                                        Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="Activate" Click="OnToggleActiveClick" Tag="{x:Bind}"
                                        Visibility="{x:Bind IsActive, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
