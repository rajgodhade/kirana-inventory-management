<ContentDialog
    x:Class="Kirana.App.Views.StockAdjustmentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:entities="using:Kirana.Domain.Entities"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DialogTitleText" Grid.Column="0" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                    Click="OnCloseIconClick" AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <StackPanel Spacing="10" MinWidth="420" MaxHeight="560">
        <TextBlock Text="{x:Bind ViewModel.ProductName}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock>
            <Run Text="Current stock: " /><Run Text="{x:Bind ViewModel.CurrentStock, Mode=OneWay}" />
        </TextBlock>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" Header="Type"
                      ItemsSource="{x:Bind ViewModel.AdjustableTypes}"
                      SelectedItem="{x:Bind ViewModel.SelectedMovementType, Mode=TwoWay}" HorizontalAlignment="Stretch" />
            <TextBox Grid.Column="1" Header="Quantity" Text="{x:Bind ViewModel.QuantityText, Mode=TwoWay}" />
        </Grid>

        <TextBox Header="Reason" Text="{x:Bind ViewModel.Reason, Mode=TwoWay}" />

        <Button Content="Apply Adjustment" Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.ApplyCommand}" HorizontalAlignment="Left" />

        <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <TextBlock Text="Recent movements" FontWeight="SemiBold" Margin="0,8,0,0" />
        <ListView ItemsSource="{x:Bind ViewModel.History}" MaxHeight="220">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="entities:StockMovement">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind TimestampUtc}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{x:Bind MovementType}" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="{x:Bind QuantityChange}" FontSize="12" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Reason}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
