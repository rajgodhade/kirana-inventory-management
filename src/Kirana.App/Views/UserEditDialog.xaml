<ContentDialog
    x:Class="Kirana.App.Views.UserEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="360">

        <TextBox Header="Username" Text="{x:Bind ViewModel.Username, Mode=TwoWay}"
                 IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />

        <TextBox Header="Full Name" Text="{x:Bind ViewModel.FullName, Mode=TwoWay}" />

        <ComboBox Header="Role" ItemsSource="{x:Bind ViewModel.Roles}" DisplayMemberPath="Name"
                  SelectedItem="{x:Bind ViewModel.SelectedRole, Mode=TwoWay}" />

        <PasswordBox Header="Password" Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                     Visibility="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

        <PasswordBox Header="PIN (optional, 4-6 digits)" Password="{x:Bind ViewModel.Pin, Mode=TwoWay}"
                     Visibility="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

        <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
