<Page
    x:Class="Kirana.App.Views.ProductsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <StackPanel Spacing="2">
                <TextBlock Text="Products" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Catalogue, pricing, stock levels and batches." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Padding="20,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" PlaceholderText="Search name / SKU / barcode…"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnSearchBoxKeyDown"
                     TextChanged="OnSearchTextChanged" />

            <ComboBox Grid.Column="1" PlaceholderText="Category"
                      ItemsSource="{x:Bind ViewModel.Categories}" DisplayMemberPath="Name"
                      SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                      SelectionChanged="OnCategoryOrBrandChanged" />

            <ComboBox Grid.Column="2" PlaceholderText="Brand"
                      ItemsSource="{x:Bind ViewModel.Brands}" DisplayMemberPath="Name"
                      SelectedItem="{x:Bind ViewModel.SelectedBrand, Mode=TwoWay}"
                      SelectionChanged="OnCategoryOrBrandChanged" />

            <CheckBox Grid.Column="3" Content="Show inactive" VerticalAlignment="Center"
                      IsChecked="{x:Bind ViewModel.ShowInactive, Mode=TwoWay}" Checked="OnShowInactiveChanged" Unchecked="OnShowInactiveChanged" />

            <Button Grid.Column="5" Content="Categories" Click="OnManageCategoriesClick" />
            <Button Grid.Column="6" Content="Brands" Click="OnManageBrandsClick" Margin="8,0,0,0" />
            <Button Grid.Column="7" Content="Bulk Labels" Click="OnBulkLabelsClick" Margin="8,0,0,0"
                    IsEnabled="{x:Bind ViewModel.CanManageInventory}" />
            <Button Grid.Column="8" Content="Import" Click="OnImportProductsClick" Margin="8,0,0,0"
                    IsEnabled="{x:Bind ViewModel.CanEditProducts}"
                    ToolTipService.ToolTip="Bulk-import products from a CSV or Excel file" />
            <Button Grid.Column="9" Content="Add Product" Style="{StaticResource AccentButtonStyle}"
                    Click="OnAddProductClick" IsEnabled="{x:Bind ViewModel.CanEditProducts}" Margin="8,0,0,0" />
        </Grid>

        <!-- Results -->
        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12,10" ColumnSpacing="16"
                          Background="{ThemeResource SurfaceAltBrush}"
                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="220" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="90" />
                            <!-- Fixed, not Auto: rows differ in button count (only batch-tracked
                                 products get a "Batches" button), and an Auto column would size to
                                 each row's own buttons, stealing different amounts of width from the
                                 star-sized PRODUCT column and shifting every middle column out of
                                 line row-to-row. A fixed width keeps all rows on the same grid. -->
                            <ColumnDefinition Width="440" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PRODUCT" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="CATEGORY / BRAND / UNIT" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="PRICING" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="STOCK" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="ACTIONS" Style="{StaticResource ColumnHeaderTextStyle}" />
                    </Grid>

                    <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                             Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                             Margin="12,8,12,0" VerticalAlignment="Top" />

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Products}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProductRowViewModel">
                                <Grid Padding="12,10" ColumnSpacing="16" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                    <!-- Must stay byte-for-byte identical to the header row's columns
                                         above, or the headers stop lining up with their data. -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="220" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="440" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <!-- Ellipsis rather than a hard clip: the code/SKU/barcode line
                                             can outrun the column on long names, and a trailing "…" reads
                                             as "there's more" instead of looking like a truncated value. -->
                                        <TextBlock Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis">
                                            <Run Text="{x:Bind ProductCode}" />
                                            <Run Text=" · SKU: " /><Run Text="{x:Bind Sku}" />
                                            <Run Text=" · Barcode: " /><Run Text="{x:Bind Barcode}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Category and Brand are optional, so their TextBlocks are collapsed
                                         when empty rather than left as blank lines — otherwise a product
                                         with no category/brand pushed its Unit to the bottom of the cell
                                         and the column read as ragged and misaligned across rows. -->
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind CategoryName}" FontSize="12"
                                                   Visibility="{x:Bind CategoryName, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <TextBlock Text="{x:Bind BrandName}" FontSize="12" Opacity="0.7"
                                                   Visibility="{x:Bind BrandName, Converter={StaticResource StringToVisibilityConverter}}" />
                                        <Border Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource SurfaceAltBrush}"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind Unit}" Style="{StaticResource BadgeTextStyle}"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock FontSize="12"><Run Text="MRP " /><Run Text="{x:Bind Mrp, Converter={StaticResource CurrencyConverter}}" /></TextBlock>
                                        <TextBlock FontWeight="SemiBold"><Run Text="Sell " /><Run Text="{x:Bind SellingPrice, Converter={StaticResource CurrencyConverter}}" /></TextBlock>
                                        <TextBlock FontSize="12" Opacity="0.7"
                                                   Visibility="{x:Bind ShowPurchasePrice, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Run Text="Cost " /><Run Text="{x:Bind PurchasePrice, Converter={StaticResource CurrencyConverter}}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Stock}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <Border Background="{x:Bind StockStatus, Converter={StaticResource StockStatusToBrushConverter}}"
                                                Visibility="{x:Bind StockStatus, Converter={StaticResource StringToVisibilityConverter}}"
                                                CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="{x:Bind StockStatus}" FontSize="10" Foreground="White" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Button Content="Edit" Click="OnEditClick" Tag="{x:Bind}" />
                                        <Button Content="Stock" Click="OnAdjustStockClick" Tag="{x:Bind}" />
                                        <Button Content="Labels" Click="OnLabelsClick" Tag="{x:Bind}" />
                                        <Button Content="Batches" Click="OnBatchesClick" Tag="{x:Bind}"
                                                Visibility="{x:Bind TracksBatches, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Button Content="Deactivate" Click="OnToggleActiveClick" Tag="{x:Bind}"
                                                Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Button Content="Reactivate" Click="OnToggleActiveClick" Tag="{x:Bind}"
                                                Visibility="{x:Bind IsActive, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
