<Page
    x:Class="Kirana.App.Views.ProductsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <StackPanel Spacing="2">
                <TextBlock Text="Products" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Catalogue, pricing, stock levels and batches." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <!-- Filters: their own row, evenly spaced. Kept separate from the actions row below —
             sharing one row split by a flexible spacer repeatedly overflowed at this page's working
             window width as more controls were added (Sort, result count), with trailing buttons
             going completely unrendered and unreachable. Same class of bug fixed earlier on the
             Purchases page; giving each group its own row sidesteps it for good regardless of how
             much either group grows. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="20,12,20,0">
            <TextBox Width="260" PlaceholderText="Search name / SKU / barcode…"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnSearchBoxKeyDown"
                     TextChanged="OnSearchTextChanged" />

            <CheckBox Content="Show inactive" VerticalAlignment="Center" Margin="4,0,0,0"
                      IsChecked="{x:Bind ViewModel.ShowInactive, Mode=TwoWay}" Checked="OnShowInactiveChanged" Unchecked="OnShowInactiveChanged" />

            <CheckBox Content="Out of stock" VerticalAlignment="Center"
                      IsChecked="{x:Bind ViewModel.OutOfStockOnly, Mode=TwoWay}" Checked="OnOutOfStockOnlyChanged" Unchecked="OnOutOfStockOnlyChanged" />

            <CheckBox Content="Expired" VerticalAlignment="Center"
                      IsChecked="{x:Bind ViewModel.ExpiredOnly, Mode=TwoWay}" Checked="OnExpiredOnlyChanged" Unchecked="OnExpiredOnlyChanged" />

            <ComboBox Width="200" ItemsSource="{x:Bind ViewModel.SortOptions}"
                      SelectedItem="{x:Bind ViewModel.SelectedSortOption, Mode=TwoWay}"
                      SelectionChanged="OnSortOptionChanged"
                      VerticalAlignment="Center" AutomationProperties.Name="Sort products" />

            <TextBlock Text="{x:Bind ViewModel.TotalProductsText, Mode=OneWay}"
                       Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>

        <!-- Actions: their own row, right-aligned, always fully visible regardless of window width
             or how much space the filters row above is using. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Padding="20,12,20,0">
            <Button Content="Categories" Click="OnManageCategoriesClick" />
            <Button Content="Brands" Click="OnManageBrandsClick" />
            <Button Content="Bulk Labels" Click="OnBulkLabelsClick"
                    IsEnabled="{x:Bind ViewModel.CanManageInventory}" />
            <Button Content="Import" Click="OnImportProductsClick"
                    IsEnabled="{x:Bind ViewModel.CanEditProducts}"
                    ToolTipService.ToolTip="Bulk-import products from a CSV or Excel file" />
            <Button Content="Add Product" Style="{StaticResource AccentButtonStyle}"
                    Click="OnAddProductClick" IsEnabled="{x:Bind ViewModel.CanEditProducts}" />
        </StackPanel>

        <!-- Results -->
        <Grid Grid.Row="3" Margin="20,16,20,20">
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12,10" ColumnSpacing="16"
                          Background="{ThemeResource SurfaceAltBrush}"
                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="220" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="100" />
                            <!-- Fixed, not Auto: rows differ in button count (only batch-tracked
                                 products get a "Batches" button), and an Auto column would size to
                                 each row's own buttons, stealing different amounts of width from the
                                 star-sized PRODUCT column and shifting every middle column out of
                                 line row-to-row. A fixed width keeps all rows on the same grid. -->
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PRODUCT" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="CATEGORY / BRAND / UNIT" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="PRICING" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="STOCK" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="EXPIRY" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="ACTIONS" Style="{StaticResource ColumnHeaderTextStyle}" />
                    </Grid>

                    <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                             Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                             Margin="12,8,12,0" VerticalAlignment="Top" />

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Products}" SelectionMode="None" DoubleTapped="OnProductDoubleTapped">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProductRowViewModel">
                                <!-- Inactive products are dimmed as well as badged, so a discontinued
                                     row reads as "switched off" from across the grid rather than
                                     depending on spotting one small label. -->
                                <Grid Padding="12,6" ColumnSpacing="16" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"
                                      Opacity="{x:Bind RowOpacity}">
                                    <!-- Must stay byte-for-byte identical to the header row's columns
                                         above, or the headers stop lining up with their data. -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="220" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                        <!-- Name and badge share a line to keep the row height the
                                             compact single-line-per-field shape the grid uses. -->
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                            <Border Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource DangerSubtleBrush}"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind IsInactive, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="INACTIVE" Foreground="{ThemeResource DangerBrush}"
                                                           Style="{StaticResource BadgeTextStyle}" />
                                            </Border>
                                        </StackPanel>
                                        <!-- Ellipsis rather than a hard clip: the code/SKU/barcode line
                                             can outrun the column on long names, and a trailing "…" reads
                                             as "there's more" instead of looking like a truncated value. -->
                                        <TextBlock Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis">
                                            <Run Text="{x:Bind ProductCode}" />
                                            <Run Text=" · SKU: " /><Run Text="{x:Bind Sku}" />
                                            <Run Text=" · Barcode: " /><Run Text="{x:Bind BarcodeSummary}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Category and Brand share one line (rather than each stacking
                                         separately) specifically to keep the row's overall height down;
                                         Unit gets its own line since it's present on every product,
                                         unlike Category/Brand which are optional and collapse when empty. -->
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Border Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource PastelBlueBrush}" HorizontalAlignment="Left" Visibility="{x:Bind CategoryName, Converter={StaticResource StringToVisibilityConverter}}"><TextBlock Text="{x:Bind CategoryName}" Foreground="{ThemeResource PastelBlueOnBrush}" Style="{StaticResource BadgeTextStyle}" TextTrimming="CharacterEllipsis" MaxWidth="86" /></Border>
                                            <Border Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource PastelVioletBrush}" HorizontalAlignment="Left" Visibility="{x:Bind BrandName, Converter={StaticResource StringToVisibilityConverter}}"><TextBlock Text="{x:Bind BrandName}" Foreground="{ThemeResource PastelVioletOnBrush}" Style="{StaticResource BadgeTextStyle}" TextTrimming="CharacterEllipsis" MaxWidth="86" /></Border>
                                        </StackPanel>
                                        <Border Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource SurfaceAltBrush}"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{x:Bind Unit}" Style="{StaticResource BadgeTextStyle}"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"><Run Text="SELL  " /><Run Text="{x:Bind SellingPrice, Converter={StaticResource CurrencyConverter}}" /></TextBlock>
                                            <Border CornerRadius="10" Padding="7,2" VerticalAlignment="Center"
                                                    Background="{ThemeResource PastelGreenBrush}"
                                                    ToolTipService.ToolTip="GST treatment at billing">
                                                <TextBlock Text="{x:Bind PricingTypeLabel}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource PastelGreenOnBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"><Run Text="MRP  " /><Run Text="{x:Bind Mrp, Converter={StaticResource CurrencyConverter}}" /></TextBlock>
                                            <TextBlock FontSize="11" Opacity="0.7"
                                                       Visibility="{x:Bind ShowPurchasePrice, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Run Text="Cost " /><Run Text="{x:Bind PurchasePrice, Converter={StaticResource CurrencyConverter}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" HorizontalAlignment="Center"><Run Text="{x:Bind Stock}" /><Run Text=" " /><Run Text="{x:Bind Unit}" /></TextBlock>
                                        <Border Background="{x:Bind StockStatus, Converter={StaticResource StockStatusToBrushConverter}}"
                                                Visibility="{x:Bind StockStatus, Converter={StaticResource StringToVisibilityConverter}}"
                                                CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="{x:Bind StockStatus}" FontSize="10" Foreground="White" />
                                        </Border>
                                    </StackPanel>

                                    <!-- "—" for products that don't track batches, or that track
                                         batches but have none with both remaining stock and an
                                         expiry date set. Mirrors the STOCK column's own value+badge
                                         layout; the badge only appears once there's something
                                         actionable (already expired, or due within 30 days). -->
                                    <StackPanel Grid.Column="4" Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ExpiryDateText}" FontSize="12" HorizontalAlignment="Center"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <Border Background="{x:Bind ExpiryStatus, Converter={StaticResource ExpiryStatusToBrushConverter}}"
                                                Visibility="{x:Bind ExpiryStatus, Converter={StaticResource StringToVisibilityConverter}}"
                                                CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="{x:Bind ExpiryStatus}" FontSize="9" Foreground="White" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Button Content="Edit" Click="OnEditClick" Tag="{x:Bind}" Padding="12,5" />
                                        <Button Content="⋯" FontSize="18" Padding="10,3" AutomationProperties.Name="More product actions"><Button.Flyout><Flyout><StackPanel MinWidth="150" Spacing="2" Padding="4"><Button Content="Edit" Click="OnEditClick" Tag="{x:Bind}" HorizontalAlignment="Stretch" /><Button Content="Stock" Click="OnAdjustStockClick" Tag="{x:Bind}" HorizontalAlignment="Stretch" /><Button Content="Labels" Click="OnLabelsClick" Tag="{x:Bind}" HorizontalAlignment="Stretch" /><Button Content="Batches" Click="OnBatchesClick" Tag="{x:Bind}" HorizontalAlignment="Stretch" Visibility="{x:Bind TracksBatches, Converter={StaticResource BoolToVisibilityConverter}}" /><Button Content="Deactivate" Click="OnToggleActiveClick" Tag="{x:Bind}" HorizontalAlignment="Stretch" Visibility="{x:Bind IsActive, Converter={StaticResource BoolToVisibilityConverter}}" /><Button Content="Reactivate" Click="OnToggleActiveClick" Tag="{x:Bind}" HorizontalAlignment="Stretch" Visibility="{x:Bind IsActive, Converter={StaticResource InverseBoolToVisibilityConverter}}" /></StackPanel></Flyout></Button.Flyout></Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
