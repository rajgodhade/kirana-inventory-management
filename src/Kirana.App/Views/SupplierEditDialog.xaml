<ContentDialog
    x:Class="Kirana.App.Views.SupplierEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Title>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DialogTitleText" Grid.Column="0" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{StaticResource DialogCloseButtonStyle}"
                    Click="OnCloseIconClick" AutomationProperties.Name="Close dialog">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>
    </ContentDialog.Title>

    <ScrollViewer MaxHeight="480">
        <StackPanel Spacing="10" MinWidth="380">
            <TextBox Header="Business / Name" Text="{x:Bind ViewModel.Name, Mode=TwoWay}" />
            <TextBox Header="GSTIN" Text="{x:Bind ViewModel.Gstin, Mode=TwoWay}" />
            <TextBox Header="Contact Person" Text="{x:Bind ViewModel.ContactPerson, Mode=TwoWay}" />
            <TextBox Header="Phone" Text="{x:Bind ViewModel.Phone, Mode=TwoWay}" />
            <TextBox Header="Email" Text="{x:Bind ViewModel.Email, Mode=TwoWay}" />
            <TextBox Header="Address" Text="{x:Bind ViewModel.Address, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />

            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
