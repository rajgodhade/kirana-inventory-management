<Page x:Class="Kirana.App.Views.ReplenishmentPage" x:Name="RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:Kirana.App.ViewModels">
    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Padding="{StaticResource PageHeaderPadding}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Replenishment" Style="{StaticResource PageTitleTextStyle}"/><TextBlock Text="Current stock and open-order planning. Recommendations never order automatically." Style="{StaticResource PageSubtitleTextStyle}"/></StackPanel>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CalculatedAtText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Grid.Column="2" Content="Refresh" Click="OnRefreshClick"/>
        </Grid>

        <Grid Grid.Row="1" Margin="24,0,24,20" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{ThemeResource PastelBlueBrush}" CornerRadius="18" Padding="20"><StackPanel><TextBlock Text="NEEDS REORDER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind ViewModel.ProductsNeedingReorder, Mode=OneWay}" FontSize="30" FontWeight="Bold"/><TextBlock Text="products requiring review" Style="{StaticResource CaptionTextStyle}"/></StackPanel></Border>
            <Border Grid.Column="1" Background="{ThemeResource PastelAmberBrush}" CornerRadius="18" Padding="20"><StackPanel><TextBlock Text="SUGGESTED UNITS" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind ViewModel.TotalSuggestedUnits, Mode=OneWay}" FontSize="30" FontWeight="Bold"/><TextBlock Text="in product base units" Style="{StaticResource CaptionTextStyle}"/></StackPanel></Border>
            <Border Grid.Column="2" Background="{ThemeResource PastelGreenBrush}" CornerRadius="18" Padding="20"><StackPanel><TextBlock Text="ESTIMATED VALUE" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind ViewModel.EstimatedOrderValue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="30" FontWeight="Bold"/><TextBlock Text="completed purchase costs only" Style="{StaticResource CaptionTextStyle}"/></StackPanel></Border>
            <Border Grid.Column="3" Background="{ThemeResource PastelRoseBrush}" CornerRadius="18" Padding="20"><StackPanel><TextBlock Text="UNCONFIGURED LOW STOCK" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Text="{x:Bind ViewModel.UnconfiguredLowStockProducts, Mode=OneWay}" FontSize="30" FontWeight="Bold"/><TextBlock Text="excluded until configured" Style="{StaticResource CaptionTextStyle}"/></StackPanel></Border>
        </Grid>

        <Border Grid.Row="2" Margin="24,0,24,20" Style="{StaticResource ElevatedCardStyle}" Padding="14">
            <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search product / code…"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ItemsSource="{x:Bind ViewModel.SearchSuggestions}" TextChanged="OnSearchTextChanged"
                                SuggestionChosen="OnSuggestionChosen" QuerySubmitted="OnSearchQuerySubmitted" GotFocus="OnSearchGotFocus"
                                AutomationProperties.Name="Search replenishment products">
                    <AutoSuggestBox.ItemTemplate><DataTemplate x:DataType="vm:SearchSuggestionItem"><StackPanel Padding="4,2"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextStyle}"/></StackPanel></DataTemplate></AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <ComboBox Grid.Column="1" PlaceholderText="All suppliers" ItemsSource="{x:Bind ViewModel.Suppliers}" SelectedItem="{x:Bind ViewModel.SelectedSupplier, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="OnFilterChanged"/>
                <ComboBox Grid.Column="2" ItemsSource="{x:Bind ViewModel.StatusOptions}" SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}" HorizontalAlignment="Stretch" SelectionChanged="OnFilterChanged"/>
                <ComboBox Grid.Column="3" ItemsSource="{x:Bind ViewModel.ConfigurationOptions}" SelectedItem="{x:Bind ViewModel.SelectedConfiguration, Mode=TwoWay}" HorizontalAlignment="Stretch" SelectionChanged="OnFilterChanged"/>
                <Button Grid.Column="4" Content="Clear" Click="OnClearClick"/>
                <Button Grid.Column="5" Content="Export CSV" Click="OnExportClick"/>
                <Button Grid.Column="6" Content="Create Purchase Order" Style="{StaticResource AccentButtonStyle}" Click="OnCreateSelectedClick" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="24,0,24,20" Style="{StaticResource ElevatedCardStyle}" Padding="0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <!-- Keep this grid exactly in step with the item grid below: the shared spacing and fixed action column prevent header/value drift. -->
                <Grid Padding="14,12" Background="{ThemeResource SurfaceAltBrush}" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="95"/><ColumnDefinition Width="95"/><ColumnDefinition Width="95"/><ColumnDefinition Width="105"/><ColumnDefinition Width="90"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="115"/><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="PRODUCT" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="2" Text="CURRENT" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/><TextBlock Grid.Column="3" Text="REORDER" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/><TextBlock Grid.Column="4" Text="TARGET" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/><TextBlock Grid.Column="5" Text="OPEN PO" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/><TextBlock Grid.Column="6" Text="SUGGESTED" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/><TextBlock Grid.Column="7" Text="SUPPLIER" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="8" Text="EST. COST" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right"/><TextBlock Grid.Column="9" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}"/><TextBlock Grid.Column="10" Text="ACTIONS" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"><FontIcon Glyph="&#xE7BF;" FontSize="38" Opacity="0.5"/><TextBlock Text="No replenishment recommendations found." FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="Change filters or configure replenishment in Product Edit." Style="{StaticResource CaptionTextStyle}"/></StackPanel>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None" Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="IsTabStop" Value="False"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate x:DataType="vm:ReplenishmentRowViewModel">
                    <Grid Padding="14,11" ColumnSpacing="8" BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="95"/><ColumnDefinition Width="95"/><ColumnDefinition Width="95"/><ColumnDefinition Width="105"/><ColumnDefinition Width="90"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="115"/><ColumnDefinition Width="130"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Checked="OnRowSelectionChanged" Unchecked="OnRowSelectionChanged" AutomationProperties.Name="Select recommendation"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="{x:Bind ProductName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind ProductCode}" Style="{StaticResource CodeTextStyle}"/></StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind Recommendation.CurrentStock}" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{x:Bind Recommendation.ReorderLevel}" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{x:Bind Recommendation.TargetStock}" HorizontalAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{x:Bind Recommendation.OpenPurchaseOrderQuantity}" HorizontalAlignment="Right" VerticalAlignment="Center"/><StackPanel Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{x:Bind Recommendation.SuggestedQuantity}" FontWeight="Bold"/><TextBlock Text="{x:Bind Unit}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right"/></StackPanel>
                        <TextBlock Grid.Column="7" Text="{x:Bind Supplier}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><StackPanel Grid.Column="8" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{x:Bind EstimatedCost}"/><TextBlock Text="{x:Bind EstimatedValue}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right"/></StackPanel>
                        <Border Grid.Column="9" Background="{ThemeResource PastelAmberBrush}" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{x:Bind Status}" FontSize="12" FontWeight="SemiBold"/></Border>
                        <Button Grid.Column="10" Content="Create PO" Tag="{x:Bind}" Click="OnCreateRowClick" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Grid>
                </DataTemplate></ListView.ItemTemplate></ListView>
                <InfoBar Grid.Row="1" Margin="16" VerticalAlignment="Bottom" IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
