<Page
    x:Class="Kirana.App.Views.PurchasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}">
            <StackPanel Spacing="2">
                <TextBlock Text="Purchases" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Goods received from suppliers, with GST and batch detail." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Padding="20,12" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" PlaceholderText="Search purchase # / supplier invoice # / supplier name…"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" KeyDown="OnSearchBoxKeyDown"
                     TextChanged="OnSearchTextChanged" />

            <CheckBox Grid.Column="1" Content="Outstanding only" VerticalAlignment="Center" Margin="8,0,0,0"
                      IsChecked="{x:Bind ViewModel.OutstandingOnly, Mode=TwoWay}" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />

            <Button Grid.Column="3" Content="New Purchase" Style="{StaticResource AccentButtonStyle}"
                    Click="OnNewPurchaseClick" IsEnabled="{x:Bind ViewModel.CanManagePurchases}" />
        </Grid>

        <!-- Results -->
        <Grid Grid.Row="2">
            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Margin="20,0,20,8" VerticalAlignment="Top" />

            <ListView ItemsSource="{x:Bind ViewModel.Purchases}" Padding="20,0,20,20" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PurchaseRowViewModel">
                        <Grid Padding="12" ColumnSpacing="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="180" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind PurchaseNumber}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind SupplierName}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind DateText}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" FontWeight="SemiBold" VerticalAlignment="Center">
                                <Run Text="{x:Bind GrandTotal, Converter={StaticResource CurrencyConverter}}" />
                            </TextBlock>
                            <TextBlock Grid.Column="4" VerticalAlignment="Center">
                                <Run Text="{x:Bind OutstandingAmount, Converter={StaticResource CurrencyConverter}}" />
                            </TextBlock>

                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content="Details" Click="OnDetailsClick" Tag="{x:Bind}" />
                                <Button Content="Pay" Click="OnPayClick" Tag="{x:Bind}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
