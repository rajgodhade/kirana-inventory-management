<Page
    x:Class="Kirana.App.Views.ExpensesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Expenses" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="What the shop spends. Expenses never affect stock."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16,10"
                    Background="{ThemeResource WarningSubtleBrush}" BorderThickness="0" VerticalAlignment="Center">
                <StackPanel Spacing="1">
                    <TextBlock Text="Total for this filter" Style="{StaticResource MetricLabelTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.TotalDisplay, Mode=OneWay}"
                               Style="{StaticResource MetricTextStyle}" FontSize="22"
                               Foreground="{ThemeResource WarningBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.CountDisplay, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="OnAddClick"
                    VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.CanManageExpenses}"
                    AutomationProperties.Name="Add Expense">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add Expense" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Padding="{StaticResource ToolbarPadding}" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" PlaceholderText="Search voucher / category / description…"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnSearchKeyDown"
                     TextChanged="OnSearchTextChanged" />
            <Button Grid.Column="1" Click="OnSearchClick" AutomationProperties.Name="Search expenses">
                <FontIcon Glyph="&#xE721;" FontSize="14" />
            </Button>

            <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.CategoryNames}"
                      SelectedItem="{x:Bind ViewModel.SelectedCategoryName, Mode=TwoWay}"
                      SelectionChanged="OnCategoryFilterChanged" />

            <Button Grid.Column="4" Content="Manage Categories" Click="OnCategoriesClick" />
        </Grid>

        <Grid Grid.Row="2" Margin="24,0,24,24">
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="14,10" ColumnSpacing="16"
                          Background="{ThemeResource SurfaceAltBrush}"
                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" MinWidth="160" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="VOUCHER" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="DATE" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="CATEGORY" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="3" Text="DESCRIPTION" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="4" Text="MODE" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="5" Text="AMOUNT" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Expenses}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExpenseRowViewModel">
                                <Grid Padding="14,12" ColumnSpacing="16"
                                      BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" MinWidth="160" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" MinWidth="160" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind ExpenseNumber}" Style="{StaticResource CardTitleTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind DateText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind CategoryName}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Description}" Style="{StaticResource SecondaryTextStyle}"
                                               VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind PaymentMethod}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind AmountText}" Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button Content="Details" Click="OnDetailsClick" Tag="{x:Bind}" />
                                        <Button Content="Edit" Click="OnEditClick" Tag="{x:Bind}" />
                                        <Button Padding="9,5" AutomationProperties.Name="More actions">
                                            <FontIcon Glyph="&#xE712;" FontSize="13" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Delete" Click="OnDeleteClick" Tag="{x:Bind}" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" VerticalAlignment="Top" />
        </Grid>
    </Grid>
</Page>
