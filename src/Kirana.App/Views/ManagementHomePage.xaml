<Page
    x:Class="Kirana.App.Views.ManagementHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <ScrollViewer Background="{ThemeResource PageBackgroundBrush}">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20">

            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Here's how the store is doing." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <!-- KPI cards. Each is permission-scoped; a user who can't see the figure doesn't
                 get an empty card, they get no card. -->
            <ItemsControl>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <Border Style="{StaticResource CardBorderStyle}" Width="220">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BF;" FontSize="14" Foreground="{ThemeResource BrandPrimaryBrush}" />
                            <TextBlock Text="Today's Sales" Style="{StaticResource MetricLabelTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.TodaySalesText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.TodaySalesCountText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Width="220"
                        Visibility="{x:Bind ViewModel.CanSeeInventory, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource WarningBrush}" />
                            <TextBlock Text="Low Stock Items" Style="{StaticResource MetricLabelTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.LowStockCountText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" />
                        <TextBlock Text="at or below minimum" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Width="220"
                        Visibility="{x:Bind ViewModel.CanSeeCustomerFinancials, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="14" Foreground="{ThemeResource DangerBrush}" />
                            <TextBlock Text="Outstanding Udhaar" Style="{StaticResource MetricLabelTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.OutstandingUdhaarText, Mode=OneWay}"
                                   Style="{StaticResource MetricTextStyle}" Foreground="{ThemeResource DangerBrush}" />
                        <TextBlock Text="owed by customers" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Width="220"
                        Visibility="{x:Bind ViewModel.CanSeePurchaseFinancials, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7B8;" FontSize="14" Foreground="{ThemeResource WarningBrush}" />
                            <TextBlock Text="Payable to Suppliers" Style="{StaticResource MetricLabelTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.SupplierDueText, Mode=OneWay}" Style="{StaticResource MetricTextStyle}" />
                        <TextBlock Text="outstanding balance" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>
            </ItemsControl>

            <!-- Quick actions: things that are dialogs rather than destinations, so they have
                 no place in the nav pane. -->
            <StackPanel Spacing="10">
                <TextBlock Text="Quick actions" Style="{StaticResource SectionTitleTextStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <!-- Icon + TextBlock content leaves these buttons with no accessible name, so
                         set one explicitly — same as the icon buttons elsewhere in the app. -->
                    <Button Click="OnReprintInvoiceClick" AutomationProperties.Name="Reprint Invoice">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE749;" FontSize="14" />
                            <TextBlock Text="Reprint Invoice" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnBackToBillingClick" AutomationProperties.Name="Back to Billing">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BF;" FontSize="14" />
                            <TextBlock Text="Back to Billing" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Recent invoices" Style="{StaticResource SectionTitleTextStyle}" />
                <Border Style="{StaticResource CardBorderStyle}" Padding="4">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentActivityRowViewModel">
                                <Grid Padding="12,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="1">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource CardTitleTextStyle}" />
                                        <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Amount}" Style="{StaticResource AmountTextStyle}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
