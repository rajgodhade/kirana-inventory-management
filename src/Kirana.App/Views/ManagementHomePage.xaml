<Page
    x:Class="Kirana.App.Views.ManagementHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    xmlns:rpt="using:Kirana.Application.Reports"
    xmlns:controls="using:Kirana.App.Views.Controls">

    <Page.Resources>
        <Style x:Key="DashboardTileButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="MinHeight" Value="126" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="142" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="DashboardPanelStyle" TargetType="Border" BasedOn="{StaticResource ElevatedCardStyle}">
            <Setter Property="Padding" Value="20" />
        </Style>
    </Page.Resources>

    <ScrollViewer Background="{ThemeResource PageBackgroundBrush}">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="22" MaxWidth="1600" HorizontalAlignment="Stretch">
            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Warning" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <!-- Greeting and operational context -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.TodayDateText, Mode=OneWay}" Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="{ThemeResource PastelGreenBrush}" CornerRadius="14" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource PastelGreenOnBrush}" />
                            <TextBlock Text="Billing active" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource PastelGreenOnBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource CardElevatedBorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="10,6"
                            Visibility="{x:Bind ViewModel.CanManageBackups, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind ViewModel.LastBackupText, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Border>
                    <Border Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource CardElevatedBorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="10,6">
                        <TextBlock Text="{x:Bind ViewModel.UserText, Mode=OneWay}" FontSize="12"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Commercial KPI cards -->
            <StackPanel Spacing="10">
                <Grid>
                    <TextBlock Text="Today at a glance" Style="{StaticResource SectionTitleTextStyle}" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="18" Height="18"
                                  HorizontalAlignment="Right" AutomationProperties.Name="Loading dashboard" />
                </Grid>
                <Grid x:Name="KpiGrid" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="KpiColumn1" Width="*" />
                        <ColumnDefinition x:Name="KpiColumn2" Width="*" />
                        <ColumnDefinition x:Name="KpiColumn3" Width="*" />
                        <ColumnDefinition x:Name="KpiColumn4" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button x:Name="SalesCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource DashboardTileButtonStyle}"
                            Background="{ThemeResource PastelGreenBrush}" BorderBrush="{ThemeResource PastelGreenBrush}"
                            Tag="Reports" Click="OnDashboardDestinationClick" AutomationProperties.Name="Open today's sales report">
                        <Grid><StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7BF;" FontSize="15" Foreground="{ThemeResource PastelGreenOnBrush}" /><TextBlock Text="TODAY'S SALES" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}" /></StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.TodaySalesText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.TodaySalesCountText, Mode=OneWay}" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelGreenOnBrush}" />
                        </StackPanel><FontIcon Glyph="&#xE76C;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource PastelGreenOnBrush}" /></Grid>
                    </Button>

                    <Button x:Name="ProfitCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource DashboardTileButtonStyle}"
                            Background="{ThemeResource PastelTealBrush}" BorderBrush="{ThemeResource PastelTealBrush}"
                            Tag="Reports" Click="OnDashboardDestinationClick" AutomationProperties.Name="Open profit report"
                            Visibility="{x:Bind ViewModel.CanSeeProfit, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid><StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="{ThemeResource PastelTealOnBrush}" /><TextBlock Text="EST. GROSS PROFIT" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelTealOnBrush}" /></StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.GrossProfitText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelTealOnBrush}" />
                            <TextBlock Text="based on recorded costs" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelTealOnBrush}" />
                        </StackPanel><FontIcon Glyph="&#xE76C;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource PastelTealOnBrush}" /></Grid>
                    </Button>

                    <Button x:Name="BillsCard" Grid.Row="0" Grid.Column="2" Style="{StaticResource DashboardTileButtonStyle}"
                            Background="{ThemeResource PastelBlueBrush}" BorderBrush="{ThemeResource PastelBlueBrush}"
                            Tag="Reports" Click="OnDashboardDestinationClick" AutomationProperties.Name="Open bills report">
                        <Grid><StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8C7;" FontSize="15" Foreground="{ThemeResource PastelBlueOnBrush}" /><TextBlock Text="BILLS" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}" /></StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.BillCountText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}" />
                            <TextBlock Text="invoices completed today" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelBlueOnBrush}" />
                        </StackPanel><FontIcon Glyph="&#xE76C;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource PastelBlueOnBrush}" /></Grid>
                    </Button>

                    <Button x:Name="ItemsCard" Grid.Row="0" Grid.Column="3" Style="{StaticResource DashboardTileButtonStyle}"
                            Background="{ThemeResource PastelVioletBrush}" BorderBrush="{ThemeResource PastelVioletBrush}"
                            Tag="Reports" Click="OnDashboardDestinationClick" AutomationProperties.Name="Open items sold report">
                        <Grid><StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE719;" FontSize="15" Foreground="{ThemeResource PastelVioletOnBrush}" /><TextBlock Text="ITEMS SOLD" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" /></StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.ItemsSoldText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" />
                            <TextBlock Text="units sold today" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelVioletOnBrush}" />
                        </StackPanel><FontIcon Glyph="&#xE76C;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource PastelVioletOnBrush}" /></Grid>
                    </Button>

                    <Button x:Name="CreditCard" Grid.Row="1" Grid.Column="0" Style="{StaticResource DashboardTileButtonStyle}"
                            Background="{ThemeResource PastelRoseBrush}" BorderBrush="{ThemeResource PastelRoseBrush}"
                            Tag="Customers" Click="OnDashboardDestinationClick" AutomationProperties.Name="Open customer credit"
                            Visibility="{x:Bind ViewModel.CanSeeCustomerFinancials, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid><StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="{ThemeResource PastelRoseOnBrush}" /><TextBlock Text="CUSTOMER CREDIT" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" /></StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.OutstandingUdhaarText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" />
                            <TextBlock Text="outstanding udhaar" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" />
                        </StackPanel><FontIcon Glyph="&#xE76C;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource PastelRoseOnBrush}" /></Grid>
                    </Button>

                    <Button x:Name="PayableCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardTileButtonStyle}"
                            Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}"
                            Tag="Purchases" Click="OnDashboardDestinationClick" AutomationProperties.Name="Open supplier payables"
                            Visibility="{x:Bind ViewModel.CanSeePurchaseFinancials, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid><StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7B8;" FontSize="15" Foreground="{ThemeResource PastelAmberOnBrush}" /><TextBlock Text="SUPPLIER PAYABLE" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" /></StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SupplierDueText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" />
                            <TextBlock Text="outstanding balance" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" />
                        </StackPanel><FontIcon Glyph="&#xE76C;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource PastelAmberOnBrush}" /></Grid>
                    </Button>

                    <Button x:Name="LowStockCard" Grid.Row="1" Grid.Column="2" Style="{StaticResource DashboardTileButtonStyle}"
                            Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource PastelAmberBrush}"
                            Tag="Products" Click="OnDashboardDestinationClick" AutomationProperties.Name="Open low stock products"
                            Visibility="{x:Bind ViewModel.CanSeeInventory, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid><StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="{ThemeResource PastelAmberOnBrush}" /><TextBlock Text="LOW STOCK" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" /></StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.LowStockCountText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" />
                            <TextBlock Text="at or below minimum" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelAmberOnBrush}" />
                        </StackPanel><FontIcon Glyph="&#xE76C;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource PastelAmberOnBrush}" /></Grid>
                    </Button>

                    <Button x:Name="OutStockCard" Grid.Row="1" Grid.Column="3" Style="{StaticResource DashboardTileButtonStyle}"
                            Background="{ThemeResource PastelRoseBrush}" BorderBrush="{ThemeResource PastelRoseBrush}"
                            Tag="Products" Click="OnDashboardDestinationClick" AutomationProperties.Name="Open out of stock products"
                            Visibility="{x:Bind ViewModel.CanSeeInventory, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid><StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEA39;" FontSize="15" Foreground="{ThemeResource PastelRoseOnBrush}" /><TextBlock Text="OUT OF STOCK" Style="{StaticResource KpiLabelTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" /></StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.OutOfStockCountText, Mode=OneWay}" Style="{StaticResource KpiValueTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" />
                            <TextBlock Text="needs replenishment" Style="{StaticResource KpiCaptionTextStyle}" Foreground="{ThemeResource PastelRoseOnBrush}" />
                        </StackPanel><FontIcon Glyph="&#xE76C;" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{ThemeResource PastelRoseOnBrush}" /></Grid>
                    </Button>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="CompactKpis">
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="KpiColumn3.Width" Value="0" /><Setter Target="KpiColumn4.Width" Value="0" />
                                    <Setter Target="BillsCard.(Grid.Row)" Value="1" /><Setter Target="BillsCard.(Grid.Column)" Value="0" />
                                    <Setter Target="ItemsCard.(Grid.Row)" Value="1" /><Setter Target="ItemsCard.(Grid.Column)" Value="1" />
                                    <Setter Target="CreditCard.(Grid.Row)" Value="2" /><Setter Target="CreditCard.(Grid.Column)" Value="0" />
                                    <Setter Target="PayableCard.(Grid.Row)" Value="2" /><Setter Target="PayableCard.(Grid.Column)" Value="1" />
                                    <Setter Target="LowStockCard.(Grid.Row)" Value="3" /><Setter Target="LowStockCard.(Grid.Column)" Value="0" />
                                    <Setter Target="OutStockCard.(Grid.Row)" Value="3" /><Setter Target="OutStockCard.(Grid.Column)" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="WideKpis">
                                <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1250" /></VisualState.StateTriggers>
                                <VisualState.Setters><Setter Target="KpiColumn3.Width" Value="*" /><Setter Target="KpiColumn4.Width" Value="*" /></VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                </Grid>
            </StackPanel>

            <Border Style="{StaticResource DashboardPanelStyle}" Visibility="{x:Bind ViewModel.CanSeePromotions, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12" Background="{ThemeResource PastelVioletBrush}"><FontIcon Glyph="&#xE8EC;" FontSize="17" Foreground="{ThemeResource PastelVioletOnBrush}" /></Border>
                    <StackPanel Grid.Column="1"><TextBlock Text="RUNNING PROMOTIONS" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock Text="{x:Bind ViewModel.RunningPromotionsText, Mode=OneWay}" FontSize="22" FontWeight="Bold" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="ENDS TODAY" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock Text="{x:Bind ViewModel.PromotionsEndingTodayText, Mode=OneWay}" FontSize="22" FontWeight="Bold" /></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="TOP PROMOTION TODAY" Style="{StaticResource KpiLabelTextStyle}" /><TextBlock Text="{x:Bind ViewModel.TopPromotionText, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <Button Grid.Column="4" Content="Manage offers" Tag="Promotions" Click="OnDashboardDestinationClick" />
                </Grid>
            </Border>

            <!-- Active alerts only -->
            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasAlerts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Business alerts" Style="{StaticResource SectionTitleTextStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.BusinessAlerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DashboardAlertViewModel">
                            <Border Background="{ThemeResource PastelAmberBrush}" BorderBrush="{ThemeResource WarningBrush}"
                                    BorderThickness="3,0,0,0" CornerRadius="10" Padding="14,11" Margin="0,0,0,8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource PastelAmberOnBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" /><TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" /></StackPanel>
                                    <Button Grid.Column="2" Content="{x:Bind Action}" Tag="{x:Bind Destination}" Click="OnDashboardDestinationClick" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Primary workflows -->
            <StackPanel Spacing="10">
                <TextBlock Text="Quick actions" Style="{StaticResource SectionTitleTextStyle}" />
                <ItemsControl>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="154" ItemHeight="52" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnBackToBillingClick" AutomationProperties.Name="Create a new bill"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE710;" FontSize="15" /><TextBlock Text="New Bill" /></StackPanel></Button>
                    <Button Style="{StaticResource QuickActionButtonStyle}" Tag="PurchaseEntry" Click="OnDashboardDestinationClick" AutomationProperties.Name="Create purchase" Visibility="{x:Bind ViewModel.CanSeePurchaseFinancials, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE7B8;" FontSize="15" /><TextBlock Text="New Purchase" /></StackPanel></Button>
                    <Button Style="{StaticResource QuickActionButtonStyle}" Tag="Customers" Click="OnDashboardDestinationClick" AutomationProperties.Name="Open customers" Visibility="{x:Bind ViewModel.CanSeeCustomerFinancials, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE716;" FontSize="15" /><TextBlock Text="Add Customer" /></StackPanel></Button>
                    <Button Style="{StaticResource QuickActionButtonStyle}" Tag="Expenses" Click="OnDashboardDestinationClick" AutomationProperties.Name="Add expense" Visibility="{x:Bind ViewModel.CanManageExpenses, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE8C7;" FontSize="15" /><TextBlock Text="Add Expense" /></StackPanel></Button>
                    <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnReprintInvoiceClick" AutomationProperties.Name="Reprint invoice"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE749;" FontSize="15" /><TextBlock Text="Reprint Invoice" /></StackPanel></Button>
                    <Button Style="{StaticResource QuickActionButtonStyle}" Tag="Reports" Click="OnDashboardDestinationClick" AutomationProperties.Name="Open reports" Visibility="{x:Bind ViewModel.CanSeeReports, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE9D2;" FontSize="15" /><TextBlock Text="View Reports" /></StackPanel></Button>
                    <Button Style="{StaticResource QuickActionButtonStyle}" Tag="Backup" Click="OnDashboardDestinationClick" AutomationProperties.Name="Open backup manager" Visibility="{x:Bind ViewModel.CanManageBackups, Converter={StaticResource BoolToVisibilityConverter}}"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE753;" FontSize="15" /><TextBlock Text="Backup" /></StackPanel></Button>
                </ItemsControl>
            </StackPanel>

            <!-- Today summary and decision support -->
            <Grid ColumnSpacing="14" Visibility="{x:Bind ViewModel.CanSeeReports, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource DashboardPanelStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Today summary" Style="{StaticResource SectionTitleTextStyle}" />
                        <Grid RowSpacing="12" ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="Gross sales" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{x:Bind ViewModel.GrossSalesText, Mode=OneWay}" Style="{StaticResource AmountTextStyle}" FontSize="20" /></StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1"><TextBlock Text="Discounts" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{x:Bind ViewModel.DiscountsText, Mode=OneWay}" Style="{StaticResource AmountTextStyle}" FontSize="20" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="Returns" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{x:Bind ViewModel.ReturnsText, Mode=OneWay}" Style="{StaticResource AmountTextStyle}" FontSize="20" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Net sales" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="{x:Bind ViewModel.NetSalesText, Mode=OneWay}" Style="{StaticResource AmountTextStyle}" FontSize="20" Foreground="{ThemeResource BrandPrimaryBrush}" /></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource DashboardPanelStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Insights" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="Insights appear as trading activity builds." Style="{StaticResource CaptionTextStyle}" Visibility="{x:Bind ViewModel.HasInsights, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Insights}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DashboardInsightViewModel"><Grid ColumnSpacing="10" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="9" Background="{ThemeResource BrandSubtleBrush}"><FontIcon Glyph="{x:Bind Glyph}" FontSize="13" Foreground="{ThemeResource BrandOnSubtleBrush}" /></Border><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" /><TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" /></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Lightweight charts and best sellers, loaded after core KPIs -->
            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.CanSeeReports, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Performance" Style="{StaticResource SectionTitleTextStyle}" />
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource DashboardPanelStyle}">
                        <StackPanel Spacing="14"><TextBlock Text="Sales trend" Style="{StaticResource CardTitleTextStyle}" /><TextBlock Text="Recent daily sales" Style="{StaticResource CaptionTextStyle}" /><ItemsControl ItemsSource="{x:Bind ViewModel.SalesTrend}" ItemTemplate="{StaticResource ChartBarItemTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource DashboardPanelStyle}">
                        <StackPanel Spacing="14"><TextBlock Text="Top-selling products" Style="{StaticResource CardTitleTextStyle}" /><TextBlock Text="No products sold today." Style="{StaticResource CaptionTextStyle}" Visibility="{x:Bind ViewModel.HasTopProducts, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" /><ItemsControl ItemsSource="{x:Bind ViewModel.TopSellingProducts}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="rpt:ProductSalesRow"><Grid ColumnSpacing="10" Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind ProductName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind ProductCode}" Style="{StaticResource CodeTextStyle}" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{x:Bind Revenue, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource AmountTextStyle}" /><TextBlock Text="{x:Bind QuantitySold, Converter={StaticResource QuantityConverter}}" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" /></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource DashboardPanelStyle}">
                        <StackPanel Spacing="14"><TextBlock Text="Payment mix" Style="{StaticResource CardTitleTextStyle}" /><TextBlock Text="Today's tender distribution" Style="{StaticResource CaptionTextStyle}" /><ItemsControl ItemsSource="{x:Bind ViewModel.PaymentMix}" ItemTemplate="{StaticResource ChartBarItemTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Recent invoices -->
            <StackPanel Spacing="10">
                <Grid><TextBlock Text="Recent invoices" Style="{StaticResource SectionTitleTextStyle}" /><Button Content="View all invoices" Tag="Invoices" Click="OnDashboardDestinationClick" HorizontalAlignment="Right" /></Grid>
                <Border Style="{StaticResource DashboardPanelStyle}" Padding="0">
                    <StackPanel>
                        <Grid Padding="16,11" Background="{ThemeResource SurfaceAltBrush}" ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="INVOICE" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="1" Text="CUSTOMER / TIME" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="2" Text="PAYMENT" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource ColumnHeaderTextStyle}" /><TextBlock Grid.Column="4" Text="AMOUNT" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="No invoices have been created yet." Padding="16,22" Style="{StaticResource CaptionTextStyle}" Visibility="{x:Bind ViewModel.HasRecentActivity, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RecentActivity}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RecentActivityRowViewModel"><Border BorderBrush="{ThemeResource CardElevatedBorderBrush}" BorderThickness="0,0,0,1"><Grid Padding="16,12" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{x:Bind Title}" FontWeight="SemiBold" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Customer}" /><TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextStyle}" /></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind PaymentMethod}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" /><Border Grid.Column="3" Background="{ThemeResource PastelGreenBrush}" CornerRadius="12" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{x:Bind Status}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource PastelGreenOnBrush}" /></Border><TextBlock Grid.Column="4" Text="{x:Bind Amount}" Style="{StaticResource AmountTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Operational devices use the same reusable monitor as POS and Hardware Settings. -->
            <StackPanel Spacing="10">
                <TextBlock Text="Store systems" Style="{StaticResource SectionTitleTextStyle}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <controls:DeviceStatusWidget Grid.Column="0" Title="Receipt printer" Glyph="&#xE749;" Detail="{x:Bind ViewModel.DefaultPrinterText, Mode=OneWay}" Status="{x:Bind ViewModel.PrinterHardwareStatus, Mode=OneWay}" />
                    <controls:DeviceStatusWidget Grid.Column="1" Title="Barcode scanner" Glyph="&#xE8BD;" Detail="{x:Bind ViewModel.ScannerStatusText, Mode=OneWay}" Status="{x:Bind ViewModel.ScannerHardwareStatus, Mode=OneWay}" />
                    <Border Grid.Column="2" Style="{StaticResource DashboardPanelStyle}" Padding="16"><StackPanel Orientation="Horizontal" Spacing="12"><Border Width="36" Height="36" CornerRadius="10" Background="{ThemeResource PastelGreenBrush}"><FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource PastelGreenOnBrush}" /></Border><StackPanel><TextBlock Text="Database" FontWeight="SemiBold" /><TextBlock Text="Connected" Style="{StaticResource CaptionTextStyle}" /><TextBlock Text="Local store data available" Style="{StaticResource CaptionTextStyle}" /></StackPanel></StackPanel></Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
