<Page
    x:Class="Kirana.App.Views.PosShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Page.Resources>
        <MenuFlyout x:Key="SearchFlyout" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.StoreName, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Dashboard 🔒" Click="OnDashboardClick" />
        </Grid>

        <!-- Scan / search bar + customer -->
        <Grid Grid.Row="1" Margin="20,12,20,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ScanSearchBox" Grid.Column="0" FontSize="18"
                     PlaceholderText="Scan Barcode / Product ID / SKU / Name (F2)"
                     CharacterReceived="OnCharacterReceived" KeyDown="OnScanSearchKeyDown" />

            <Button Grid.Column="1" Click="OnCustomerClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE77B;" FontSize="16" />
                    <TextBlock Text="{x:Bind ViewModel.CustomerDisplayText, Mode=OneWay}" />
                    <TextBlock Text="(F4)" Opacity="0.6" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar Grid.Row="1" Margin="20,0,20,0" VerticalAlignment="Bottom"
                 IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <!-- Cart -->
        <Grid Grid.Row="2" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" ItemsSource="{x:Bind ViewModel.CartLines}" SelectionMode="None">
                <ListView.HeaderTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="8" Padding="8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Product" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Qty" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="Price" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="3" Text="Disc %" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="Line Total" FontWeight="SemiBold" />
                        </Grid>
                    </DataTemplate>
                </ListView.HeaderTemplate>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CartLineViewModel">
                        <Grid ColumnSpacing="8" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Bind ProductName}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ProductCode}" Opacity="0.6" FontSize="11" />
                            </StackPanel>

                            <TextBox Grid.Column="1" Text="{x:Bind QuantityText, Mode=TwoWay}" Tag="{x:Bind}" LostFocus="OnQuantityLostFocus" />
                            <TextBlock Grid.Column="2" Text="{x:Bind UnitPrice}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="3" Text="{x:Bind DiscountPercentText, Mode=TwoWay}" Tag="{x:Bind}" LostFocus="OnDiscountLostFocus" />
                            <TextBlock Grid.Column="4" Text="{x:Bind LineTotal, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <Button Grid.Column="5" Content="✕" Click="OnRemoveLineClick" Tag="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Totals panel -->
            <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="6" VerticalAlignment="Top">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Subtotal" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SubTotal, Mode=OneWay}" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Item Discounts" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ItemDiscountTotal, Mode=OneWay}" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Bill Discount" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.BillDiscountAmount, Mode=OneWay}" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="GST" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TaxTotal, Mode=OneWay}" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Round Off" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RoundOffAmount, Mode=OneWay}" />
                </Grid>

                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,8" />

                <TextBlock FontSize="34" FontWeight="Bold" HorizontalAlignment="Right">
                    <Run Text="₹" /><Run Text="{x:Bind ViewModel.GrandTotal, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Action bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Padding="20,0,20,12" HorizontalAlignment="Right">
            <Button Content="Hold (F6)" Click="OnHoldClick" />
            <Button Content="Resume (F7)" Click="OnResumeClick" />
            <Button Content="Discount (F8)" Click="OnDiscountClick" />
            <Button Content="Payment / Complete Sale (F9)" Style="{StaticResource AccentButtonStyle}" Click="OnPaymentClick" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="16" Padding="20,0,20,16" HorizontalAlignment="Left">
            <TextBlock Text="{x:Bind ViewModel.HeldBillsCount, Mode=OneWay}" Opacity="0.7" />
            <TextBlock Text="held bill(s)" Opacity="0.7" />
        </StackPanel>
    </Grid>
</Page>
