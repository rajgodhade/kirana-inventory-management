<Page
    x:Class="Kirana.App.Views.PosShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    xmlns:dom="using:Kirana.Domain.Entities">

    <Page.Resources>
        <MenuFlyout x:Key="SearchFlyout" />
    </Page.Resources>

    <!--
        Layout and keyboard flow are unchanged from the original billing screen (F2 search, F4
        customer, F6 hold, F7 resume, F8 discount, F9 pay) — only the presentation was reworked.
    -->
    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,12" Background="{ThemeResource NavigationBackgroundBrush}"
              BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="{StaticResource RadiusMedium}"
                    Background="{ThemeResource BrandPrimaryBrush}" VerticalAlignment="Center">
                <TextBlock Text="K" FontSize="17" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                <TextBlock Text="{x:Bind ViewModel.StoreName, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="Billing" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>

            <Button Grid.Column="2" Click="OnThemeToggleClick" VerticalAlignment="Center"
                    AutomationProperties.Name="Toggle light and dark theme">
                <FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="15" />
            </Button>

            <Button Grid.Column="3" Click="OnDashboardClick" VerticalAlignment="Center"
                    AutomationProperties.Name="Open management dashboard">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72E;" FontSize="14" />
                    <TextBlock Text="Dashboard" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Scan / search bar + customer -->
        <Grid Grid.Row="1" Margin="20,16,20,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ScanSearchBox" Grid.Column="0" FontSize="17" Padding="14,11"
                     PlaceholderText="Scan barcode, or type Product ID / SKU / name  (F2)"
                     CharacterReceived="OnCharacterReceived" KeyDown="OnScanSearchKeyDown"
                     TextChanged="OnScanSearchTextChanged" />

            <Popup x:Name="SuggestionsPopup" Grid.Column="0" HorizontalOffset="0" VerticalOffset="52"
                   IsLightDismissEnabled="False" IsOpen="{x:Bind ViewModel.HasSuggestions, Mode=OneWay}">
                <Border Style="{StaticResource CardBorderStyle}" Width="520" MaxHeight="360" Padding="4">
                    <ListView x:Name="SuggestionsList" ItemsSource="{x:Bind ViewModel.SearchSuggestions}"
                              SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnSuggestionItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dom:Product">
                                <Grid ColumnSpacing="12" Padding="8,6" AutomationProperties.Name="{x:Bind Name}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="1">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}">
                                            <Run Text="{x:Bind ProductCode}" /><Run Text="  ·  " /><Run Text="{x:Bind Sku}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind SellingPrice, Converter={StaticResource CurrencyConverter}}"
                                               Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Popup>

            <!-- The button's content is icon + bound text, which leaves it without an accessible
                 name; set one explicitly so screen readers announce it. -->
            <Button Grid.Column="1" Click="OnCustomerClick" Padding="14,11"
                    AutomationProperties.Name="Select Customer (F4)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE77B;" FontSize="15" />
                    <TextBlock Text="{x:Bind ViewModel.CustomerDisplayText, Mode=OneWay}" />
                    <TextBlock Text="F4" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Cart + totals -->
        <Grid Grid.Row="2" Margin="20,16,20,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="10" Padding="14,10"
                          Background="{ThemeResource SurfaceAltBrush}"
                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PRODUCT" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="QTY" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="PRICE" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="DISC %" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="TOTAL" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                    </Grid>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.CartLines}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CartLineViewModel">
                                <Grid ColumnSpacing="10" Padding="14,10"
                                      BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="160" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ProductName}" Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ProductCode}" Style="{StaticResource CodeTextStyle}" />
                                    </StackPanel>

                                    <TextBox Grid.Column="1" Text="{x:Bind QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Bind}"
                                             TextChanged="OnQuantityTextChanged" LostFocus="OnQuantityLostFocus"
                                             VerticalAlignment="Center" TextAlignment="Center" />

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                        <TextBox Text="{x:Bind UnitPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Bind}"
                                                 TextChanged="OnPriceTextChanged" LostFocus="OnPriceLostFocus"
                                                 TextAlignment="Center"
                                                 AutomationProperties.Name="Price (editable — applies to this bill only)" />
                                        <TextBlock Text="{x:Bind OriginalUnitPrice, Converter={StaticResource CurrencyConverter}}"
                                                   Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center"
                                                   TextDecorations="Strikethrough"
                                                   Visibility="{x:Bind IsPriceOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>

                                    <TextBox Grid.Column="3" Text="{x:Bind DiscountPercentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Bind}"
                                             TextChanged="OnDiscountTextChanged" LostFocus="OnDiscountLostFocus"
                                             VerticalAlignment="Center" TextAlignment="Center" />

                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource AmountTextStyle}"
                                               HorizontalAlignment="Right"
                                               Text="{x:Bind LineTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />

                                    <Button Grid.Column="5" Click="OnRemoveLineClick" Tag="{x:Bind}"
                                            VerticalAlignment="Center" Padding="8,4"
                                            AutomationProperties.Name="Remove line">
                                        <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="{ThemeResource DangerBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Totals -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}"
                    VerticalAlignment="Top">
                <StackPanel Spacing="9">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Subtotal" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}"
                                   Text="{x:Bind ViewModel.SubTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Item discounts" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}"
                                   Text="{x:Bind ViewModel.ItemDiscountTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Bill discount" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}"
                                   Text="{x:Bind ViewModel.BillDiscountAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="GST" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}"
                                   Text="{x:Bind ViewModel.TaxTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Round off" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}"
                                   Text="{x:Bind ViewModel.RoundOffAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                    </Grid>

                    <Border BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,4" />

                    <StackPanel Spacing="0">
                        <TextBlock Text="AMOUNT PAYABLE" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Style="{StaticResource MetricTextStyle}" FontSize="34"
                                   Foreground="{ThemeResource BrandPrimaryBrush}"
                                   Text="{x:Bind ViewModel.GrandTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <InfoBar Grid.Row="2" Margin="20,0,356,12" VerticalAlignment="Bottom"
                 IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                 Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

        <!-- Action bar -->
        <Grid Grid.Row="3" Padding="20,14" ColumnSpacing="8"
              Background="{ThemeResource NavigationBackgroundBrush}"
              BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}"
                          Visibility="{x:Bind ViewModel.HasHeldBills, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                           Text="{x:Bind ViewModel.HeldBillsSummary, Mode=OneWay}" />
            </StackPanel>

            <Button Grid.Column="2" Content="Hold (F6)" Click="OnHoldClick" Padding="14,9" />
            <Button Grid.Column="3" Content="Resume (F7)" Click="OnResumeClick" Padding="14,9" />
            <Button Grid.Column="4" Content="Discount (F8)" Click="OnDiscountClick" Padding="14,9" />
            <Button Grid.Column="5" Style="{StaticResource AccentButtonStyle}" Click="OnPaymentClick" Padding="20,9">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8C7;" FontSize="14" />
                    <TextBlock Text="Payment / Complete Sale" FontWeight="SemiBold" />
                    <TextBlock Text="F9" Opacity="0.75" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
