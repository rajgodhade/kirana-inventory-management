<Page
    x:Class="Kirana.App.Views.PosShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels"
    xmlns:dom="using:Kirana.Domain.Entities"
    xmlns:controls="using:Kirana.App.Views.Controls">

    <Page.Resources>
        <MenuFlyout x:Key="SearchFlyout" />

        <!-- One billing tab chip. Selected state uses the same pastel-fill + teal-underline
             language as the Reports tab bar, so both tab strips in the app read as one idea. -->
        <DataTemplate x:Key="BillTabTemplate" x:DataType="vm:BillSessionViewModel">
            <Grid>
                <!-- Pastel fill for the selected tab. A ThemeResource-bound Border rather than a
                     converter, so it re-resolves on light/dark switch with no code involved. -->
                <Border CornerRadius="8,8,0,0" Background="{ThemeResource BrandSubtleBrush}"
                        Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button Click="OnBillTabClick" Tag="{x:Bind}" Padding="12,6,6,6" MinWidth="0"
                        CornerRadius="8,8,0,0" BorderThickness="0" Background="Transparent"
                        HorizontalContentAlignment="Left"
                        AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Dot marks a tab that still holds scanned goods. -->
                        <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{ThemeResource BrandPrimaryBrush}"
                                 Visibility="{x:Bind HasItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="13"
                                       FontWeight="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BillTabFontWeightConverter}}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind CustomerSummary, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button Grid.Column="2" Click="OnCloseBillClick" Tag="{x:Bind}"
                                Padding="4" MinWidth="0" Width="22" Height="22"
                                Background="Transparent" BorderThickness="0" CornerRadius="11"
                                ToolTipService.ToolTip="Close this bill"
                                AutomationProperties.Name="Close bill">
                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                        </Button>
                    </Grid>
                </Button>

                <!-- 3px active underline, matching the Reports tab bar. -->
                <Border Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="4,0,4,0"
                        Background="{ThemeResource BrandPrimaryBrush}"
                        Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!--
        Layout and keyboard flow are unchanged from the original billing screen (F2 search, F4
        customer, F6 hold, F7 resume, F8 discount, F9 pay) — only the presentation was reworked.
    -->
    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,12" Background="{ThemeResource NavigationBackgroundBrush}"
              BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="{StaticResource RadiusMedium}"
                    Background="{ThemeResource BrandPrimaryBrush}" VerticalAlignment="Center">
                <TextBlock Text="K" FontSize="17" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                <TextBlock Text="{x:Bind ViewModel.StoreName, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <TextBlock Text="Billing" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock x:Name="CurrentDayDateText" Style="{StaticResource SecondaryTextStyle}"
                           HorizontalAlignment="Right" />
                <TextBlock x:Name="CurrentTimeText" Style="{StaticResource CaptionTextStyle}"
                           HorizontalAlignment="Right" />
            </StackPanel>

            <Button Grid.Column="3" Click="OnThemeToggleClick" VerticalAlignment="Center"
                    AutomationProperties.Name="Toggle light and dark theme">
                <FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="15" />
            </Button>

            <Button Grid.Column="4" Click="OnDashboardClick" VerticalAlignment="Center"
                    AutomationProperties.Name="Open management dashboard">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72E;" FontSize="14" />
                    <TextBlock Text="Dashboard" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Billing tabs: several customers can be part-way through a bill at once. -->
        <Grid Grid.Row="1" Padding="20,10,20,0" Background="{ThemeResource NavigationBackgroundBrush}"
              BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Bills}" ItemTemplate="{StaticResource BillTabTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button Click="OnNewBillClick" VerticalAlignment="Center" Margin="4,0,0,0" Padding="12,7"
                            CornerRadius="{StaticResource RadiusMedium}" IsEnabled="{x:Bind ViewModel.CanAddBill, Mode=OneWay}"
                            ToolTipService.ToolTip="Start another bill (up to 10)" AutomationProperties.Name="New Bill beside bill tabs">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="12" /><TextBlock Text="New Bill" FontSize="13" /></StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <TextBox Grid.Column="1" Width="190" Height="34" VerticalAlignment="Center" Margin="0,0,0,6"
                     CornerRadius="{StaticResource RadiusMedium}"
                     PlaceholderText="Note for this bill"
                     Text="{x:Bind ViewModel.ActiveBillNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Note for this bill" />

        </Grid>

        <!-- Scan / search bar + customer -->
        <Grid Grid.Row="2" Margin="20,16,20,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ScanSearchBox" Grid.Column="0" FontSize="17" Padding="14,11"
                     PlaceholderText="Scan barcode, or type Product ID / SKU / name  (F2)"
                     CharacterReceived="OnCharacterReceived" KeyDown="OnScanSearchKeyDown"
                     TextChanged="OnScanSearchTextChanged" />

            <Popup x:Name="SuggestionsPopup" Grid.Column="0" HorizontalOffset="0" VerticalOffset="52"
                   IsLightDismissEnabled="False" IsOpen="{x:Bind ViewModel.HasSuggestions, Mode=OneWay}">
                <Border Style="{StaticResource CardBorderStyle}" Width="520" MaxHeight="360" Padding="4">
                    <ListView x:Name="SuggestionsList" ItemsSource="{x:Bind ViewModel.SearchSuggestions}"
                              SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnSuggestionItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dom:Product">
                                <Grid ColumnSpacing="12" Padding="8,6" AutomationProperties.Name="{x:Bind Name}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="1">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock Style="{StaticResource CaptionTextStyle}">
                                            <Run Text="{x:Bind ProductCode}" /><Run Text="  ·  " /><Run Text="{x:Bind Sku}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind SellingPrice, Converter={StaticResource CurrencyConverter}}"
                                               Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Popup>

            <!-- The button's content is icon + bound text, which leaves it without an accessible
                 name; set one explicitly so screen readers announce it. -->
            <Button Grid.Column="1" Click="OnCustomerClick" Padding="14,9"
                    CornerRadius="{StaticResource RadiusMedium}"
                    AutomationProperties.Name="Select Customer (F4)">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE77B;" FontSize="15" VerticalAlignment="Center" />
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.CustomerDisplayText, Mode=OneWay}" FontWeight="SemiBold" />
                        <!-- Outstanding udhaar surfaces here so the cashier sees it before adding
                             more credit, without opening the customer's ledger. -->
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    Visibility="{x:Bind ViewModel.HasCustomerOutstanding, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Owes" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.CustomerOutstandingText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource WarningBrush}" />
                        </StackPanel>
                        <TextBlock Text="Press F4 to change" Style="{StaticResource CaptionTextStyle}"
                                   Visibility="{x:Bind ViewModel.HasCustomerOutstanding, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Text="F4" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Cart + totals -->
        <Grid Grid.Row="3" Margin="20,16,20,0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="10" Padding="14,10"
                          Background="{ThemeResource SurfaceAltBrush}"
                          BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PRODUCT" Style="{StaticResource ColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="QTY / UNIT" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="MRP" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="PRICE" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="DISC %" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="TOTAL" Style="{StaticResource ColumnHeaderTextStyle}" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Empty state doubles as the keyboard cheat-sheet: this is the screen a new
                         cashier stares at most, so the shortcuts are taught here rather than hidden
                         in a manual. -->
                    <StackPanel Grid.Row="1" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.HasCartLines, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE7BF;" FontSize="34" Foreground="{ThemeResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Cart is empty" Style="{StaticResource SectionTitleTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Scan a barcode, or search by name / SKU to add the first item."
                                   Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" />

                        <Border Background="{ThemeResource SurfaceAltBrush}" CornerRadius="{StaticResource RadiusLarge}"
                                BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="1"
                                Padding="18,14" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <StackPanel Spacing="8">
                                <TextBlock Text="KEYBOARD SHORTCUTS" Style="{StaticResource ColumnHeaderTextStyle}"
                                           HorizontalAlignment="Center" />
                                <Grid ColumnSpacing="22" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="F2" Style="{StaticResource CodeTextStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Search / scan" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="F4" Style="{StaticResource CodeTextStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Select customer" Style="{StaticResource CaptionTextStyle}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="F6" Style="{StaticResource CodeTextStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Hold bill" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="F7" Style="{StaticResource CodeTextStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Resume held bill" Style="{StaticResource CaptionTextStyle}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="F8" Style="{StaticResource CodeTextStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Bill discount" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="F9" Style="{StaticResource CodeTextStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Payment / complete" Style="{StaticResource CaptionTextStyle}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.CartLines}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CartLineViewModel">
                                <Grid ColumnSpacing="10" Padding="14,10"
                                      BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="160" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="44" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ProductName}" Style="{StaticResource CardTitleTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ProductCode}" Style="{StaticResource CodeTextStyle}" />
                                        <Border Background="{ThemeResource SurfaceAltBrush}" CornerRadius="10" Padding="7,3"
                                                HorizontalAlignment="Left"
                                                ToolTipService.ToolTip="GST treatment for this item">
                                            <TextBlock Text="{x:Bind PricingTypeLabel}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </Border>
                                        <Border Background="{ThemeResource PastelGreenBrush}" CornerRadius="10" Padding="7,3"
                                                HorizontalAlignment="Left"
                                                Visibility="{x:Bind HasPromotion, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{ThemeResource PastelGreenOnBrush}" />
                                                <TextBlock Text="{x:Bind PromotionText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource PastelGreenOnBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Unit sits under the quantity box because it qualifies that number
                                         ("1.5 Kilogram"), and it is the same unit printed on the invoice. -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <TextBox Text="{x:Bind QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Bind}"
                                                 TextChanged="OnQuantityTextChanged" LostFocus="OnQuantityLostFocus"
                                                 TextAlignment="Center" />
                                        <TextBlock Text="{x:Bind Unit}" Style="{StaticResource CaptionTextStyle}"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Read-only: MRP is a product attribute shown for comparison, never
                                         something a cashier edits mid-bill (unlike the Price cell). Hidden
                                         rather than shown as "₹0.00" for a product with no MRP set. -->
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}"
                                               HorizontalAlignment="Center" Opacity="0.75"
                                               Text="{x:Bind Mrp, Converter={StaticResource CurrencyConverter}}"
                                               Visibility="{x:Bind HasMrp, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="1">
                                        <TextBox Text="{x:Bind UnitPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Bind}"
                                                 TextChanged="OnPriceTextChanged" LostFocus="OnPriceLostFocus"
                                                 TextAlignment="Center"
                                                 AutomationProperties.Name="Price (editable — applies to this bill only)" />
                                        <TextBlock Text="{x:Bind OriginalUnitPrice, Converter={StaticResource CurrencyConverter}}"
                                                   Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center"
                                                   TextDecorations="Strikethrough"
                                                   Visibility="{x:Bind IsPriceOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>

                                    <TextBox Grid.Column="4" Text="{x:Bind DiscountPercentText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Bind}"
                                             TextChanged="OnDiscountTextChanged" LostFocus="OnDiscountLostFocus"
                                             VerticalAlignment="Center" TextAlignment="Center" />

                                    <TextBlock Grid.Column="5" VerticalAlignment="Center" Style="{StaticResource AmountTextStyle}"
                                               HorizontalAlignment="Right"
                                               Text="{x:Bind LineTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />

                                    <Button Grid.Column="6" Click="OnRemoveLineClick" Tag="{x:Bind}"
                                            VerticalAlignment="Center" Padding="8,4"
                                            AutomationProperties.Name="Remove line">
                                        <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="{ThemeResource DangerBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Totals -->
            <!-- Stretches rather than sitting Top, and scrolls internally: the tab strip costs the
                 billing area ~55px of height, which was enough to clip the Amount Payable panel off
                 the bottom on a short window. HorizontalScrollMode MUST stay Disabled — a
                 ScrollViewer measures its content at infinite size in any direction it can scroll,
                 which would let the card ignore this column's width. -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="{StaticResource CardPaddingLarge}"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                <!-- Only the breakdown scrolls; Amount Payable is pinned to the bottom row so the
                     number the customer is about to pay is never the thing that scrolls away. -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="9">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Total items" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}"
                                   Text="{x:Bind ViewModel.TotalItemCount, Mode=OneWay}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Subtotal" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}"
                                   Text="{x:Bind ViewModel.SubTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Item discounts" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}"
                                   Text="{x:Bind ViewModel.ItemDiscountTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                    </Grid>
                    <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.HasPromotionDiscount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Promotion savings" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{ThemeResource SuccessBrush}"
                                   Text="{x:Bind ViewModel.PromotionDiscountTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Bill discount" Style="{StaticResource SecondaryTextStyle}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"
                                   Text="{x:Bind ViewModel.BillDiscountAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                        <!-- Only way to undo a bill discount used to be reopening the dialog and
                             typing 0, which reads as "change it", not "remove it". -->
                        <Button Grid.Column="2" Click="OnClearBillDiscountClick" Padding="5,2" MinWidth="0"
                                Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                AutomationProperties.Name="Remove bill discount"
                                ToolTipService.ToolTip="Remove bill discount"
                                Visibility="{x:Bind ViewModel.HasBillDiscount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="{ThemeResource DangerBrush}" />
                        </Button>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="GST" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}"
                                   Text="{x:Bind ViewModel.TaxTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Round off" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}"
                                   Text="{x:Bind ViewModel.RoundOffAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                    </Grid>
                </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Spacing="9">
                    <Border BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,4" />

                    <!-- The one number the customer is about to hand over money for: given its own
                         filled panel so it can't be confused with the breakdown rows above it. -->
                    <Border Background="{ThemeResource PastelTealBrush}" CornerRadius="{StaticResource RadiusLarge}"
                            Padding="16,12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="AMOUNT PAYABLE" Style="{StaticResource ColumnHeaderTextStyle}"
                                       Foreground="{ThemeResource PastelTealOnBrush}" />
                            <TextBlock Style="{StaticResource MetricTextStyle}" FontSize="38"
                                       Foreground="{ThemeResource PastelTealOnBrush}"
                                       Text="{x:Bind ViewModel.GrandTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                            <TextBlock Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{ThemeResource PastelTealOnBrush}" Opacity="0.85">
                                <Run Text="{x:Bind ViewModel.TotalItemCount, Mode=OneWay}" /><Run Text=" item(s) · press F9 to take payment" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- MRP vs. what's actually being charged, floored at zero — a product with no
                         MRP set or a manually-raised price contributes nothing, never a negative
                         "saving". Hidden entirely rather than shown as ₹0.00 when there's nothing
                         to report. -->
                    <Border Background="{ThemeResource SuccessSubtleBrush}" CornerRadius="6" Padding="10,6" Margin="0,8,0,0"
                            Visibility="{x:Bind ViewModel.HasSavings, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="You Saved" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{ThemeResource SuccessBrush}" />
                            <TextBlock Grid.Column="1" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{ThemeResource SuccessBrush}"
                                       Text="{x:Bind ViewModel.TotalSavings, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" />
                        </Grid>
                    </Border>
                </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Margin="20,0,356,12" VerticalAlignment="Bottom" Spacing="6">
            <InfoBar x:Name="HardwareWarningBar" IsOpen="False" Severity="Warning" IsClosable="True" />
            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>

        <!-- Action bar -->
        <Grid Grid.Row="4" Padding="20,14" ColumnSpacing="8"
              Background="{ThemeResource NavigationBackgroundBrush}"
              BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}"
                              Visibility="{x:Bind ViewModel.HasHeldBills, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"
                               Text="{x:Bind ViewModel.HeldBillsSummary, Mode=OneWay}" />
                </StackPanel>

                <Button Padding="0" Background="Transparent" BorderThickness="0" Click="OnHardwareStatusClick"
                        ToolTipService.ToolTip="Open Hardware Settings">
                    <controls:DeviceStatusWidget Width="210" Title="Printer" Glyph="&#xE749;"
                        Detail="{x:Bind DeviceStatus.PrinterDetail, Mode=OneWay}"
                        Status="{x:Bind DeviceStatus.PrinterStatus, Mode=OneWay}" />
                </Button>

                <Button Padding="0" Background="Transparent" BorderThickness="0" Click="OnHardwareStatusClick"
                        ToolTipService.ToolTip="Open Hardware Settings">
                    <controls:DeviceStatusWidget Width="210" Title="Scanner" Glyph="&#xE8BD;"
                        Detail="{x:Bind DeviceStatus.ScannerDetail, Mode=OneWay}"
                        Status="{x:Bind DeviceStatus.ScannerStatus, Mode=OneWay}" />
                </Button>
            </StackPanel>

            <Button Grid.Column="2" Content="Hold (F6)" Click="OnHoldClick" Padding="14,9" />
            <Button Grid.Column="3" Content="Resume (F7)" Click="OnResumeClick" Padding="14,9" />
            <Button Grid.Column="4" Content="Discount (F8)" Click="OnDiscountClick" Padding="14,9" />
            <Button Grid.Column="5" Style="{StaticResource AccentButtonStyle}" Click="OnPaymentClick" Padding="20,9">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8C7;" FontSize="14" />
                    <TextBlock Text="Payment / Complete Sale" FontWeight="SemiBold" />
                    <TextBlock Text="F9" Opacity="0.75" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
