<Page
    x:Class="Kirana.App.Views.ManagementPlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="20,16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Management" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Lock &amp; Return to Billing" Click="OnLockClick" />
        </Grid>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <TextBlock Text="You're signed in to management mode." FontSize="20" HorizontalAlignment="Center" />
            <Button Content="Products" Click="OnProductsClick" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" />
            <Button Content="Barcode Scan" Click="OnBarcodeScanClick" HorizontalAlignment="Center" />
            <Button Content="Reprint Invoice" Click="OnReprintInvoiceClick" HorizontalAlignment="Center" />
            <Button Content="Suppliers" Click="OnSuppliersClick" HorizontalAlignment="Center"
                    Visibility="{x:Bind CanManagePurchases, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Content="Purchases" Click="OnPurchasesClick" HorizontalAlignment="Center"
                    Visibility="{x:Bind CanManagePurchases, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Content="Users" Click="OnUsersClick" HorizontalAlignment="Center"
                    Visibility="{x:Bind CanManageUsers, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Content="Audit Log" Click="OnAuditLogClick" HorizontalAlignment="Center"
                    Visibility="{x:Bind CanViewAuditLog, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Content="Settings" Click="OnSettingsClick" HorizontalAlignment="Center"
                    Visibility="{x:Bind CanChangeSettings, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Button Content="Reports" Click="OnReportsClick" HorizontalAlignment="Center"
                    Visibility="{x:Bind CanViewReports, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="Customer Udhaar, returns, full Reports etc. arrive in later phases."
                       Opacity="0.7" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
