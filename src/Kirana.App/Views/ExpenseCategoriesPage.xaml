<Page
    x:Class="Kirana.App.Views.ExpenseCategoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Kirana.App.ViewModels">

    <Grid Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="{StaticResource PageHeaderPadding}" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Expense Categories" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Headings expenses are filed under. Built-in ones can be renamed or deactivated."
                           Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnAddClick"
                    VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.CanManageExpenses}"
                    AutomationProperties.Name="Add Category">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Add Category" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Padding="{StaticResource ToolbarPadding}" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" Content="Show inactive" IsChecked="{x:Bind ViewModel.ShowInactive, Mode=TwoWay}"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
            <Button Grid.Column="2" Content="Back to Expenses" Click="OnBackToExpensesClick" />
        </Grid>

        <Grid Grid.Row="2" Margin="24,0,24,24">
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <ListView ItemsSource="{x:Bind ViewModel.Categories}" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExpenseCategoryRowViewModel">
                            <Grid Padding="14,12" ColumnSpacing="16"
                                  BorderBrush="{ThemeResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" MinWidth="230" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" Style="{StaticResource CardTitleTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Description}" Style="{StaticResource SecondaryTextStyle}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />

                                <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}"
                                        Background="{ThemeResource SuccessSubtleBrush}"
                                        Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Active" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource SuccessBrush}" />
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}"
                                        Background="{ThemeResource SurfaceAltBrush}"
                                        Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="Inactive" Style="{StaticResource BadgeTextStyle}" Foreground="{ThemeResource TextTertiaryBrush}" />
                                </Border>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Content="Rename" Click="OnEditClick" Tag="{x:Bind}" />
                                    <Button Content="Deactivate" Click="OnToggleActiveClick" Tag="{x:Bind}"
                                            Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Button Content="Reactivate" Click="OnToggleActiveClick" Tag="{x:Bind}"
                                            Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    <Button Content="Delete" Click="OnDeleteClick" Tag="{x:Bind}"
                                            Visibility="{x:Bind CanDelete, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <InfoBar IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                     Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" VerticalAlignment="Top" />
        </Grid>
    </Grid>
</Page>
