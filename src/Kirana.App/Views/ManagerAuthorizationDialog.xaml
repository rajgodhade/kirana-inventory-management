<ContentDialog
    x:Class="Kirana.App.Views.ManagerAuthorizationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Manager Authorization Required"
    PrimaryButtonText="Authorize"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="320">
        <TextBlock Text="This action needs a manager or owner PIN." TextWrapping="Wrap" />
        <PasswordBox x:Name="PinBox" Header="Manager / Owner PIN" />
        <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" />
    </StackPanel>
</ContentDialog>
